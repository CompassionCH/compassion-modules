{
  "name": "Intervention Reservation Creation",
  "model": "compassion.intervention.hold.wizard",
  "mapping": {
    "Intervention_ID": {
      "field": "intervention_id.intervention_id",
      "allow_relational_creation": false
    },
    "ExpirationDate": {
      "field": "expiration_date",
      "to_json_conversion": "fields.Datetime.from_string(odoo_value).strftime('%Y-%m-%dT%H:%M:%SZ')"
    },
    "PrimaryOwner": {
      "field": "user_id.name",
      "search_relational_record": true
    },
    "Reservation_ID": {
      "field": "reservation_id",
      "exclude_from_json": true,
      "from_json_conversion": "str(json_value)"
    },
    "SecondaryOwner": {
      "field": "secondary_owner"
    },
    "ServiceLevel": {
      "field": "service_level",
      "to_json_conversion": "odoo_value and int(odoo_value[-1]) or 1"
    },
    "GlobalPartner_ID": {
      "to_json_conversion": "gpid"
    }
  }
}
