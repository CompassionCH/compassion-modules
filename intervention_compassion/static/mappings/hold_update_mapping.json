{
  "name": "Hold Update",
  "model": "compassion.intervention",
  "mapping": {
    "Intervention_ID": {
      "field": "intervention_id"
    },
    "HoldID": {
      "field": "hold_id"
    },
    "ExpirationDate": {
      "field": "expiration_date"
    },
    "HoldExpirationDate": "expiration_date",
    "HoldAmount": {
      "field": "hold_amount",
      "to_json_conversion": "str(odoo_value)"
    },
    "NextYearOptIn": {
      "field": "next_year_opt_in"
    },
    "PrimaryOwner": {
      "field": "user_id.name",
      "search_relational_record": true
    },
    "Reservation_ID": {
      "field": "reservation_id",
      "from_json_conversion": "int(json_value)"
    },
    "SecondaryOwner": {
      "field": "secondary_owner"
    },
    "ServiceLevelAgreement": {
      "field": "service_level"
    },
    "SLALevel": {
      "field": "service_level",
      "from_json_conversion": "'Level ' + str(json_value)"
    },
    "GlobalPartner_ID": {
      "to_json_conversion": "gpid"
    }
  }
}
