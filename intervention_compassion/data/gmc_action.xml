<odoo>
    <data noupdate="1">
        <!-- Get Intervention Kit -->
        <record id="intervention_details_request" model="gmc.action">
            <field name="direction">out</field>
            <field name="name">InterventionDetailsRequest</field>
            <field name="mapping_id" ref="mapping_intervention" />
            <field name="model">compassion.intervention</field>
            <field name="description">GET Intervention Kit</field>
            <field
        name="connect_service"
      >interventions/${object.intervention_id}/kits/InterventionKit</field>
            <field
        name="connect_answer_wrapper"
      >InterventionDetailsRequest</field>
            <field name="request_type">GET</field>
            <field name="auto_process">1</field>
            <field name="no_outgoing_data" eval="True" />
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <!-- update Intervention Kit -->
        <record id="update_intervention_details" model="gmc.action">
            <field name="direction">in</field>
            <field name="name">UpdateInterventionDetailsRequest</field>
            <field name="mapping_id" ref="mapping_intervention" />
            <field name="model">compassion.intervention</field>
            <field
        name="incoming_method"
      >update_intervention_details_request</field>
            <field name="description">Update Intervention Kit</field>
            <field name="auto_process">1</field>
            <field name="no_outgoing_data" eval="True" />
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <!-- create Intervention Kit -->
        <record id="create_intervention_details" model="gmc.action">
            <field name="direction">in</field>
            <field name="name">GPInitiatedInterventionHoldNotification</field>
            <field name="mapping_id" ref="mapping_intervention" />
            <field name="model">compassion.intervention</field>
            <field name="incoming_method">create_intervention</field>
            <field name="description">Create Intervention Kit</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>
        <record id="create_intervention_opt_in" model="gmc.action">
            <field name="direction">in</field>
            <field name="name">InterventionOptInHoldNotification</field>
            <field name="mapping_id" ref="mapping_intervention" />
            <field name="model">compassion.intervention</field>
            <field name="incoming_method">create_intervention</field>
            <field
        name="description"
      >Create Intervention Because Opt-In was set</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <!-- Search Intervention -->
        <record id="intervention_search_action" model="gmc.action">
            <field name="direction">out</field>
            <field name="name">InterventionSearch</field>
            <field name="model">compassion.intervention.search</field>
            <field name="mapping_id" ref="mapping_intervention_search" />
            <field
        name="description"
      >This will send a search query for Interventions.</field>
            <field
        name="connect_service"
      >interventions/availabilityquery</field>
            <field name="request_type">POST</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <!-- Create Hold -->
        <record id="intervention_create_hold_action" model="gmc.action">
            <field name="direction">out</field>
            <field name="name">InterventionHoldCreate</field>
            <field name="model">compassion.intervention.hold.wizard</field>
            <field name="mapping_id" ref="mapping_hold_create" />
            <field
        name="description"
      >This will create a hold for Interventions.</field>
            <field name="connect_service">interventions/holds</field>
            <field name="connect_outgoing_wrapper">InterventionHoldList</field>
            <field
        name="connect_answer_wrapper"
      >InterventionHoldResponse</field>
            <field name="success_method">hold_sent</field>
            <field name="request_type">POST</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <!-- Update Hold -->
        <record id="intervention_update_hold_action" model="gmc.action">
            <field name="direction">out</field>
            <field name="name">InterventionHoldUpdate</field>
            <field name="model">compassion.intervention</field>
            <field name="mapping_id" ref="mapping_hold_update" />
            <field
        name="description"
      >This will update a hold for Interventions.</field>
            <field
        name="connect_service"
      >interventions/${object.intervention_id}/holds/${object.hold_id}</field>
            <field name="connect_outgoing_wrapper">InterventionHoldList</field>
            <field
        name="connect_answer_wrapper"
      >InterventionHoldResponse</field>
            <field name="success_method">hold_sent</field>
            <field name="request_type">PUT</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <!-- Cancel Hold -->
        <record id="intervention_cancel_hold_action" model="gmc.action">
            <field name="direction">out</field>
            <field name="name">InterventionHoldCancel</field>
            <field name="model">compassion.intervention</field>
            <field name="mapping_id" ref="mapping_hold_cancel" />
            <field
        name="description"
      >This will cancel a hold for Interventions.</field>
            <field name="connect_service">interventions/holds/release</field>
            <field
        name="connect_outgoing_wrapper"
      >InterventionHoldCancellationList</field>
            <field
        name="connect_answer_wrapper"
      >InterventionHoldCancellationResponseList</field>
            <field name="success_method">hold_cancelled</field>
            <field name="auto_process">1</field>
            <field name="request_type">POST</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <!-- Remove Intervention Hold -->
        <record id="intervention_hold_removal_notification" model="gmc.action">
            <field name="direction">in</field>
            <field name="name">InterventionHoldRemovalNotification</field>
            <field name="mapping_id" ref="mapping_intervention" />
            <field name="model">compassion.intervention</field>
            <field
        name="incoming_method"
      >intervention_hold_removal_notification</field>
            <field
        name="description"
      >Notification sent to GP when a intervention hold is cancelled</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <!-- MileStonesMessage -->
        <record id="intervention_reporting_milestone" model="gmc.action">
            <field name="direction">in</field>
            <field name="name">InterventionReportingMilestoneRequestList</field>
            <field name="mapping_id" ref="mapping_intervention" />
            <field name="model">compassion.intervention</field>
            <field
        name="incoming_method"
      >intervention_reporting_milestone</field>
            <field
        name="description"
      >Notification send to follower of an intervention when it has an update</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <!-- Intervention Amendment Commitment Notification -->
        <record
      id="intervention_amendment_commitment_notification"
      model="gmc.action"
    >
            <field name="direction">in</field>
            <field
        name="name"
      >InterventionAmendmentCommitmentNotification</field>
            <field name="mapping_id" ref="mapping_intervention" />
            <field name="model">compassion.intervention</field>
            <field
        name="incoming_method"
      >intervention_amendement_commitment</field>
            <field
        name="description"
      >Notification send to follower of an intervention when a modification is made, and
                update this intervention
            </field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <!-- Create Commitment -->
        <record id="intervention_create_commitment_action" model="gmc.action">
            <field name="direction">out</field>
            <field name="name">InterventionCreateCommitment</field>
            <field
        name="model"
      >compassion.intervention.commitment.wizard</field>
            <field name="mapping_id" ref="mapping_create_commitment" />
            <field
        name="description"
      >This will create a commitment for an Intervention</field>
            <field name="connect_service">interventions/commitments</field>
            <field
        name="connect_outgoing_wrapper"
      >InterventionCommitmentList</field>
            <field
        name="connect_answer_wrapper"
      >InterventionCommitmentResponseList</field>
            <field name="success_method">commitment_created</field>
            <field name="request_type">POST</field>
            <field name="auto_process">0</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <!-- Commitment percent change notification -->
        <record id="commitment_percent_change_notification" model="gmc.action">
            <field name="direction">in</field>
            <field
        name="name"
      >InterventionCommittedPercentChangeNotification</field>
            <field name="mapping_id" ref="mapping_intervention" />
            <field name="model">compassion.intervention</field>
            <field name="incoming_method">commited_percent_change</field>
            <field
        name="description"
      >Notification sent to GP when the commited funding percentage has changed for an
                intervention.
            </field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <record
      id="intervention_hold_removal_connect"
      model="gmc.action.connect"
    >
            <field name="connect_schema">
                http://schemas.ci.org/ci/messaging/availability/2016/04/InterventionHoldRemovalNotification
            </field>
            <field
        name="action_id"
        ref="intervention_hold_removal_notification"
      />
        </record>

        <record id="intervention_create_connect" model="gmc.action.connect">
            <field name="connect_schema">
                http://schemas.ci.org/ci/messages/interventions/2016/04/GPInitiatedInterventionHoldNotification
            </field>
            <field name="action_id" ref="create_intervention_details" />
        </record>
        <record id="intervention_create_connect_2" model="gmc.action.connect">
            <field name="connect_schema">
                http://schemas.ci.org/ci/messages/availability/2016/04/GPInitiatedInterventionHoldNotification
            </field>
            <field name="action_id" ref="create_intervention_details" />
        </record>

        <record
      id="intervention_create_opt_in_connect"
      model="gmc.action.connect"
    >
            <field name="connect_schema">
                http://schemas.ci.org/ci/messaging/availability/2016/04/InterventionOptInHoldNotification
            </field>
            <field name="action_id" ref="create_intervention_opt_in" />
        </record>

        <record
      id="intervention_reporting_milestone_connect"
      model="gmc.action.connect"
    >
            <field name="connect_schema">
                http://schemas.ci.org/ci/messages/interventions/2016/04/ReportingMilestonesKit
            </field>
            <field name="action_id" ref="intervention_reporting_milestone" />
        </record>

        <record
      id="intervention_amendment_commitment_notification_connect"
      model="gmc.action.connect"
    >
            <field
        name="connect_schema"
      >http://schemas.ci.org/ci/messaging/availability/2016/04/InterventionAmendmentCommitmentNotification</field>
            <field
        name="action_id"
        ref="intervention_amendment_commitment_notification"
      />
        </record>

        <record id="intervention_update_connect" model="gmc.action.connect">
            <field
        name="connect_schema"
      >http://schemas.ci.org/ci/messages/interventions/2016/04/InterventionKit</field>
            <field name="action_id" ref="update_intervention_details" />
        </record>

        <record id="intervention_amend" model="gmc.action.connect">
            <field
        name="connect_schema"
      >http://schemas.ci.org/ci/messages/interventions/2016/04/AmendmentKit</field>
            <field
        name="action_id"
        ref="intervention_amendment_commitment_notification"
      />
        </record>

        <record
      id="intervention_commited_percent_connect"
      model="gmc.action.connect"
    >
            <field name="connect_schema">
                http://schemas.ci.org/ci/messaging/availability/2016/04/InterventionCommittedPercentChangeNotification
            </field>
            <field
        name="action_id"
        ref="commitment_percent_change_notification"
      />
        </record>

        <!-- Intervention Reservation -->
        <record id="intervention_create_reservation_action" model="gmc.action">
            <field name="direction">out</field>
            <field name="name">InterventionCreateReservation</field>
            <field name="model">compassion.intervention.hold.wizard</field>
            <field name="mapping_id" ref="mapping_reservation_create" />
            <field
        name="description"
      >Create a reservation to hold an intervention when the intervention becomes
Available.</field>
            <field name="connect_service">interventions/reservation</field>
            <field name="connect_answer_wrapper">ReservationResponse</field>
            <field name="success_method">hold_sent</field>
            <field name="priority">50</field>
            <field name="request_type">POST</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>
        <record id="intervention_update_reservation_action" model="gmc.action">
            <field name="direction">out</field>
            <field name="name">InterventionUpdateReservation</field>
            <field name="model">compassion.intervention</field>
            <field name="mapping_id" ref="mapping_reservation_update" />
            <field
        name="description"
      >Update a reservation to hold an intervention when the intervention becomes
Available.</field>
            <field
        name="connect_service"
      >interventions/reservation-update</field>
            <field name="connect_answer_wrapper">ReservationResponse</field>
            <field name="success_method">hold_sent</field>
            <field name="priority">50</field>
            <field name="request_type">PUT</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>
        <record id="intervention_cancel_reservation_action" model="gmc.action">
            <field name="direction">out</field>
            <field name="name">InterventionCancelReservation</field>
            <field name="model">compassion.intervention</field>
            <field name="mapping_id" ref="mapping_reservation_cancel" />
            <field
        name="description"
      >Cancel a reservation of an intervention.</field>
            <field
        name="connect_service"
      >interventions/reservation-cancel</field>
            <field name="connect_answer_wrapper">ReservationResponse</field>
            <field name="success_method">hold_cancelled</field>
            <field name="priority">50</field>
            <field name="request_type">POST</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>


        <!-- Intervention FCP Reservation -->
        <record
      id="intervention_create_fcp_reservation_action"
      model="gmc.action"
    >
            <field name="direction">out</field>
            <field name="name">InterventionCreateFCPReservation</field>
            <field name="model">compassion.reservation</field>
            <field
        name="mapping_id"
        ref="mapping_fcp_intervetion_reservation"
      />
            <field
        name="description"
      >Create a FCP Reservation to hold an intervention when the intervention becomes
Available in a given FCP.</field>
            <field
        name="connect_service"
      >interventions/fcp-reservation-create</field>
            <field
        name="connect_outgoing_wrapper"
      >FcpReservationCreateRequestList</field>
            <field
        name="connect_answer_wrapper"
      >FcpReservationCreateResponseList</field>
            <field name="success_method">reservation_create_answer</field>
            <field name="failure_method">reservation_create_answer_fail</field>
            <field name="priority">50</field>
            <field name="request_type">POST</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>
        <record
      id="intervention_update_fcp_reservation_action"
      model="gmc.action"
    >
            <field name="direction">out</field>
            <field name="name">InterventionUpdateFCPReservation</field>
            <field name="model">compassion.reservation</field>
            <field
        name="mapping_id"
        ref="mapping_fcp_intervetion_reservation"
      />
            <field
        name="description"
      >Update a FCP Reservation to hold an intervention when the intervention becomes
Available in a given FCP.</field>
            <field
        name="connect_service"
      >interventions/fcp-reservation-update</field>
            <field
        name="connect_outgoing_wrapper"
      >FcpReservationUpdateRequestList</field>
            <field
        name="connect_answer_wrapper"
      >FcpReservationUpdateResponseList</field>
            <field name="success_method">reservation_create_answer</field>
            <field name="failure_method">reservation_create_answer_fail</field>
            <field name="priority">50</field>
            <field name="request_type">PUT</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>
        <record
      id="intervention_cancel_fcp_reservation_action"
      model="gmc.action"
    >
            <field name="direction">out</field>
            <field name="name">InterventionCancelFCPReservation</field>
            <field name="model">compassion.reservation</field>
            <field
        name="mapping_id"
        ref="mapping_fcp_intervetion_reservation"
      />
            <field
        name="description"
      >Cancel an Intervention FCP Reservation.</field>
            <field
        name="connect_service"
      >interventions/fcp-reservation-cancel</field>
            <field
        name="connect_outgoing_wrapper"
      >FcpReservationCancelRequestList</field>
            <field
        name="connect_answer_wrapper"
      >FcpReservationCancelResponseList</field>
            <field name="success_method">reservation_cancel_answer</field>
            <field name="priority">50</field>
            <field name="request_type">POST</field>
            <field name="auto_process">1</field>
            <field name="job_channel">root.intervention_compassion</field>
        </record>

        <!--  Intervention reservation notifications   -->
        <record id="intervention_reservation_expired" model="gmc.action">
            <field name="direction">in</field>
            <field name="name">InterventionReservationExpired</field>
            <field name="mapping_id" ref="mapping_intervention" />
            <field name="model">compassion.intervention</field>
            <field
        name="incoming_method"
      >intervention_hold_removal_notification</field>
            <field name="description">Intervention Reservation Expired</field>
            <field name="auto_process">1</field>
            <field name="no_outgoing_data" eval="True" />
            <field name="job_channel">root.intervention_compassion</field>
        </record>
        <record id="intervention_reservation_to_hold" model="gmc.action">
            <field name="direction">in</field>
            <field name="name">InterventionReservationToHold</field>
            <field name="mapping_id" ref="mapping_hold_update" />
            <field name="model">compassion.intervention</field>
            <field name="incoming_method">reservation_to_hold</field>
            <field
        name="description"
      >Convert an Intervention reservation to hold</field>
            <field name="auto_process">1</field>
            <field name="no_outgoing_data" eval="True" />
            <field name="job_channel">root.intervention_compassion</field>
        </record>
        <record model="gmc.action.connect" id="expiration_reservation_connect">
            <field name="action_id" ref="intervention_reservation_expired" />
            <field
        name="connect_schema"
      >http://schemas.ci.org/ci/messaging/availability/2025/02/ReservationExpiredNotification</field>
        </record>
        <record model="gmc.action.connect" id="intervetion_to_hold_connect">
            <field name="action_id" ref="intervention_reservation_to_hold" />
            <field
        name="connect_schema"
      >http://schemas.ci.org/ci/messaging/availability/2025/06/InterventionReservationConvertedToHoldNotification</field>
        </record>
    </data>
</odoo>
