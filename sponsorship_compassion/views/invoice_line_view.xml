<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_invoice_line_child_tree" model="ir.ui.view">
        <field name="name">account.invoice.line.child.tree</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree" />
        <field eval="18" name="priority" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field
          name="contract_id"
          domain="['|', ('partner_id', '=', parent.partner_id), ('correspondent_id', '=', parent.partner_id)]"
          options="{'create_edit':false,'field_color': 'state',
                                     'colors': {'cancelled': 'gray', 'terminated': 'gray', 'draft': 'blue', 'mandate': 'red', 'waiting': 'green'}}"
        />
            </field>
        </field>
    </record>

    <record id="view_invoice_child_form" model="ir.ui.view">
        <field name="name">account.invoice.child.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field eval="18" name="priority" />
        <field name="arch" type="xml">
            <xpath
        expr="//tree/field[@name='product_id']"
        position="attributes"
      >
                <attribute
          name="options"
        >{'colors': {'Sponsorship':'blue', 'Fund':'green', 'Sponsor gifts':'blueviolet'}, 'field_color':'categ_name'}</attribute>
            </xpath>
            <xpath expr="//tree/field[@name='name']" position="after">
                <field
          name="contract_id"
          domain="['|', ('partner_id', '=', parent.partner_id), ('correspondent_id', '=', parent.partner_id), ('state', 'in', ['waiting', 'active'])]"
          options="{'create_edit':false,'field_color': 'state', 'search_more':true,
                                     'colors': {'cancelled': 'gray', 'terminated': 'gray', 'draft': 'blue', 'mandate': 'red', 'waiting': 'green'}}"
        />
            </xpath>
            <xpath
        expr="//form/sheet/notebook/page[@id='aml_tab']/field/tree/field[@name='partner_id']"
        position="after"
      >
                <field name="contract_id" />
            </xpath>
        </field>
    </record>

    <record id="view_invoice_line_partner_tree" model="ir.ui.view">
        <field name="name">account.invoice.line.partner.tree</field>
        <field name="model">account.move.line</field>
        <field eval="18" name="priority" />
        <field name="arch" type="xml">
            <tree
        string="Invoice lines"
        decoration-info="parent_state == 'draft'"
        decoration-bf="parent_state == 'open'"
        decoration-muted="parent_state == 'cancel'"
      >
                <field name="partner_id" />
                <field name="product_id" />
                <field name="contract_id" />
                <field name="due_date" />
                <field name="last_payment" />
                <field name="quantity" sum="Total" />
                <field name="price_unit" />
                <field name="price_subtotal" sum="Total" />
                <field name="parent_state" />
            </tree>
        </field>
    </record>
    <record id="view_move_line_donations" model="ir.ui.view">
        <field name="name">account.move.line.donations.tree</field>
        <field name="model">account.move.line</field>
        <field eval="18" name="priority" />
        <field name="arch" type="xml">
            <tree
        create="False"
        edit="False"
        delete="False"
        default_order="date desc"
        groups_limit="100"
        decoration-danger="move_type == 'out_invoice' and payment_state == 'not_paid'"
        decoration-success="move_category == 'fund'"
        decoration-primary="move_category == 'gift'"
      >
                <header>
                    <button
            type="object"
            string="Sponsorship impact"
            name="action_automatic_entry"
            icon="fa-file-text-o "
            display="always"
          />
                </header>
                <field name="move_id" column_invisible="1" />
                <field
          name="move_name"
          string="Journal Entry"
          widget="open_move_widget"
        />
                <field name="date" />
                <field name="last_payment" optional="hide" />
                <field name="move_category" />
                <field name="product_id" domain="[('categ_name')]" />
                <field name="account_id" optional="hide" />
                <field name="name" />
                <field name="contract_id" />
                <field name="company_currency_id" column_invisible="1" />
                <field name="credit" sum="Total" decoration-bf="1" />
                <field name="move_type" optional="hide" />
                <field
          name="payment_state"
          optional="hide"
          invisible="move_type == 'entry'"
        />

                <groupby name="move_id">
                    <button
            type="edit"
            name="edit"
            icon="fa-edit"
            title="Edit"
          />
                </groupby>
                <groupby name="contract_id">
                    <button
            type="edit"
            name="edit"
            icon="fa-edit"
            title="Edit"
          />
                </groupby>
            </tree>
        </field>
    </record>

    <record id="view_donation_filter" model="ir.ui.view">
        <field name="name">move.line.donation.select</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search>
                <filter
          name="filter_sponsorship"
          string="Sponsorship"
          domain="[('move_category','=','sponsorship')]"
        />
                <filter
          name="filter_gift"
          string="Gift"
          domain="[('move_category','=','gift')]"
        />
                <filter
          name="filter_fund"
          string="Fund"
          domain="[('move_category','=','fund')]"
        />
                <field name="product_id" string="Product" />
                <field name="partner_id" string="Partner" />
                <group expand="0" string="Group By...">
                    <filter
            string="Move"
            name="group_move"
            domain="[]"
            context="{'group_by':'move_id'}"
          />
                    <filter
            string="Date"
            name="group_date"
            domain="[]"
            context="{'group_by':'date'}"
          />
                    <filter
            name="group_contract"
            string="Contract"
            domain="[]"
            context="{'group_by':'contract_id'}"
          />
                    <filter
            name="group_product"
            string="Product"
            domain="[]"
            context="{'group_by':'product_id'}"
          />
                </group>
            </search>
        </field>
    </record>

    <record id="view_account_invoice_sponsorship_filter" model="ir.ui.view">
        <field name="name">account.invoice.sponsorship.filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="payment_mode_id" />
                <field name="invoice_category" />
            </field>
            <xpath expr="//group">
                <separator />
                <filter
          string="Invoice type"
          name="invoice_category"
          context="{'group_by':'invoice_category'}"
        />
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_compassion" model="ir.ui.view">
        <field name="name">view.move.tree.compassion</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="children" />
                <field name="invoice_category" />
            </field>
        </field>
    </record>
</odoo>
