<odoo>
    <!-- Configuration View -->
    <record id="view_settings" model="ir.ui.view">
        <field name="name">MIS report SPN</field>
        <field name="model">res.config.settings</field>
        <field
      name="inherit_id"
      ref="message_center_compassion.compassion_settings"
    />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='compassion_settings']">
                <block title="MIS report SPN" name="mis_report_spn">
                    <setting id="mis_main_company_id">
                        <field name="mis_main_company_id" />
                    </setting>
                    <setting id="mis_child_sponsored_id">
                        <field name="mis_child_sponsored_id" />
                    </setting>
                    <setting id="mis_contract_created_id">
                        <field name="mis_contract_created_id" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
