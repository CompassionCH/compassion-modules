#. module: partner_communication
#: model:mail.template,body_html:partner_communication.default_communication_template
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, "
"Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set partner = object.partner_id\n"
"   \n"
"% set sponsorships = partner.sponsorship_ids.filtered('is_active')\n"
"% set lang = partner.lang\n"
"% set param = object.env['ir.config_parameter'].sudo()\n"
"  </div>\n"
"  <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida "
"Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   % if sponsorships:\n"
"    Thank you for investing into the life of\n"
"   ${sponsorships.get_list('child_id.preferred_name', 3, 'many children', "
"False)}.\n"
"   <br>\n"
"   <br>\n"
"   <br>\n"
"   <br>\n"
"   % endif \n"
"   <br>\n"
"   <br>\n"
"   % if sponsorships:\n"
"\tYour support for a child in extreme poverty is valuable. Compassion "
"believes that your support will give a child opportunity to live a "
"purposeful life.\n"
"   % endif \n"
"${object.success_sentence  or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can "
"positively change the lives of currently more than 2,3 million children in "
"27 countries.\n"
"  </p>\n"
"  <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida "
"Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   Best regards,\n"
"% if object.send_mode != 'physical':\n"
"  <br>\n"
"  <br>\n"
"  ${object.user_id.signature | safe}\n"
"% endif \n"
"  </p>\n"
" "
msgstr ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, "
"Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set partner = object.partner_id\n"
"   \n"
"% set sponsorships = partner.sponsorship_ids.filtered('is_active')\n"
"% set lang = partner.lang\n"
"% set param = object.env['ir.config_parameter'].sudo()\n"
"  </div>\n"
"  <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida "
"Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   % if sponsorships:\n"
"    Vielen Dank für die Investition in das Leben von\n"
"   ${sponsorships.get_list('child_id.preferred_name', 3, 'many children', "
"False)}.\n"
"   <br>\n"
"   <br>\n"
"   <br>\n"
"   <br>\n"
"   % endif\n"
"   <br>\n"
"   <br>\n"
"   % if Patenschaften:\n"
"\tIhre Unterstützung für ein Kind in extremer Armut ist wertvoll. Compassion "
"glaubt, dass Ihre Unterstützung einem Kind die Möglichkeit gibt, ein "
"sinnvolles Leben zu führen.\n"
"   % endif\n"
"${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Nochmals vielen Dank für Ihr Engagement, damit wir gemeinsam das Leben "
"von derzeit mehr als 2,3 Millionen Kindern in 27 Ländern positiv verändern "
"können.\n"
"  </p>\n"
"  <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida "
"Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   Mit freundlichen Grüßen,\n"
"% if object.send_mode != 'physical':\n"
"  <br>\n"
"  <br>\n"
"  ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "

