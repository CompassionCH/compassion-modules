#. module: partner_communication
#: model:mail.template,body_html:partner_communication.default_communication_template
msgid ""
"<html>\n"
"  <body><div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"   \n"
"<t t-set=\"sponsorships\" t-value=\"partner.sponsorship_ids.filtered(&#x27;is_active&#x27;)\"/>\n"
"<t t-set=\"lang\" t-value=\"partner.lang\"/>\n"
"<t t-set=\"param\" t-value=\"object.env[&#x27;ir.config_parameter&#x27;].sudo()\"/>\n"
"  </div>\n"
"  <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   <t t-out=\"partner.salutation\"></t>,\n"
"   <br/>\n"
"   <br/>\n"
"   <t t-if=\"sponsorships\">\n"
"    Thank you for investing into the life of\n"
"   <t t-out=\"sponsorships.get_list(&#x27;child_id.preferred_name&#x27;, 3, &#x27;many children&#x27;, False)\"></t>.\n"
"   <br/>\n"
"   <br/>\n"
"   <br/>\n"
"   <br/>\n"
"   </t>\n"
"   <br/>\n"
"   <br/>\n"
"   <t t-if=\"sponsorships\">\n"
"\tYour support for a child in extreme poverty is valuable. Compassion believes that your support will give a child opportunity to live a purposeful life.\n"
"   </t>\n"
"<t t-out=\"object.success_sentence  or &#x27;&#x27;\"></t>\n"
"   <br/>\n"
"   <br/>\n"
"   Once again, thank you for your commitment so that together we can positively change the lives of currently more than 2,3 million children in 27 countries.\n"
"  </p>\n"
"  <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   Best regards,\n"
"<t t-if=\"object.send_mode != &#x27;physical&#x27;\">\n"
"  <br/>\n"
"  <br/>\n"
"  <t t-out=\"object.user_id.signature\"></t>\n"
"</t>\n"
"  </p>\n"
" </body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><span>\n"
"    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"    <t t-set=\"sponsorships\" t-value=\"partner.sponsorship_ids.filtered(&#x27;is_active&#x27;)\"/>\n"
"    <t t-set=\"lang\" t-value=\"partner.lang\"/>\n"
"    <t t-set=\"param\" t-value=\"object.env[&#x27;ir.config_parameter&#x27;].sudo()\"/>\n"
"    <t t-set=\"plural\" t-value=\"partner.title.plural or partner.title.id == 29\"/>\n"
"    <t t-set=\"du\" t-value=\"&#x27;ihr&#x27; if plural else &#x27;du&#x27;\"/>\n"
"    <t t-set=\"deine\" t-value=\"&#x27;eure&#x27; if plural else &#x27;deine&#x27;\"/>\n"
"    <t t-set=\"christmas_fund_2022\" t-value=\"265 in partner.category_id.ids\"/>\n"
"    <t t-set=\"number_years\" t-value=\"object.get_snippet(&#x27;number_years&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_children\" t-value=\"object.get_snippet(&#x27;number_children&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_fcps\" t-value=\"object.get_snippet(&#x27;number_fcps&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_countries\" t-value=\"object.get_snippet(&#x27;number_countries&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_uc\" t-value=\"object.get_snippet(&#x27;years_uc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"years_lc\" t-value=\"object.get_snippet(&#x27;years_lc&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"children_in_poverty\" t-value=\"object.get_snippet(&#x27;children_in_poverty&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"early_deaths\" t-value=\"object.get_snippet(&#x27;early_deaths&#x27;, strip_html=True)\"/>\n"
"    <t t-set=\"number_mothers\" t-value=\"object.get_snippet(&#x27;number_mothers&#x27;, strip_html=True)\"/>\n"
"</span>\n"
"<p>\n"
"    <t t-out=\"partner.salutation\"></t>\n"
"</p>\n"
"<br/>\n"
"<p>\n"
"    <t t-if=\"sponsorships\">\n"
"        Danke, dass <t t-out=\"du\"></t> in das Leben von <t t-out=\"sponsorships.get_list(&#x27;child_id.preferred_name&#x27;, 3, deine + &#x27;n Patenkindern&#x27;, False)\"></t> <t t-out=\"&#x27;investiert&#x27; if plural else &#x27;investierst&#x27;\"></t>.\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        Danke, dass <t t-out=\"du\"></t> in das Leben von Kindern in Armut <t t-out=\"&#x27;investiert&#x27; if plural else &#x27;investierst&#x27;\"></t>.\n"
"    </t>\n"
"</p>\n"
"<p>\n"
"    <t t-if=\"sponsorships\">\n"
"        <t t-out=\"deine.title()\"></t> Unterstützung für <t t-out=\"&#x27;ein Kind&#x27; if len(sponsorships) == 1 else &#x27;Kinder&#x27;\"></t> in extremer Armut\n"
"    ist enorm wertvoll. Compassion ist davon überzeugt, dass <t t-out=\"du\"></t> durch <t t-out=\"deine\"></t> Unterstützung <t t-out=\"&#x27;einem Kind&#x27; if len(sponsorships) == 1 else &#x27;mehreren Kindern&#x27;\"></t> die Chance <t t-out=\"&#x27;gebt&#x27; if plural else &#x27;gibst&#x27;\"></t>, ein Leben mit Hoffnung und Zukunft zu haben.\n"
"    </t>\n"
"<t t-else=\"\">\n"
"        <t t-out=\"deine.title()\"></t> Unterstützung für Kinder in extremer Armut ist enorm wertvoll. Compassion ist davon überzeugt, dass <t t-out=\"du\"></t> durch <t t-out=\"deine\"></t> Unterstützung Kindern die Chance <t t-out=\"&#x27;gebt&#x27; if plural else &#x27;gibst&#x27;\"></t>, ein Leben mit Hoffnung und Zukunft zu haben.\n"
"    </t>\n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse\n"
"</p>\n"
"<p>\n"
"    <t t-if=\"object.send_mode != &#x27;physical&#x27;\">\n"
"        <t t-out=\"object.user_id.signature\"></t>\n"
"    </t>\n"
"</p>\n"
"</body>\n"
"</html>\n"

