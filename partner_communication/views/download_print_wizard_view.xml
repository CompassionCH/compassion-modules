<odoo>
    <record model="ir.ui.view" id="download_print_wizard_form">
        <field
      name="name"
    >partner.communication.download.print.wizard.form</field>
        <field
      name="model"
    >partner.communication.download.print.job.wizard</field>
        <field name="arch" type="xml">
            <form edit="false">
                <group string="Merged Documents">
                    <field name="merged_name" invisible="1" />
                    <field name="merged_data" filename="merged_name" />
                    <field name="letters_name" invisible="1" />
                    <field name="letters_data" filename="letters_name" />
                    <field name="attachments_name" invisible="1" />
                    <field
            name="attachments_data"
            filename="attachments_name"
          />
                </group>
                <group string="Individual Documents">
                    <field name="communication_job_ids" readonly="1">
                        <list editable="bottom">
                            <field name="partner_id" />
                            <field
                name="printed_pdf_data"
                widget="binary"
                filename="printed_pdf_name"
              />
                            <field
                name="printed_pdf_name"
                column_invisible="1"
              />
                        </list>
                    </field>
                    <field name="attachment_ids" widget="one2many" readonly="1">
                        <list editable="bottom">
                            <field name="name" />
                            <field
                name="printed_pdf_data"
                widget="binary"
                filename="printed_pdf_name"
              />
                            <field
                name="printed_pdf_name"
                column_invisible="1"
              />
                        </list>
                    </field>
                </group>
                <footer>
                    <button
            name="clear_data"
            string="Clear data and close"
            type="object"
            class="oe_highlight"
          />
                    <button special="cancel" string="Close and keep data" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
