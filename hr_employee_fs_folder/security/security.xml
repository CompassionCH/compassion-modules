<odoo>
    <!-- rules of different groups are combined with OR: an HR officer sees the
         folders of his companies, an employee only his own -->
    <record id="rule_shared_folder_own" model="ir.rule">
        <field name="name">Employee shared folder: own folder</field>
        <field name="model_id" ref="model_hr_employee_shared_folder" />
        <field name="domain_force">[("user_id", "=", user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="rule_shared_folder_hr" model="ir.rule">
        <field name="name">Employee shared folder: HR, allowed companies</field>
        <field name="model_id" ref="model_hr_employee_shared_folder" />
        <field
            name="domain_force"
        >["|", ("company_id", "=", False), ("company_id", "in", company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]" />
    </record>
</odoo>
