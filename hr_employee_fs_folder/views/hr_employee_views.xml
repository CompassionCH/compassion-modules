<odoo>
    <record id="view_employee_form_document_folder" model="ir.ui.view">
        <field name="name">hr.employee.form.document.folder</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page
                    string="HR Documents"
                    name="hr_document_folder"
                    groups="hr.group_hr_user"
                >
                    <div class="text-muted mb-2">
                        The "Shared" subfolder is visible to the employee (read only).
                        The rest of the folder is visible to HR only.
                    </div>
                    <field name="hr_document_folder" nolabel="1" />
                </page>
            </notebook>
        </field>
    </record>

    <record id="action_create_document_folders" model="ir.actions.server">
        <field name="name">Create Documents Folders</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="groups_id" eval="[(4, ref('hr.group_hr_user'))]" />
        <field name="state">code</field>
        <field name="code">records.action_create_document_folders()</field>
    </record>
</odoo>
