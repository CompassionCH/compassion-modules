<odoo>
    <record model="ir.ui.view" id="communication_job_orm_form">
        <field name="name">communication.job.omr.form</field>
        <field name="model">partner.communication.job</field>
        <field name="inherit_id" ref="partner_communication.communication_job_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook">
                <page string="OMR">
                    <group invisible="send_mode not in ['physical', 'both']">
                        <group>
                            <field name="omr_enable_marks" />
                            <field
                                name="omr_should_close_envelope"
                                invisible="omr_enable_marks == False"
                            />
                            <field
                                name="omr_add_attachment_tray_1"
                                invisible="omr_enable_marks == False"
                            />
                            <field
                                name="omr_add_attachment_tray_2"
                                invisible="omr_enable_marks == False"
                            />
                        </group>
                        <group>
                            <field
                                name="omr_single_sided"
                                invisible="omr_enable_marks == False"
                            />
                            <field
                                name="omr_top_mark_x"
                                invisible="omr_enable_marks == False"
                            />
                            <field
                                name="omr_top_mark_y"
                                invisible="omr_enable_marks == False"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
