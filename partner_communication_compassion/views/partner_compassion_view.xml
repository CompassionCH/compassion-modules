<odoo>
    <!-- Add letter delivery preference -->
    <record id="view_partner_letter_delivery" model="ir.ui.view">
        <field name="name">res.partner.letter.delivery</field>
        <field name="model">res.partner</field>
        <field
      name="inherit_id"
      ref="partner_communication.view_partner_form"
    />
        <field name="arch" type="xml">
            <field
        name="global_communication_delivery_preference"
        position="after"
      >
                <field name="letter_delivery_preference" />
                <field name="photo_delivery_preference" />
            </field>
        </field>
    </record>

    <!-- Highlight terminated sponsorships whose exit communication has not yet
         been sent to the sponsor -->
    <record id="view_res_partner_sponsorships_exit_pending" model="ir.ui.view">
        <field name="name">contracts.sponsorships.exit.pending</field>
        <field name="model">recurring.contract</field>
        <field
      name="inherit_id"
      ref="sponsorship_compassion.recurring_contract_simple_tree"
    />
        <field name="arch" type="xml">
            <xpath
        expr="/list"
        position="attributes"
      >
                <attribute
          name="decoration-muted"
        >state in ('terminated','cancelled') and not exit_communication_pending</attribute>
                <attribute
          name="decoration-warning"
        >exit_communication_pending</attribute>
            </xpath>
<!--            <xpath-->
<!--        expr="//field[@name='contracts_paid']/tree/field[@name='state']"-->
<!--        position="after"-->
<!--      >-->
<!--                <field name="exit_communication_pending" invisible="1" />-->
<!--            </xpath>-->
        </field>
    </record>
</odoo>
