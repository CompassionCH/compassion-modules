#. module: partner_communication_compassion
#: model:partner.communication.config,mobile_notification_body:partner_communication_compassion.child_letter_config
msgid ""
"% set types = ','.join(object.communication_type_ids.mapped('name')).lower()\n"
"% if 'gift' in types:\n"
"${object.child_id.preferred_name} wrote you a letter ${'with a picture ' if 'large' in types else ''}to thank you for your gift\n"
"% else:\n"
"${object.child_id.preferred_name} wrote you a ${'first' if 'new sponsor' in types else 'new'} letter\n"
"% endif"
msgstr ""
"% set types = ','.join(object.communication_type_ids.mapped('name')).lower()\n"
"% if 'gift' in types:\n"
"% if 'large' in types:\n"
"${object.child_id.preferred_name} ti ha scritto un biglietto di ringraziamento per il tuo regalo\n"
"% else:\n"
"${object.child_id.preferred_name} ti ha scritto una lettera riguardo il tuo regalo\n"
"% endif\n"
"% else:\n"
"${object.child_id.preferred_name} ti ha scritto ${'la prima' if 'new sponsor' in types else 'una nuova'} lettera\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.new_letter
msgid ""
"<!-- this is a comment for testing purposes -->\n"
"<!-- this is a comment for testing purposes --><div>\n"
"    % set letter = object.get_objects()\n"
"    % set child = letter.mapped('child_id')\n"
"    % set s = '' if len(child) == 1 else 's'\n"
"    % set partner = object.partner_id\n"
"    % set child = letter.mapped('child_id')\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set urls = []\n"
"\n"
"    % for letter_set in letter.filtered('read_url').mapped('read_url'):\n"
"        % if letter_set not in urls:\n"
"             % set void = urls.append(letter_set)\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % set field_office_ids = child.mapped('field_office_id').ids\n"
"    % set restricted = 1 in field_office_ids or 19 in field_office_ids\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    We are very happy to inform you that a new letter has arrived from ${child.get_list('preferred_name', 3, child.get_number()) or child.get_list('firstname', 3, child.get_number())}!\n"
"</p>\n"
"<p>\n"
"    You can download the letter by clicking on the link. Enjoy reading:\n"
"    <ul>\n"
"        % for l in urls:\n"
"            <li>\n"
"                <a href=\"${l}\">\n"
"                    ${l}\n"
"                </a>\n"
"            </li>\n"
"        % endfor\n"
"    </ul>\n"
"</p>\n"
"<p>\n"
"    ${years_uc} ${number_years} years of experience show us the importance of letters for the development of the children.\n"
"</p>\n"
"<p>\n"
"    Thank you in advance for taking a few minutes to reply to the enclosed letter. You can respond online via <a href=\"https://www.mycompassion.ch\">MyCompassion</a>.\n"
"</p>\n"
"% if restricted:\n"
"    <p>\n"
"        Important information about writing to your sponsored ${'child' if len(child) == 1 else 'children'}.\n"
"    </p>\n"
"    <div style=\"margin:20px auto; text-align: center;\">\n"
"        <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_de.pdf\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            Information on writing letters\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"<p>\n"
"    Please do not hesitate to contact us with regards to any questions you may have in relation to exchanging letters.\n"
"</p>\n"
"<p>\n"
"    Best regards,\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
"% endif"
msgstr ""
"<!--\n"
"È arrivata una nuova lettera di ${object.get_objects().mapped('child_id').get_list('preferred_name', 3, 'vostri figlioli', False)}\n"
"-->\n"
"<div>\n"
"    % set letter = object.get_objects()\n"
"    % set child = letter.mapped('child_id')\n"
"    % set al_bambino = child.get('al bambino')\n"
"    % set firstname = child.get_list('preferred_name', 3, 'vostri figlioli', False)\n"
"    % set partner = object.partner_id\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set urls = []\n"
"\n"
"    % for letter_set in letter.filtered('read_url').mapped('read_url'):\n"
"        % if letter_set not in urls:\n"
"            % set void = urls.append(letter_set)\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % set field_office_ids = child.mapped('field_office_id').ids\n"
"    % set restricted = 1 in field_office_ids or 19 in field_office_ids\n"
"\n"
"    % set christmas_fund_2022 = 265 in partner.category_id.ids\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_IT_uc = object.get_snippet('years_IT_uc') | striptags | safe\n"
"    % set years_IT_lc = object.get_snippet('years_IT_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"</p>\n"
"<p>\n"
"    Siamo felici di ${'inviarvi' if plural else 'inviarti'} una nuova lettera di ${firstname}!\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${'Cliccate' if plural else 'Clicca'} sul link per scaricarla.* Buona lettura.\n"
"    </p>\n"
"    <ul>\n"
"        % for l in urls:\n"
"            <li>\n"
"                <a href=\"${l}\">\n"
"                    ${l}\n"
"                </a>\n"
"            </li>\n"
"        % endfor\n"
"    </ul>\n"
"% endif\n"
"<p>\n"
"    Oltre ${number_years} anni di esperienza hanno dimostrato che lo scambio di lettere può avere un'influenza significativa sullo sviluppo del bambino sostenuto.\n"
"</p>\n"
"<p>\n"
"    ${'Potete' if plural else 'Puoi'} scrivere ${al_bambino} che ${'sostenete' if plural else 'sostieni'} in modo semplice e veloce su <a href=\"https://mycompassion.ch\">MyCompassion</a>. La piattaforma ${'vi' if plural else 'ti'} permette di avere sempre a portata di mano foto, lettere e informazioni su ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Se ${'avete' if plural else 'hai'} domande sulla corrispondenza, non ${'esitate' if plural else 'esitare'} a contattarci!\n"
"</p>\n"
"\n"
"% if restricted:\n"
"    % if object.send_mode != \"physical\":\n"
"        <p>\n"
"            Qui ${'troverete' if plural else 'troverai'} raccomandazioni speciali per la corrispondenza con ${firstname}:\n"
"            <div style=\"margin:20px auto; text-align: center;\">\n"
"                <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_fr.pdf\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"                    Vedi le raccomandazioni speciali\n"
"                </a>\n"
"            </div>\n"
"        </p>\n"
"    % endif\n"
"% endif\n"
"\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.sudo().short_signature | safe}\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    *Se ${'avete' if plural else 'hai'} problemi a scaricare la lettera, ${'potete' if plural else 'puoi'} aprirla su <a href=\"https://mycompassion.ch\">MyCompassion</a>.\n"
"</p>"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_completion_date_change
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    % set child = object.get_objects()\n"
"                </div>\n"
"                <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    ${object.partner_id.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    We learned that ${child.firstname} will finish the Compassion program on ${child.get_date('completion_date', 'date_full')}.\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_parent_alive
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    % set child = object.get_objects()\n"
"    % set role = 'mother' if child.household_id.revised_value_ids.name == 'Natural Mother Alive' else 'father'\n"
"    % set status = 'alive' if child.household_id.revised_value_ids.get_field_value() == 'True' else 'dead'\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation}\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Thank you for investing in the life of ${child.firstname} with a sponsorship.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    We have been notified from our local employees that the ${role} of your sponsored child has passed away. If you would like to write a few lines expressing your condolences to comfort ${child.get('him')}, this can be easily done via your <a href=\"https://www.compassion.ch\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">MyCompassion</a> profile.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    In this difficult time, your support for ${child.firstname} makes an even bigger difference.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Once again, thank you for your commitment so that together we can positively transform the lives of currently more than ${number_children} million children in ${number_countries} countries.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    With kind regards,\n"
"</p>\n"
"% if object.send_mode == 'digital':\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set firstname = child.get_list('preferred_name', translate=False)\n"
"    % set female = child.household_id.revised_value_ids.name == 'Natural Mother Alive'\n"
"    % set role = 'la mamma' if female else 'il papà'\n"
"    % set boy = child.gender == 'M'\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set reason = False\n"
"    % set lifecycle = child.mapped('lifecycle_ids')\n"
"\n"
"    % for l in lifecycle:\n"
"        % if l.request_reason == 'death of caregiver':\n"
"            % if l.comments:\n"
"                % set reason = l.translate('comments')\n"
"            % endif\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Grazie di cuore per aver investito nel migliorare la vita di ${firstname} tramite il sostegno.\n"
"</p>\n"
"<p>\n"
"    L'ufficio nazionale ci informa che ${role} ${'del bambino' if boy else 'della bambina'} che ${'sostenete' if plural else 'sostieni'} è decedut${'a' if female else 'o'}.\n"
"\n"
"    % if reason:\n"
"        Secondo il centro di accoglienza, ${reason}\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Se ${'desiderate' if plural else 'desideri'} scrivere a ${firstname} per avere sue notizie e offrir${'gli' if boy else 'le'} parole di conforto, ${'potete' if plural else 'puoi'} farlo direttamente online su <a href=\"https://compassion.ch/it/scrivere/\">compassion.ch/it/scrivere/</a>.\n"
"</p>\n"
"<p>\n"
"    In questo momento di prova, il ${'vostro' if plural else 'tuo'} sostegno a ${firstname} è ancora più prezioso.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"\n"
" "

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_sponsorship_transfer_dossier
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set less_4 = len(child) &lt; 4\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set correspondant = object.partner_id in sponsorships.mapped('correspondent_id')\n"
"    % set partner = object.partner_id\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"</div>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    A very warm welcome to you, ${partner.firstname}!\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    It's so nice to have you as part of the Compassion Switzerland family!\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Together with you and ${number_fcps} partner churches in ${number_countries} countries, we are currently releasing over ${number_children} million children from poverty. Collectively, we enable the children to have a life with a future filled with hope.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    In order to ensure a smooth continuation to your sponsorship for ${firstname}, please find attached important information:\n"
"</p>\n"
"<ul style=\"margin:0px 0 1rem 0;\">\n"
"    <li>1 photo of ${'your sponsored child' if one_child else 'each child'}</li>\n"
"    <li>1 folder with important information about your sponsorship</li>\n"
"\n"
"    % if object.send_mode == \"physical\":\n"
"        <li>1 sheet of labels for the letter correspondence (please stick them on cards, letters, stickers, drawings, etc.)</li>\n"
"    % endif\n"
"</ul>\n"
"\n"
"% if payer:\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"        % if lsv_dd:\n"
"            We kindly ask you to fill in and return via post the attached bank form to continue your sponsorship journey with ${firstname}.\n"
"        % else:\n"
"            We kindly ask you to activate a standing order with the attached payment slip to continue your sponsorship journey with ${firstname}.\n"
"        % endif\n"
"    </p>\n"
"% endif\n"
"\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Please do not hesitate to get in touch with us if you have any further questions.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Thank you so much for investing in the ${'life of ' + firstname if less_4 else 'lives of many children'}!\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    We wish you much joy as you continue your sponsorship journey.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Together, we are changing the world! One child at a time.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Warm regards\n"
"</p>\n"
"\n"
"% if object.send_mode == \"digital\":\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<!--\n"
"% if object.partner_id.title.id == 29 or object.partner_id.title.plural:\n"
"    % set Ti = 'Vi'\n"
"% else:\n"
"    % set Ti = 'Ti'\n"
"% endif\n"
"${Ti} diamo il benvenuto nella famiglia di Compassion Svizzera\n"
"-->\n"
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set te = \"voi\" if plural else \"te\"\n"
"    % set tu = \"voi\" if plural else \"tu\"\n"
"    % set tua = \"vostra\" if plural else \"tua\"\n"
"    % set tuo = \"vostro\" if plural else \"tuo\"\n"
"    % set tue = \"vostre\" if plural else \"tue\"\n"
"    % set ti = \"vi\" if plural else \"ti\"\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped(\"child_id\")\n"
"    % set one_child = len(child) == 1\n"
"\n"
"    % if one_child:\n"
"        % set girl = child.gender == 'F'\n"
"    % endif\n"
"\n"
"    % set firstname = child.get_list(\"preferred_name\", translate=False)\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Grazie per aver deciso di far parte della famiglia di Compassion in Svizzera!\n"
"</p>\n"
"<p>\n"
"    Insieme a ${te} e a oltre ${number_fcps} chiese partner nel Sud del mondo, stiamo liberando ${number_children} milioni di bambini dalla povertà estrema. Stiamo offrendo loro un futuro di speranza.\n"
"</p>\n"
"<p>\n"
"    Per ${'assicurarvi' if plural else 'assicurarti'} che il ${tuo} sostegno continui nelle migliori condizioni possibili, ${ti} alleghiamo una serie di documenti e informazioni importanti:\n"
"</p>\n"
"<ul>\n"
"    <li>\n"
"        1 foto di ${firstname if one_child else 'di ciascun bambino'}\n"
"    </li>\n"
"    <li>\n"
"        1 file con informazioni pratiche sul ${tuo} sostegno\n"
"    </li>\n"
"    <li>\n"
"        1 foglio con le etichette da utilizzare per la corrispondenza con ${firstname if one_child else 'i bambini'} (da incollare su biglietti, lettere, disegni, adesivi, ecc.)\n"
"    </li>\n"
"</ul>\n"
"<p>\n"
"    % if lsv_dd:\n"
"        Per continuare a sostenerl${'i' if not one_child else ('a' if girl else 'o')}, ${ti} preghiamo di compilare il modulo allegato e rispedircelo firmato per posta.\n"
"    % else:\n"
"        Per continuare a sostenerl${'i' if not one_child else ('a' if girl else 'o')}, ${ti} preghiamo di impostare il ${tuo} ordine permanente utilizzando il bollettino di versamento allegato.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Grazie di cuore per aver investito nel migliorare la vita di ${firstname}, ${ti.capitalize()} auguriamo tanta gioia nella relazione con ${'loro' if not one_child else ('lei' if girl else 'lui')}.\n"
"</p>\n"
"<p>\n"
"    Per qualsiasi domanda, non ${'esitate' if plural else 'esitare'} a contattarci.\n"
"</p>\n"
"<p>\n"
"    Insieme, contribuiamo a cambiare il mondo, un bambino alla volta.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"<p style=\"margin-top: 20px\">\n"
"    PS: ${'Sapevate che potete' if plural else 'Sapevi che puoi'} scrivere ${'ai bambini' if not one_child else ('alla bambina' if girl else 'al bambino')} che ${'sostenete' if plural else 'sostieni'} in modo facile e veloce su <a href=\"https://mycompassion.ch/it\">MyCompassion</a>? La piattaforma ${ti} permette di avere sempre con ${te} tutte le informazioni, le foto e le lettere di ${firstname}.\n"
"</p>\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_gender
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${child.firstname}&nbsp;with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   In circumstances of extreme poverty, sometimes data is not collected correctly. This is the case with your sponsored child. We have been informed that ${child.get('he')} was introduced to you as a ${'boy' if child.old_values == 'M' else 'girl'} even though${child.get('he')}&nbsp;is a ${'boy' if child.gender == 'M' else 'girl'}. We thank you in advance for your understanding.\n"
"   <br>\n"
"   <br>\n"
"   Your support of a child in extreme poverty is valuable. At Compassion, we believe this will give a child the chance to live with purpose. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your committment so that together we can positively transform the lives of currently 2 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Your sincerely,\n"
"   % if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"     ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set firstname = child.preferred_name\n"
"    % set boy = child.gender == 'M'\n"
"\n"
"    % if boy:\n"
"        % set o = 'o'\n"
"        % set new_gender = 'un bambino'\n"
"        % set old_gender = 'una bambina'\n"
"    % else:\n"
"        % set o = 'a'\n"
"        % set old_gender = 'un bambino'\n"
"        % set new_gender = 'una bambina'\n"
"    % endif\n"
"\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"</div>\n"
"% if send_mode == 'sms':\n"
"    <p>\n"
"        ${partner.informal_salutation},\n"
"    </p>\n"
"    <p>\n"
"        In situazioni di estrema povertà, i dati relativi ai bambini potrebbero non essere stati registrati correttamente. Questo è il caso ${'del bambino' if boy else 'della bambina'} che ${'sostenete' if plural else 'sostieni'}. Abbiamo saputo che ${'vi' if plural else 'ti'} è stat${o} presentat${o} come ${old_gender}, invece si tratta di ${new_gender}. Ci scusiamo per questo.\n"
"    </p>\n"
"    <p>\n"
"        Grazie per il tuo prezioso sostegno.\n"
"    </p>\n"
"    <p>\n"
"        Buona giornata e a presto!\n"
"    </p>\n"
"    <p>\n"
"        Il team di Compassion\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        ${partner.salutation},\n"
"    </p>\n"
"    <p>\n"
"        Grazie per aver investito nel migliorare la vita di ${firstname} attraverso il sostegno.\n"
"    </p>\n"
"    <p>\n"
"        In situazioni di estrema povertà, i dati relativi ai bambini potrebbero non essere stati registrati correttamente. Questo è il caso ${'del bambino' if boy else 'della bambina'} che ${'sostenete' if plural else 'sostieni'}. Abbiamo saputo che ${'vi' if plural else 'ti'} è stat${o} presentat${o} come ${old_gender}, invece si tratta di ${new_gender}. Ci scusiamo per questo.\n"
"    </p>\n"
"    <p>\n"
"        Più di ${number_years} anni di esperienza ci permettono di affermare che il sostegno trasforma non solo la vita di un bambino, ma anche quella della sua famiglia. Grazie per il ${'vostro' if plural else 'tuo'} contributo.\n"
"    </p>\n"
"    <p>\n"
"        Cari saluti,\n"
"    </p>\n"
"\n"
"    % if object.send_mode == 'digital':\n"
"        <p>\n"
"            ${object.user_id.signature | safe}\n"
"        </p>\n"
"    % endif\n"
"% endif\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_birthdate
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${child.firstname}.&nbsp;In situations of extreme poverty, sometimes data is not recorded correctly. This is the case with your sponsored child. We were informed that your sponsored child was not born on ${child.get_date('old_values', 'date_full')} but on ${child.get_date('birthdate', 'date_full')}.\n"
"   <br>\n"
"   <br>\n"
"   Your&nbsp;support of a child in extreme poverty is valuable.&nbsp; At Compassion, we believe that this will give a child the opportunity to live a purposeful life. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Thank you again for your commitment so that together we can positively change the lives of currently more than 1.9 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"% if object.send_mode == 'digital':\n"
"       ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"\n"
"    % if len(child) == 1:\n"
"        % set firstname = child.get_list('preferred_name', translate=False)\n"
"        % set boy = child.gender == 'M'\n"
"        % set partner = object.partner_id\n"
"        % set plural = partner.title.plural or partner.title.id == 29\n"
"        % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"\n"
"        <p>\n"
"            ${partner.salutation},\n"
"        </p>\n"
"\n"
"        % if object.send_mode != \"sms\":\n"
"            <p>\n"
"                Grazie per aver investito nel migliorare la vita di ${firstname} attraverso il sostegno.\n"
"            </p>\n"
"        % endif\n"
"\n"
"        <p>\n"
"            In situazioni di estrema povertà, a volte non è possibile registrare correttamente i dati dei bambini. Può capitare che alcuni non abbiano un certificato di nascita.\n"
"        </p>\n"
"        <p>\n"
"            Abbiamo saputo che la data di nascita ${'del bambino' if boy else 'della bambina'} che ${'sostenete' if plural else 'sostieni'} è stata registrata in modo errato. ${firstname} non è nat${'o' if boy else 'a'} il ${child.get_date('old_values', 'date_full')}, ma il ${child.get_date('birthdate', 'date_full')}.\n"
"        </p>\n"
"\n"
"        % if object.send_mode != \"sms\":\n"
"            <p>\n"
"                 Il ${'vostro' if plural else 'tuo'} sostegno a un bambino che vive in condizioni di estrema povertà è prezioso. Noi di Compassion sappiamo che ${'state' if plural else 'stai'} contribuendo a dare a un bambino una vita dignitosa e piena di senso.\n"
"            </p>\n"
"            <p>\n"
"                Cari saluti,\n"
"            </p>\n"
"\n"
"            % if object.send_mode == 'digital':\n"
"                <p>\n"
"                    ${object.user_id.signature | safe}\n"
"                </p>\n"
"            % endif\n"
"        % else:\n"
"            <p>\n"
"                Buona giornata e a presto!\n"
"            </p>\n"
"            <p>\n"
"                ${whatsapp_signature}\n"
"            </p>\n"
"        % endif\n"
"    % endif\n"
"</div>\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_multiple_changes
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${child.get_list('old_firstname')}&nbsp;with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   The situation of your sponsored child has changed. We received the following message from the project where ${child.get_list('old_firstname')} is attending.\n"
"   <br>\n"
"   <br>\n"
"   Your support of a child in extreme poverty is valuable. At Compassion we believe that this will give a child the chance to live a purposeful life. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can transform the lives of currently 2 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Your sincerely,  \n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"      ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set firstname = child.get_list('preferred_name', translate=False)\n"
"    % set boy = child.gender == 'M'\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"</div>\n"
"\n"
"% if object.send_mode == 'sms':\n"
"    <p>\n"
"        ${object.partner_id.informal_salutation},\n"
"    </p>\n"
"    <p>\n"
"        Il centro di sviluppo infantile in cui è iscritt${'o' if boy else 'a'} ${firstname} ci informa che la sua situazione è cambiata:\n"
"    </p>\n"
"    <ul>\n"
"        % for revision in child.mapped('revised_value_ids') + child.mapped('household_id.revised_value_ids'):\n"
"            <li>\n"
"                ${revision.name} : ${revision.old_value} -&gt; ${revision.get_field_value()}\n"
"            </li>\n"
"        % endfor\n"
"    </ul>\n"
"    <p>\n"
"        Cari saluti e a presto,\n"
"    </p>\n"
"    <p>\n"
"        ${whatsapp_signature}\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        ${object.partner_id.salutation},\n"
"    </p>\n"
"    <p>\n"
"        Grazie di cuore per aver investito nel migliorare la vita di ${firstname} tramite il sostegno.\n"
"    </p>\n"
"    <p>\n"
"        Il centro di sviluppo infantile in cui è iscritt${'o' if boy else 'a'} ${firstname} ci informa che la sua situazione è cambiata:\n"
"    </p>\n"
"    <ul>\n"
"        % for revision in child.mapped('revised_value_ids') + child.mapped('household_id.revised_value_ids'):\n"
"            <li>\n"
"                ${revision.name} : ${revision.old_value} -&gt; ${revision.get_field_value()}\n"
"            </li>\n"
"        % endfor\n"
"    </ul>\n"
"    <p>\n"
"        Più di ${number_years} anni di esperienza ci permettono di affermare che un sostegno può cambiare non solo la vita di un bambino, ma anche quella della sua famiglia. Grazie per il ${'vostro' if plural else 'tuo'} impegno al nostro fianco.\n"
"    </p>\n"
"    <p>\n"
"        Cari saluti e a presto,\n"
"    </p>\n"
"    % if object.send_mode == 'digital':\n"
"        <p>\n"
"            ${object.user_id.signature | safe}\n"
"        </p>\n"
"    % endif\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_name
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${child.old_firstname}&nbsp;with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   In extreme poverty situations, data may not be collected correctly or the family situation may change.&nbsp; This is the case with your sponsored child.\n"
"   <br>\n"
"   <br>\n"
"   From now on, you can call your sponsored child,\n"
"   <b style=\"font-weight:bolder;\">\n"
"    ${child.preferred_name}\n"
"   </b>\n"
"   in your next letter.\n"
"   <br>\n"
"   <br>\n"
"   Your support of a child in extreme poverty is valuable. At Compassion, we believe this will give a child the opportunity to live a purposeful life. ${object.succes_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can positively transform the lives of currently more than 2 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Your sincerly,   \n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"      ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"% set child = object.get_objects()\n"
"\n"
"% if len(child) == 1:\n"
"    % set child = object.get_objects()\n"
"    % set boy = child.gender == 'M'\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"\n"
"    % if object.send_mode != 'sms':\n"
"        <p>\n"
"            ${object.partner_id.salutation},\n"
"        </p>\n"
"        <p>\n"
"            Grazie per aver investito nel migliorare la vita di ${child.old_firstname} attraverso il sostegno.\n"
"        </p>\n"
"        <p>\n"
"            In situazioni di estrema povertà, potrebbe non essere possibile registrare correttamente i dati dei bambini o potrebbe accadere che la loro situazione familiare cambi. Questo è il caso ${'del bambino' if boy else 'della bambina'} che ${'sostenete' if plural else 'sostieni'} il cui nome non è stato inserito correttamente. Ci dispiace per questo.\n"
"        </p>\n"
"        <p>\n"
"            In futuro, ${'vi' if plural else 'ti'} preghiamo di chiamare ${child.preferred_name} ${'il bambino' if boy else 'la bambina'} che ${'sostenete' if plural else 'sostieni'}.\n"
"        </p>\n"
"        <p>\n"
"            Il ${'vostro' if plural else 'tuo'} sostegno a un bambino che vive in condizioni di estrema povertà è prezioso. Noi di Compassion sappiamo che ${'state' if plural else 'stai'} contribuendo a dare a un bambino una vita dignitosa e significativa. Grazie di cuore.\n"
"        </p>\n"
"        <p>\n"
"            Cari saluti e a presto,\n"
"        </p>\n"
"        % if object.send_mode == 'digital':\n"
"            <p>\n"
"                ${object.user_id.signature | safe}\n"
"            </p>\n"
"        % endif\n"
"    % else:\n"
"        <p>\n"
"            ${object.partner_id.informal_salutation},\n"
"        </p>\n"
"        <p>\n"
"            In situazioni di estrema povertà, a volte i dati non vengono registrati correttamente. Quando ${'il bambino' if boy else 'la bambina'} che sostieni è stat${'o' if boy else 'a'} ammess${'o' if boy else 'a'} al centro di sviluppo infantile, il suo nome è stato registrato in modo errato. Ci dispiace per l'inconveniente!\n"
"        </p>\n"
"        <p>\n"
"            D'ora in poi potrai chiamar${'lo' if boy else 'la'} ${child.preferred_name}.\n"
"        </p>\n"
"        <p>\n"
"            Grazie per il tuo prezioso supporto.\n"
"        </p>\n"
"        <p>\n"
"            Buona giornata e a presto!\n"
"        </p>\n"
"        <p>${whatsapp_signature}</p>\n"
"    % endif\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_disability
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of&nbsp;${child.preferred_name}&nbsp;with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   In Switzerand and also in the country where your sponsored child lives, there are health problems despite medical precautions and examinations. We have been informed by the local staff that ${child.preferred_name} has contracted&nbsp;${child.current_values}.\n"
"   <br>\n"
"   <br>\n"
"   Thanks to your support and a special fund for medical emergencies, Compassion is able to look after the health problems of ${child.preferred_name}. Thank you for accompanying ${child.get('him')} in prayer.\n"
"   <br>\n"
"   <br>\n"
"   Your support for a child in extreme poverty is valuable. At Compassion, we believe this will give a child the chance to live a dignified and meaningful life. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can positively transform the lives of over 1.9 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Sincerely,\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"      ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"% set child = object.get_objects()\n"
"\n"
"% if len(child) == 1:\n"
"    % set firstname = child.get_list('preferred_name', translate=False)\n"
"    % set boy = child.gender == 'M'\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set illness = child.current_values\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.get_snippet('number_mothers') | striptags | safe\n"
"    % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"\n"
"    % if object.send_mode != \"sms\":\n"
"        <p>\n"
"            ${object.partner_id.salutation},\n"
"        </p>\n"
"        <p>\n"
"            Grazie per aver investito nel migliorare la vita di ${firstname} attraverso il sostegno.\n"
"        </p>\n"
"        <p>\n"
"            Purtroppo ${'vi' if plural else 'ti'} contattiamo per ${'darvi' if plural else 'darti'} una triste notizia: il centro di sviluppo infantile ci ha informato che ${firstname} è affett${'o' if boy else 'a'} da ${illness}.\n"
"        </p>\n"
"        <p>\n"
"            Grazie al ${'vostro' if plural else 'tuo'} sostegno e a uno speciale fondo medico, Compassion si impegna a monitorare e curare i problemi di salute di ${firstname}. ${'Vi' if plural else 'Ti'} chiediamo di pregare per la sua protezione e la sua salute.\n"
"        </p>\n"
"        <p>\n"
"            Il ${'vostro' if plural else 'tuo'} sostegno a un bambino che vive in estrema povertà è prezioso. A Compassion sappiamo che ${'state' if plural else 'stai'} contribuendo a dare a un bambino una vita dignitosa e piena di senso. Grazie!\n"
"        </p>\n"
"        <p>Cari saluti,</p>\n"
"\n"
"        % if object.send_mode == \"digital\":\n"
"            <p>\n"
"                ${object.user_id.signature | safe}\n"
"            </p>\n"
"        % endif\n"
"    % else:\n"
"        <p>\n"
"            ${object.partner_id.informal_salutation},\n"
"        </p>\n"
"        <p>\n"
"            Purtroppo ${'vi' if plural else 'ti'} contattiamo per ${'darvi' if plural else 'darti'} una triste notizia: il centro di sviluppo infantile ci ha informato che ${firstname} è affetto da ${illness}.\n"
"        </p>\n"
"        <p>\n"
"            Grazie al ${'vostro' if plural else 'tuo'} sostegno e a uno speciale fondo medico, Compassion si impegna a monitorare e curare i problemi di salute di ${firstname}. ${'Vi' if plural else 'Ti'} chiediamo di pregare per la sua protezione e la sua salute.\n"
"        </p>\n"
"        <p>\n"
"            Buona giornata e a presto!\n"
"        </p>\n"
"        <p>\n"
"            ${whatsapp_signature}\n"
"        </p>\n"
"    % endif\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_sponsorship_cancellation
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set partner = object.partner_id\n"
"                    \n"
"% set sponsorships = object.get_objects()\n"
"                    \n"
"% set children = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = children.get_list('preferred_name', 3, 'many children', False)\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   We took note of the cancellation of your sponsorship toward ${firstname}.\n"
"   <br>\n"
"   <br>\n"
"   Thank you so much for having sponsored ${children.get('this child')}!                    Thanks to your sponsorship, ${children.get('he')} could participate in all the activities offered by the Compassion child project:                    food, clothes, academic support, health screenings and treatments, Bible studies, games, field trips, birthday and Christmas gifts and a lot more.\n"
"   <br>\n"
"   <br>\n"
"   We will now look for a new sponsor to continue the follow up with ${firstname}.\n"
"   <br>\n"
"   <br>\n"
"   With our best regards,\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set tuo = 'vostro' if plural else 'tuo'\n"
"    % set tuoi_bambini = 'vostri bambini' if plural else 'tuoi bambini'\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set one_child = len(children) == 1\n"
"    % set boy = one_child and children.gender == 'M'\n"
"    % set firstname = children.get_list('preferred_name', 3, tuoi_bambini, False)\n"
"    % set nb_weeks = sponsorships[:1].contract_duration // 7\n"
"    % set nb_years = (sponsorships[:1].contract_duration // 364) or 1\n"
"    % set field = children[:1].field_office_id\n"
"    % set hours_fcp = field.fcp_hours_week * nb_weeks\n"
"    % set meals = field.fcp_meal_week * nb_weeks\n"
"    % set medical = field.fcp_medical_check * nb_years\n"
"\n"
"    % if len(hours_fcp|string) > 3:\n"
"        % set hours_fcp = hours_fcp|string\n"
"        % set hours_fcp = hours_fcp[:-3] + '.' + hours_fcp[-3:]\n"
"    % endif\n"
"\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"\n"
"% if 7 in sponsorships.mapped(\"end_reason_id\").ids or 9 in sponsorships.mapped(\"end_reason_id\").ids:\n"
"    <p>\n"
"        ${'Avete' if plural else 'Hai'} scelto di sostenere ${firstname} per aiutar${'lo' if boy else 'la'} a uscire dalla povertà estrema. Questo impegno non è stato confermato dal pagamento concordato.\n"
"    </p>\n"
"    <p>\n"
"        ${'VI' if plural else 'Ti'} comunichiamo pertanto che il sostegno è stato annullato.\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        Con la presente confermiamo la fine del sostegno di ${firstname}.\n"
"    </p>\n"
"    <p>\n"
"        Durante il ${tuo} sostegno, ${firstname} ha trascorso ${hours_fcp} ore presso il centro di sviluppo infantile della chiesa locale. Il personale si è preso cura di ${'lui' if boy else 'lei'} con amore, trasmettendo${'gli' if boy else 'le'} speranza per il futuro. Ha ricevuto ${meals} pasti e beneficiato di ${medical} visite mediche.\n"
"\n"
"        % if min(children.mapped('age')) >= 7:\n"
"            Ha potuto inoltre frequentare la scuola ed essere incoraggiat${'o' if boy else 'a'} a sviluppare i propri talenti. Infine, ha scoperto che qualcuno dall'altra parte del mondo si preoccupava per ${'lui' if boy else 'lei'}. Grazie di cuore!\n"
"        % endif\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Compassion Svizzera cercherà un sostenitore affinché ${firstname} possa beneficiare del sostegno e delle attività del centro infantile, per vivere una vita dignitosa e piena di senso.\n"
"</p>\n"
"<!-- CSP -->\n"
"<p>\n"
"    Il sostegno dei bambini è solo uno dei numerosi programmi di Compassion per liberare ogni giorno più bambini dalla povertà estrema. ${'Conoscete' if plural else 'Conosci'} il programma di sopravvivenza per le donne incinte e le mamme di neonati? Con una donazione una tantum o regolare, ${'potete' if plural else 'puoi'} fare davvero la differenza garantendo loro: accesso alle cure mediche durante la gravidanza, assistenza al parto in una struttura medica, formazione genitoriale, supporto psicologico, sociale e spirituale, aiuto materiale e formazione per generare reddito.\n"
"</p>\n"
"<p>\n"
"    Con soli 15 CHF ${'potete' if plural else 'puoi'} sostenere una donna e il suo bambino per un'intera settimana. Non ${'esitate' if plural else 'esitare'} a contattarci o, se lo ${'desiderate' if plural else 'desideri'}, a fare una donazione qui:\n"
"    % if object.send_mode == \"digital\":\n"
"        <a href=\"https://compassion.ch/it/sopravvivenza/\">compassion.ch/it/sopravvivenza</a>\n"
"    % else:\n"
"        compassion.ch/it/sopravvivenza\n"
"    % endif\n"
"     per continuare a contribuire alla lotta contro la povertà estrema.\n"
"</p>\n"
"<!-- WASH -->\n"
"<!--\n"
"<p>\n"
"    ${'Sapevate' if plural else 'Sapevi'} che quasi 4 persone su 10 nel mondo non hanno accesso a una toilette sicura? A causa di questa situazione e dell'acqua contaminata, i bambini spesso si ammalano e non possono andare a scuola. Compassion costruisce e ristruttura servizi igienici e fornisce ai bambini e alle famiglie una formazione sull'igiene per proteggere la loro salute e favorire il loro sviluppo.\n"
"</p>\n"
"<p>\n"
"    Con una donazione unica o regolare di 30 CHF, ${'potete' if plural else 'puoi'} garantire a un bambino l'accesso a servizi igienici sicuri e fare una differenza significativa nella sua vita. Non ${'esitate' if plural else 'esitare'} a contattarci o, se lo ${'desiderate' if plural else 'desideri'}, a fare una donazione qui\n"
"    % if object.send_mode == \"digital\":\n"
"        <a href=\"https://compassion.ch/it/donare/\">compassion.ch/it/donare/</a>\n"
"    % else:\n"
"        compassion.ch/it/donare/\n"
"    % endif\n"
"</p>\n"
"-->\n"
"<p>\n"
"    Saremo felici di ${'avervi' if plural else 'averti'} al nostro fianco in futuro nella lotta contro la povertà estrema.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.b2s_email_not_read
msgid ""
"<div>\n"
"\n"
"    % set letter = object.get_objects()\n"
"    % set child = letter.mapped('child_id')\n"
"    % set s = '' if len(child) == 1 else 's'\n"
"    % set partner = object.partner_id\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set firstname = child.get_list('preferred_name', 3, 'your sponsored children', False)\n"
"    % set email = partner.email\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    A few days ago, you should have received a letter by email from ${firstname}.</p>\n"
"<p>\n"
"    Unfortunately, it does not seem to have been delivered to the email address ${email}.\n"
"</p>\n"
"<p>\n"
"    That is why we are sending you the letter by post. We hope you enjoy it!\n"
"</p>\n"
"<p>\n"
"    Has your email changed? Or maybe the email landed in your spam folder?\n"
"</p>\n"
"<p>\n"
"    Please let us know if you have a new email address or kindly add info@compassion.ch to your contacts to ensure that the email does not land in the spam folder.\n"
"</p>\n"
"<p>\n"
"    ${years_uc} ${number_years} years of experience has shown us that letters have a decisive influence on the children’s development.\n"
"</p>\n"
"<p>\n"
"    Thank you for taking a few minutes of your time to respond to the letter online in your <a href='https://mycompassion.ch'>MyCompassion profile</a>.\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
"% endif"
msgstr ""
"<div>\n"
"    % set letter = object.get_objects()\n"
"    % set child = letter.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, 'vostri figlioli', False)\n"
"    % set partner = object.partner_id\n"
"    % set child = letter.mapped('child_id')\n"
"    % set christmas_fund_2022 = 265 in partner.category_id.ids\n"
"    \n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"    <br>\n"
"    <br>\n"
"    Pochi giorni fa le abbiamo inviato una lettera di ${firstname}! Ha avuto il tempo di leggerla?\n"
"    <br>\n"
"    <br>\n"
"    Lo scambio di lettere è un elemento chiave per il sostegno di un bambino. ${years_uc} ${number_years} anni di esperienza dimostrano che le lettere danno un contributo decisivo allo sviluppo del bambino.\n"
"    <br>\n"
"    <br>\n"
"    Ci auguriamo che le faccia piacere leggere le notizie ${child.get('del suo bambino')}. ${object.success_sentence or ''}\n"
"    <br>\n"
"    <br>\n"
"    Grazie in anticipo per prendere qualche minuto per rispondere alla letterina. Grazie di usare parole di incoraggiamento per ${firstname}. Può scrivere  direttamente dal nostro sito internet: https://compassion.ch/it/scrivere/  o tramite l'App di Compassion https://compassion.ch/app/\n"
"    <br>\n"
"    <br>\n"
"    Se preferisce che un volontario scriva a ${firstname} per conto suo, ci contatti gentilmente al numero +41 031 552 21 24 o per email a: courrier@compassion.ch\n"
"    <br>\n"
"    <br>\n"
"    Restiamo a sua completa disposizione per qualsiasi domanda relativa agli scambi di corrispondenza!\n"
"    <br>\n"
"    <br>\n"
"    Ancora una volta le ricordiamo che sta trasformando la vita di un bambino liberandolo dalla povertà estrema dandogli la possibilità di una vita dignitosa e piena di significato.\n"
"    <br>\n"
"    <br>\n"
"    Riceva i nostri calorosi saluti\n"
"</p>\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_caregiver_change
msgid ""
"<div>\n"
"                    % set child = object.get_objects()\n"
"                    % set caregiver = child.household_id.primary_caregiver\n"
"                </div>\n"
"                <p>\n"
"                    ${object.partner_id.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    We learned that the primary caregiver of ${child.firstname} is now ${child.get('his')}\n"
"                    % if 'Beneficiary' not in caregiver:\n"
"                        ${caregiver}\n"
"                    % else:\n"
"                        ${'sister' if 'Female' in caregiver else 'brother'}\n"
"                    % endif\n"
"                    .\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_project_reactivation
msgid ""
"<div>\n"
"                    % set child = object.get_objects()\n"
"                    % set project = child.mapped('project_id')[0]\n"
"                    % set reactivation = project.lifecycle_ids[0]\n"
"                    % set details = reactivation.icp_improvement_desc\n"
"                </div>\n"
"                <p>\n"
"                    ${object.partner_id.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    A few time ago the project ${project.icp_id} where ${child.get('your sponsored child')} ${child.get('is')} registered was on suspension.\n"
"                    We are happy to inform you that the problem is resolved and that the project is again sane and active.\n"
"                    The project will do regular tuitions and spiritual activites to keep the situation healthy.\n"
"                    <br>\n"
"                    <br>\n"
"                    % if details:\n"
"                        ${details}\n"
"                        <br>\n"
"                        <br>\n"
"                    % endif\n"
"                    Yours sincerely\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_project_transition
msgid ""
"<div>\n"
"                    % set child = object.get_objects()\n"
"                    % set project = child.mapped('project_id')[0]\n"
"                    % set transition = project.lifecycle_ids[0]\n"
"                    % set details = transition.details\n"
"                </div>\n"
"                <p>\n"
"                    ${object.partner_id.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    A few time ago the project ${project.icp_id} where ${child.get('your sponsored child')} ${child.get('is')} registered was on suspension.\n"
"                    <br>\n"
"                    <br>\n"
"                    Unfortunately the local church will definitely end its partnership with Compassion\n"
"                    % if transition.transition_date:\n"
"                        <!-- --> on ${transition.get_date('transition date', 'date_full')}\n"
"                    % endif\n"
"                    % if transition.transition_reason_ids:\n"
"                        <!-- --> because of ${transition.get_list('transition_reason_ids.value')}\n"
"                    % endif\n"
"                    .\n"
"                    % if transition.future_involvement_ids:\n"
"                        The project will continue to work and offer ${transition.get_list('future_involvement_ids.value')} in its area.\n"
"                    % endif\n"
"                    <br>\n"
"                    <br>\n"
"                    % if details:\n"
"                        <span style=\"font-style: italic;\">${details}</span>\n"
"                        <br>\n"
"                        <br>\n"
"                    % endif\n"
"                    % if transition.action_plan:\n"
"                        <span style=\"font-style: italic;\">${transition.action_plan}</span>\n"
"                        <br>\n"
"                        <br>\n"
"                    % endif\n"
"                    The children living close to another project will be transfered.\n"
"                    <br>\n"
"                    <br>\n"
"                    We feel sorry for this situation and hope you will understand. You will receive soon another letter that will give you more details about ${child.get('your sponsored child')}. Thank you so much for the support.\n"
"                    <br>\n"
"                    <br>\n"
"                    Please don't hesitate to contact us in case you have any questions regarding the situation.\n"
"                    <br>\n"
"                    <br>\n"
"                    Yours sincerely\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_transition
msgid ""
"<div>\n"
"                    % set child = object.get_objects()\n"
"                </div>\n"
"                <p>\n"
"                    Dear sponsor,\n"
"                    <br>\n"
"                    <br>\n"
"                    We warmly thank you for your precious sponsorship of ${child.get_list('preferred_name')}.\n"
"                    <br>\n"
"                    <br>\n"
"                    Your sponsored child is starting now the ${child.get_list('cdsp_type')} sponsorship program.\n"
"                    <br>\n"
"                    <br>\n"
"                    We encourage you to send a letter to your child to encourage him participating to the program.\n"
"                    <br>\n"
"                    <br>\n"
"                    Yours sincerely\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_hold_removal
msgid ""
"<div>\n"
"                    % set hold = object.get_objects()\n"
"                    % set owner = object.partner_id.firstname\n"
"                    % set child_code = hold.mapped('child_id').get_list('local_id')\n"
"                    % set child_name = hold.mapped('child_id').get_list('name')\n"
"                </div>\n"
"                <p>\n"
"                    Dear ${owner},\n"
"                    <br>\n"
"                    <br>\n"
"                    We just learned that the child ${child_name} with ref. ${child_code} is no longer available for sponsorship.\n"
"                    The following comments were received :\n"
"                    % for h in hold:\n"
"                        <br>\n"
"                        ${h.comments}\n"
"                        <br>\n"
"                    % endfor\n"
"                    <br>\n"
"                    <br>\n"
"                    If you have the childpack, please don't use it.\n"
"                    <br>\n"
"                    <br>\n"
"                    Yours sincerely\n"
"                </p>\n"
"            "
msgstr ""
"<div>\n"
"    % set hold = object.get_objects()\n"
"    % set owner = object.partner_id\n"
"    % set child = hold.mapped('child_id')\n"
"                    % set child_code = hold.mapped('child_id').get_list('local_id')\n"
"                    % set child_name = hold.mapped('child_id').get_list('name')\n"
"</div>\n"
"<p>\n"
"    ${owner.salutation},\n"
"    <br>\n"
"    <br>\n"
"    Abbiamo appreso che ${child_name}, ${child_code}. Non è più disponibile per essere ${'sostenuto' if child.gender == 'M' else 'sostenuta'}.\n"
"    <br>\n"
"    <br>\n"
"    Abbiamo ricevuto il messaggio seguente (in inglese):\n"
"    <br>\n"
"    <br>\n"
"    <i>${hold.comments}</i>\n"
"    <br>\n"
"    <br>\n"
"    Se avete ancora con voi il dossier del ${child.get('child')}, vi preghiamo di non utilizzarlo.\n"
"    <br>\n"
"    <br>\n"
"    Cordiali saluti.\n"
"</p>"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_transfer
msgid ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set preferred_name = child.get_list('preferred_name', translate=False)\n"
"    % set fcp = child.mapped('project_id')\n"
"    % set lifecycle = child.mapped('lifecycle_ids')[:1]\n"
"    % set one = len(child) == 1\n"
"    % set partner = object.partner_id\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"   Thank you for investing in the life of ${preferred_name} with a sponsorship.\n"
"</p>\n"
"<p>\n"
"    We have received a message that your sponsored child has moved to a new Child Development Centre.\n"
"</p>\n"
"<p>\n"
"    Therefore, ${child.get('he')} has been issued a new reference number, ${child.local_id}, which you will need for future letter correspondences via post.\n"
"</p>\n"
"    % if partner.email:\n"
"    \t<p>You can write via your <a href='https://www.mycompassion.ch'>MyCompassion</a> profile.</p>\n"
"    \t<p>Do you need inspiration? <a href=\"https://compassion.ch/de/was-soll-ich-meinem-patenkind-schreiben/\">5 ideas to write your letter</a></p>\n"
"    % elif object.send_mode == \"physical\":\n"
"    \t<p>Enclosed, you will find a new sheet of labels for your letters that you send via post.</p>\n"
"    \t<p>You can also write via your <a href='https://www.mycompassion.ch'>MyCompassion</a> profile.</p>\n"
"    \t<p>Do you need inspiration? <a href=\"https://compassion.ch/de/was-soll-ich-meinem-patenkind-schreiben/\">5 ideas to write your letter</a></p>\n"
"    % endif\n"
"<p>\n"
"    We wish you much joy whilst writing!\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"% if object.send_mode != \"physical\":\n"
"\t<p>${object.user_id.signature | safe}</p>\n"
"% endif\n"
msgstr ""
"<!--\n"
"% set child = object.get_objects()\n"
"% set partner = object.partner_id\n"
"${'Il bambino' if child.gender == 'M' else 'La bambina'} che ${'sostenete' if partner.title.plural or partner.title.id == 29 else 'sostieni'} ha cambiato centro di accoglienza\n"
"-->\n"
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set child = object.get_objects()\n"
"    % set name = child.get_list('preferred_name')\n"
"    % set fcp = child.mapped('project_id')\n"
"    % set lifecycle = child.lifecycle_ids[:1]\n"
"    % set one = len(child) == 1\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"</p>\n"
"<p>\n"
"    Grazie di cuore per aver investito nel migliorare la vita di ${name} attraverso il sostegno. ${'State' if plural else 'Stai'} facendo una differenza duratura nella sua vita.\n"
"</p>\n"
"<p>\n"
"    Abbiamo ricevuto la notizia che ${name} ha cambiato centro di accoglienza e che il suo nuovo numero di riferimento è il seguente: ${child.local_id}.\n"
"<!--\n"
"Abbiamo ricevuto la notizia che ${child.get('il suo bambino')} ${child.get('is')} ${child.get('stato trasferito')} in un altro centro Compassion, causa trasferimento. Di conseguenza,\n"
"\n"
"% if one:\n"
"    ha un nuovo numero di riferimento: ${child.local_id}.\n"
"% else:\n"
"    hanno dei nuovi numeri di riferimento:\n"
"    </p>\n"
"    <ul>\n"
"        % for _child in child:\n"
"            <li>\n"
"            ${_child.preferred_name} : ${_child.local_id}\n"
"            </li>\n"
"        % endfor\n"
"    </ul>\n"
"    <p>\n"
"% endif\n"
"-->\n"
"<p>\n"
"    ${'Vi' if plural else 'Ti'} preghiamo, d’ora in poi, di utilizzare questo riferimento quando ${'le' if child.gender == 'F' else 'gli'} ${'scriverete' if plural else 'scriverai'} una lettera.\n"
"</p>\n"
"\n"
"% if not partner.email:\n"
"    <p>\n"
"        In allegato ${'troverete' if plural else 'troverai'} un set di etichette da incollare alle lettere che ${'invierete' if plural else 'invierai'}.\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    ${'Potete' if plural else 'Puoi'} anche scrivere <a href=\"https://www.compassion.ch/ecrire\">online</a>.\n"
"</p>\n"
"<p>\n"
"    Se ${'avete' if plural else 'hai'} bisogno di ispirazione, ${'potete' if plural else 'puoi'} trovare alcune idee qui: <a href=\"https://compassion.ch/it/cosa-dovrei-scrivere-al-mio-bambino/\">compassion.ch/it/cosa-dovrei-scrivere-al-mio-bambino</a>\n"
"</p>\n"
"<p>\n"
"    Buona scrittura!\n"
"</p>\n"
"<p>\n"
