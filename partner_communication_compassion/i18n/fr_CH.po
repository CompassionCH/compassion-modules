"${object.child_id.preferred_name} vous a écrit une lettre suite à votre cadeau\n"
"% else:\n"
"${object.child_id.preferred_name} vous a écrit une ${'première' if 'new sponsor' in types else 'nouvelle'} lettre\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.new_letter
msgid ""
"<!-- this is a comment for testing purposes -->\n"
"<!-- this is a comment for testing purposes --><div>\n"
"    % set letter = object.get_objects()\n"
"    % set child = letter.mapped('child_id')\n"
"    % set s = '' if len(child) == 1 else 's'\n"
"    % set partner = object.partner_id\n"
"    % set child = letter.mapped('child_id')\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set urls = []\n"
"\n"
"    % for letter_set in letter.filtered('read_url').mapped('read_url'):\n"
"        % if letter_set not in urls:\n"
"             % set void = urls.append(letter_set)\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % set field_office_ids = child.mapped('field_office_id').ids\n"
"    % set restricted = 1 in field_office_ids or 19 in field_office_ids\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    We are very happy to inform you that a new letter has arrived from ${child.get_list('preferred_name', 3, child.get_number()) or child.get_list('firstname', 3, child.get_number())}!\n"
"</p>\n"
"<p>\n"
"    You can download the letter by clicking on the link. Enjoy reading:\n"
"    <ul>\n"
"        % for l in urls:\n"
"            <li>\n"
"                <a href=\"${l}\">\n"
"                    ${l}\n"
"                </a>\n"
"            </li>\n"
"        % endfor\n"
"    </ul>\n"
"</p>\n"
"<p>\n"
"    ${years_uc} ${number_years} years of experience show us the importance of letters for the development of the children.\n"
"</p>\n"
"<p>\n"
"    Thank you in advance for taking a few minutes to reply to the enclosed letter. You can respond online via <a href=\"https://www.mycompassion.ch\">MyCompassion</a>.\n"
"</p>\n"
"% if restricted:\n"
"    <p>\n"
"        Important information about writing to your sponsored ${'child' if len(child) == 1 else 'children'}.\n"
"    </p>\n"
"    <div style=\"margin:20px auto; text-align: center;\">\n"
"        <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_de.pdf\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            Information on writing letters\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"<p>\n"
"    Please do not hesitate to contact us with regards to any questions you may have in relation to exchanging letters.\n"
"</p>\n"
"<p>\n"
"    Best regards,\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
"% endif"
msgstr ""
"<span>\n"
"    % set letter = object.get_objects()\n"
"    % set intro = 'une nouvelle lettre de ' + (letter.child_id.preferred_name or letter.child_id.firstname) if len(letter) == 1 else 'de nouvelles lettres'\n"
"    % set partner = object.partner_id\n"
"    % set child = letter.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set urls = []\n"
"\n"
"    % for letter_set in letter.filtered('read_url').mapped('read_url'):\n"
"        % if letter_set not in urls:\n"
"            % set void = urls.append(letter_set)\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/fr_CH/im_livechat/support/3\"\n"
"    % set christmas_fund_2022 = 265 in partner.category_id.ids\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.get_snippet('number_mothers') | striptags | safe\n"
"    % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"\n"
"    % set field_office_ids = child.mapped('field_office_id').ids\n"
"    % set restricted = 1 in field_office_ids or 19 in field_office_ids\n"
"</span>\n"
"<div>\n"
"% if object.send_mode == \"sms\":\n"
"    <p>\n"
"        ${partner.salutation},\n"
"    </p>\n"
"    <p>\n"
"        Nous sommes heureux de t'envoyer la nouvelle lettre de ${child.get_list('preferred_name', translate=False)}!\n"
"    </p>\n"
"    <p> \n"
"        Clique ici pour télécharger la lettre: <a href=\"${urls[0]}\">Lettre</a>\n"
"    </p>\n"
"    <p> \n"
"        Bonne lecture!\n"
"    </p>\n"
"    <p>\n"
"        Si tu as cinq minutes, pourrais-tu directement répondre à cette lettre? Clique simplement ici: <a href=\"https://mycompassion.ch/fr_CH/my/letter\">MyCompassion</a>\n"
"    </p>\n"
"    <p>Merci et à bientôt!</p>\n"
"    <p>\n"
"        ${whatsapp_signature}\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        ${partner.salutation},\n"
"    </p>\n"
"    <p>\n"
"        C'est avec joie que nous vous adressons ${intro} !\n"
"        % if object.send_mode == 'digital':\n"
"            Cliquez sur le lien pour la télécharger.*\n"
"        % endif\n"
"        Nous vous souhaitons beaucoup de plaisir à la lecture des nouvelles de ${child.get('your sponsored child')}.\n"
"    </p>\n"
"    % if object.send_mode == 'digital':\n"
"        <ul>\n"
"            % for l in urls:\n"
"                <li>\n"
"                    <a href=\"${l}\">\n"
"                        ${l}\n"
"                    </a>\n"
"                </li>\n"
"            % endfor\n"
"        </ul>\n"
"    % endif\n"
"    <p>\n"
"        ${years_uc} ${number_years} ans d'expérience ont montré que l'échange de lettres peut influencer de façon\n"
"        significative le développement ${\"de l'enfant parrainé\" if one_child else \"des enfants parrainés\"}.\n"
"    </p>\n"
"    <p>\n"
"        Vous pouvez écrire rapidement et facilement à ${child.get('your sponsored child')} sur\n"
"        <a href=\"https://mycompassion.ch\">\n"
"            MyCompassion.ch.\n"
"        </a>\n"
"        La plateforme vous permet d'avoir toujours à portée de main les photos, les lettres et les informations de ${child.get('your sponsored child')}.\n"
"    </p>\n"
"    <p>\n"
"        Si vous avez une question au sujet de la correspondance avec ${child.get('your sponsored child')}, n'hésitez pas à prendre contact avec nous !\n"
"    </p>\n"
"    % if restricted and object.send_mode != 'physical':\n"
"        <p>\n"
"            Des recommandations spéciales s'appliquent pour la correspondance avec ${child.get('your sponsored child')} et sont consultables ici:\n"
"        </p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"            <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_fr.pdf\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"                Voir les recommandations spéciales\n"
"            </a>\n"
"        </div>\n"
"    % endif\n"
"    <p>\n"
"        Recevez nos chaleureuses salutations.\n"
"    </p>\n"
"    % if object.send_mode != 'physical':\n"
"        <p>\n"
"            ${object.sudo().user_id.signature | safe}\n"
"        </p>\n"
"    % endif\n"
"<p>\n"
"    *Si vous rencontrez des problèmes lors du téléchargement de la lettre, vous pouvez ouvrir la lettre sur <a href=\"https://mycompassion.ch/fr_CH/my/letter\">MyCompassion</a>.\n"
"</p>\n"
"\n"
"\n"
"% endif\n"
"</div>"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_completion_date_change
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    % set child = object.get_objects()\n"
"                </div>\n"
"                <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    ${object.partner_id.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    We learned that ${child.firstname} will finish the Compassion program on ${child.get_date('completion_date', 'date_full')}.\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_parent_alive
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    % set child = object.get_objects()\n"
"    % set role = 'mother' if child.household_id.revised_value_ids.name == 'Natural Mother Alive' else 'father'\n"
"    % set status = 'alive' if child.household_id.revised_value_ids.get_field_value() == 'True' else 'dead'\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation}\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Thank you for investing in the life of ${child.firstname} with a sponsorship.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    We have been notified from our local employees that the ${role} of your sponsored child has passed away. If you would like to write a few lines expressing your condolences to comfort ${child.get('him')}, this can be easily done via your <a href=\"https://www.compassion.ch\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">MyCompassion</a> profile.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    In this difficult time, your support for ${child.firstname} makes an even bigger difference.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Once again, thank you for your commitment so that together we can positively transform the lives of currently more than ${number_children} million children in ${number_countries} countries.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    With kind regards,\n"
"</p>\n"
"% if object.send_mode == 'digital':\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set role = 'la maman' if child.household_id.revised_value_ids.name == 'Natural Mother Alive' else 'le papa'\n"
"    % set accord = 'e' if role == 'la maman' else ''\n"
"    % set status = 'vivant' + accord if child.household_id.revised_value_ids.get_field_value() == 'True' else 'décédé' + accord\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"\n"
"    % set reason = False\n"
"    % set lifecycle = child.mapped('lifecycle_ids')\n"
"\n"
"    % for l in lifecycle:\n"
"        % if l.request_reason == 'death of caregiver':\n"
"            % if l.comments:\n"
"                % set reason = l.comments\n"
"            % endif\n"
"        % endif\n"
"    % endfor\n"
"\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"    <br>\n"
"    <br>\n"
"    Merci de tout cœur d'investir dans la vie de ${child.preferred_name or child.firstname} par le biais du parrainage.\n"
"    <br>\n"
"    <br>\n"
"    Le bureau national nous informe que ${role} de ${child.get('your sponsored child')} est ${status}.\n"
"    % if reason:\n"
"        D'après le centre d'accueil, la raison est ${reason}.\n"
"    % endif\n"
"    Peut-être avez-vous à coeur de lui écrire pour prendre de ses nouvelles et lui adresser des paroles de consolation ? Vous pouvez le faire directement en ligne sur <a href=\"https://www.compassion.ch/ecrire\">www.compassion.ch/ecrire</a>.\n"
"    <br>\n"
"    <br>\n"
"    Dans ce temps d'épreuve, votre soutien à ${child.preferred_name or child.firstname} est encore plus précieux.\n"
"    <br>\n"
"    <br>\n"
"    Recevez nos chaleureuses salutations.\n"
"    % if object.send_mode == 'digital':\n"
"        <br>\n"
"        <br>\n"
"            ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_sponsorship_transfer_dossier
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set less_4 = len(child) &lt; 4\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set correspondant = object.partner_id in sponsorships.mapped('correspondent_id')\n"
"    % set partner = object.partner_id\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"</div>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    A very warm welcome to you, ${partner.firstname}!\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    It's so nice to have you as part of the Compassion Switzerland family!\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Together with you and ${number_fcps} partner churches in ${number_countries} countries, we are currently releasing over ${number_children} million children from poverty. Collectively, we enable the children to have a life with a future filled with hope.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    In order to ensure a smooth continuation to your sponsorship for ${firstname}, please find attached important information:\n"
"</p>\n"
"<ul style=\"margin:0px 0 1rem 0;\">\n"
"    <li>1 photo of ${'your sponsored child' if one_child else 'each child'}</li>\n"
"    <li>1 folder with important information about your sponsorship</li>\n"
"\n"
"    % if object.send_mode == \"physical\":\n"
"        <li>1 sheet of labels for the letter correspondence (please stick them on cards, letters, stickers, drawings, etc.)</li>\n"
"    % endif\n"
"</ul>\n"
"\n"
"% if payer:\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"        % if lsv_dd:\n"
"            We kindly ask you to fill in and return via post the attached bank form to continue your sponsorship journey with ${firstname}.\n"
"        % else:\n"
"            We kindly ask you to activate a standing order with the attached payment slip to continue your sponsorship journey with ${firstname}.\n"
"        % endif\n"
"    </p>\n"
"% endif\n"
"\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Please do not hesitate to get in touch with us if you have any further questions.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Thank you so much for investing in the ${'life of ' + firstname if less_4 else 'lives of many children'}!\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    We wish you much joy as you continue your sponsorship journey.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Together, we are changing the world! One child at a time.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Warm regards\n"
"</p>\n"
"\n"
"% if object.send_mode == \"digital\":\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set correspondant = object.partner_id in sponsorships.mapped('correspondent_id')\n"
"    % set partner = object.partner_id\n"
"    % set un_parrain = 'un parrain'\n"
"\n"
"    % if partner.gender == 'F':\n"
"        % set un_parrain = 'une marraine'\n"
"    % endif \n"
"\n"
"    % if partner.title == partner.env.ref('partner_compassion.res_partner_title_family'):\n"
"        % set un_parrain = 'une famille'\n"
"    % endif\n"
"\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"\n"
"</div>\n"
"<div style=\"font-size:8pt\">\n"
"    ${partner.salutation},\n"
"    <br>\n"
"    <br>\n"
"    Merci de faire partie de la famille de Compassion en Suisse !\n"
"    <br>\n"
"    <br>\n"
"    Avec vous et avec ${number_fcps} Eglises partenaires dans les pays du Sud, nous nous engageons à libérer ${number_children} millions d'enfants de l'extrême pauvreté. Ensemble, nous offrons à ces enfants un avenir empreint d'espérance.\n"
"    <br>\n"
"    <br>\n"
"\n"
"    % if object.send_mode == \"physical\":\n"
"        Pour que votre parrainage se poursuive dans les meilleures conditions, vous trouverez ci-joint plusieurs informations et documents importants:\n"
"        <ul>\n"
"            <li>\n"
"                1 photo de ${(child.get('each of') or '') + child.get('your sponsored child') |safe}\n"
"            </li>\n"
"            <li>\n"
"                1 dossier avec des informations pratiques concernant votre parrainage\n"
"            </li>\n"
"    \n"
"            % if correspondant:\n"
"<!--                <li>\n"
"                    1 carte de présentation à envoyer à ${child.get('your sponsored child')}\n"
"                </li>\n"
"            -->\n"
"                <li>\n"
"                    1 feuille d'étiquettes ${child.get('per child') or ''}à utiliser pour toute la correspondance avec ${child.get('your sponsored child')} (à coller sur vos cartes, lettres, dessins, autocollants,...)\n"
"                </li>\n"
"           % endif \n"
"    \n"
"        </ul>\n"
"    % endif\n"
"\n"
"    % if payer:\n"
"        Pour poursuivre votre soutien à ${firstname},  nous vous remercions d'avance\n"
"            % if lsv_dd:\n"
"                de remplir le formulaire ci-joint et de nous le retourner signé par courrier postal.\n"
"            % else:\n"
"                de mettre en place un ordre permanent au moyen du bulletin de versement ci-joint.\n"
"            % endif\n"
"        <br>\n"
"        <br>\n"
"    % endif \n"
"\n"
"    Merci beaucoup d'investir dans la vie de ${firstname}. Nous vous souhaitons beaucoup de joie dans votre relation avec ${child.get('lui_elle')}.\n"
"    <br>\n"
"    <br>\n"
"    N'hésitez pas à nous contacter pour toute question.\n"
"    <br>\n"
"    <br>\n"
"    Ensemble, changeons le monde, un enfant à la fois.\n"
"    <br>\n"
"    <br>\n"
"    Avec nos meilleures salutations.\n"
"    <br>\n"
"    <br>\n"
"\n"
"    % if object.send_mode == \"digital\":\n"
"        ${object.user_id.signature | safe}\n"
"        <br>\n"
"        <br>\n"
"    PS: Saviez-vous que vous pouvez écrire à votre ${child.get('filleul')} rapidement et simplement sur <a href=\"https://mycompassion.ch\">MyCompassion</a> ? La plateforme vous permet d'avoir toutes les informations, les photos et les lettres de ${firstname} en tous temps avec vous.\n"
"    % endif\n"
"</div>"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_gender
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${child.firstname}&nbsp;with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   In circumstances of extreme poverty, sometimes data is not collected correctly. This is the case with your sponsored child. We have been informed that ${child.get('he')} was introduced to you as a ${'boy' if child.old_values == 'M' else 'girl'} even though${child.get('he')}&nbsp;is a ${'boy' if child.gender == 'M' else 'girl'}. We thank you in advance for your understanding.\n"
"   <br>\n"
"   <br>\n"
"   Your support of a child in extreme poverty is valuable. At Compassion, we believe this will give a child the chance to live with purpose. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your committment so that together we can positively transform the lives of currently 2 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Your sincerely,\n"
"   % if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"     ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/fr_CH/im_livechat/support/3\"\n"
"    % set sms = object.send_mode == \"sms\"\n"
"    % set plural = object.partner_id.title.plural or object.partner_id.title.id == 29\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set boy = child.gender == 'M'\n"
"</div>\n"
"\n"
"<p>\n"
"    ${object.partner_id.informal_salutation if sms else object.partner_id.salutation},\n"
"</p>\n"
"\n"
"% if not sms:\n"
"    <p>\n"
"        Merci de tout cœur d'investir dans la vie de ${child.preferred_name or child.firstname} par le biais du parrainage.\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Il arrive que dans les situations d'extrême pauvreté, les données relatives aux enfants n'aient pas pu être récoltées correctement. C'est le cas de ${child.get('your sponsored child')}. Nous avons appris qu'${child.get('he')} ${\"t'a\" if sms and not plural else \"vous a\"} été présenté${child.get('accord_e') or ''} comme ${'un garçon' if child.old_values == 'M' else 'une fille'}, alors qu'${child.get('he')} est ${'un garçon' if child.gender == 'M' else 'une fille'}. Toutes nos excuses.\n"
"</p>\n"
"\n"
"% if sms:\n"
"    <p>Merci pour ton précieux soutien.</p>\n"
"    <p>Bonne journée et à bientôt!</p>\n"
"    <p>L'équipe de Compassion\n"
"        <br/>\n"
"        Tel: +41 (0)24 434 21 24\n"
"        <br/>\n"
"        Des questions? Tchate avec nous sur MyCompassion: <a href=\"${wp_tchat_url}\">${wp_tchat_url}</a>\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        ${years_uc} ${number_years} ans d'expérience nous permettent d'affirmer que le parrainage ne transforme pas seulement la vie d'un enfant, mais aussi celle de sa famille. Merci de votre engagement.\n"
"    </p>\n"
"    <p>Avec nos chaleureuses salutations.</p>\n"
"    <p>\n"
"        % if object.send_mode == 'digital':\n"
"            ${object.user_id.signature | safe}\n"
"        % endif\n"
"    </p>\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_birthdate
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${child.firstname}.&nbsp;In situations of extreme poverty, sometimes data is not recorded correctly. This is the case with your sponsored child. We were informed that your sponsored child was not born on ${child.get_date('old_values', 'date_full')} but on ${child.get_date('birthdate', 'date_full')}.\n"
"   <br>\n"
"   <br>\n"
"   Your&nbsp;support of a child in extreme poverty is valuable.&nbsp; At Compassion, we believe that this will give a child the opportunity to live a purposeful life. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Thank you again for your commitment so that together we can positively change the lives of currently more than 1.9 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"% if object.send_mode == 'digital':\n"
"       ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"% if len(object.get_objects()) == 1:\n"
"    <div>\n"
"        % set child = object.get_objects()\n"
"        % set wp_tchat_url = \"https://mycompassion.ch/fr_CH/im_livechat/support/3\"\n"
"    </div>\n"
"    <p>\n"
"        ${object.partner_id.informal_salutation if object.send_mode == \"sms\" else object.partner_id.salutation},\n"
"    </p>\n"
"\n"
"    % if object.send_mode != \"sms\":\n"
"        <p>\n"
"            Merci de tout cœur d'investir dans la vie de ${child.preferred_name} par le biais du parrainage.\n"
"        </p>\n"
"    % endif\n"
"\n"
"    <p>\n"
"        Il arrive que dans les situations d'extrême pauvreté, les données relatives aux enfants n'aient pas pu être\n"
"        récoltées correctement, par exemple parce que l'enfant n'a ni certificat de naissance ni papiers d'identité.\n"
"    </p>\n"
"    <p>\n"
"        Nous avons appris que la date de naissance de ${child.get('your sponsored child')} n'a pas été enregistrée\n"
"        correctement. ${child.preferred_name} n'est pas né${child.get('accord_e')} le ${child.get_date('old_values',\n"
"        'date_full')}, mais le ${child.get_date('birthdate', 'date_full')}.\n"
"    </p>\n"
"\n"
"    % if object.send_mode != \"sms\":\n"
"        <p>\n"
"            Votre soutien à un enfant vivant dans l’extrême pauvreté est précieux. A Compassion, nous savons que vous\n"
"            êtes en train de contribuer à offrir à ${'un enfant' if len(child) == 1 else 'des enfants'} une vie digne\n"
"            et qui ait du sens.\n"
"        </p>\n"
"        <p>\n"
"            Avec nos chaleureuses salutations et à bientôt.\n"
"            % if object.send_mode == 'digital':\n"
"                <br>\n"
"                <br>\n"
"                ${object.user_id.signature | safe}\n"
"            % endif\n"
"        </p>\n"
"    % else:\n"
"        <p>Bonne journée et à bientôt !</p>\n"
"        <p>L'équipe de Compassion\n"
"            <br>\n"
"            Tel: +41 (0)24 434 21 24\n"
"            <br>\n"
"            Des questions? Écris-nous sur WhatsApp: +41 (0)79 622 31 97\n"
"        </p>\n"
"    % endif\n"
"% endif\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_multiple_changes
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${child.get_list('old_firstname')}&nbsp;with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   The situation of your sponsored child has changed. We received the following message from the project where ${child.get_list('old_firstname')} is attending.\n"
"   <br>\n"
"   <br>\n"
"   Your support of a child in extreme poverty is valuable. At Compassion we believe that this will give a child the chance to live a purposeful life. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can transform the lives of currently 2 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Your sincerely,  \n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"      ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set partner = object.partner_id\n"
"    % set sms = object.send_mode == \"sms\"\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/fr_CH/im_livechat/support/3\"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation if sms and not plural else partner.salutation},\n"
"</p>\n"
"\n"
"% if not sms:\n"
"    <p>Merci de tout cœur d'investir dans la vie de ${child.get_list('old_firstname')} par le biais du parrainage.</p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Le centre de développement de l'enfant dans lequel est inscrit${child.get('accord_e') or ''} ${child.get_list\n"
"    ('old_firstname')} nous informe que la situation de ${child.get('your sponsored child')} a changé comme suit:\n"
"</p>\n"
"<ul>\n"
"    % for revision in child.mapped('revised_value_ids') + child.mapped('household_id.revised_value_ids'):\n"
"        <li>\n"
"            ${revision.name} : ${revision.old_value} -&gt; ${revision.get_field_value()}\n"
"        </li>\n"
"    <br>\n"
"    % endfor\n"
"</ul>\n"
"\n"
"% if not sms:\n"
"    <p>\n"
"        ${years_uc} ${number_years} ans d'expérience nous permettent d'affirmer qu'un parrainage peut changer non\n"
"        seulement la vie d'un enfant, mais aussi celle de sa famille. Merci de votre engagement à nos côtés.\n"
"        <br>\n"
"        <br>\n"
"        Avec nos chaleureuses salutations et à bientôt.\n"
"\n"
"        % if object.send_mode == 'digital':\n"
"            <br>\n"
"            <br>\n"
"            ${object.user_id.signature | safe}\n"
"        % endif\n"
"    </p>\n"
"% else:\n"
"    <p>Bonne journée et à bientôt!</p>\n"
"    <p>L'équipe de Compassion\n"
"        <br/>Tel: +41 (0)24 434 21 24\n"
"        <br/>Des questions? Tchate avec nous sur MyCompassion: <a href=\"${wp_tchat_url}\">${wp_tchat_url}</a>\n"
"    </p>\n"
"% endif\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_name
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${child.old_firstname}&nbsp;with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   In extreme poverty situations, data may not be collected correctly or the family situation may change.&nbsp; This is the case with your sponsored child.\n"
"   <br>\n"
"   <br>\n"
"   From now on, you can call your sponsored child,\n"
"   <b style=\"font-weight:bolder;\">\n"
"    ${child.preferred_name}\n"
"   </b>\n"
"   in your next letter.\n"
"   <br>\n"
"   <br>\n"
"   Your support of a child in extreme poverty is valuable. At Compassion, we believe this will give a child the opportunity to live a purposeful life. ${object.succes_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can positively transform the lives of currently more than 2 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Your sincerly,   \n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"      ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set partner = object.partner_id\n"
"    % set sms = object.send_mode == \"sms\"\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/fr_CH/im_livechat/support/3\"\n"
"    % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation if sms and not plural else partner.salutation},\n"
"</p>\n"
"\n"
"% if sms:\n"
"    <p>\n"
"        Dans la réalité de l'extrême pauvreté, les données ne sont parfois pas enregistrées correctement. Lorsque ${child.get(\"your sponsored child\") if plural else child.get(\"ton filleul\")} a été admis dans le centre de développement de l’enfant, son nom a été enregistré de manière incorrecte. Désolé!\n"
"    </p>\n"
"    <p>\n"
"        A partir de maintenant, tu peux appeler ${child.get(\"your sponsored child\") if plural else child.get(\"ton filleul\")} ${child.get_list(\"preferred_name\", translate=False)}.\n"
"    </p>\n"
"    <p>\n"
"        Merci pour ton précieux soutien.\n"
"    </p>\n"
"    <p>Bonne journée et à bientôt!</p>\n"
"    <p>\n"
"        ${whatsapp_signature}\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        Merci de tout coeur d'investir dans la vie de ${child.old_firstname} par le biais du parrainage.\n"
"    </p>\n"
"    <p>\n"
"        Il arrive que dans les situations d'extrême pauvreté, les données relatives aux enfants n'aient pas pu être récoltées correctement ou que la situation familiale ait changé. C'est le cas de votre ${'filleul' if child.gender == 'M' else 'filleule'} dont le prénom n'a pas été saisi correctement. Toutes nos excuses.\n"
"    </p>\n"
"    <p>\n"
"        A l'avenir, nous vous prions d'appeler ${child.get('your sponsored child')} ${child.preferred_name}.\n"
"    </p>\n"
"    <p>\n"
"        Votre soutien à un enfant vivant dans l’extrême pauvreté est précieux. A Compassion, nous savons que vous êtes en train d’offrir à ${'un enfant' if len(child) == 1 else 'des enfants'} une vie digne et qui ait du sens. Merci beaucoup.\n"
"    </p>\n"
"    <p>\n"
"        Avec nos chaleureuses salutations et à bientôt.\n"
"        % if object.send_mode == 'digital':\n"
"            <br>\n"
"            <br>\n"
"            ${object.user_id.signature | safe}\n"
"        % endif\n"
"    </p>\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_disability
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of&nbsp;${child.preferred_name}&nbsp;with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   In Switzerand and also in the country where your sponsored child lives, there are health problems despite medical precautions and examinations. We have been informed by the local staff that ${child.preferred_name} has contracted&nbsp;${child.current_values}.\n"
"   <br>\n"
"   <br>\n"
"   Thanks to your support and a special fund for medical emergencies, Compassion is able to look after the health problems of ${child.preferred_name}. Thank you for accompanying ${child.get('him')} in prayer.\n"
"   <br>\n"
"   <br>\n"
"   Your support for a child in extreme poverty is valuable. At Compassion, we believe this will give a child the chance to live a dignified and meaningful life. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can positively transform the lives of over 1.9 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Sincerely,\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"      ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"% if len(object.get_objects()) == 1:\n"
"    <div>\n"
"        % set child = object.get_objects()\n"
"        % set partner = object.partner_id\n"
"        % set sms = object.send_mode == \"sms\"\n"
"        % set plural = partner.title.plural or partner.title.id == 29\n"
"        % set wp_tchat_url = \"https://mycompassion.ch/fr_CH/im_livechat/support/3\"\n"
"    </div>\n"
"    <p>\n"
"        ${partner.informal_salutation if sms and not plural else partner.salutation},\n"
"    </p>\n"
"\n"
"    % if not sms:\n"
"        <p>\n"
"            Merci de tout cœur d'investir dans la vie de ${child.preferred_name or child.firstname} par le biais du\n"
"            parrainage.\n"
"        </p>\n"
"    % endif\n"
"\n"
"    <p>\n"
"        Nous vous contactons malheureusement avec une triste nouvelle : nous avons été informés par le centre de\n"
"        développement de l'enfant que ${child.preferred_name or child.firstname} est atteint de ${child.current_values}.\n"
"    </p>\n"
"    <p>\n"
"        Grâce à ${\"ton\" if sms and not plural else \"votre\"} soutien et à un fond médical spécial, Compassion s'engage\n"
"        à suivre et traiter les problèmes de santé de ${child.preferred_name or child.firstname}. Merci de prier pour\n"
"        sa protection et sa santé.\n"
"    </p>\n"
"\n"
"    % if sms:\n"
"        <p>Bonne journée et à bientôt!</p>\n"
"        <p>L'équipe de Compassion\n"
"            <br>\n"
"            Tel: +41 (0)24 434 21 24\n"
"            <br>\n"
"            Des questions? Écris-nous sur WhatsApp: +41 (0)79 622 31 97\n"
"        </p>\n"
"    % else:\n"
"        <p>\n"
"            Votre soutien à un enfant vivant dans l’extrême pauvreté est précieux. A Compassion, nous savons que vous\n"
"            êtes en train de contribuer à offrir à ${'un enfant' if len(child) == 1 else 'des enfants'} une vie\n"
"            digne et qui ait du sens. Merci !\n"
"        </p>\n"
"        <p>\n"
"            % if object.send_mode == 'digital':\n"
"                Avec nos chaleureuses salutations et à bientôt.\n"
"                <br>\n"
"                <br>\n"
"                ${object.user_id.signature | safe}\n"
"            % endif\n"
"        </p>\n"
"    % endif\n"
"% endif\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_sponsorship_cancellation
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set partner = object.partner_id\n"
"                    \n"
"% set sponsorships = object.get_objects()\n"
"                    \n"
"% set children = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = children.get_list('preferred_name', 3, 'many children', False)\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   We took note of the cancellation of your sponsorship toward ${firstname}.\n"
"   <br>\n"
"   <br>\n"
"   Thank you so much for having sponsored ${children.get('this child')}!                    Thanks to your sponsorship, ${children.get('he')} could participate in all the activities offered by the Compassion child project:                    food, clothes, academic support, health screenings and treatments, Bible studies, games, field trips, birthday and Christmas gifts and a lot more.\n"
"   <br>\n"
"   <br>\n"
"   We will now look for a new sponsor to continue the follow up with ${firstname}.\n"
"   <br>\n"
"   <br>\n"
"   With our best regards,\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, 'vos filleuls', False)\n"
"    % set nb_weeks = sum(sponsorships.mapped('contract_duration')) // 7\n"
"    % set nb_years = (sum(sponsorships.mapped('contract_duration')) // 364) or 1\n"
"    % set field = child.mapped('field_office_id')\n"
"    % set hours_fcp = sum(field.mapped('fcp_hours_week')) * nb_weeks\n"
"    % set meals = sum(field.mapped('fcp_meal_week')) * nb_weeks\n"
"    % set medical = sum(field.mapped('fcp_medical_check')) * nb_years\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"    <br>\n"
"    <br>\n"
"\n"
"    % if 7 in sponsorships.mapped(\"end_reason_id\").ids or 9 in sponsorships.mapped(\"end_reason_id\").ids:\n"
"        Vous avez choisi de parrainer ${firstname} pour lui permettre d'être libéré${child.get('accord_e') or ''} de l'extrême pauvreté. Cet engagement n'a pas été confirmé par le paiement du soutien promis.\n"
"        <br>\n"
"        <br>\n"
"        C'est pourquoi, nous vous informons que ce parrainage est aujourd'hui annulé.\n"
"    % else:\n"
"        Nous confirmons par la présente la fin du parrainage de ${firstname}.\n"
"        <br>\n"
"        <br>\n"
"        Durant votre parrainage, ${child.get('he')} ${child.get('has')} passé ${\"{:,}\".format(hours_fcp).replace(\",\",\"'\")} heures au\n"
"    centre de développement de l'enfant de l'Eglise locale. Les collaborateurs de celui-ci se sont occupés\n"
"\n"
"        % if len(child) == 1:\n"
"            ${\"d'elle\" if child.gender == \"F\" else \"de lui\"}\n"
"        % else:\n"
"            ${\"d'eux\" if \"M\" in child.mapped('gender') else \"d'elles\"}\n"
"        % endif\n"
"\n"
"        avec amour et ${child.get('lui_leur')} ont transmis l'espérance pour ${child.get('son')} avenir. ${\"{:,}\".format(meals).replace(\",\",\"'\")} repas ${child.get('lui_leur')} ont été servis. ${child.get('he').title()} ${child.get('has')} en outre bénéficié de ${\"{:,}\".format(medical).replace(\",\",\"'\")} examens médicaux.\n"
"\n"
"        % if child[:1].age >= 7:\n"
"            ${child.get('he').title()} ${child.get('has')} pu aller à l'école, être encouragé${child.get('accord_e') or ''} à développer ${child.get('ses')} talents.\n"
"        % endif\n"
"\n"
"        Enfin, ${child.get('he')}  ${child.get('has')} découvert qu'une personne à l'autre bout du monde se préoccupait\n"
"\n"
"        % if len(child) == 1:\n"
"            ${\"d'elle\" if child[:1].gender == \"F\" else \"de lui\"}.\n"
"        % else:\n"
"            d'${'eux' if \"M\" in child.mapped('gender') else 'elles'}.\n"
"        % endif\n"
"\n"
"        Un immense merci !\n"
"    % endif\n"
"    <br>\n"
"    <br>\n"
"    Compassion Suisse va chercher un parrain pour que ${firstname} puisse${'' if len(child) == 1 else 'nt'} bénéficier du soutien et des activités mises en place pour ${child.get('lui_leur')} assurer une vie digne et qui ait du sens.\n"
"    <br>\n"
"    <br>\n"
"<!-- CSP -->\n"
"    Le parrainage d’enfants est un des programmes de Compassion. Saviez-vous qu'il est possible d’apporter un soutien aux femmes enceintes et aux mamans d'un nouveau né démunies? Avec un don ponctuel ou régulier, vous pouvez faire une grande différence: des soins médicaux pendant la grossesse, l'accouchement dans une structure médicale, des formations à la parentalité, un soutien psychologique, social et spirituel, une aide matérielle ainsi qu'une formation pour générer des revenus.\n"
"</p>\n"
"<p>\n"
"    Avec CHF 15.-, vous pouvez soutenir une femme et son bébé pendant une semaine entière. N'hésitez pas à prendre contact avec nous ou à faire un don <a href=\"https://compassion.ch/survie?${object.partner_id.wordpress_form_data}\">ici</a> pour continuer à faire une différence dans la lutte contre l’extrême pauvreté.\n"
"</p>\n"
"<!-- WASH -->\n"
"<!--\n"
"<p>\n"
"    Le parrainage d’enfants n'est qu'un des nombreux programmes de Compassion pour libérer chaque jour plus d’enfants de l’extrême pauvreté. Saviez-vous que près de 4 personnes sur 10 dans le monde n'ont pas un accès quotidien à des toilettes sûres ? En raison de l'eau contaminée et du manque de toilettes, les enfants tombent souvent malades et ne peuvent pas aller à l'école. Compassion construit et rénove des toilettes, accompagne les enfants et les familles avec une formation à l'hygiène afin de protéger leur santé et favoriser leur développement.\n"
"</p>\n"
"<p>\n"
"    Avec un don unique ou régulier de CHF 30.-, vous offrez à un enfant l'accès à des toilettes sûres et faites une différence significative dans sa vie. N'hésitez pas à prendre contact avec nous ou à verser un don <a href=\"https://compassion.ch/donations/\">ici</a>.\n"
"</p>\n"
"-->\n"
"<p>\n"
"    Nous nous réjouirions de vous avoir à nos côtés à l'avenir dans la lutte contre l'extrême pauvreté.\n"
"</p>\n"
"<p>\n"
"    Avec nos chaleureuses salutations.\n"
"</p>\n"
"% if object.send_mode == 'digital':\n"
"    ${object.user_id.signature | safe}\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.b2s_email_not_read
msgid ""
"<div>\n"
"\n"
"    % set letter = object.get_objects()\n"
"    % set child = letter.mapped('child_id')\n"
"    % set s = '' if len(child) == 1 else 's'\n"
"    % set partner = object.partner_id\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set firstname = child.get_list('preferred_name', 3, 'your sponsored children', False)\n"
"    % set email = partner.email\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    A few days ago, you should have received a letter by email from ${firstname}.</p>\n"
"<p>\n"
"    Unfortunately, it does not seem to have been delivered to the email address ${email}.\n"
"</p>\n"
"<p>\n"
"    That is why we are sending you the letter by post. We hope you enjoy it!\n"
"</p>\n"
"<p>\n"
"    Has your email changed? Or maybe the email landed in your spam folder?\n"
"</p>\n"
"<p>\n"
"    Please let us know if you have a new email address or kindly add info@compassion.ch to your contacts to ensure that the email does not land in the spam folder.\n"
"</p>\n"
"<p>\n"
"    ${years_uc} ${number_years} years of experience has shown us that letters have a decisive influence on the children’s development.\n"
"</p>\n"
"<p>\n"
"    Thank you for taking a few minutes of your time to respond to the letter online in your <a href='https://mycompassion.ch'>MyCompassion profile</a>.\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
"% endif"
msgstr ""
"<div>\n"
"   % set letter = object.get_objects()\n"
"   \n"
"% set votreLettre = 'votre lettre' if len(letter) == 1 else 'vos lettres'\n"
"  \n"
"% set partner = object.partner_id\n"
"\n"
"% set child = letter.mapped('child_id')\n"
"% set christmas_fund_2022 = 265 in partner.category_id.ids\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   </p>\n"
"  <p>\n"
"   Il y a quelques jours, Compassion Suisse vous a adressé une lettre de ${child.get('your sponsored child')} ${child.get_list('preferred_name', 3)}.\n"
"   </p>\n"
"  <p>\n"
"   Il semble que ce mail ne soit pas arrivé jusqu'à vous. C'est pourquoi, nous vous envoyons la lettre de ${child.get_list('preferred_name', 1, child.get('your sponsored child'))} aussi par courrier. Nous vous souhaitons beaucoup de plaisir à la lecture des nouvelles de ${child.get('your sponsored child')}.\n"
"   </p>\n"
"  <p>\n"
"   Avez-vous changé d'adresse mail ou notre envoi a-t-il atterri dans les spams? Merci de nous communiquer votre nouvelle adresse mail si c'est le cas: info@compassion.ch .\n"
"   </p>\n"
"  <p>\n"
"   ${years_uc} ${number_years} ans d'expérience confirment que ces lettres contribuent de façon déterminante au développement de l'enfant.\n"
"  </p>\n"
"  <p>\n"
"   D'avance, merci de prendre quelques minutes pour répondre au courrier ci-joint. Vous pouvez écrire rapidement et facilement à ${child.get('your sponsored child')} sur https://mycompassion.ch ou depuis notre application mobile. Les deux plate-formes vous permettent d'avoir toujours à portée de main les photos, les lettres et les informations de ${child.get('your sponsored child')}.\n"
"  </p>\n"
"  <p>\n"
"   Recevez nos chaleureuses salutations.\n"
"  </p>\n"
"  <p>\n"
"   ${object.user_id.short_signature | striptags}\n"
"  </p>\n"
" "

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_caregiver_change
msgid ""
"<div>\n"
"                    % set child = object.get_objects()\n"
"                    % set caregiver = child.household_id.primary_caregiver\n"
"                </div>\n"
"                <p>\n"
"                    ${object.partner_id.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    We learned that the primary caregiver of ${child.firstname} is now ${child.get('his')}\n"
"                    % if 'Beneficiary' not in caregiver:\n"
"                        ${caregiver}\n"
"                    % else:\n"
"                        ${'sister' if 'Female' in caregiver else 'brother'}\n"
"                    % endif\n"
"                    .\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_project_reactivation
msgid ""
"<div>\n"
"                    % set child = object.get_objects()\n"
"                    % set project = child.mapped('project_id')[0]\n"
"                    % set reactivation = project.lifecycle_ids[0]\n"
"                    % set details = reactivation.icp_improvement_desc\n"
"                </div>\n"
"                <p>\n"
"                    ${object.partner_id.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    A few time ago the project ${project.icp_id} where ${child.get('your sponsored child')} ${child.get('is')} registered was on suspension.\n"
"                    We are happy to inform you that the problem is resolved and that the project is again sane and active.\n"
"                    The project will do regular tuitions and spiritual activites to keep the situation healthy.\n"
"                    <br>\n"
"                    <br>\n"
"                    % if details:\n"
"                        ${details}\n"
"                        <br>\n"
"                        <br>\n"
"                    % endif\n"
"                    Yours sincerely\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_project_transition
msgid ""
"<div>\n"
"                    % set child = object.get_objects()\n"
"                    % set project = child.mapped('project_id')[0]\n"
"                    % set transition = project.lifecycle_ids[0]\n"
"                    % set details = transition.details\n"
"                </div>\n"
"                <p>\n"
"                    ${object.partner_id.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    A few time ago the project ${project.icp_id} where ${child.get('your sponsored child')} ${child.get('is')} registered was on suspension.\n"
"                    <br>\n"
"                    <br>\n"
"                    Unfortunately the local church will definitely end its partnership with Compassion\n"
"                    % if transition.transition_date:\n"
"                        <!-- --> on ${transition.get_date('transition date', 'date_full')}\n"
"                    % endif\n"
"                    % if transition.transition_reason_ids:\n"
"                        <!-- --> because of ${transition.get_list('transition_reason_ids.value')}\n"
"                    % endif\n"
"                    .\n"
"                    % if transition.future_involvement_ids:\n"
"                        The project will continue to work and offer ${transition.get_list('future_involvement_ids.value')} in its area.\n"
"                    % endif\n"
"                    <br>\n"
"                    <br>\n"
"                    % if details:\n"
"                        <span style=\"font-style: italic;\">${details}</span>\n"
"                        <br>\n"
"                        <br>\n"
"                    % endif\n"
"                    % if transition.action_plan:\n"
"                        <span style=\"font-style: italic;\">${transition.action_plan}</span>\n"
"                        <br>\n"
"                        <br>\n"
"                    % endif\n"
"                    The children living close to another project will be transfered.\n"
"                    <br>\n"
"                    <br>\n"
"                    We feel sorry for this situation and hope you will understand. You will receive soon another letter that will give you more details about ${child.get('your sponsored child')}. Thank you so much for the support.\n"
"                    <br>\n"
"                    <br>\n"
"                    Please don't hesitate to contact us in case you have any questions regarding the situation.\n"
"                    <br>\n"
"                    <br>\n"
"                    Yours sincerely\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_transition
msgid ""
"<div>\n"
"                    % set child = object.get_objects()\n"
"                </div>\n"
"                <p>\n"
"                    Dear sponsor,\n"
"                    <br>\n"
"                    <br>\n"
"                    We warmly thank you for your precious sponsorship of ${child.get_list('preferred_name')}.\n"
"                    <br>\n"
"                    <br>\n"
"                    Your sponsored child is starting now the ${child.get_list('cdsp_type')} sponsorship program.\n"
"                    <br>\n"
"                    <br>\n"
"                    We encourage you to send a letter to your child to encourage him participating to the program.\n"
"                    <br>\n"
"                    <br>\n"
"                    Yours sincerely\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_hold_removal
msgid ""
"<div>\n"
"                    % set hold = object.get_objects()\n"
"                    % set owner = object.partner_id.firstname\n"
"                    % set child_code = hold.mapped('child_id').get_list('local_id')\n"
"                    % set child_name = hold.mapped('child_id').get_list('name')\n"
"                </div>\n"
"                <p>\n"
"                    Dear ${owner},\n"
"                    <br>\n"
"                    <br>\n"
"                    We just learned that the child ${child_name} with ref. ${child_code} is no longer available for sponsorship.\n"
"                    The following comments were received :\n"
"                    % for h in hold:\n"
"                        <br>\n"
"                        ${h.comments}\n"
"                        <br>\n"
"                    % endfor\n"
"                    <br>\n"
"                    <br>\n"
"                    If you have the childpack, please don't use it.\n"
"                    <br>\n"
"                    <br>\n"
"                    Yours sincerely\n"
"                </p>\n"
"            "
msgstr ""
"<div>\n"
"    % set hold = object.get_objects()\n"
"    % set owner = object.partner_id\n"
"    % set child_code = hold.mapped('child_id').get_list('local_id')\n"
"    % set child_name = hold.mapped('child_id').get_list('name')\n"
"</div>\n"
"<p style='margin:0px 0px 9px 0px;font-size:13px;font-family:\"Lucida Grande\", Helvetica, Verdana, Arial, sans-serif;'>\n"
"    ${owner.salutation},<br>\n"
"    <br>\n"
"    Nous venons d'apprendre que l'enfant ${child_name} avec la référence ${child_code} n'est plus disponible pour le parrainage.\n"
"    Les commentaires suivants ont été reçus des Etats-Unis (en anglais) :\n"
"                    % for h in hold:\n"
"                        <br>\n"
"                        ${h.comments}\n"
"                        <br>\n"
"                    % endfor\n"
"    <br>\n"
"    <br>\n"
"    Si vous avez encore le dossier de cet enfant, merci de ne plus l'utiliser et de le jeter.</p>"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_transfer
msgid ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set preferred_name = child.get_list('preferred_name', translate=False)\n"
"    % set fcp = child.mapped('project_id')\n"
"    % set lifecycle = child.mapped('lifecycle_ids')[:1]\n"
"    % set one = len(child) == 1\n"
"    % set partner = object.partner_id\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"   Thank you for investing in the life of ${preferred_name} with a sponsorship.\n"
"</p>\n"
"<p>\n"
"    We have received a message that your sponsored child has moved to a new Child Development Centre.\n"
"</p>\n"
"<p>\n"
"    Therefore, ${child.get('he')} has been issued a new reference number, ${child.local_id}, which you will need for future letter correspondences via post.\n"
"</p>\n"
"    % if partner.email:\n"
"    \t<p>You can write via your <a href='https://www.mycompassion.ch'>MyCompassion</a> profile.</p>\n"
"    \t<p>Do you need inspiration? <a href=\"https://compassion.ch/de/was-soll-ich-meinem-patenkind-schreiben/\">5 ideas to write your letter</a></p>\n"
"    % elif object.send_mode == \"physical\":\n"
"    \t<p>Enclosed, you will find a new sheet of labels for your letters that you send via post.</p>\n"
"    \t<p>You can also write via your <a href='https://www.mycompassion.ch'>MyCompassion</a> profile.</p>\n"
"    \t<p>Do you need inspiration? <a href=\"https://compassion.ch/de/was-soll-ich-meinem-patenkind-schreiben/\">5 ideas to write your letter</a></p>\n"
"    % endif\n"
"<p>\n"
"    We wish you much joy whilst writing!\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"% if object.send_mode != \"physical\":\n"
"\t<p>${object.user_id.signature | safe}</p>\n"
"% endif\n"
msgstr ""
"<!--\n"
"${object.get_objects().get('your sponsored child').title()} ${object.get_objects().get('has')} changé de centre d'accueil\n"
"-->\n"
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set preferred_name = child.get_list('preferred_name', translate=False)\n"
"    % set fcp = child.mapped('project_id')\n"
"    % set lifecycle = child.mapped('lifecycle_ids')[:1]\n"
"    % set one = len(child) == 1\n"
"    % set partner = object.partner_id\n"
"</div>\n"
"\n"
"${object.partner_id.salutation},\n"
"<br><br>\n"
"Merci de tout cœur d'investir dans la vie de ${preferred_name} par le parrainage. Vous êtes en train de transformer durablement ${child.get('sa')} vie.\n"
"<br><br>\n"
"<!-- Nous avons reçu la nouvelle que ${child.get('your sponsored child')} ${child.get('has')} changé${child.get('accord_e') or ''} de centre d'accueil, -->\n"
"Nous avons reçu la nouvelle que ${child.get('your sponsored child')} ${child.get('has')} changé de centre d'accueil,\n"
"\n"
"% if one:\n"
"    et que sa référence s'est modifiée comme suit :\n"
"    <b style=\"font-weight:bold;\">\n"
"       ${child.local_id}.\n"
"    </b>\n"
"% else:\n"
"    et que leurs références sont modifiées comme suit :\n"
"    <ul>\n"
"        % for the_child in child:\n"
"            <li>\n"
"                ${the_child.preferred_name} : ${the_child.local_id}\n"
"            </li>\n"
"        % endfor\n"
"    </ul>\n"
"% endif\n"
"Merci d'utiliser désormais cette référence lorsque vous lui écrivez une lettre.\n"
"<br><br>\n"
"\n"
"% if not partner.email and object.send_mode == \"physical\":\n"
"    Vous trouverez ci-joint une série d'étiquettes à coller sur les lettres que vous envoyez à ${child.get('filleul')}.\n"
"    <br><br>\n"
"    Vous pouvez aussi écrire en ligne (www.mycompassion.ch).\n"
"    <br><br>\n"
"    Si vous avez besoin d'inspiration pour écrire une lettre, vous trouverez quelques idées ici: www.compassion.ch/que-dois-je-ecrire-a-mon-filleul.\n"
"% else:\n"
"    Vous pouvez aussi\n"
"    <a href=\"https://mycompassion.ch/fr_CH/my/letter\">\n"
"        écrire en ligne.\n"
"    </a>\n"
"    <br><br>\n"
"    Si vous avez besoin d'inspiration pour écrire une lettre, vous trouverez\n"
"    <a href=\"https://compassion.ch/que-dois-je-ecrire-a-mon-filleul\">\n"
"        quelques idées ici.\n"
"    </a>\n"
"% endif\n"
"<br><br>\n"
"Nous vous souhaitons du plaisir à écrire vos lettres.\n"
"<br><br>\n"
"Avec nos chaleureuses salutations,\n"
"\n"
"% if object.send_mode != \"physical\":\n"
"    <br><br>\n"
"    ${object.user_id.signature | safe}\n"
"% endif\n"
" "

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_project_suspension
msgid ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set project = child.mapped('project_id')[0]\n"
"    % set suspension = project.lifecycle_ids[0]\n"
"    % set reasons = suspension.suspension_reason_ids\n"
"    % set details = suspension.suspension_detail\n"
"    % set partner = object.partner_id\n"
"    % set firstname = child.get_list('preferred_name', 3, deine_patenkinder, translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.get_snippet('number_mothers') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"</p>\n"
"<p>\n"
"    Thank you for investing in the ${'lives' if len(child) > 1 else 'life'} of ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Compassion works with ${number_fcps} partner churches in ${number_countries} countries, which work according to international quality standards and are regularly inspected.\n"
"</p>\n"
"<p>\n"
"    Today we would like to inform you that the child development center that ${firstname} attends is currently suspended because quality standards are not met. Various investigations are underway. Compassion staff are offering the partner church support and training to resolve the issues.\n"
"</p>\n"
"<p>\n"
"    Specifically, this means that your donations / part of your donations for ${firstname} will be withheld until the child development center can fully resume all activities.\n"
"</p>\n"
"<p>\n"
"    % if suspension.hold_gifts and suspension.hold_s2b_letters:\n"
"        Unfortunately, neither gifts nor letters can be sent.\n"
"    % elif suspension.hold_gifts and not suspension.hold_s2b_letters:\n"
"        We are pleased that gifts and letters can still be sent.\n"
"    % elif not suspension.hold_gifts and suspension.hold_s2b_letters:\n"
"        We are pleased that letters can still be sent. However, it is currently not possible to send gifts.\n"
"    % else:\n"
"        We are pleased that gifts can still be sent. However, it is not possible to forward letters at the moment.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    We will inform you about the further process and any need for action over the next two months.\n"
"</p>    \n"
"<p>\n"
"    If you have any further questions or concerns, please do not hesitate to contact us.\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.short_signature | safe}\n"
"</p>\n"
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set project = child.mapped('project_id')[0]\n"
"    % set suspension = project.lifecycle_ids[0]\n"
"    % set reasons = suspension.suspension_reason_ids\n"
"    % set details = suspension.suspension_detail\n"
"    % set partner = object.partner_id\n"
"    % set firstname = child.get_list('preferred_name', 3, deine_patenkinder, translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.get_snippet('number_mothers') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    Un grand merci d'être avec nous et d'investir dans la vie de ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Compassion collabore avec ${number_fcps} églises partenaires dans ${number_countries} pays, qui travaillent selon des normes de qualité internationales et sont régulièrement contrôlées.\n"
"</p>\n"
"<p>\n"
"    Aujourd'hui, nous souhaitons vous informer que le centre de développement que ${firstname} fréquente est actuellement suspendu. Différentes enquêtes sont en cours, car le centre ne remplit pas les standards de qualité du programme. Compassion offre à l'église partenaire des formations et du soutien pour améliorer la situation et reprendre les activités comme à l'accoutumée.\n"
"</p>\n"
"<p>\n"
"    % if suspension.hold_gifts and suspension.hold_s2b_letters:\n"
"        Malheureusement, ni les cadeaux ni les lettres ne peuvent être transmis.\n"
"    % elif suspension.hold_gifts and not suspension.hold_s2b_letters:\n"
"        Nous sommes heureux que les cadeaux et les lettres puissent continuer à être envoyés.\n"
"    % elif not suspension.hold_gifts and suspension.hold_s2b_letters:\n"
"        Nous sommes heureux que les lettres puissent continuer à être envoyées. Cependant, il n'est pas possible de faire des cadeaux pour le moment.\n"
"    % else:\n"
"        Nous sommes heureux que les cadeaux puissent continuer à être envoyés. Cependant, il n'est pas possible de transmettre des lettres pour le moment.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Nous vous informerons au cours des deux prochains mois de la suite du processus et des éventuelles mesures à prendre.\n"
"</p>\n"
"<p>\n"
"    N’hésitez pas à nous contacter pour toute question complémentaire.\n"
"</p>\n"
"<p>\n"
"    Meilleures salutations\n"
"<br>\n"
"    ${object.user_id.short_signature | safe}\n"
"</p>\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_disaster_alert
msgid ""
"<div>\n"
"    % set children = object.get_objects().mapped('child_id')\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set firstname = children.get_list('preferred_name', 3, 'your sponsored children', False)\n"
"    % set Firstname = children.get_list('preferred_name', 3, 'Your sponsored children', False)\n"
"    % set firstname_n = children.get_list('preferred_name', 3, 'your sponsored children', False)\n"
"    % set Firstname_n = children.get_list('preferred_name', 3, 'Your sponsored children', False)\n"
"    % set disaster = children.mapped('child_disaster_impact_ids.disaster_id')[:1].with_context(lang='en_US')\n"
"    % set healthy = children.mapped('child_disaster_impact_ids')[:1].beneficiary_physical_condition == 'Beneficiary Healthy'\n"
"    % set house_damaged = children.mapped('child_disaster_impact_ids')[:1].house_condition != 'Not Damaged'\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"    % set sms = object.send_mode == \"sms\"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you for investing in the life of ${firstname}.\n"
"</p>\n"
"<p>\n"
"    We have been informed that a natural disaster has struck the region where ${firstname} lives.\n"
"</p>\n"
"<p>\n"
"% if healthy:\n"
"    Luckily, ${firstname} is well.\n"
"% else:\n"
"    Unfortunately, ${firstname} has been hurt.\n"
"% endif\n"
"\n"
"${children.get('his').title()}\n"
"\n"
"% if house_damaged:\n"
"    house is damaged and ${children.get('he')} has lost all ${children.get('his')} household items, clothes and school supplies.\n"
"% else:\n"
"    house was not damaged.\n"
"% endif\n"
"\n"
"</p>\n"
"<p>\n"
"    You may want to write some lines to comfort ${firstname}.\n"
"</p>\n"
"<p>\n"
"    This can easily be done via your <a href='https://www.mycompassion.ch'>MyCompassion</a> profile.\n"
"</p>\n"
"\n"
"<p>\n"
"    You can also make a donation to ${firstname} and ${children.get('his')} family in these difficult circumstances using the attached payment slip.\n"
"</p>\n"
"<p>\n"
"    Especially in exceptional situations such as this one, your support makes a big difference. Thank you!\n"
"</p>\n"
"<p>\n"
"    Kind regards\n"
"</p>\n"
"% if object.send_mode != \"physical\":\n"
"\t<p>${object.user_id.signature | safe}</p>\n"
"% endif\n"
"\n"
"\n"
"<h3>\n"
"    Internal notes to remove (for giving more info if needed)\n"
"</h3>\n"
"<br>\n"
"<b>\n"
"    ${disaster.name}\n"
"</b>\n"
"<ul>\n"
"    <li>\n"
"        Happened : ${disaster.disaster_date}\n"
"    </li>\n"
"    <li>\n"
"        Type : ${disaster.disaster_type}\n"
"    </li>\n"
"    <li>\n"
"        (internal usage :\n"
"        <a href=\"${disaster.access_link}\" target=\"blank\">\n"
"            details\n"
"        </a>\n"
"        )\n"
"    </li>\n"
"</ul>\n"
"<p>\n"
"    % if disaster.fcp_disaster_impact_ids:\n"
"        <b>\n"
"            Impacts on the project :\n"
"        </b>\n"
"        </p>\n"
"        % for fcp_impact in disaster.fcp_disaster_impact_ids:\n"
"% if fcp_impact.project_fcp_id in children.mapped(\"project_id.fcp_id\"):\n"
"        <ul>\n"
"            <li>\n"
"                Description : ${fcp_impact.disaster_impact_description}\n"
"            </li>\n"
"            <li>\n"
"                Impact on the project activities : ${fcp_impact.impact_on_fcp_program}\n"
"            </li>\n"
"            <li>\n"
"                Infrastructure: ${fcp_impact.infrastructure}\n"
"            </li>\n"
"        </ul>\n"
"   % endif\n"
"        % endfor \n"
"      <p>\n"
"    % endif\n"
"    <br>\n"
"    % for child in children:\n"
"        % set impact = child.child_disaster_impact_ids[:1]\n"
"        <b>\n"
"            ${child.name} - [${child.local_id}]\n"
"        </b>\n"
"        </p>\n"
"        <ul>\n"
"            <li>\n"
"                Physical condition : ${impact.beneficiary_physical_condition}\n"
"                % if impact.beneficiary_physical_condition_description:\n"
"                <br>\n"
"                ${impact.beneficiary_physical_condition_description}\n"
"                % endif\n"
"            </li>\n"
"            % if impact.house_condition:\n"
"            <li>\n"
"                House condition : ${impact.house_condition}\n"
"            </li>\n"
"            % endif\n"
"        \n"
"            % if impact.siblings_died_number:\n"
"            <li>\n"
"                Siblings died: ${impact.siblings_died_number}\n"
"            </li>\n"
"            % endif\n"
"        \n"
"            % if impact.siblings_seriously_injured_number:\n"
"            <li>\n"
"                Siblings seriously injured: ${impact.siblings_seriously_injured_number}\n"
"            </li>\n"
"            % endif\n"
"        \n"
"            % if impact.caregivers_died_number:\n"
"            <li>\n"
"                Caregivers died: ${impact.caregivers_died_number}\n"
"            </li>\n"
"            % endif\n"
"        \n"
"            % if impact.caregivers_seriously_injured_number:\n"
"            <li>\n"
"                Caregivers seriously injured: ${impact.caregivers_seriously_injured_number}\n"
"            </li>\n"
"            % endif\n"
"        \n"
"            % if impact.loss_ids:\n"
"            <li>\n"
"                Personal effects destroyed or lost:\n"
"                <ul>\n"
"                    % for loss in impact.loss_ids:\n"
"                    <li>\n"
"                        ${loss.name}\n"
"                    </li>\n"
"                    % endfor\n"
"                </ul>\n"
"            </li>\n"
"            % endif\n"
"        </ul>\n"
"    % endfor\n"
"\n"
msgstr ""
"<!--\n"
"Information importante concernant ${object.get_objects().mapped('child_id').get('your sponsored child')} ${object.get_objects().mapped('child_id').get_list('preferred_name', 1) if len(object.get_objects().mapped('child_id')) == 1 else ''}\n"
"-->\n"
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set children = object.get_objects().mapped('child_id')\n"
"    % set disaster = children.mapped('child_disaster_impact_ids.disaster_id')[:1].with_context(lang='en_US')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set Firstname = firstname[0].upper() + firstname[1:]\n"
"    % set healthy = children.mapped('child_disaster_impact_ids')[:1].beneficiary_physical_condition == 'Beneficiary Healthy'\n"
"    % set house_damaged = children.mapped('child_disaster_impact_ids')[:1].house_condition != 'Not Damaged'\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/fr_CH/im_livechat/support/3\"\n"
"    % set sms = object.send_mode == \"sms\"\n"
"\n"
"    % if len(children) == 1:\n"
"        % if children.gender == 'M':\n"
"            % set quil = \"qu'il\"\n"
"        % else:\n"
"            % set quil = \"qu'elle\"\n"
"        % endif\n"
"    % else:\n"
"        % set quil = \"qu'elles\"\n"
"    % endif\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Merci de tout cœur d'investir dans la vie de ${firstname} par le biais du parrainage.\n"
"</p>\n"
"% if not sms:\n"
"    <p>\n"
"        Par la présente, nous vous informons qu'une catastrophe naturelle s'est abattue sur la région où  ${'vit' if len(children)==1 else 'vivent'} ${children.get('your sponsored child')}.\n"
"    </p>\n"
"\n"
"    % if healthy:\n"
"        <p>${Firstname} ${children.get('is')} en bonne santé,\n"
"    % else:\n"
"        <p>${Firstname} ${children.get('is')} blessé${children.get('accord_e') or ''},\n"
"    % endif\n"
"\n"
"    % if house_damaged:\n"
"        ${'mais' if healthy else ''} ${children.get('sa')}${children.get('accord_s') or ''} maison${children.get('accord_s') or ''} ${children.get('has')} été détruite${children.get('accord_s') or ''} et ${children.get('he')} ${children.get('has')} perdu tous ses articles ménagers, ses vêtements et ses fournitures scolaires.</p>\n"
"    % else:\n"
"        ${'mais' if not healthy else 'et'} ${children.get('sa')} maison est intacte.</p>\n"
"    % endif\n"
"\n"
"    <p>\n"
"        Souhaitez-vous lui écrire une lettre de réconfort ? Vous pouvez le faire directement sur le site de <a href=\"https://mycompassion.ch/fr_CH/my/letter\">Compassion</a>*.\n"
"    </p>\n"
"    <p>\n"
"        Vous pouvez par ailleurs lui adresser un soutien particulier dans ce temps d'épreuve en faisant un don à sa famille directement <a href=\"https://compassion.ch/offrir?${partner.with_context(mailchimp_child=child).wordpress_form_data}\"></a>en ligne</a> ou par le biais du bulletin ci-joint.\n"
"    </p>\n"
"    <p>\n"
"        Dans la situation particulièrement difficile ${quil} ${'traverse' if len(children) == 1 else 'traversent'}, votre soutien est particulièrement précieux.\n"
"    </p>\n"
"    <p>\n"
"        Encore une fois, merci de votre engagement à nos côtés, qui nous permet de changer actuellement la vie de plus de ${number_children} millions d’enfants dans ${number_countries} pays.\n"
"    </p>\n"
"    <p>\n"
"        Recevez nos chaleureuses salutations et à bientôt.\n"
"    </p>\n"
"\n"
"    % if object.send_mode == 'digital':\n"
"        <p>${object.user_id.signature | safe}</p>\n"
"    % endif\n"
"% else:\n"
"    <p>${partner.informal_salutation},</p>\n"
"    <p>Nous avons appris qu'une catastrophe naturelle s'est abattue sur la région où vit ton ${children.get('filleul')}.\n"
"    % if healthy:\n"
"        <p>${Firstname} ${children.get('is')} en bonne santé,\n"
"    % else:\n"
"        <p>${Firstname} ${children.get('is')} blessé${children.get('accord_e') or ''},\n"
"    % endif\n"
"    % if house_damaged:\n"
"        ${'mais' if healthy else ''} ${children.get('sa')}${children.get('accord_s') or ''} maison${children.get('accord_s') or ''} ${children.get('has')} été détruite${children.get('accord_s') or ''} et ${children.get('he')} ${children.get('has')} perdu tous ses articles ménagers, ses vêtements et ses fournitures scolaires</p>\n"
"    % else:\n"
"        ${'mais' if not healthy else 'et'} ${children.get('sa')} maison est intacte.</p>\n"
"    % endif\n"
"    <p>Tu aimerais écrire quelques lignes pour ${children.get('le')} réconforter ? </p>\n"
"    <p>Tu peux écrire dans MyCompassion.</p>\n"
"    <p>Merci de prier pour ${firstname} dans cette situation difficile. </p>\n"
"    <p>Bonne journée et à bientôt!</p>\n"
"    <p>L'équipe de Compassion<br>\n"
"Tel: +41 (0)24 434 21 24<br>\n"
"Des questions? Écris-nous sur WhatsApp: +41 (0)79 622 31 97</p>\n"
"% endif\n"
"\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.mail_onboarding_first_letter
msgid ""
"<div>\n"
"    % set letter = object.get_objects()\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set child = letter.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set less_4 = len(child) < 4\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set deinem_patenkind = child.get_list('preferred_name', 3, 'your sponsored children', translate=False)\n"
"    % set apos = \"'\" if firstname[-1] == 's' else \"'s\"\n"
"    % set urls = []\n"
"    % set special = \"BD\" in child.get_list(\"local_id\") or \"LK\" in child.get_list(\"local_id\")\n"
"\n"
"    % for letter_set in letter.filtered('read_url').mapped('read_url'):\n"
"        % if letter_set not in urls:\n"
"            % set void = urls.append(letter_set)\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % if len(urls) == 0:\n"
"        % set void = urls.append('https://mycompassion.ch/my/children?child_id=' + str(letter.child_id.id))\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"\n"
"<p>We are excited to send you ${firstname + apos} first letter today.</p>\n"
"\n"
"% if object.send_mode != \"physical\":\n"
"    % if len(letter) == 1:\n"
"        <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"            <a href=\"${urls[0]}\"\n"
"               style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\"\n"
"               title=\"\">\n"
"                Download letter\n"
"            </a>\n"
"        </div>\n"
"    % else:\n"
"        <p>You can download the letters here:</p>\n"
"        <ul>\n"
"            % for the_url in urls:\n"
"            <li><a href=\"${the_url}\">Letter from ${letter[loop.index0].child_id.preferred_name}</a></li>\n"
"            % endfor\n"
"        </ul>\n"
"    % endif\n"
"% endif\n"
"\n"
"<p>It's important to know that the sponsored children live in a culture where communication is predominantly verbal. Writing letters and responding to specific questions is, therefore, a long learning process. It's so nice that you're accompanying ${firstname} in that!</p>\n"
"\n"
"<p>The first letter was written before the sponsorship began, and every letter travels a long way:</p>\n"
"\n"
"% if object.send_mode == \"digital\":\n"
"    <div style=\"margin:30px auto; text-align: center;\">\n"
"        <a href=\"https://compassion.ch/medias/onboarding/chemin_en.pdf\">\n"
"            <img src=\"http://compassion.ch/medias/onboarding/image_1_letter_en.png\">\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"\n"
"<p>You can reply to ${firstname} via <a href=\"https://mycompassion.ch/en_US/my/letter\">MyCompassion</a>.</p>\n"
"\n"
"% if not letter.mapped('sponsorship_id').filtered('is_first_sponsorship'):\n"
"    % if special:\n"
"        <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"            <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_EN.pdf\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"                Extra information for writing letters to your sponsored child${'ren' if one_child}.\n"
"            </a>\n"
"        </div>\n"
"    % endif\n"
"% endif\n"
"\n"
"<p>Another important letter writing information: To ensure the protection of the children, but also for your own safety, the communication between you and your sponsored child[ren] must run solely through us.</p>\n"
"<p>Please never mention:</p>\n"
"<ul>\n"
"    <li>Your postal address</li>\n"
"    <li>Your email address</li>\n"
"    <li>Your phone number</li>\n"
"    <li>Compassion Switzerland's address</li>\n"
"    <li>Your Facebook or other social media contact details</li>\n"
"    <li>Making promises (e.g. a gift or visit)</li>\n"
"</ul>\n"
"<p>It is so wonderful that you are investing in the ${\"life of \" + firstname if one_child else (\"lives of \" + firstname if less_4 else \"your sponsored children\")}!</p>\n"
"<p>Warm regards,</p>\n"
"<p>${object.user_id.sudo().signature | safe}</p>"
msgstr ""
"<div>\n"
"    % set letter = object.get_objects()\n"
"    % set partner = object.partner_id\n"
"    % set child = letter.mapped('child_id')\n"
"    % set wp = \"SWP\" in letter.mapped(\"sponsorship_id.type\")\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set informal = wp and not plural\n"
"    % set tu = \"tu\" if informal else \"vous\"\n"
"    % set te = \"te\" if informal else \"vous\"\n"
"    % set toi = \"toi\" if informal else \"vous\"\n"
"    % set ton = \"ton\" if informal else \"votre\"\n"
"    % set tes = \"tes\" if informal else \"vos\"\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get('ton filleul') if informal else child.get('your sponsored child'), translate=False)\n"
"    % set urls = []\n"
"    % set field_office_ids = letter.mapped('child_id.field_office_id').ids\n"
"    % set special = 1 in field_office_ids or 19 in field_office_ids\n"
"\n"
"    % for letter_set in letter.filtered('read_url').mapped('read_url'):\n"
"        % if letter_set not in urls:\n"
"            % set void = urls.append(letter_set)\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % if len(urls) == 0:\n"
"        % set void = urls.append('https://mycompassion.ch/my/children?child_id=' + str(letter.child_id.id))\n"
"    % endif\n"
"\n"
"    % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"\n"
"% if object.send_mode == \"sms\":\n"
"    <p>Nous sommes heureux de t'envoyer la nouvelle lettre de ${firstname}!</p>\n"
"    <p>Clique ici pour télécharger la lettre: <a href=\"${urls[0]}\">Lettre</a></p>\n"
"    <p>Bonne lecture!</p>\n"
"    <p>\n"
"        Si tu as cinq minutes, pourrais-tu directement répondre à cette lettre? Clique simplement ici: <a href=\"https://mycompassion.ch/fr_CH/my/letter\">MyCompassion</a>\n"
"    </p>\n"
"    <p>Merci et à bientôt!    </p>\n"
"    <p>\n"
"        ${whatsapp_signature}\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        C’est avec joie que nous vous adressons la première lettre de ${firstname}.\n"
"    </p>\n"
"    % if object.send_mode != \"physical\":\n"
"        <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"            <a href=\"${urls[0]}\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"                Télécharger votre lettre\n"
"            </a>\n"
"        </div>\n"
"    % endif\n"
"    <p>\n"
"        Il est important de savoir que la culture des enfants parrainés est principalement orale. Rédiger des lettres et répondre concrètement à des questions nécessite donc un long processus d'apprentissage. Merci beaucoup d'accompagner ${firstname} dans ce développement !\n"
"    </p>\n"
"    <p>\n"
"        Vous pouvez écrire sur <a href=\"https://mycompassion.ch/fr_CH/my/letter\">MyCompassion</a>.\n"
"    </p>\n"
"\n"
"    % if special.field:\n"
"        <p>\n"
"            Des recommandations spéciales s'appliquent pour la correspondance avec votre ${child.get('filleul')}\n"
"            <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"                <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_fr.pdf\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"                    Recommandations spéciales ${special.field}\n"
"                </a>\n"
"            </div>\n"
"        </p>\n"
"    % endif\n"
"    <p>\n"
"        Pour la protection de l'enfant et la vôtre, toute la correspondance passe par Compassion. Ne mentionnez jamais les infos suivantes dans vos lettres :\n"
"    </p>\n"
"    <ul>\n"
"        <li>\n"
"            Votre adresse postale\n"
"        </li>\n"
"        <li>\n"
"            Votre adresse e-mail\n"
"        </li>\n"
"        <li>\n"
"            Votre numéro de téléphone\n"
"        </li>\n"
"        <li>\n"
"            Les coordonnées de vos comptes de réseaux sociaux\n"
"        </li>\n"
"        <li>\n"
"            L’adresse de Compassion Suisse\n"
"        </li>\n"
"        <li>\n"
"            Une promesse d'envoi d'un cadeau ou d'une visite\n"
"        </li>\n"
"    </ul>\n"
"    <p>\n"
"        Merci d'investir dans la vie de ${firstname}. Votre parrainage fait vraiment une différence !\n"
"    </p>\n"
"    <p>\n"
"        Chaleureusement,\n"
"    </p>\n"
"    % if object.send_mode == \"digital\":\n"
"        <p>\n"
"            ${object.user_id.sudo().short_signature | safe}\n"
"        </p>\n"
"    % endif\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_biennial
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set child = object.get_objects()\n"
"    % set firstname = child.get_list('preferred_name', 3, 'many children', False)\n"
"\n"
"    % if len(child) == 1:\n"
"        % set Hasnot = \"Hasn't\"\n"
"    % else:\n"
"        % set Hasnot = \"Haven't\"\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    We're excited to send you a new photo of ${firstname}. ${Hasnot} ${child.get('he')} grown a lot?\n"
"</p>\n"
"<p>\n"
"    Why not take some time to write a letter to ${firstname} and show ${child.get('him')} how precious ${child.get('he')} is? You can do so <a href='https://compassion.ch/schreiben/'>online</a>.\n"
"</p>\n"
"<p>\n"
"    Thanks to your generous and faithful support, the employees of the child centre can care for ${firstname} in a holistic way. In the context of activities, a great emphasis is placed not only on ${child.get('his')} academic advancement, but also on ${child.get('his')} personality development. ${firstname} has access to medical care, receives balanced meals and is learning personal responsibility.\n"
"</p>\n"
"<p>\n"
"    Together, we are changing the world! One child at a time.\n"
"</p>\n"
"<p>\n"
"    Kind regards\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set child = object.get_objects()\n"
"    % set firstname = child.get_list('preferred_name', 3, 'ces enfants', False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"\n"
"    % if plural:\n"
"        % set fier = 'fiers'\n"
"    % elif partner.title.id == 3:\n"
"        % set fier = 'fière'\n"
"    % else:\n"
"        % set fier = 'fier'\n"
"    % endif\n"
"</div>\n"
"\n"
"% if object.send_mode == \"sms\":\n"
"    <p>\n"
"        ${partner.informal_salutation},\n"
"    </p>\n"
"    <p>\n"
"        Tu as reçu une nouvelle photo de ${firstname} dans MyCompassion. Qu’est-ce qu’${\"elle\" if child.gender == \"F\" else \"il\"} a changé, non?\n"
"    </p>\n"
"    <p>\n"
"        Qu'est-ce qu'${child.get('he')} ${child.get('has')} changé, non?\n"
"    </p>\n"
"    <p>\n"
"        Prends un moment pour dire à ${firstname} combien tu es ${\"fière\" if partner.gender == \"F\" and not partner.plural else \"fier\"} <a href=\"https://mycompassion.ch/my/letter\">${\"d'elle\" if child.gender == \"F\" else \"de lui\"}</a>\n"
"    </p>\n"
"    <p>\n"
"        Merci d'investir dans la vie de ${firstname}. Cela a énormément de valeur!\n"
"    </p>\n"
"    <p>\n"
"        L'équipe de Compassion\n"
"        <br/>Tel: +41 (0)24 434 21 24\n"
"        <br/>Des questions? Écris-nous sur WhatsApp: +41 (0)79 622 31 97\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        ${partner.salutation},\n"
"    </p>\n"
"    <p>\n"
"        C'est avec joie que nous vous adressons ci-joint une nouvelle photo de ${child.get('your sponsored child')}. Vous verrez ainsi comme\n"
"        % if len(child) == 1 and child.age >= 18:\n"
"            ${child.get('he')} devient adulte.\n"
"        % else:\n"
"            ${child.get('he') + ' ' + child.get('has')} grandi.\n"
"        % endif\n"
"    </p>\n"
"    <p>\n"
"        Prenez donc quelques minutes pour dire à ${firstname} comme vous êtes ${fier}\n"
"        % if len(child) == 1:\n"
"            ${\"d'elle\" if child.gender == \"F\" else \"de lui\"},\n"
"        % endif\n"
"        directement en ligne: <a href=\"https://www.compassion.ch/ecrire\">www.compassion.ch/ecrire</a>.\n"
"    </p>\n"
"    <p>\n"
"        Grâce à votre engagement généreux et fidèle, les collaborateurs du centre de développement de l'enfant peuvent apporter un soutien holistique à ${child.get('your sponsored child')}. ${firstname} n'est pas seulement scolarisé${child.get('accord_e')}. ${child.get('he').title()} reçoit des bons repas, bénéficie d'un soutien médical. ${child.get('he').title()} est encouragé${child.get('accord_e')} et stimulé${child.get('accord_e')} à développer ses talents personnels, sa personnalité et à cultiver l'espérance.\n"
"    </p>\n"
"    <p>\n"
"        Ensemble nous changeons le monde, un enfant à la fois.\n"
"    </p>\n"
"    <p>\n"
"        Avec nos meilleures salutations et à bientôt.\n"
"    </p>\n"
"    % if object.send_mode != 'physical':\n"
"        <p>\n"
"            ${object.user_id.signature |safe}\n"
"        </p>\n"
"    % endif\n"
" % endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_sponsorship_dossier
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set his = child.get('his')\n"
"    % set he = child.get('he')\n"
"    % set him = child.get('him')\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set correspondant = object.partner_id in sponsorships.mapped('correspondent_id')\n"
"</div>\n"
"<p>\n"
"</p>\n"
"<p>\n"
"    % if sponsorships.mapped('parent_id') or len(object.partner_id.sponsorship_ids) != len(sponsorships):\n"
"        ${object.partner_id.salutation},\n"
"        <br><br>\n"
"        Thank you for committing to support another child through Compassion Switzerland.\n"
"    % else:\n"
"        A warm welcome to you, ${object.partner_id.salutation|replace('Dear', 'dear')}! It's so nice to have you as part of the Compassion family!\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Your support will change the life of ${firstname} and ${child.get('his')} family significantly. We thank you so much\n"
"    for investing in the life of ${firstname} and encouraging [him] through your letters and prayers.\n"
"</p>\n"
"<p>\n"
"    For a smooth start of this new relationship please find enclosed:\n"
"</p>\n"
"<ul>\n"
"    <li>\n"
"        1 photo of ${child.get('your sponsored child')}\n"
"    </li>\n"
"    <li>\n"
"        1 folder with practical information about your sponsorship\n"
"    </li>\n"
"    <li>\n"
"        1 sheet of labels to use for all the correspondence with ${child.get('your sponsored child')} (to stick on your\n"
"        cards, letters, stickers, etc.).\n"
"    </li>\n"
"    % if payer:\n"
"        <li>\n"
"            ${sponsorships[0].payment_type_attachment}\n"
"        </li>\n"
"    % endif\n"
"    <li>\n"
"        1 presentation card to send to ${child.get('your sponsored child')}\n"
"    </li>\n"
"</ul>\n"
"% if payer:\n"
"    <p>\n"
"        Upon receipt of the first payment, which we are expecting in the coming days, ${firstname} will be notified that you are ${child.get('his')} sponsor.\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Thank you for your valuable involvement in our sponsorship program. We hope that the relationship with ${firstname} will be a source of joy and blessing for him as well as for you!\n"
"</p>\n"
"<p>\n"
"    Do not hesitate to contact us if you have any questions!\n"
"</p>\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.sudo().user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    PS: Do you already have the Compassion App? With it you always have your sponsored child's pictures, letters and all\n"
"    information at hand. And the letter writing is made even easier. Download here: www.compassion.ch/app\n"
"</p>\n"
msgstr ""
"<!--\n"
"${'Bienvenue dans la famille de Compassion' if object.get_objects().filtered(\"is_first_sponsorship\") else 'Merci pour votre engagement !'}\n"
"-->\n"
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set correspondant = object.partner_id in sponsorships.mapped('correspondent_id')\n"
"    % set partner = object.partner_id\n"
"    % set un_parrain = 'un parrain'\n"
"    % set parrain = 'parrain'\n"
"\n"
"    % if partner.gender == 'F':\n"
"        % set un_parrain = 'une marraine'\n"
"        % set parrain = 'marraine'\n"
"    % endif\n"
"    \n"
"    % if partner.title == partner.env.ref('partner_compassion.res_partner_title_family'):\n"
"        % set un_parrain = 'une famille'\n"
"    % endif\n"
"\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]        \n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set number_years = object.env[\"partner.communication.job\"].get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.env[\"partner.communication.job\"].get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.env[\"partner.communication.job\"].get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.env[\"partner.communication.job\"].get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.env[\"partner.communication.job\"].get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.env[\"partner.communication.job\"].get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = object.env[\"partner.communication.job\"].get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"</div>\n"
"<div style=\"font-size:8pt\">\n"
"    ${partner.salutation},\n"
"    <br>\n"
"    <br>\n"
"    % if sponsorships.mapped('parent_id') or len(object.partner_id.sponsorship_ids) != len(sponsorships):\n"
"        Merci d'avoir décidé d'investir dans la vie ${\"d'un enfant de plus\" if len(child) == 1 else \"d'enfants supplémentaires\"}.\n"
"    % else:\n"
"        Merci d'avoir rejoint la famille de Compassion.\n"
"    % endif \n"
"    <br>\n"
"    <br>\n"
"    Avec vous et avec ${number_fcps} Eglises partenaires dans les pays du Sud, nous nous engageons à libérer ${number_children} millions d'enfants de l'extrême pauvreté. Ensemble, nous offrons à ces enfants un avenir empreint d'espérance.\n"
"    <br>\n"
"    <br>\n"
"    Pour que votre parrainage débute sur de bonnes bases, vous trouverez ci-joint plusieurs informations et documents importants:\n"
"    <ul>\n"
"        <li>\n"
"            1 photo de ${(child.get('each of') or '') + ' ' + child.get('your sponsored child') | safe}\n"
"        </li>\n"
"        <li>\n"
"            Des informations pratiques concernant votre parrainage\n"
"        </li>\n"
"        <li>\n"
"            ${\"1 carte\" if len(sponsorships) == 1 else \"Des cartes\"} de présentation à envoyer à ${child.get('your sponsored child')}\n"
"        </li>\n"
"        <li>\n"
"            1 feuille d'étiquettes ${child.get('per child') or ''} à utiliser pour toute la correspondance avec\n"
"            ${child.get('your sponsored child')} (à coller sur vos cartes, lettres, dessins, autocollants...). Celle-ci indique votre référence de ${parrain} et la référence de ${child.get('your sponsored child') | safe}\n"
"        </li>\n"
"    </ul>\n"
"\n"
"    % if payer:\n"
"        Afin de concrétiser votre soutien à ${firstname}, d'avance merci\n"
"        % if lsv_dd:\n"
"            de remplir le formulaire LSV ci-joint et de nous le renvoyer par la poste pour activer le prélèvement automatique de votre soutien mensuel.\n"
"        % else:\n"
"            de mettre en place votre ordre permanent avec le bulletin ci-joint.\n"
"        % endif\n"
"\n"
"        Dès réception de votre premier versement, ${firstname} ${child.get('will be')} averti${child.get('accord_e') or ''} que vous êtes\n"
"\n"
"        % if partner.plural or partner.gender == 'M':\n"
"            ${child.get('son')} parrain.\n"
"        % else:\n"
"            ${child.get('sa')} marraine.\n"
"        % endif\n"
"        <br>\n"
"        <br>\n"
"    % endif \n"
"\n"
"    Grâce à vous, ce n'est pas seulement un enfant, mais toute sa famille qui peut envisager l'avenir avec plus de confiance. Merci d'avoir pris cette décision généreuse en faveur de ${firstname}. \n"
"    <br>\n"
"    <br>\n"
"    Nous vous souhaitons beaucoup de joie avec ${\"ce parrainage\" if len(child) == 1 else \"ces parrainages\"}.\n"
"    <br>\n"
"    <br>\n"
"    Nous sommes à disposition pour toute question.\n"
"    <br>\n"
"    <br>\n"
"    Ensemble, changeons le monde, un enfant à la fois.\n"
"    <br>\n"
"    <br>\n"
"    Avec nos meilleures salutations.\n"
"</div>  "

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_unplanned_exit
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set nb_weeks = sponsorships[:1].contract_duration // 7\n"
"    % set nb_years = (sponsorships[:1].contract_duration // 364) or 1\n"
"    % set field = child[:1].field_office_id\n"
"    % set hours_fcp = field.fcp_hours_week * nb_weeks\n"
"    % set meals = field.fcp_meal_week * nb_weeks\n"
"    % set medical = field.fcp_medical_check * nb_years\n"
"\n"
"    % if meals == 1:\n"
"        % set lunch = 'meal'\n"
"    % else:\n"
"        % set lunch = 'meals'\n"
"    % endif\n"
"\n"
"    % if medical == 1:\n"
"        % set checkup = 'medical checkup'\n"
"    % else:\n"
"        % set checkup = 'medical checkups'\n"
"    % endif\n"
"\n"
"   % set partner = object.partner_id\n"
"   % set plural = partner.title.plural or partner.title.id == 29\n"
"   % set name = child.get_list('preferred_name', 3, translate=False)\n"
"   % set lifecycle = child.mapped('lifecycle_ids')[:1]\n"
"   % set good_reason = lifecycle.with_context(lang=\"en_US\").request_reason in (\"beneficiary pursuing career opportunity\", \"conflicts with school or work schedule\", \"family circumstances have changed positively so that child no longer needs compassion's assistance\", \"no longer needs our assistance\")\n"
"   % set last_letter = sponsorships[:1].child_letter_ids[:1]\n"
"</div>\n"
"<p>\n"
"   ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"% if good_reason:\n"
"    We have good news!\n"
"    <br><br>\n"
"    ${name} will come to the end of ${child.get('his')} sponsored journey early, because ${lifecycle.translate('request_reason')}. ${child.get('His').title()} goal is to ${lifecycle.get_list('future_hope_ids.value')}. Isn't that great?\n"
"    <br><br>\n"
"    ${child.get('His').title()} life was positively changed thanks to your support.\n"
"    <br><br>\n"
"    ${name} spent a total of ${hours_fcp} hours at the child centre of the local church. ${child.get('He')} received ${meals} ${lunch} and went through ${medical} ${checkup}. ${child.get('He').title()} was able to go to school regularly, was encouraged individually and knew that someone on the other side of the world was looking after ${child.get('him')}. <b>Thank you so much!</b>\n"
"    <br><br>\n"
"    We understand that this news might come as a surprise to you, but we hope that you will still be able to rejoice with us. \n"
"% else:\n"
"    We have received unexpected news from our staff ${field.country_id.in_preposition} ${field.country_id.name}. ${name} will come to the end of ${child.get('his')} sponsored journey early, because ${lifecycle.translate('request_reason')}.\n"
"    <br><br>\n"
"    We understand that this news might come as a surprise to you. In circumstances of extreme poverty, the life situation sometimes changes in ways that we are not accustomed to. We are very sorry that your sponsorship with ${name} has abruptly ended.\n"
"    <br><br>\n"
"    That is why we would like to thank you all the more for your precious support. ${child.get('He').title()} received ${meals} ${lunch} and went through ${medical} ${checkup}. ${child.get('He').title()} was able to go to school regularly, was encouraged individually and knew that someone on the other side of the world was looking after ${child.get('him').title()}. Your investment will continue to impact and inspire ${child.get('him')} and ${child.get('his')} family. <b>Thank you so much!</b>\n"
"    <br><br>\n"
"    ${name} is doing well. ${child.get('His').title()} goal is to ${lifecycle.get_list('future_hope_ids.value')}. Isn't that great?\n"
"</p>\n"
"% endif\n"
"\n"
"<p>\n"
"% if object.partner_id in sponsorships.mapped('correspondent_id'):\n"
"    % if 2 in last_letter.communication_type_ids.ids and not last_letter.sent_date:\n"
"        This moment becomes even more emotional, as attached you will find ${name}'s final correspondence. You are welcome to write a final farewell letter to ${name} to encourage ${child.get('him')} for the future.\n"
"    % endif\n"
"% endif\n"
"</p>\n"
"<p>\n"
"\n"
"Thank you for changing the life of a child and ${child.get('his')} family in a sustainable way!\n"
"</p>\n"
"<p>\n"
"Together, we are changing the world! One child at a time.\n"
"</p>\n"
"<p>\n"
"Best regards\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"        <br><br>\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Our fight against extreme poverty continues! 385 million children still live in unacceptable conditions. 14000 children under the age of five die every day. We seek to tackle this urgency. With this in mind, we will soon suggest another child for you to sponsor.\n"
"</p>"
msgstr ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set name = child.get_list('preferred_name', 3, child.get('your sponsored child'), translate=False)\n"
"    % set projects = child.mapped('project_id')\n"
"    % set nb_weeks = sponsorships[:1].contract_duration // 7\n"
"    % set nb_years = (sponsorships[:1].contract_duration // 364) or 1\n"
"    % set field = child[:1].field_office_id\n"
"    % set hours_fcp = field.fcp_hours_week * nb_weeks\n"
"    % set meals = field.fcp_meal_week * nb_weeks\n"
"    % set medical = field.fcp_medical_check * nb_years\n"
"    % set lifecycle = child.mapped('lifecycle_ids')[:1]\n"
"    % set good_reason = lifecycle.with_context(lang=\"en_US\").request_reason in (\"beneficiary pursuing career opportunity\", \"conflicts with school or work schedule\", \"family circumstances have changed positively so that child no longer needs compassion's assistance\", \"no longer needs our assistance\")\n"
"    % set last_letter = sponsorships[:1].child_letter_ids[:1]\n"
"    % set number_unacceptable_conditions = object.get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"    % set number_deaths_under_5 = object.get_snippet('number_deaths_under_5') | striptags | safe\n"
"    % set age_deaths_under_5 = object.get_snippet('age_deaths_under_5') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"</p>\n"
"<p>\n"
"    % if good_reason:\n"
"        Le parrainage de ${name} se termine plus tôt que prévu parce qu'${child.get('he')} ${lifecycle.translate('request_reason')} Son but dans la vie, c'est ${lifecycle.get_list('future_hope_ids.value')}. N'est-ce pas formidable ?\n"
"    % else:\n"
"        Nous avons été informés de façon inattendue par les collègues ${field.country_id.from_preposition} ${field.country_id.name} que le parrainage de ${name} se termine plus tôt que prévu parce ${\"qu'\" if child.gender == 'F' else 'que'} ${lifecycle.translate('request_reason')}.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Durant votre parrainage, ${child.get('he')} a passé ${hours_fcp} heures au centre de développement de l'enfant de l'Eglise locale. Les collaborateurs de celui-ci se sont occupés ${\"d'elle\" if child[:1].gender == \"F\" else \"de lui\"} avec amour et lui ont transmis l'espérance pour son avenir. ${meals} repas lui ont été servis. ${child.get('he').title()} a en outre bénéficié de ${medical} examens médicaux.\n"
"\n"
"    % if child[:1].age >= 7:\n"
"        ${child.get('he').title()} a pu aller à l'école, être encouragé${child.get('accord_e') or ''} à développer ses talents.\n"
"    % endif\n"
"\n"
"    Enfin, ${child.get('he')} a découvert qu'une personne à l'autre bout du monde se préoccupait ${\"d'elle\" if child[:1].gender == \"F\" else \"de lui\"}. Un immense merci !\n"
"</p>\n"
"<p>\n"
"    % if good_reason:\n"
"        Nous comprenons que cette nouvelle peut vous surprendre. Nous espérons toutefois que vous puissiez vous réjouir avec nous.\n"
"    % else:\n"
"        ${name.capitalize()} se porte bien. Son but, c'est ${lifecycle.get_list('future_hope_ids.value')}. C'est génial,\n"
"    non ?\n"
"    % endif\n"
"</p>\n"
"\n"
"% if object.partner_id in sponsorships.mapped('correspondent_id'):\n"
"    % if 2 in last_letter.communication_type_ids.ids and not last_letter.sent_date:\n"
"        <p>C'est aussi un moment d'émotion car nous vous envoyons avec la présente la dernière lettre de ${name}.</p>\n"
"    % endif\n"
"    <p>Vous pouvez à votre tour prendre congé de ${name} dans une dernière lettre et l'encourager pour son avenir.</p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Notre engagement contre l'extrême pauvreté se poursuit. ${number_unacceptable_conditions} millions d'enfants vivent toujours dans des conditions inacceptables. ${number_deaths_under_5} enfants de moins de ${age_deaths_under_5} ans meurent chaque jour. Nous ne pouvons pas rester les bras croisés devant cette injustice. C’est pourquoi, nous nous permettrons de vous envoyer bientôt une proposition de parrainage d'un autre enfant.\n"
"</p>\n"
"<p>\n"
"    Ensemble, nous sommes en train de changer le monde, un enfant à la fois.\n"
"</p>\n"
"    <p>\n"
"    Avec nos meilleures salutations.\n"
"</p>\n"
"\n"
" % if object.send_mode == \"digital\":\n"
"    <p>${object.user_id.signature | safe}</p>\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_planned_exit
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set one = len(child) == 1\n"
"    % set name = child.get_list('preferred_name', 3, 'your children')\n"
"                        \n"
"    % if one:\n"
"        % set lifecycle = child.mapped('lifecycle_ids') and child.mapped('lifecycle_ids')[0]\n"
"    % endif \n"
"                        \n"
"    % set sub = sponsorships.mapped('sub_sponsorship_id.child_id')\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"    <br>\n"
"    <br>\n"
"    We sincerely thank you for investing in the life of ${name}. We have received joyful news from the child project: after many years of support from the staff at the local church and through you as the sponsor,\n"
"    <b>${name} is coming to the end of the sponsorship program and is a young adult.</b>\n"
"    ${child.get('he').title()} looks with hope and trust to the future.\n"
"    <br>\n"
"    <br>\n"
"\n"
"% if one:\n"
"    The local staff have told us that ${name}'s goals are to ${lifecycle.get_list('future_hope_ids.value')}.\n"
"    <br>\n"
"    <br>\n"
"% else:\n"
"</p>\n"
"<ul>\n"
"    % for one_child in child:\n"
"        % set lifecycle = one_child.mapped('lifecycle_ids') and one_child.mapped('lifecycle_ids')[0]\n"
"        <li>${one_child.preferred_name}'s current goals are: ${lifecycle.get_list('future_hope_ids.value')}.</li>\n"
"    % endfor\n"
"</ul>\n"
"% endif \n"
"\n"
"Thanks to your regular support, ${name} ${child.get('was')} able to go to school,  receive medical care and receive balanced meals and clothing. ${child.get('he').title()} ${child.get('was')} also able to participate in activities that have helped ${child.get('him')} in ${child.get('his')} development - socially and spiritually. The family also benefitted from the support and participated in various activities organized by the center.\n"
"<br>\n"
"<br>\n"
"\n"
"% if object.partner_id in sponsorships.mapped('correspondent_id'):\n"
"    You are welcome to send a last letter to ${name} and say goodbye to ${child.get('him')} and encourage ${child.get('him')} for the future. You can continue to accompany ${name} in prayer throughout ${child.get('his')} life.\n"
"% endif \n"
"\n"
"<br>\n"
"<br>\n"
"\n"
"% if sub:\n"
"    % if one:\n"
"        As you know, the plight is enormous in the countries of the Global South. ${sub.preferred_name} ${sub.project_id.country_id.preposition} ${sub.project_id.country_id.name} lives in extreme poverty. Would you be ready to sponsor ${sub.get('him')}? We will send you the information for ${sub.preferred_name} within 15 days to start the new sponsorship. If you would like to support a child in another country, have questions, or would like to cancel a sponsorship, please do not hesitate to contact us. We can be reached by phone at 031 552 21 25 or by e-mail at: info@compassion.ch \n"
"\t% else:\n"
"        As you already know, the plight of children living in poverty is enormous.  For instance, ${sub[0].preferred_name} ${sub.project_id.country_id.name} ${sub[0].project_id.country_id.name} is one of them.  Would you consider and be ready to sponsor ${sub.get('him')}?  We would like to send you information about ${sub[0].preferred_name} and other children in need within 15 days to begin new sponsorships. However, if you have questions, concerns, or would no longer like to be a sponsor, please do not hesitate to contact us. We can be reached by phone at 031 552 21 25 or by e-mail at: info@compassion.ch\n"
"    % endif \n"
"% else:\n"
"    With this letter, we acknowledge that you would not like to sponsor another child at this time.\n"
"    <br>\n"
"    <br>\n"
"    Did you know that you can also help children in poverty by giving them access to clean water (water filters, toilet installation, hygiene awareness)? If you are interested, call us on 031 552 21 25 or donate online here at www.compassion.ch/spenden.\n"
"% endif\n"
"\n"
"<br>\n"
"<br>\n"
"We are thankful to work with you and so many other sponsors and donors to help release children from poverty every day.\n"
"<br>\n"
"<br>\n"
"Sincerely,\n"
"\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"    ${object.sudo().user_id.short_signature | safe}\n"
"    </p>\n"
"% endif "
msgstr ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set nb_weeks = sponsorships[:1].contract_duration // 7\n"
"    % set nb_years = (sponsorships[:1].contract_duration // 364) or 1\n"
"    % set field = child[:1].field_office_id\n"
"    % set hours_fcp = field.fcp_hours_week * nb_weeks\n"
"    % set meals = field.fcp_meal_week * nb_weeks\n"
"    % set medical = field.fcp_medical_check * nb_years\n"
"    % set name = child.get_list('preferred_name', 3, child.get('your sponsored child'), translate=False)\n"
"    % set lifecycle = child.mapped('lifecycle_ids') and child.mapped('lifecycle_ids')[:1]\n"
"    % set last_letter = sponsorships[:1].child_letter_ids[:1]\n"
"    % set one = len(child) == 1\n"
"    % set number_unacceptable_conditions = object.get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"    % set number_deaths_under_5 = object.get_snippet('number_deaths_under_5') | striptags | safe\n"
"    % set age_deaths_under_5 = object.get_snippet('age_deaths_under_5') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"    <br>\n"
"    <br>\n"
"    C'est avec joie que nous vous informons qu'après de nombreuses années de soutien, ${name} arrive à la fin de ${child.get('son')} parrainage.\n"
"    <br>\n"
"    <br>\n"
"    <b>\n"
"        Désormais jeune${child.get('accord_s') or ''} adulte${child.get('accord_s') or ''}, ${child.get('he')} ${child.get('is')} devenu${child.get('accord_e') or ''} une personne${child.get('accord_s') or ''} responsable${child.get('accord_s') or ''}, prête${child.get('accord_s') or ''} à aborder la vie avec espérance et confiance. N'est-ce pas génial ?\n"
"    </b>\n"
"    <br>\n"
"    <br>\n"
"    Durant votre parrainage, ${child.get('he')} a passé ${hours_fcp} heures au centre de développement de l'enfant de l'Eglise locale. Les collaborateurs de celui-ci se sont occupés ${\"d'elle\" if child[:1].gender == \"F\" else \"de lui\"} avec amour et lui ont transmis l'espérance pour son avenir. ${meals} repas lui ont été servis. ${child.get('he').title()} a en outre bénéficié de ${medical} examens médicaux.\n"
"\n"
"    % if child[:1].age >= 7:\n"
"        ${child.get('he').title()} a pu aller à l'école, être encouragé${child.get('accord_e') or ''} à développer ses talents.\n"
"    % endif\n"
"        Enfin, ${child.get('he')}  a découvert${child.get('accord_e')} qu'une personne à l'autre bout du monde se préoccupait ${\"d'elle\" if child[:1].gender == \"F\" else \"de lui\"}. Un immense merci !\n"
"</p>\n"
"\n"
"% if object.partner_id in sponsorships.mapped('correspondent_id'):\n"
"    % if 2 in last_letter.communication_type_ids.ids and not last_letter.sent_date:\n"
"        <p>\n"
"            C'est un moment émotionnellement fort, car nous vous adressons, en annexe, sa dernière lettre.\n"
"        </p>\n"
"    % endif\n"
"    <p>\n"
"        Vous avez la possibilité d’écrire un dernier courrier à ${name} pour prendre congé ${'de lui' if child[:1].gender == 'M' else \"d'elle\"} et l'encourager pour son avenir.\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Merci d'avoir investi dans la vie d'un enfant et de sa famille, afin de leur apporter une transformation durable.\n"
"</p>\n"
"\n"
"% if sponsorships[:1].sds_state in (\"sub\", \"sub_waiting\"):\n"
"    <p>\n"
"        Notre engagement contre l'extrême pauvreté se poursuit. ${number_unacceptable_conditions} millions d'enfants vivent toujours dans des conditions inacceptables. ${number_deaths_under_5} enfants de moins de ${age_deaths_under_5} ans meurent chaque jour. Nous ne pouvons pas rester les bras croisés devant cette injustice. C'est pourquoi, nous nous permettrons de vous envoyer bientôt une proposition de parrainage d'un autre enfant.\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Ensemble, nous sommes en train de changer le monde, un enfant à la fois.\n"
"</p>\n"
"<p>\n"
"    Recevez nos chaleureuses salutations,\n"
"</p>\n"
"\n"
"% if object.send_mode == \"digital\":\n"
"    <p>${object.user_id.signature | safe}</p>\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_reinstatement
msgid ""
"<div>\n"
"   % set child = object.get_objects()\n"
"    \n"
"% set partner = object.partner_id\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation}\n"
"   <br>\n"
"   <br>\n"
"   We have received good news! ${child.get('your sponsored child')}${child.get_list('preferred_name')} has returned to the project of the local church and has been re-enrolled in the sponsorship program, because ${child.lifecycle_ids[:1].translate('request_reason')}.\n"
"   <br>\n"
"   <br>\n"
"   You were previously the sponsor of ${child.get_list('preferred_name')}. Thus we would like to offer you the opportunity to sponsor ${child.get_list('preferred_name')} again and continue to invest in ${child.get('his')} life in order to release ${child.get('him')} from poverty in the long-term. We thank you in advance for a quick answer.\n"
"   <br>\n"
"   <br>\n"
"   After more than 70 years of experience, we at Compassion believe: Taking on a sponsorship changes the life of a child, their family and their surroundings. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together with you and our 8600 partner churches in the global south, we are able to transform the lives of more than 2,3 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Kind Regards,\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"    ${object.user_id.signature | safe}\n"
"\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<!--\n"
"    Votre ${'filleul' if object.get_objects().gender == 'M' else 'filleule'} ${object.get_objects().preferred_name} est de retour dans le centre de développement de l'enfant\n"
"-->\n"
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"\n"
"    % if plural:\n"
"        % set sponsor = 'les parrains'\n"
"    % else:\n"
"        % if partner.gender == 'M'\n"
"            % set sponsor = 'le parrain'\n"
"        % else:\n"
"            % set sponsor = 'la marraine'\n"
"        % endif\n"
"    % endif\n"
"\n"
"    % set sms = object.send_mode == \"sms\"\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/fr_CH/im_livechat/support/3\"\n"
"    % set informal = sms and not plural\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation if sms else partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Bonne nouvelle ! ${child.get('your sponsored child').capitalize()} ${child.get_list('preferred_name')} ${child.get\n"
"    ('is')}\n"
"    revenu${child.get('accord_e') or ''} au centre de développement de l'enfant de Compassion et a réintégré le\n"
"    programme de parrainage.\n"
"</p>\n"
"<p>\n"
"    Vous étiez ${sponsor} de ${child.get_list('preferred_name')}. C'est pourquoi, nous vous proposons en priorité de\n"
"    reprendre le parrainage. Etes-vous d'accord de reprendre le parrainage, afin de lui permettre d'être durablement\n"
"    libéré${child.get('accord_e') or ''} de la pauvreté ?\n"
"</p>\n"
"<p>\n"
"    Nous vous remercions par avance de votre réponse rapide.\n"
"</p>\n"
"\n"
"% if not sms:\n"
"    <p>\n"
"        Imaginez un peu sa joie, si ${child.get('your sponsored child')} apprend cette nouvelle !\n"
"    </p>\n"
"    <p>\n"
"        ${years_uc} ${number_years} ans d'expérience nous permettent d'affirmer que le parrainage permet non\n"
"        seulement de transformer durablement la vie d'un enfant mais aussi celle de ses proches, de sa famille.\n"
"    </p>\n"
"    <p>\n"
"        Merci de votre engagement à nos côtés pour lutter contre l'extrême pauvreté !\n"
"    </p>\n"
"    <p>\n"
"        Avec nos chaleureuses salutations.\n"
"    </p>\n"
"    % if object.send_mode != 'physical':\n"
"        <p>\n"
"            ${object.user_id.signature | safe}\n"
"        </p>\n"
"    % endif\n"
"% else:\n"
"    <p>Bonne journée et à bientôt!</p>\n"
"    <p>\n"
"        ${whatsapp_signature}\n"
"    </p>\n"
"% endif\n"
" "

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_illness
msgid ""
"<div>\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p>\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"\n"
"    Thank you for investing in the life of ${child.preferred_name} with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"    In Switzerland and also in the country where ${child.preferred_name}     lives, healthcare problems sometimes occurdespite medical care and support. Our staff at the Children‘s Center haveinformed us that ${child.preferred_name} has ${child.current_values}. It is a chronic illness.\n"
"   <br>\n"
"   <br>\n"
"    Thanks to your regular support and through a special fund for medical emergencies, Compassion is committed to the treatment and care of ${child.preferred_name}. If you accompany ${child.get('him')} in prayer now and ask for God‘s blessings andprotection, you are taking on an important service for this child!\n"
"      <br>\n"
"   <br>\n"
"    Your support of a child in extreme poverty is valuable. At Compassion, weare convinced that this will give a child the chance for a dignified and meaningfullife. ${object.success_sentence or ''}\n"
"     <br>\n"
"   <br>\n"
"    Thank you again for your committment, so that together we can positivelytransform the lives of currently more than 2 million children in 25countries.\n"
"     <br>\n"
"   <br>\n"
"    Best regards,\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"      ${object.user_id.signature | safe}\n"
"% endif\n"
"  \n"
"  </p>\n"
" "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_notes
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"                    \n"
"% set child = object.get_objects()\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, 'many children', False)\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation}\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${firstname} with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   The living situation of your sponsored child has changed. The staff at the the Child Development Center has informed us that ${child.get_list('note_ids.body')}\n"
"   <br>\n"
"   <br>\n"
"   Your support for a child in extreme poverty is valuable. At Compassion, we believe that this will give a child the opportunity to live a dignified and meaningful life. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can positively transform the lives of currently more than 2 million children in 25 countries.\n"
"   <br>\n"
"  <br>\n"
"  Kind regards,\n"
"  <br>\n"
"  <br>\n"
"% if object.send_mode == 'digital':\n"
"       ${object.user_id.signature | safe}\n"
"% else:\n"
"    PS: As you requested, we will send you the original letter${s}. Please keep in mind it can take several weeks until we receive it.\n"
"% endif\n"
" </p>"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set child = object.get_objects()\n"
"    % set firstname = child.get_list('preferred_name', 3, 'ces enfants', False)\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"</p>\n"
"<p>\n"
"    Merci de tout cœur d'investir dans la vie de ${firstname} par le biais du parrainage.\n"
"</p>\n"
"<p>\n"
"    Dans un contexte d'extrême pauvreté, les situations de vie changent parfois rapidement. C'est le cas pour ${child\n"
"    .get('your sponsored child')}. Le centre de développement de l'enfant dans lequel ${'est' if len(child) == 1 else\n"
"    'sont'} inscrit${child.get('accord_e') or ''} ${firstname} nous informe que:\n"
"</p>\n"
"<ul>\n"
"    % for revision in child.mapped('revised_value_ids') + child.mapped('household_id.revised_value_ids'):\n"
"        <li>\n"
"            ${revision.name} : ${revision.old_value} -&gt; ${revision.get_field_value()}\n"
"        </li>\n"
"    % endfor\n"
"    % if child.note_ids:\n"
"    <li>${child.note_ids[0].body or ''}</li>\n"
"    % endif\n"
"</ul>\n"
"<p>\n"
"    ${years_uc} ${number_years} ans d'expérience nous permettent d'affirmer qu'un parrainage peut changer non seulement\n"
"    la vie d'un enfant, mais aussi celle de sa famille.\n"
"</p>\n"
"<p>\n"
"     Merci de votre engagement à nos côtés.\n"
"</p>\n"
"<p>\n"
"    Recevez nos chaleureuses salutations.\n"
"</p>\n"
"<p>\n"
"    % if object.send_mode == 'digital':\n"
"        ${object.user_id.signature | safe}\n"
"    % endif\n"
"</p>\n"

