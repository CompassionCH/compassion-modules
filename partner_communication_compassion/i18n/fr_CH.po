#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_project_suspension_follow_up
msgid ""
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida "
"Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\"><br></p>"
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set project = child.mapped('project_id')[0]\n"
"    % set suspension = project.lifecycle_ids[0]\n"
"    % set date1 = suspension.create_date\n"
"    % set type = suspension.type\n"
"    % set suspended = suspension.type == 'Suspension'\n"
"    % set reasons = suspension.suspension_reason_ids\n"
"    % set details = suspension.suspension_detail\n"
"    % set partner = object.partner_id\n"
"    % set firstname = child.get_list('preferred_name', 3, deine_patenkinder, translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"\n"
"    % if suspension.type == 'Reactivation':\n"
"        % set date2 = project.lifecycle_ids[1].create_date\n"
"    % else:\n"
"        % set date2 = date1\n"
"        % set date1 = datetime.date.today()\n"
"    % endif\n"
"    % set months = (date1.year - date2.year) * 12 + (date1.month - date2.month)\n"
"\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"</p>\n"
"% if suspended:\n"
"    <p>\n"
"        Nous sommes au regret de vous informer que l'enquête sur le centre de développement de ${firstname} est toujours en cours. Cependant, ceci nous confirme que les normes de qualité internationales selon lesquelles Compassion travaille sont prises au sérieux et appliquées.\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        Nous avons le plaisir de vous informer aujourd'hui que les clarifications concernant le centre de développement de ${firstname} sont terminées et que toutes les activités du centre ont pu reprendre.\n"
"% endif\n"
"\n"
"<p>\n"
"    Nous tenons à vous remercier de tout cœur pour votre confiance et votre précieux soutien pendant la période de suspension du centre pour enfants.\n"
"</p>\n"
"<p>\n"
"    Vos dons n’ont pas pu être transmis pendant ${months} mois. Si vous souhaitez un remboursement de vos dons, nous vous  serions reconnaissants de nous faire parvenir vos coordonnées bancaires.\n"
"</p>\n"
"\n"
"% if suspended:\n"
"    <p>\n"
"        Pour le reste de la période de suspension, nous vous proposons soit d'arrêter votre ordre permanent, soit de verser les dons dans notre fonds pour les enfants sans parrain.\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        Dans le cas contraire, nous vous proposons de verser les dons dans notre fonds pour les enfants sans parrain.\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Merci d’avance pour votre retour dans les prochaines semaines.\n"
"</p>\n"
"\n"
"% if suspended:\n"
"    <p>\n"
"        Nous vous tiendrons bien entendu au courant de la suite du processus.\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Meilleures salutations<br>\n"
"    ${object.user_id.signature | safe}\n"
"</p>"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_planned_exit_notification
msgid ""
"<p>\n"
"% set partner = object.partner_id\n"
"% set sponsorships = object.get_objects()\n"
"% set child = sponsorships.mapped(\"child_id\")\n"
"\n"
"${partner.salutation}\n"
"</p>\n"
"<p>\n"
"We have good news!  ${child.get_list('preferred_name', translate=False)} is coming to the end of the sponsorship journey after ${(datetime.datetime.now() -sponsorships[:1].start_date).days // 364} years of support from you and the staff in the field.\n"
"</p>\n"
"<p>\n"
"That's a reason to celebrate and be thankful!\n"
"</p>\n"
"<p>\n"
"You will receive more information about the end of the sponsorship in the coming weeks.\n"
"</p>\n"
"<p>\n"
"Thank you so much for your investment in the life of  ${child.get_list('preferred_name', translate=False)}.\n"
"</p>\n"
"<p>\n"
"See you soon.\n"
"</p>\n"
"<p>\n"
"Kind regards,\n"
"</p>\n"
"${object.user_id.signature | safe}"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped(\"child_id\")\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set nb_years = (sponsorships[:1].contract_duration // 364)\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Nous avons une nouvelle importante à vous annoncer.\n"
"</p>\n"
"<p>\n"
"    % if nb_years >= 1:\n"
"        Après ${(datetime.datetime.now() -sponsorships[:1].start_date).days // 364} ${'an' if nb_years == 1 else 'ans'} de soutien fidèle de votre part et\n"
"        de celle des collaborateurs du centre de développement de l’enfant, ${firstname} ${'va' if len(child) == 1 else 'vont'} terminer le programme de parrainage.\n"
"    % else:\n"
"        ${firstname.capitalize()} ${'va' if len(child) == 1 else 'vont'} terminer le programme de parrainage.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Quel sujet de reconnaissance !\n"
"</p>\n"
"<p>\n"
"    Vous recevrez dans les jours à venir des informations plus précises sur la fin de ${'ce' if len(child) == 1 else 'ces'} parrainage.\n"
"</p>\n"
"<p>\n"
"    Merci de votre investissement dans la vie de ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Avec nos meilleures salutations et à bientôt !\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.signature | safe}\n"
"</p>"

