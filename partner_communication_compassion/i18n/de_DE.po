#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_project_suspension_follow_up
msgid ""
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida "
"Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\"><br></p>"
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set project = child.mapped('project_id')[0]\n"
"    % set suspension = project.lifecycle_ids[0]\n"
"    % set type = suspension.type\n"
"    % set suspended = suspension.type == 'Suspension'\n"
"    % set reasons = suspension.suspension_reason_ids\n"
"    % set details = suspension.suspension_detail\n"
"    % set partner = object.partner_id\n"
"    % set firstname = child.get_list('preferred_name', 3, deine_patenkinder, translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"\n"
"    % if plural:\n"
"        % set du = 'ihr'\n"
"        % set bist = 'seid'\n"
"        % set investierst = 'investiert'\n"
"        % set dich = 'euch'\n"
"        % set hast = 'habt'\n"
"        % set dein = 'euer'\n"
"        % set deine = 'eure'\n"
"        % set deiner = 'eurer'\n"
"        % set dir = 'euch'\n"
"        % set konnte = 'konnten'\n"
"        % set wünschst = 'wünscht'\n"
"    % else:\n"
"        % set du = 'du'\n"
"        % set bist = 'bist'\n"
"        % set investierst = 'investierst'\n"
"        % set dich = 'dich'\n"
"        % set hast = 'hast'\n"
"        % set dein = 'dein'\n"
"        % set deine = 'deine'\n"
"        % set deiner = 'deiner'\n"
"        % set dir = 'dir'\n"
"        % set konnte = 'konnte'\n"
"        % set wünschst = 'wünschst'\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"% if suspended:\n"
"    <p>\n"
"        Leider müssen wir ${dich} darüber informieren, dass die Abklärungen über das Kinderzentrum von ${firstname} weiterhin im Gange sind. Jedoch bestätigt uns diese Tatsache, dass die internationalen Qualitätsstandards, nach denen Compassion  arbeitet, ernst genommen und umgesetzt werden.\n"
"    </p>\n"
"    <p>\n"
"        Für die weitere Zeit der Suspendierung schlagen wir ${dir} vor, entweder deinen Dauerauftrag einzustellen oder die Spenden unserem Fonds für Kinder ohne Paten zukommen zu lassen.\n"
"    </p>\n"
"    <p>\n"
"        Selbstverständlich werden wir dich über den weiteren Prozess informieren.\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        Wir freuen uns, ${dir} heute mitzuteilen, dass die Abklärungen über das Kinderzentrum von ${firstname} beendet und wieder alle Aktivitäten des Kinderzentrums aufgenommen werden konnten.\n"
"    </p>\n"
"    <p>\n"
"        <b>Von ganzem Herzen möchten wir uns bei ${dir} für ${dein} Vertrauen und ${deine} wertvolle Unterstützung während der Zeit der Suspendierung des Kinderzentrums bedanken.</b>\n"
"    </p>\n"
"    <p>\n"
"        <b>${deiner.title()} Spenden ${konnte} während dieser Zeit nicht weitergeleitet werden.</b> Falls ${du} eine Rückerstattung der Spenden ${wünschst}, sind wir ${dir} dankbar, wenn ${du} uns ${deine} Kontoangaben zukommen lässt. Andernfalls schlagen wir ${dir} vor, die Spenden unserem Fonds für Kinder ohne Paten zukommen zu lassen.\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Danke für deine Rückmeldung innerhalb der nächsten Wochen.\n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse<br>\n"
"    ${object.user_id.signature | safe}\n"
"</p>"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_planned_exit_notification
msgid ""
"<p>\n"
"% set partner = object.partner_id\n"
"% set sponsorships = object.get_objects()\n"
"% set child = sponsorships.mapped(\"child_id\")\n"
"\n"
"${partner.salutation}\n"
"</p>\n"
"<p>\n"
"We have good news!  ${child.get_list('preferred_name', translate=False)} is coming to the end of the sponsorship journey after ${(datetime.datetime.now() -sponsorships[:1].start_date).days // 364} years of support from you and the staff in the field.\n"
"</p>\n"
"<p>\n"
"That's a reason to celebrate and be thankful!\n"
"</p>\n"
"<p>\n"
"You will receive more information about the end of the sponsorship in the coming weeks.\n"
"</p>\n"
"<p>\n"
"Thank you so much for your investment in the life of  ${child.get_list('preferred_name', translate=False)}.\n"
"</p>\n"
"<p>\n"
"See you soon.\n"
"</p>\n"
"<p>\n"
"Kind regards,\n"
"</p>\n"
"${object.user_id.signature | safe}"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), translate=False)\n"
"    % set less_3 = firstname != children.get_number()\n"
"    % set nb_years = (sponsorships[:1].contract_duration // 364)\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Wir haben wichtige Neuigkeiten!\n"
"</p>\n"
"<p>\n"
"    % if nb_years > 1:\n"
"        Nach ${(datetime.datetime.now() -sponsorships[:1].start_date).days // 364} Jahren Unterstützung durch ${dich}\n"
"        und die Mitarbeitenden vor Ort kommt ${firstname} ans Ende der Patenschaft.\n"
"    % elif nb_years == 1:\n"
"        Nach 1 Jahr Unterstützung durch ${dich} und die Mitarbeitenden vor Ort kommt ${firstname} ans Ende der\n"
"        Patenschaft.\n"
"    % else:\n"
"        ${firstname.capitalize if len(children) > 3 else firstname} kommt ans Ende der Patenschaft.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Das ist ein Grund zur Dankbarkeit!\n"
"</p>\n"
"<p>\n"
"    Wir werden ${dir} in den kommenden Tagen genauere Informationen zum Ende der Patenschaft zukommen lassen.\n"
"</p>\n"
"<p>\n"
"    Herzlichen Dank für ${deine} Investition in das Leben von ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif"

