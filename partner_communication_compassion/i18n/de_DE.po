#. module: partner_communication_compassion
#: model:partner.communication.config,mobile_notification_body:partner_communication_compassion.child_letter_config
msgid ""
"% set types = ','.join(object.communication_type_ids.mapped('name')).lower()\n"
"% if 'gift' in types:\n"
"${object.child_id.preferred_name} wrote you a letter ${'with a picture ' if 'large' in types else ''}to thank you for your gift\n"
"% else:\n"
"${object.child_id.preferred_name} wrote you a ${'first' if 'new sponsor' in types else 'new'} letter\n"
"% endif"
msgstr ""
"% set types = ','.join(object.communication_type_ids.mapped('name')).lower()\n"
"% if 'gift' in types:\n"
"${object.child_id.preferred_name} hat dir einen Dankesbrief geschrieben für dein Geschenk\n"
"% else:\n"
"${object.child_id.preferred_name} hat dir einen ${'ersten' if 'new sponsor' in types else 'neuen'} Brief geschrieben\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.new_letter
msgid ""
"<!-- this is a comment for testing purposes -->\n"
"<!-- this is a comment for testing purposes --><div>\n"
"    % set letter = object.get_objects()\n"
"    % set child = letter.mapped('child_id')\n"
"    % set s = '' if len(child) == 1 else 's'\n"
"    % set partner = object.partner_id\n"
"    % set child = letter.mapped('child_id')\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set urls = []\n"
"\n"
"    % for letter_set in letter.filtered('read_url').mapped('read_url'):\n"
"        % if letter_set not in urls:\n"
"             % set void = urls.append(letter_set)\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % set field_office_ids = child.mapped('field_office_id').ids\n"
"    % set restricted = 1 in field_office_ids or 19 in field_office_ids\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    We are very happy to inform you that a new letter has arrived from ${child.get_list('preferred_name', 3, child.get_number()) or child.get_list('firstname', 3, child.get_number())}!\n"
"</p>\n"
"<p>\n"
"    You can download the letter by clicking on the link. Enjoy reading:\n"
"    <ul>\n"
"        % for l in urls:\n"
"            <li>\n"
"                <a href=\"${l}\">\n"
"                    ${l}\n"
"                </a>\n"
"            </li>\n"
"        % endfor\n"
"    </ul>\n"
"</p>\n"
"<p>\n"
"    ${years_uc} ${number_years} years of experience show us the importance of letters for the development of the children.\n"
"</p>\n"
"<p>\n"
"    Thank you in advance for taking a few minutes to reply to the enclosed letter. You can respond online via <a href=\"https://www.mycompassion.ch\">MyCompassion</a>.\n"
"</p>\n"
"% if restricted:\n"
"    <p>\n"
"        Important information about writing to your sponsored ${'child' if len(child) == 1 else 'children'}.\n"
"    </p>\n"
"    <div style=\"margin:20px auto; text-align: center;\">\n"
"        <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_de.pdf\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"            Information on writing letters\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"<p>\n"
"    Please do not hesitate to contact us with regards to any questions you may have in relation to exchanging letters.\n"
"</p>\n"
"<p>\n"
"    Best regards,\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
"% endif"
msgstr ""
"<div>\n"
"    % set letter = object.get_objects()\n"
"    % set child = letter.mapped('child_id')\n"
"    % set denBrief = 'den Brief' if len(letter) == 1 else 'die Briefe'\n"
"    % set leLien = 'den Link' if len(letter) == 1 else 'die Links'\n"
"    % set partner = object.partner_id\n"
"    % set child = letter.mapped('child_id')\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set Du = 'Ihr' if plural else 'Du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set hast = 'habt' if plural else 'hast'\n"
"    % set kannst = 'könnt' if plural else 'kannst'\n"
"    % set firstname = child.get_list('preferred_name', 3, deine + 'n Patenkindern', False)\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set urls = []\n"
"\n"
"    % for letter_set in letter.filtered('read_url').mapped('read_url'):\n"
"        % if letter_set not in urls:\n"
"            % set void = urls.append(letter_set)\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % set field_office_ids = child.mapped('field_office_id').ids\n"
"    % set restricted = 1 in field_office_ids or 19 in field_office_ids\n"
"\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"    % set christmas_fund_2022 = 265 in partner.category_id.ids\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    Wir freuen uns, ${dir} ${\"einen neuen Brief\" if len(letter) == 1 else \"die neuen Briefe\"} von ${firstname} zu\n"
"    senden!\n"
"</p>\n"
"\n"
"% if object.send_mode == \"sms\":\n"
"    <p>\n"
"        ${'Klickt' if plural else 'Klicke'} hier, um ${denBrief} herunterzuladen: <a href=\"${urls[0]}\">link</a>\n"
"    </p>\n"
"    <p>\n"
"        Viel Spass beim Lesen!\n"
"    </p>\n"
"    <p>\n"
"        ${'Nehmt' if plural else 'Nimm'} ${dir} doch fünf Minuten Zeit, um auf ${denBrief} zu antworten über <a href=\"https://mycompassion.ch/de_DE/my/letter\">MyCompassion</a>.\n"
"    </p>\n"
"    <p>\n"
"        Sarah<br>\n"
"        Tel: +41 (0)31 552 21 21<br>\n"
"        Fragen? Melde dich per WhatsApp bei uns: +41 (0)79 622 31 97\n"
"    </p>\n"
"% else:\n"
"    % if object.send_mode != 'physical':\n"
"        <p>\n"
"            ${'Klickt' if plural else 'Klicke'} auf ${leLien}, um ${denBrief} herunterzuladen.* Viel Spass beim Lesen:\n"
"        </p>\n"
"        <ul>\n"
"            % for l in urls:\n"
"                <li>\n"
"                    <a href=\"${l}\">${l}</a>\n"
"                </li>\n"
"            % endfor\n"
"        </ul>\n"
"    % endif\n"
"    <p>\n"
"        ${years_uc} ${number_years} Jahre Erfahrung zeigen uns, dass Briefe die Entwicklung des Kindes entscheidend beeinflussen können.\n"
"    </p>\n"
"    <p>\n"
"        ${'Nehmt' if plural else 'Nimm'} ${dir} doch fünf Minuten Zeit, um auf ${denBrief} zu antworten.\n"
"\n"
"        % if object.send_mode != \"physical\":\n"
"            ${\"Ihr könnt\" if plural else \"Du kannst\"} schnell und einfach über <a href=\"https://mycompassion.ch/de_DE/my/letter\">MyCompassion</a> schreiben.\n"
"        % else:\n"
"            ${\"Ihr könnt\" if plural else \"Du kannst\"} schnell und einfach über mycompassion.ch/de_DE/my/letter schreiben.\n"
"        % endif\n"
"    </p>\n"
"\n"
"    % if restricted:\n"
"        % if object.send_mode != \"physical\":\n"
"            <p>\n"
"                Besondere Informationen zum Briefeschreiben für ${dein if len(child) == 1 else deine} ${'Patenkind' if len(child)==1 else 'Patenkinder'}.\n"
"            </p>\n"
"            <div style=\"margin:20px auto; text-align: center;\">\n"
"                <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_de.pdf\" style=\"padding: 12px 18px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"                    Informationen zum Briefeschreiben\n"
"                </a>\n"
"            </div>\n"
"        % endif\n"
"    % endif\n"
"\n"
"    % if not partner.email:\n"
"        <p>\n"
"            Bitte ${'erwähnt' if plural else 'erwähne'} nie:\n"
"            <br>\n"
"        </p>\n"
"        <ul>\n"
"            <li>${deine} Postadresse</li>\n"
"            <li>${deine} E-Mail Adresse</li>\n"
"            <li>${deine} Telefonnummer</li>\n"
"            <li>die Adresse von Compassion Schweiz</li>\n"
"            <li>${deine} Kontaktdaten von Facebook oder anderen sozialen Medien</li>\n"
"            <li>${'Macht' if plural else 'Mache'} keine Versprechen, bspw. für ein Geschenk oder einen Besuch</li>\n"
"        </ul>\n"
"        <p>Vielen Dank!</p>\n"
"    % endif\n"
"\n"
"    <p>\n"
"        ${'Habt' if plural else 'Hast'} ${du} Fragen zur Korrespondenz mit ${child.get('eurem Patenkind') if plural else child.get('deinem Patenkind')}? Dann ${'meldet' if plural else 'melde'} ${dich} ungeniert bei uns.\n"
"    </p>\n"
"    <p>\n"
"        Liebe Grüsse\n"
"    </p>\n"
"\n"
"    % if object.send_mode != 'physical':\n"
"        <p>\n"
"            ${object.user_id.signature | safe}\n"
"        </p>\n"
"        <p>\n"
"            *Falls ${du} Probleme beim Öffnen des Briefes ${hast}, ${kannst} ${du} den Brief auf <a href=\"https://mycompassion.ch/de_DE/my/letter\">MyCompassion</a> herunterladen.\n"
"        </p>\n"
"\n"
"    % endif\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_completion_date_change
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    % set child = object.get_objects()\n"
"                </div>\n"
"                <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    ${object.partner_id.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    We learned that ${child.firstname} will finish the Compassion program on ${child.get_date('completion_date', 'date_full')}.\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_parent_alive
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    % set child = object.get_objects()\n"
"    % set role = 'mother' if child.household_id.revised_value_ids.name == 'Natural Mother Alive' else 'father'\n"
"    % set status = 'alive' if child.household_id.revised_value_ids.get_field_value() == 'True' else 'dead'\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation}\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Thank you for investing in the life of ${child.firstname} with a sponsorship.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    We have been notified from our local employees that the ${role} of your sponsored child has passed away. If you would like to write a few lines expressing your condolences to comfort ${child.get('him')}, this can be easily done via your <a href=\"https://www.compassion.ch\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">MyCompassion</a> profile.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    In this difficult time, your support for ${child.firstname} makes an even bigger difference.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Once again, thank you for your commitment so that together we can positively transform the lives of currently more than ${number_children} million children in ${number_countries} countries.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    With kind regards,\n"
"</p>\n"
"% if object.send_mode == 'digital':\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<!--\n"
"% set plural = object.partner_id.title.plural or object.partner_id.title.id == 29\n"
"% set deinem = 'eurem' if plural else 'deinem'\n"
"Wichtige Information zu ${deinem} Patenkind ${object.get_objects().get_list('old_firstname')}\n"
"-->\n"
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set role = 'die Mutter' if child.household_id.revised_value_ids.name == 'Natural Mother Alive' else 'der Vater'\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set firstname = child.get_list('preferred_name', 3, deine + 'n Patenkindern', False)\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"\n"
"    % set reason = False\n"
"    % set lifecycle = child.mapped('lifecycle_ids')\n"
"\n"
"    % for l in lifecycle:\n"
"        % if l.request_reason == 'death of caregiver':\n"
"            % if l.comments:\n"
"                % set reason = l.translate('comments')\n"
"            % endif\n"
"        % endif\n"
"    % endfor\n"
"</div>\n"
"    <p>\n"
"       ${partner.salutation}\n"
"    </p>\n"
"    <p>\n"
"        Leider kommen wir heute mit einer traurigen Nachricht zu ${dir}.\n"
"    </p>\n"
"    <p>\n"
"        Wir haben von unseren Mitarbeitenden vor Ort erfahren, dass ${role} ${child.get('eures Patenkindes') if plural else child.get('deines Patenkindes')} gestorben ist.\n"
"        <b>\n"
"            % if reason:\n"
"                ${reason}\n"
"            % endif\n"
"        </b>\n"
"        Vielleicht ${\"möchtet ihr\" if plural else \"möchtest du\"} ${child.get('ihm')} einige Zeilen schreiben, um ${child.get('ihm')} etwas Trost zu spenden? ${\"Ihr könnt\" if plural else \"Du kannst\"} schnell und einfach über \n"
"        % if object.send_mode == \"digital\":\n"
"            <a href=\"https://mycompassion.ch/de_DE/my/letter\">MyCompassion</a>\n"
"        % else:\n"
"            www.mycompassion.ch\n"
"        % endif\n"
"        schreiben.\n"
"    </p>\n"
"    <p>\n"
"        In dieser schwierigen Zeit ist ${deine} Unterstützung wertvoller denn je.\n"
"    </p>\n"
"    <p>\n"
"        Herzlichen Dank!\n"
"    </p>\n"
"    <p>\n"
"        Liebe Grüsse\n"
"        % if object.send_mode == 'digital':\n"
"            <p>${object.user_id.signature | safe}</p>\n"
"        % endif\n"
"    </p>\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_sponsorship_transfer_dossier
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set less_4 = len(child) &lt; 4\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set correspondant = object.partner_id in sponsorships.mapped('correspondent_id')\n"
"    % set partner = object.partner_id\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"</div>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    A very warm welcome to you, ${partner.firstname}!\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    It's so nice to have you as part of the Compassion Switzerland family!\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Together with you and ${number_fcps} partner churches in ${number_countries} countries, we are currently releasing over ${number_children} million children from poverty. Collectively, we enable the children to have a life with a future filled with hope.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    In order to ensure a smooth continuation to your sponsorship for ${firstname}, please find attached important information:\n"
"</p>\n"
"<ul style=\"margin:0px 0 1rem 0;\">\n"
"    <li>1 photo of ${'your sponsored child' if one_child else 'each child'}</li>\n"
"    <li>1 folder with important information about your sponsorship</li>\n"
"\n"
"    % if object.send_mode == \"physical\":\n"
"        <li>1 sheet of labels for the letter correspondence (please stick them on cards, letters, stickers, drawings, etc.)</li>\n"
"    % endif\n"
"</ul>\n"
"\n"
"% if payer:\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"        % if lsv_dd:\n"
"            We kindly ask you to fill in and return via post the attached bank form to continue your sponsorship journey with ${firstname}.\n"
"        % else:\n"
"            We kindly ask you to activate a standing order with the attached payment slip to continue your sponsorship journey with ${firstname}.\n"
"        % endif\n"
"    </p>\n"
"% endif\n"
"\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Please do not hesitate to get in touch with us if you have any further questions.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Thank you so much for investing in the ${'life of ' + firstname if less_4 else 'lives of many children'}!\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    We wish you much joy as you continue your sponsorship journey.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Together, we are changing the world! One child at a time.\n"
"</p>\n"
"<p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"    Warm regards\n"
"</p>\n"
"\n"
"% if object.send_mode == \"digital\":\n"
"    <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'   \n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set less_4 = firstname != child.get_number()\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set correspondant = object.partner_id in sponsorships.mapped('correspondent_id')\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"</div>\n"
"<div style=\"font-size:8pt\">\n"
"    <p>\n"
"        ${object.partner_id.salutation}\n"
"    </p>\n"
"    <p>\n"
"        So schön, dass ${du} nun zur Familie von Compassion in der Schweiz ${'gehört' if plural else 'gehörst'}!\n"
"    </p>\n"
"    <p>\n"
"        Mit ${dir} zusammen befreien wir zurzeit mit rund ${number_fcps} Partnerkirchen in ${number_countries} Ländern ${number_children} Millionen Kinder aus extremer Armut. Gemeinsam ermöglichen wir den Kindern ein Leben mit Hoffnung und Zukunft.\n"
"    </p>\n"
"    % if not partner.email:\n"
"        <p>\n"
"            Damit die ${child.get('Patenschaft')} für ${firstname if less_4 else deine + ' Patenkinder'} gut weitergeführt werden ${'kann' if len(child) == 1 else 'können'}, ${'findet ihr' if plural else 'findest du'} einige wichtige Informationen beigelegt:\n"
"        </p>\n"
"        <ul>\n"
"            <li>\n"
"                1 Foto von ${firstname if less_4 else 'jedem Kind'}\n"
"            </li>\n"
"            <li>\n"
"                1 Patenschaftsdossier mit praktischen Informationen\n"
"            </li>\n"
"            <li>\n"
"                ${\"1 Blatt\" if len(child) == 1 else \"Blätter\"} mit Etiketten für den Briefwechsel (bitte auf Karten, Briefe, Aufkleber, Zeichnungen usw. kleben)\n"
"            </li>\n"
"        </ul>\n"
"    % endif\n"
"<!-- All recipients are payers -->\n"
"<!--    % if payer: -->\n"
"    <p>\n"
"        Um ${deine} Unterstützung für ${firstname if less_4 else 'die Kinder'} weiterzuführen, sind wir dankbar, wenn ${du}\n"
"        % if lsv_dd:\n"
"            die Einzugsermächtigung für die Bank ${\"ausfüllt\" if plural else \"ausfüllst\"} und uns per Post ${\"zurückschickt\" if plural else \"zurückschickst\"}.\n"
"        % else:\n"
"            den Dauerauftrag mit dem beiliegenden Einzahlungsschein ${\"aktiviert\" if plural else \"aktivierst\"}.\n"
"        % endif\n"
"    </p>\n"
"<!--    % endif -->\n"
"    <p>\n"
"        Falls ${du} noch Fragen ${\"habt\" if plural else \"hast\"}, sind wir gerne für ${dich} da.\n"
"    </p>\n"
"    <p>\n"
"        Vielen Dank, dass ${du} in das Leben von ${firstname if less_4 else \"vielen Kindern\"} ${\"investiert\" if plural else \"investierst\"}!\n"
"    </p>\n"
"    <p>\n"
"        Wir wünschen ${dir} viel Freude dabei.\n"
"    </p>\n"
"    <p>\n"
"        ${'Habt ihr' if plural else 'Hast du'} gewusst, dass ${du} ${deine + \"m Patenkind\" if len(child) == 1 else deine + \"n Patenkindern\"} schnell und einfach über <a href=\"https://mycompassion.ch/de_DE\">MyCompassion</a> schreiben ${\"könnt\" if plural else \"kannst\"}? Dort ${\"habt ihr\" if plural else \"hast du\"} die Bilder, Briefe und alle Informationen ${(deine + 's Patenkindes') if len(child) == 1 else (deine + 'r Patenkinder')} immer zur Hand.\n"
"    </p>\n"
"    <p>\n"
"        Gemeinsam verändern wir das Leben von Kindern - eins nach dem anderen.\n"
"    </p>\n"
"    <p>\n"
"        Liebe Grüsse\n"
"    </p>\n"
"    % if object.send_mode == \"digital\":\n"
"        ${object.user_id.signature | safe}\n"
"    % endif\n"
"</div>"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_gender
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${child.firstname}&nbsp;with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   In circumstances of extreme poverty, sometimes data is not collected correctly. This is the case with your sponsored child. We have been informed that ${child.get('he')} was introduced to you as a ${'boy' if child.old_values == 'M' else 'girl'} even though${child.get('he')}&nbsp;is a ${'boy' if child.gender == 'M' else 'girl'}. We thank you in advance for your understanding.\n"
"   <br>\n"
"   <br>\n"
"   Your support of a child in extreme poverty is valuable. At Compassion, we believe this will give a child the chance to live with purpose. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your committment so that together we can positively transform the lives of currently 2 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Your sincerely,\n"
"   % if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"     ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"% if len(object.get_objects()) == 1:\n"
"    <div>\n"
"        % set child = object.get_objects()\n"
"        % set partner = object.partner_id\n"
"        % set plural = partner.title.plural or partner.title.id == 29\n"
"        % set du = 'ihr' if plural else 'du'\n"
"        % set dein = 'euer' if plural else 'dein'\n"
"        % set deine = 'eure' if plural else 'deine'\n"
"        % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"        % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"        % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"        % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"        % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"        % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"        % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"        % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"    </div>\n"
"\n"
"    % if object.send_mode == \"sms\":\n"
"        <p>\n"
"            ${partner.salutation}\n"
"        </p>\n"
"        <p>\n"
"            In der Realität von extremer Armut werden Daten manchmal nicht korrekt aufgenommen.\n"
"        </p>\n"
"        <p>\n"
"            ${child.get_list(\"preferred_name\", translate=False)} wurde ${'euch' if plural else 'dir'} als ${'Junge' if child.old_values == 'M' else 'Mädchen'} vorgestellt, obwohl ${child.get('he')} ein ${'Junge' if child.gender == 'M' else 'Mädchen'} ist. Das tut uns leid! Danke für ${dein} Verständnis.\n"
"        </p>\n"
"        <p>\n"
"            Danke für ${deine} wertvolle Unterstützung.\n"
"        </p>\n"
"        <p>\n"
"            Liebe Grüsse<br/>\n"
"            ${whatsapp_signature}\n"
"        </p>\n"
"    % else:\n"
"        <p>\n"
"            ${partner.salutation}\n"
"        </p>\n"
"        <p>\n"
"            Im Kontext von extremer Armut, wo es oft ums nackte Überleben geht, werden Dinge, wie beispielsweise die\n"
"            korrekte Aufnahme von Daten, anders gewichtet als bei uns.\n"
"        </p>\n"
"        <p>\n"
"            Bei der Registrierung ${deine}s Patenkindes im Kinderzentrum wurde ${child.get('sein')} Geschlecht falsch\n"
"            aufgenommen.\n"
"        </p>\n"
"        <p>\n"
"            Leider wurde ${child.get('he')} ${'euch' if plural else 'dir'} als ${'Junge' if child.old_values == 'M' else\n"
"            'Mädchen'} vorgestellt, obwohl ${child.get('he')} ein ${'Junge' if child.gender == 'M' else 'Mädchen'} ist.\n"
"            Das tut uns wirklich sehr leid! Danke für ${dein} Verständnis.\n"
"        </p>\n"
"        <p>\n"
"            Mit ${years_lc} ${number_years} Jahren Erfahrung wissen wir, dass eine Patenschaft nicht nur das Leben eines\n"
"            Kindes, sondern die ganze Familie und deren soziales Umfeld nachhaltig verändern kann.\n"
"        </p>\n"
"        <p>\n"
"            Danke, dass ${du} uns im Kampf gegen extreme Armut zur Seite ${'steht' if plural else 'stehst'}!\n"
"        </p>\n"
"        <p>\n"
"            Liebe Grüsse\n"
"        </p>\n"
"        % if object.send_mode == 'digital':\n"
"            ${object.user_id.signature | safe}\n"
"        % endif\n"
"    % endif\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_birthdate
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${child.firstname}.&nbsp;In situations of extreme poverty, sometimes data is not recorded correctly. This is the case with your sponsored child. We were informed that your sponsored child was not born on ${child.get_date('old_values', 'date_full')} but on ${child.get_date('birthdate', 'date_full')}.\n"
"   <br>\n"
"   <br>\n"
"   Your&nbsp;support of a child in extreme poverty is valuable.&nbsp; At Compassion, we believe that this will give a child the opportunity to live a purposeful life. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Thank you again for your commitment so that together we can positively change the lives of currently more than 1.9 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"% if object.send_mode == 'digital':\n"
"       ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set children = len(child) != 1\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set preferred_name = child.get_list('preferred_name', translate=False)\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"</div>\n"
"% if not children:\n"
"    <p>\n"
"        ${partner.salutation}\n"
"    </p>\n"
"\n"
"    % if object.send_mode != \"sms\":\n"
"        <p>\n"
"            Herzlichen Dank, dass ${du} in das Leben von ${preferred_name} ${'investiert' if plural else 'investierst'}.\n"
"        </p>\n"
"    % endif\n"
"\n"
"    <p>\n"
"        Im Kontext von extremer Armut werden Daten manchmal nicht korrekt aufgenommen, da viele Kinder nicht in einer\n"
"        Institution geboren werden. Viele besitzen deshalb auch keine Geburtsurkunde.\n"
"    </p>\n"
"    <p>\n"
"        Bei ${deine}m Patenkind wurde leider das Geburtsdatum falsch registriert.\n"
"    </p>\n"
"    <p>\n"
"        Wir wurden informiert, dass ${preferred_name} nicht am ${child.get_date('old_values', 'date_full')}, sondern am\n"
"        ${child.get_date('birthdate', 'date_full')} geboren wurde.\n"
"    </p>\n"
"\n"
"    % if object.send_mode != \"sms\":\n"
"        <p>\n"
"            ${deine.title()} Unterstützung eines Kindes in extremer Armut ist so wertvoll. Bei Compassion sind wir davon\n"
"            überzeugt, dass ${du} dazu ${'beitragt' if plural else 'beiträgst'}, einem Kind die Chance auf ein Leben mit\n"
"            Zukunft und Hoffnung zu ermöglichen.\n"
"        </p>\n"
"        <p>\n"
"            Liebe Grüsse\n"
"\n"
"            % if object.send_mode == 'digital':\n"
"                <br>\n"
"                <br>\n"
"                ${object.user_id.signature | safe}\n"
"            % endif\n"
"        </p>\n"
"    % else:\n"
"        <p>\n"
"            Danke für ${deine} wertvolle Unterstützung.\n"
"            <br>\n"
"            Sarah\n"
"            <br>\n"
"            Tel: +41 (0)31 552 21 21\n"
"            <br>\n"
"            Fragen? Melde dich per WhatsApp bei uns: +41 (0)79 622 31 97\n"
"        </p>\n"
"    % endif\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_multiple_changes
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${child.get_list('old_firstname')}&nbsp;with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   The situation of your sponsored child has changed. We received the following message from the project where ${child.get_list('old_firstname')} is attending.\n"
"   <br>\n"
"   <br>\n"
"   Your support of a child in extreme poverty is valuable. At Compassion we believe that this will give a child the chance to live a purposeful life. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can transform the lives of currently 2 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Your sincerely,  \n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"      ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"\n"
"<p>\n"
"    Wir haben vom Kinderzentrum erfahren, dass sich die Situation ${deine}s Patenkindes wie folgt verändert hat:\n"
"</p>\n"
"<ul>\n"
"    % for revision in child.mapped('revised_value_ids') + child.mapped('household_id.revised_value_ids'):\n"
"        <li>\n"
"            ${revision.name} : ${revision.old_value} -&gt; ${revision.get_field_value()}\n"
"        </li>\n"
"    % endfor\n"
"</ul>\n"
"\n"
"% if object.send_mode != \"sms\":\n"
"<p>\n"
"    Mit ${years_lc} ${number_years} Jahren Erfahrung wissen wir, dass eine Patenschaft nicht nur das Leben eines\n"
"    Kindes, sondern die ganze Familie und deren soziales Umfeldes nachhaltig verändern kann.\n"
"</p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Danke, dass ${du} uns im Kampf gegen extreme Armut zur Seite ${'steht' if plural else 'stehst'}!\n"
"</p>\n"
"\n"
"% if object.send_mode != \"sms\":\n"
"<p>Liebe Grüsse</p>\n"
"    % if object.send_mode == 'digital':\n"
"        ${object.user_id.signature | safe}\n"
"    % endif\n"
"% else:\n"
"    <p>Liebe Grüsse<br/>\n"
"    Sarah<br/>\n"
"    Tel: +41 (0)31 552 21 21<br/>\n"
"    Fragen? <a href=\"${wp_tchat_url}\">${wp_tchat_url}</a>\n"
"% endif\n"
" "

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_name
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${child.old_firstname}&nbsp;with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   In extreme poverty situations, data may not be collected correctly or the family situation may change.&nbsp; This is the case with your sponsored child.\n"
"   <br>\n"
"   <br>\n"
"   From now on, you can call your sponsored child,\n"
"   <b style=\"font-weight:bolder;\">\n"
"    ${child.preferred_name}\n"
"   </b>\n"
"   in your next letter.\n"
"   <br>\n"
"   <br>\n"
"   Your support of a child in extreme poverty is valuable. At Compassion, we believe this will give a child the opportunity to live a purposeful life. ${object.succes_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can positively transform the lives of currently more than 2 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Your sincerly,   \n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"      ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<!--\n"
"% if len(object.get_objects()) == 1:\n"
"    % set plural = object.partner_id.title.plural or object.partner_id.title.id == 29\n"
"    % set deinem = 'eurem' if plural else 'deinem'\n"
"    Wichtige Information zu ${deinem} Patenkind ${object.get_objects().get_list('old_firstname')}%\n"
"% endif\n"
"-->\n"
"% if len(object.get_objects()) == 1:\n"
"    <div>\n"
"        % set child = object.get_objects()\n"
"        % set partner = object.partner_id\n"
"        % set plural = partner.title.plural or partner.title.id == 29\n"
"        % set du = 'ihr' if plural else 'du'\n"
"        % set dein = 'euer' if plural else 'dein'\n"
"        % set deine = 'eure' if plural else 'deine'\n"
"        % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"    </div>\n"
"    <p>\n"
"        ${partner.salutation}\n"
"    </p>\n"
"        <p>\n"
"        Im Kontext von extremer Armut, wo es oft ums nackte Überleben geht, werden Dinge, wie beispielsweise die\n"
"        korrekte Aufnahme von Daten, anders gewichtet als bei uns.\n"
"    </p>\n"
"    <p>\n"
"        Bei der Registrierung ${deine}s Patenkindes im Kinderzentrum wurde ${child.get('sein')} Rufname falsch\n"
"        aufgenommen. Das tut uns leid!\n"
"    </p>\n"
"    <p>\n"
"        Ab jetzt ${'könnt' if plural else 'kannst'} ${du} ${dein} Patenkind ${child.preferred_name} nennen.\n"
"    </p>\n"
"\n"
"    % if object.send_mode != \"sms\":\n"
"        <p>\n"
"            ${deine.title()} Unterstützung für ein Kind in extremer Armut ist wertvoll. Bei Compassion sind wir davon\n"
"            überzeugt, dass ${du} dazu ${'beitragt' if plural else 'beiträgst'}, einem Kind die Chance auf ein Leben\n"
"            mit Zukunft und Hoffnung zu ermöglichen.\n"
"        </p>\n"
"        <p>\n"
"            Liebe Grüsse\n"
"        </p>\n"
"        % if object.send_mode == 'digital':\n"
"            ${object.user_id.signature | safe}\n"
"        % endif\n"
"    % else:\n"
"        <p>\n"
"            Liebe Grüsse<br/>\n"
"            Sarah<br/>\n"
"            Tel: +41 (0)31 552 21 21<br/>\n"
"            Fragen? Melde dich per WhatsApp bei uns: +41 (0)79 622 31 97 \n"
"        </p>\n"
"    % endif\n"
"% endif\n"
"\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_disability
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of&nbsp;${child.preferred_name}&nbsp;with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   In Switzerand and also in the country where your sponsored child lives, there are health problems despite medical precautions and examinations. We have been informed by the local staff that ${child.preferred_name} has contracted&nbsp;${child.current_values}.\n"
"   <br>\n"
"   <br>\n"
"   Thanks to your support and a special fund for medical emergencies, Compassion is able to look after the health problems of ${child.preferred_name}. Thank you for accompanying ${child.get('him')} in prayer.\n"
"   <br>\n"
"   <br>\n"
"   Your support for a child in extreme poverty is valuable. At Compassion, we believe this will give a child the chance to live a dignified and meaningful life. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can positively transform the lives of over 1.9 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Sincerely,\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"      ${object.user_id.signature | safe}\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"% if len(object.get_objects()) == 1:\n"
"    <div>\n"
"        % set child = object.get_objects()\n"
"        % set firstname = child.get_list('preferred_name', translate=False)\n"
"        % set partner = object.partner_id\n"
"        % set plural = partner.title.plural or partner.title.id == 29\n"
"        % set du = 'ihr' if plural else 'du'\n"
"        % set dein = 'euer' if plural else 'dein'\n"
"        % set deine = 'eure' if plural else 'deine'\n"
"        % set dir = 'euch' if plural else 'dir'\n"
"        % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"        % set illness = child.current_values\n"
"\n"
"        % if not illness:\n"
"            % set illness = '[insert information]'\n"
"        % endif\n"
"    </div>\n"
"    <p>\n"
"        ${partner.salutation}\n"
"    </p>\n"
"    <p>\n"
"        Leider kommen wir heute mit einer traurigen Nachricht zu ${dir}.\n"
"    </p>\n"
"    <p>\n"
"        Wir wurden vom Kinderzentrum informiert, dass ${firstname} leider an ${illness} erkrankt ist.\n"
"    </p>\n"
"    <p>\n"
"        Dank ${deine}r Unterstützung und des Fonds für medizinische Notfälle kümmert sich Compassion um ${firstname}.\n"
"    </p>\n"
"    <p>\n"
"        Gerne ${'könnt' if plural else 'kannst'} ${du} für ${child.get('ihn')} für Schutz und Gesundheit beten.\n"
"    </p>\n"
"\n"
"    % if object.send_mode == \"sms\":\n"
"        <p>\n"
"            Liebe Grüsse\n"
"            <br>\n"
"            Sarah\n"
"            <br>\n"
"            Tel: +41 (0)31 552 21 21\n"
"            <br>\n"
"            Fragen? Melde dich per WhatsApp bei uns: +41 (0)79 622 31 97\n"
"        </p>\n"
"    % else:\n"
"        <p>\n"
"            ${deine.title()} Unterstützung eines Kindes in extremer Armut ist so wertvoll. Bei Compassion sind wir\n"
"            davon überzeugt, dass ${du} dazu ${'beitragt' if plural else 'beiträgst'}, einem Kind die Chance auf ein\n"
"            Leben mit Zukunft und Hoffnung zu ermöglichen.\n"
"        </p>\n"
"        <p>\n"
"            Liebe Grüsse\n"
"            % if object.send_mode == 'digital':\n"
"                <br>\n"
"                <br>\n"
"                ${object.user_id.signature | safe}\n"
"            % endif\n"
"        </p>\n"
"    % endif\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_sponsorship_cancellation
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   % set partner = object.partner_id\n"
"                    \n"
"% set sponsorships = object.get_objects()\n"
"                    \n"
"% set children = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = children.get_list('preferred_name', 3, 'many children', False)\n"
"  </div>\n"
"  <p style=\"margin:0px 0px 10px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"   We took note of the cancellation of your sponsorship toward ${firstname}.\n"
"   <br>\n"
"   <br>\n"
"   Thank you so much for having sponsored ${children.get('this child')}!                    Thanks to your sponsorship, ${children.get('he')} could participate in all the activities offered by the Compassion child project:                    food, clothes, academic support, health screenings and treatments, Bible studies, games, field trips, birthday and Christmas gifts and a lot more.\n"
"   <br>\n"
"   <br>\n"
"   We will now look for a new sponsor to continue the follow up with ${firstname}.\n"
"   <br>\n"
"   <br>\n"
"   With our best regards,\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set Deine = 'Eure' if plural else 'Deine'\n"
"    % set kannst = 'könnt' if plural else 'kannst'\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % if len(children) > 1:\n"
"        % set child_plural = True\n"
"    % else:\n"
"        % set child_plural = False\n"
"    % endif\n"
"    % set firstname = children.get_list('preferred_name', 3, deine + ' Patenkinder', False)\n"
"    % set Firstname = children.get_list('preferred_name', 3, Deine + ' Patenkinder', False)\n"
"    % set nb_weeks = sponsorships[:1].contract_duration // 7\n"
"    % set nb_years = (sponsorships[:1].contract_duration // 364) or 1\n"
"    % set field = children[:1].field_office_id\n"
"    % set hours_fcp = field.fcp_hours_week * nb_weeks\n"
"    % set meals = field.fcp_meal_week * nb_weeks\n"
"    % set medical = field.fcp_medical_check * nb_years\n"
"    % set child_he = children.get(\"he\")\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    % if 7 in sponsorships.mapped(\"end_reason_id\").ids or 9 in sponsorships.mapped(\"end_reason_id\").ids:\n"
"        ${\"Ihr habt euch\" if plural else \"Du hast dich\"} entschieden, die Patenschaft für ${firstname} zu übernehmen um ${children.get('ihn')} aus extremer Armut zu befreien. Leider wurde dieses Engagement nicht mehr mit der von ${dir} zugesagten Unterstützung bestätigt.\n"
"</p>\n"
"<p>\n"
"        Deswegen informieren wir ${dich} hiermit, dass wir die ${children.get('Patenschaft')} heute annulliert haben.\n"
"</p>\n"
"    % else:\n"
"<p>\n"
"        Hiermit bestätigen wir die Auflösung der ${children.get('Patenschaft')} für ${firstname}.\n"
"</p>\n"
"<p>\n"
"        Während ${deine}r Patenschaft konnte${\"n\" if child_plural else \"\"} ${firstname} ${hours_fcp} Stunden im Kinderzentrum verbringen. In der lokalen Kirche wurde${\"n\" if child_plural else \"\"} ${child_he} liebevoll betreut und ${\"haben\" if child_plural else \"hat\"} Hoffnung für ${children.get('sein')} Leben bekommen. ${Firstname} ${\"haben\" if child_plural else \"hat\"} ${meals} Mahlzeiten erhalten und bekam${\"en\" if child_plural else \"\"} ${medical} medizinische ${\"Untersuchung\" if medical == 1 else \"Untersuchungen\"}. ${children.get('he').title()}\n"
"        % if min(children.mapped('age')) >= 7:\n"
"            konnte${'' if len(children) == 1 else 'n'} zur Schule gehen,\n"
"        % endif\n"
"        ${\"wurden\" if child_plural else \"wurde\"} individuell gefördert und ${\"wussten\" if child_plural else \"wusste\"}, dass sich auf der anderen Seite der Welt jemand um ${children.get('ihn')} kümmert. <b>Vielen herzlichen Dank!</b>\n"
"</p>\n"
"    % endif\n"
"<p>\n"
"    Wir werden nun\n"
"    % if plural:\n"
"        neue Paten\n"
"    % else:\n"
"        ${\"eine neue Patin\" if partner.gender == \"F\" else \"einen neuen Paten\"}\n"
"    % endif\n"
"    für ${children.get('ihn')} suchen, um die Unterstützung fortsetzen zu können.\n"
"</p>\n"
"<!-- CSP -->\n"
"<p>\n"
"    Kinderpatenschaften sind nur ein Programmteil von Compassion. ${\"Habt ihr\" if plural else \"Hast du\"} gewusst, dass ${du} Babys und Mütter im Überlebensprogramm unterstützen ${\"könnt\" if plural else \"kannst\"}? Mit einer einmaligen oder regelmässigen Spende ${'könnt ihr' if plural else 'kannst du'} einen grossen Unterschied bewirken: Medizinische Betreuung während der Schwangerschaft, Entbindung in einer medizinischen Einrichtung, Beratung zum Thema Elternwerden, psychische, soziale und geistliche Betreuung, materielle Unterstützung sowie Ausbildung für Einkommenssicherung.\n"
"</p>\n"
"<p>\n"
"    Mit CHF 15.- unterstützt ${du} eine Frau und ihr Baby während einer ganzen Woche. Gerne ${'könnt ihr euch' if plural else 'kannst du dich'} bei uns melden oder hier spenden:\n"
"    % if object.send_mode == \"digital\":\n"
"        <a href=\"https://compassion.ch/de/ueberleben/\">Überlebensprogramm.</a>\n"
"    % else:\n"
"        www.compassion.ch/de/ueberleben/.\n"
"    % endif\n"
"</p>\n"
"<!-- WASH -->\n"
"<!--\n"
"<p>\n"
"    Kinderpatenschaften sind nur ein Programmteil von Compassion, um jeden Tag mehr Kinder aus Armut zu befreien. Wusstest ${du}, dass fast 4 von 10 Menschen auf der Welt keinen täglichen Zugang zu sicheren Toiletten haben? Aufgrund von verunreinigtem Wasser und fehlenden WCs werden Kinder oft krank und können nicht zur Schule gehen. Compassion baut und renoviert Toiletten und begleitet Kinder und Familien mit Hygieneschulungen, um ihre Entwicklung zu fördern.\n"
"</p>\n"
"<p>\n"
"    Mit einer einmaligen oder regelmässigen Spende von CHF 30.- ${kannst} ${du} einem Kind Zugang zu sicheren Toiletten ermöglichen und einen grossen Unterschied in seinem Leben bewirken. Gerne ${kannst} ${du} ${dich} bei uns melden oder <a href=\"https://compassion.ch/de/toiletten-fuer-alle/#spenden\">hier spenden</a>.\n"
"</p>\n"
"-->\n"
"<p>\n"
"    Wir würden uns sehr freuen, ${dich} weiterhin im Kampf gegen Armut an unserer Seite zu haben!\n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    ${object.user_id.signature | safe}\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.b2s_email_not_read
msgid ""
"<div>\n"
"\n"
"    % set letter = object.get_objects()\n"
"    % set child = letter.mapped('child_id')\n"
"    % set s = '' if len(child) == 1 else 's'\n"
"    % set partner = object.partner_id\n"
"    % set partner_name = partner.firstname and (partner.firstname + ' ' + partner.lastname) or partner.name\n"
"    % set firstname = child.get_list('preferred_name', 3, 'your sponsored children', False)\n"
"    % set email = partner.email\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    A few days ago, you should have received a letter by email from ${firstname}.</p>\n"
"<p>\n"
"    Unfortunately, it does not seem to have been delivered to the email address ${email}.\n"
"</p>\n"
"<p>\n"
"    That is why we are sending you the letter by post. We hope you enjoy it!\n"
"</p>\n"
"<p>\n"
"    Has your email changed? Or maybe the email landed in your spam folder?\n"
"</p>\n"
"<p>\n"
"    Please let us know if you have a new email address or kindly add info@compassion.ch to your contacts to ensure that the email does not land in the spam folder.\n"
"</p>\n"
"<p>\n"
"    ${years_uc} ${number_years} years of experience has shown us that letters have a decisive influence on the children’s development.\n"
"</p>\n"
"<p>\n"
"    Thank you for taking a few minutes of your time to respond to the letter online in your <a href='https://mycompassion.ch'>MyCompassion profile</a>.\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
"% endif"
msgstr ""
"<div>\n"
"    % set letter = object.get_objects()\n"
"    % set child = letter.mapped('child_id')\n"
"    % set partner = object.partner_id\n"
"    % set all_children = partner.sponsorship_ids.filtered('is_active').mapped('child_id')\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set firstname = child.get_list('preferred_name', 3, deine + 'n Patenkindern', False)\n"
"    % set child = letter.mapped('child_id')\n"
"    % set one = len(letter) == 1\n"
"    % set christmas_fund_2022 = 265 in partner.category_id.ids    \n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Vor ein paar Tagen ${'habt ihr' if plural else 'hast du'} per E-Mail ${\"einen Brief\" if one else \"Briefe\"} von ${firstname} bekommen. Leider ${\"scheint er\" if one else \"scheinen sie\"} ${'euch' if plural else 'dich'} unter der E-Mail-Adresse ${partner.email} nicht erreicht zu haben.\n"
"</p>\n"
"<p>\n"
"    Deswegen schicken wir ${'euch' if plural else 'dir'} hiermit ${\"den Brief\" if one else \"die Briefe\"} per Post zu. Viel Spass beim Lesen!\n"
"</p>\n"
"<p>\n"
"    ${'Habt ihr' if plural else 'Hast du'} die E-Mail-Adresse geändert? Oder ist die E-Mail eventuell im Spam-Ordner gelandet? Bitte ${'gebt' if plural else 'gib'} uns Bescheid, falls ${du} eine neue E-Mail Adresse ${'habt' if plural else 'hast'} oder ${'fügt' if plural else 'füge'} compassion@compassion.ch zu ${deine}m Adressbuch hinzu, damit die E-Mails nicht im Spam-Ordner landen.\n"
"</p>\n"
"<p>\n"
"    Mit ${years_lc} ${number_years} Jahren Erfahrung zeigen uns, dass Briefe die Entwicklung des Kindes entscheidend beeinflussen.\n"
"</p>\n"
"<p>\n"
"    ${'Nehmt euch' if plural else 'Nimm dir'} doch fünf Minuten Zeit, um auf ${\"den Brief\" if one else \"die Briefe\"} zu antworten. ${\"Ihr könnt\" if plural else \"Du kannst\"} schnell und einfach entweder über www.mycompassion.ch oder die App schreiben.\n"
"</p>\n"
"<p>\n"
"    Herzlichen Dank, dass ${du} in das Leben ${all_children.get(\"eures Patenkindes\") if plural else all_children.get(\"deines Patenkindes\")} ${\"investiert\" if plural else \"investierst\"}. \n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.short_signature | striptags}\n"
"</p>\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_caregiver_change
msgid ""
"<div>\n"
"                    % set child = object.get_objects()\n"
"                    % set caregiver = child.household_id.primary_caregiver\n"
"                </div>\n"
"                <p>\n"
"                    ${object.partner_id.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    We learned that the primary caregiver of ${child.firstname} is now ${child.get('his')}\n"
"                    % if 'Beneficiary' not in caregiver:\n"
"                        ${caregiver}\n"
"                    % else:\n"
"                        ${'sister' if 'Female' in caregiver else 'brother'}\n"
"                    % endif\n"
"                    .\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_project_reactivation
msgid ""
"<div>\n"
"                    % set child = object.get_objects()\n"
"                    % set project = child.mapped('project_id')[0]\n"
"                    % set reactivation = project.lifecycle_ids[0]\n"
"                    % set details = reactivation.icp_improvement_desc\n"
"                </div>\n"
"                <p>\n"
"                    ${object.partner_id.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    A few time ago the project ${project.icp_id} where ${child.get('your sponsored child')} ${child.get('is')} registered was on suspension.\n"
"                    We are happy to inform you that the problem is resolved and that the project is again sane and active.\n"
"                    The project will do regular tuitions and spiritual activites to keep the situation healthy.\n"
"                    <br>\n"
"                    <br>\n"
"                    % if details:\n"
"                        ${details}\n"
"                        <br>\n"
"                        <br>\n"
"                    % endif\n"
"                    Yours sincerely\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_project_transition
msgid ""
"<div>\n"
"                    % set child = object.get_objects()\n"
"                    % set project = child.mapped('project_id')[0]\n"
"                    % set transition = project.lifecycle_ids[0]\n"
"                    % set details = transition.details\n"
"                </div>\n"
"                <p>\n"
"                    ${object.partner_id.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    A few time ago the project ${project.icp_id} where ${child.get('your sponsored child')} ${child.get('is')} registered was on suspension.\n"
"                    <br>\n"
"                    <br>\n"
"                    Unfortunately the local church will definitely end its partnership with Compassion\n"
"                    % if transition.transition_date:\n"
"                        <!-- --> on ${transition.get_date('transition date', 'date_full')}\n"
"                    % endif\n"
"                    % if transition.transition_reason_ids:\n"
"                        <!-- --> because of ${transition.get_list('transition_reason_ids.value')}\n"
"                    % endif\n"
"                    .\n"
"                    % if transition.future_involvement_ids:\n"
"                        The project will continue to work and offer ${transition.get_list('future_involvement_ids.value')} in its area.\n"
"                    % endif\n"
"                    <br>\n"
"                    <br>\n"
"                    % if details:\n"
"                        <span style=\"font-style: italic;\">${details}</span>\n"
"                        <br>\n"
"                        <br>\n"
"                    % endif\n"
"                    % if transition.action_plan:\n"
"                        <span style=\"font-style: italic;\">${transition.action_plan}</span>\n"
"                        <br>\n"
"                        <br>\n"
"                    % endif\n"
"                    The children living close to another project will be transfered.\n"
"                    <br>\n"
"                    <br>\n"
"                    We feel sorry for this situation and hope you will understand. You will receive soon another letter that will give you more details about ${child.get('your sponsored child')}. Thank you so much for the support.\n"
"                    <br>\n"
"                    <br>\n"
"                    Please don't hesitate to contact us in case you have any questions regarding the situation.\n"
"                    <br>\n"
"                    <br>\n"
"                    Yours sincerely\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_transition
msgid ""
"<div>\n"
"                    % set child = object.get_objects()\n"
"                </div>\n"
"                <p>\n"
"                    Dear sponsor,\n"
"                    <br>\n"
"                    <br>\n"
"                    We warmly thank you for your precious sponsorship of ${child.get_list('preferred_name')}.\n"
"                    <br>\n"
"                    <br>\n"
"                    Your sponsored child is starting now the ${child.get_list('cdsp_type')} sponsorship program.\n"
"                    <br>\n"
"                    <br>\n"
"                    We encourage you to send a letter to your child to encourage him participating to the program.\n"
"                    <br>\n"
"                    <br>\n"
"                    Yours sincerely\n"
"                </p>\n"
"            "
msgstr ""

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_hold_removal
msgid ""
"<div>\n"
"                    % set hold = object.get_objects()\n"
"                    % set owner = object.partner_id.firstname\n"
"                    % set child_code = hold.mapped('child_id').get_list('local_id')\n"
"                    % set child_name = hold.mapped('child_id').get_list('name')\n"
"                </div>\n"
"                <p>\n"
"                    Dear ${owner},\n"
"                    <br>\n"
"                    <br>\n"
"                    We just learned that the child ${child_name} with ref. ${child_code} is no longer available for sponsorship.\n"
"                    The following comments were received :\n"
"                    % for h in hold:\n"
"                        <br>\n"
"                        ${h.comments}\n"
"                        <br>\n"
"                    % endfor\n"
"                    <br>\n"
"                    <br>\n"
"                    If you have the childpack, please don't use it.\n"
"                    <br>\n"
"                    <br>\n"
"                    Yours sincerely\n"
"                </p>\n"
"            "
msgstr ""
"<div>\n"
"    % set hold = object.get_objects()\n"
"    % set owner = object.partner_id\n"
"                    % set child_code = hold.mapped('child_id').get_list('local_id')\n"
"                    % set child_name = hold.mapped('child_id').get_list('name')\n"
"</div>\n"
"<p>\n"
"    ${owner.salutation}\n"
"    <br>\n"
"    <br>\n"
"    Wir haben erfahren, dass für das Kind ${child_name} der Referenznummer ${child_code} keine Patenschaft mehr abgeschlossen werden kann.\n"
"    Falls Sie dieses Kinderdossier haben, brauchen Sie es nicht weiterzuempfehlen und können bei uns ein oder mehrere neue Kinderdossiers bestellen.\n"
"    <br>\n"
"    <br>\n"
"    Freundliche Grüsse\n"
"</p>"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_transfer
msgid ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set preferred_name = child.get_list('preferred_name', translate=False)\n"
"    % set fcp = child.mapped('project_id')\n"
"    % set lifecycle = child.mapped('lifecycle_ids')[:1]\n"
"    % set one = len(child) == 1\n"
"    % set partner = object.partner_id\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"   Thank you for investing in the life of ${preferred_name} with a sponsorship.\n"
"</p>\n"
"<p>\n"
"    We have received a message that your sponsored child has moved to a new Child Development Centre.\n"
"</p>\n"
"<p>\n"
"    Therefore, ${child.get('he')} has been issued a new reference number, ${child.local_id}, which you will need for future letter correspondences via post.\n"
"</p>\n"
"    % if partner.email:\n"
"    \t<p>You can write via your <a href='https://www.mycompassion.ch'>MyCompassion</a> profile.</p>\n"
"    \t<p>Do you need inspiration? <a href=\"https://compassion.ch/de/was-soll-ich-meinem-patenkind-schreiben/\">5 ideas to write your letter</a></p>\n"
"    % elif object.send_mode == \"physical\":\n"
"    \t<p>Enclosed, you will find a new sheet of labels for your letters that you send via post.</p>\n"
"    \t<p>You can also write via your <a href='https://www.mycompassion.ch'>MyCompassion</a> profile.</p>\n"
"    \t<p>Do you need inspiration? <a href=\"https://compassion.ch/de/was-soll-ich-meinem-patenkind-schreiben/\">5 ideas to write your letter</a></p>\n"
"    % endif\n"
"<p>\n"
"    We wish you much joy whilst writing!\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"% if object.send_mode != \"physical\":\n"
"\t<p>${object.user_id.signature | safe}</p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set fcp = child.mapped('project_id')\n"
"    % set lifecycle = child.lifecycle_ids[:1]\n"
"    % set one = len(child) == 1\n"
"    % set four = len(child) > 3\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set deine_patenkinder = 'deine Patenkinder' if not plural else 'eure Patenkinder'\n"
"    % set deinen_patenkindern = 'deinen Patenkindern' if not plural else 'euren Patenkindern'\n"
"    % set name = child.get_list('preferred_name', 3, deine_patenkinder, translate=False)\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"    <br>\n"
"    <br>\n"
"    Danke, dass ${du} mit einer Patenschaft in das Leben von ${deinen_patenkindern if four else name} ${'investiert' if plural else 'investierst'}.\n"
"    <br>\n"
"    <br>\n"
"    Wir haben die Nachricht erhalten, dass ${name} das Kinderzentrum gewechselt ${child.get('has')}.\n"
"    <br>\n"
"    <br>\n"
"    Deshalb ${'bekommt' if one else 'bekommen'} ${child.get('he')} die neue Referenznummer\n"
"\n"
"    % if one:\n"
"        ${child.get_list('local_id')},\n"
"    % else:\n"
"        <ul>\n"
"            % for the_child in child:\n"
"                <li>\n"
"                    ${the_child.preferred_name}: ${the_child.local_id},\n"
"                </li>\n"
"            % endfor\n"
"        </ul>\n"
"    % endif\n"
"    welche ${du} zum Schreiben per Briefpost ${'benötigt' if plural else 'benötigst'}.\n"
"    <br>\n"
"    <br>\n"
"\n"
"    % if object.send_mode == \"physical\":\n"
"        Beiliegend schicken wir ${'euch' if plural else 'dir'} das aktuelle Etikettenblatt für die Briefe, welche ${du} per Post ${'schreibt' if plural else 'schreibst'}.\n"
"        <br>\n"
"        <br>\n"
"        ${du.title()} ${'könnt' if plural else 'kannst'} schnell und einfach über www.mycompassion.ch schreiben.\n"
"    % else:\n"
"        ${du.title()} ${'könnt' if plural else 'kannst'} ${child.get('ihm')} schnell und einfach über\n"
"        <a href=\"https://mycompassion.ch/de_DE/\">MyCompassion</a>\n"
"        schreiben.\n"
"        <br>\n"
"        <br>\n"
"        ${'Braucht' if plural else 'Brauchst'} ${du} Inspiration dazu? Hier sind\n"
"        <a href=\"https://compassion.ch/de/was-soll-ich-meinem-patenkind-schreiben/\">\n"
"            5 Ideen zum Briefeschreiben.\n"
"        </a>\n"
"    % endif\n"
"    <br>\n"
"    <br>\n"
"    Wir wünschen ${\"euch\" if plural else \"dir\"} viel Freude beim Schreiben!\n"
"    <br>\n"
"    <br>\n"
"    Liebe Grüsse\n"
"\n"
"    % if object.send_mode != \"physical\":\n"
"        <br>\n"
"        <br>\n"
"        ${object.user_id.short_signature | safe}\n"
"    % endif\n"
"</p>"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_project_suspension
msgid ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set project = child.mapped('project_id')[0]\n"
"    % set suspension = project.lifecycle_ids[0]\n"
"    % set reasons = suspension.suspension_reason_ids\n"
"    % set details = suspension.suspension_detail\n"
"    % set partner = object.partner_id\n"
"    % set firstname = child.get_list('preferred_name', 3, deine_patenkinder, translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.get_snippet('number_mothers') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"</p>\n"
"<p>\n"
"    Thank you for investing in the ${'lives' if len(child) > 1 else 'life'} of ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Compassion works with ${number_fcps} partner churches in ${number_countries} countries, which work according to international quality standards and are regularly inspected.\n"
"</p>\n"
"<p>\n"
"    Today we would like to inform you that the child development center that ${firstname} attends is currently suspended because quality standards are not met. Various investigations are underway. Compassion staff are offering the partner church support and training to resolve the issues.\n"
"</p>\n"
"<p>\n"
"    Specifically, this means that your donations / part of your donations for ${firstname} will be withheld until the child development center can fully resume all activities.\n"
"</p>\n"
"<p>\n"
"    % if suspension.hold_gifts and suspension.hold_s2b_letters:\n"
"        Unfortunately, neither gifts nor letters can be sent.\n"
"    % elif suspension.hold_gifts and not suspension.hold_s2b_letters:\n"
"        We are pleased that gifts and letters can still be sent.\n"
"    % elif not suspension.hold_gifts and suspension.hold_s2b_letters:\n"
"        We are pleased that letters can still be sent. However, it is currently not possible to send gifts.\n"
"    % else:\n"
"        We are pleased that gifts can still be sent. However, it is not possible to forward letters at the moment.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    We will inform you about the further process and any need for action over the next two months.\n"
"</p>    \n"
"<p>\n"
"    If you have any further questions or concerns, please do not hesitate to contact us.\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"<p>\n"
"    ${object.user_id.short_signature | safe}\n"
"</p>\n"
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set project = child.mapped('project_id')[0]\n"
"\n"
"    % if project.lifecycle_ids[0]:\n"
"        % set suspension = project.lifecycle_ids[0]\n"
"        % set reasons = suspension.suspension_reason_ids\n"
"        % set details = suspension.suspension_detail\n"
"        % set date = suspension.date\n"
"    % else:\n"
"        % set suspension = False\n"
"    % endif\n"
"\n"
"    % set partner = object.partner_id\n"
"    % set firstname = child.get_list('preferred_name', 3, deine_patenkinder, translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"\n"
"    % if plural:\n"
"        % set du = 'ihr'\n"
"        % set bist = 'seid'\n"
"        % set investierst = 'investiert'\n"
"        % set dich = 'euch'\n"
"        % set hast = 'habt'\n"
"        % set deine = 'eure'\n"
"        % set deiner = 'eurer'\n"
"    % else:\n"
"        % set du = 'du'\n"
"        % set bist = 'bist'\n"
"        % set investierst = 'investierst'\n"
"        % set dich = 'dich'\n"
"        % set hast = 'hast'\n"
"        % set deine = 'deine'\n"
"        % set deiner = 'deiner'\n"
"    % endif\n"
"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.get_snippet('number_mothers') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    Herzlichen Dank, dass ${du} mit uns zusammen unterwegs ${bist} und in das Leben von ${firstname} ${investierst}.\n"
"</p>\n"
"<p>\n"
"    Compassion arbeitet mit ${number_fcps} Partnerkirchen in ${number_countries} Ländern zusammen, welche nach internationalen Qualitätsstandards arbeiten und regelmässig kontrolliert werden.\n"
"</p>\n"
"<p>\n"
"    <b>Heute möchten wir ${dich} darüber informieren, dass das Kinderzentrum, welches ${firstname} besucht, derzeit suspendiert ist.</b> Verschiedene Abklärungen sind im Gange, weil das Kinderzentrum die Qualitätsstandards nicht erfüllt. Die Mitarbeitenden von Compassion bieten der Partnerkirche Unterstützung und Schulungen an, um die Probleme zu lösen.\n"
"</p>\n"
"\n"
"% if suspension.hold_cdsp_funds:\n"
"    <p>\n"
"        % if suspension.hold_gifts:\n"
"            Konkret bedeutet das, dass ${deine} Spenden für ${firstname} zurückgehalten werden, bis das Kinderzentrum wieder alle Aktivitäten vollständig aufnehmen kann.\n"
"        % else:\n"
"            Konkret bedeutet das, dass ein Teil ${deiner} Spenden für ${firstname} zurückgehalten werden, bis das Kinderzentrum wieder alle Aktivitäten vollständig aufnehmen kann.\n"
"        % endif\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    % if suspension.hold_gifts and suspension.hold_s2b_letters:\n"
"        Leider können weder Geschenke noch Briefe übermittelt werden.\n"
"    % elif suspension.hold_gifts and not suspension.hold_s2b_letters:\n"
"        Wir freuen uns, dass Geschenke weiterhin übermittelt werden können. Jedoch ist es momentan nicht möglich, Briefe weiterzuleiten.\n"
"    % elif not suspension.hold_gifts and suspension.hold_s2b_letters:\n"
"        Wir freuen uns, dass Briefe weiterhin übermittelt werden können. Jedoch ist es momentan nicht möglich, Geschenke zu machen.\n"
"    % else:\n"
"        Wir freuen uns, dass Geschenke und Briefe weiterhin übermittelt werden können.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    <b>Wir werden ${dich} im Laufe der nächsten zwei Monate über den weiteren Prozess und allfälligen Handlungsbedarf informieren.</b>\n"
"</p>\n"
"<p>\n"
"    Falls ${du} weitere Fragen oder Anliegen ${hast}, sind wir gerne für ${dich} da.\n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse\n"
"</p>\n"
"\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_disaster_alert
msgid ""
"<div>\n"
"    % set children = object.get_objects().mapped('child_id')\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set firstname = children.get_list('preferred_name', 3, 'your sponsored children', False)\n"
"    % set Firstname = children.get_list('preferred_name', 3, 'Your sponsored children', False)\n"
"    % set firstname_n = children.get_list('preferred_name', 3, 'your sponsored children', False)\n"
"    % set Firstname_n = children.get_list('preferred_name', 3, 'Your sponsored children', False)\n"
"    % set disaster = children.mapped('child_disaster_impact_ids.disaster_id')[:1].with_context(lang='en_US')\n"
"    % set healthy = children.mapped('child_disaster_impact_ids')[:1].beneficiary_physical_condition == 'Beneficiary Healthy'\n"
"    % set house_damaged = children.mapped('child_disaster_impact_ids')[:1].house_condition != 'Not Damaged'\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"    % set sms = object.send_mode == \"sms\"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you for investing in the life of ${firstname}.\n"
"</p>\n"
"<p>\n"
"    We have been informed that a natural disaster has struck the region where ${firstname} lives.\n"
"</p>\n"
"<p>\n"
"% if healthy:\n"
"    Luckily, ${firstname} is well.\n"
"% else:\n"
"    Unfortunately, ${firstname} has been hurt.\n"
"% endif\n"
"\n"
"${children.get('his').title()}\n"
"\n"
"% if house_damaged:\n"
"    house is damaged and ${children.get('he')} has lost all ${children.get('his')} household items, clothes and school supplies.\n"
"% else:\n"
"    house was not damaged.\n"
"% endif\n"
"\n"
"</p>\n"
"<p>\n"
"    You may want to write some lines to comfort ${firstname}.\n"
"</p>\n"
"<p>\n"
"    This can easily be done via your <a href='https://www.mycompassion.ch'>MyCompassion</a> profile.\n"
"</p>\n"
"\n"
"<p>\n"
"    You can also make a donation to ${firstname} and ${children.get('his')} family in these difficult circumstances using the attached payment slip.\n"
"</p>\n"
"<p>\n"
"    Especially in exceptional situations such as this one, your support makes a big difference. Thank you!\n"
"</p>\n"
"<p>\n"
"    Kind regards\n"
"</p>\n"
"% if object.send_mode != \"physical\":\n"
"\t<p>${object.user_id.signature | safe}</p>\n"
"% endif\n"
"\n"
"\n"
"<h3>\n"
"    Internal notes to remove (for giving more info if needed)\n"
"</h3>\n"
"<br>\n"
"<b>\n"
"    ${disaster.name}\n"
"</b>\n"
"<ul>\n"
"    <li>\n"
"        Happened : ${disaster.disaster_date}\n"
"    </li>\n"
"    <li>\n"
"        Type : ${disaster.disaster_type}\n"
"    </li>\n"
"    <li>\n"
"        (internal usage :\n"
"        <a href=\"${disaster.access_link}\" target=\"blank\">\n"
"            details\n"
"        </a>\n"
"        )\n"
"    </li>\n"
"</ul>\n"
"<p>\n"
"    % if disaster.fcp_disaster_impact_ids:\n"
"        <b>\n"
"            Impacts on the project :\n"
"        </b>\n"
"        </p>\n"
"        % for fcp_impact in disaster.fcp_disaster_impact_ids:\n"
"% if fcp_impact.project_fcp_id in children.mapped(\"project_id.fcp_id\"):\n"
"        <ul>\n"
"            <li>\n"
"                Description : ${fcp_impact.disaster_impact_description}\n"
"            </li>\n"
"            <li>\n"
"                Impact on the project activities : ${fcp_impact.impact_on_fcp_program}\n"
"            </li>\n"
"            <li>\n"
"                Infrastructure: ${fcp_impact.infrastructure}\n"
"            </li>\n"
"        </ul>\n"
"   % endif\n"
"        % endfor \n"
"      <p>\n"
"    % endif\n"
"    <br>\n"
"    % for child in children:\n"
"        % set impact = child.child_disaster_impact_ids[:1]\n"
"        <b>\n"
"            ${child.name} - [${child.local_id}]\n"
"        </b>\n"
"        </p>\n"
"        <ul>\n"
"            <li>\n"
"                Physical condition : ${impact.beneficiary_physical_condition}\n"
"                % if impact.beneficiary_physical_condition_description:\n"
"                <br>\n"
"                ${impact.beneficiary_physical_condition_description}\n"
"                % endif\n"
"            </li>\n"
"            % if impact.house_condition:\n"
"            <li>\n"
"                House condition : ${impact.house_condition}\n"
"            </li>\n"
"            % endif\n"
"        \n"
"            % if impact.siblings_died_number:\n"
"            <li>\n"
"                Siblings died: ${impact.siblings_died_number}\n"
"            </li>\n"
"            % endif\n"
"        \n"
"            % if impact.siblings_seriously_injured_number:\n"
"            <li>\n"
"                Siblings seriously injured: ${impact.siblings_seriously_injured_number}\n"
"            </li>\n"
"            % endif\n"
"        \n"
"            % if impact.caregivers_died_number:\n"
"            <li>\n"
"                Caregivers died: ${impact.caregivers_died_number}\n"
"            </li>\n"
"            % endif\n"
"        \n"
"            % if impact.caregivers_seriously_injured_number:\n"
"            <li>\n"
"                Caregivers seriously injured: ${impact.caregivers_seriously_injured_number}\n"
"            </li>\n"
"            % endif\n"
"        \n"
"            % if impact.loss_ids:\n"
"            <li>\n"
"                Personal effects destroyed or lost:\n"
"                <ul>\n"
"                    % for loss in impact.loss_ids:\n"
"                    <li>\n"
"                        ${loss.name}\n"
"                    </li>\n"
"                    % endfor\n"
"                </ul>\n"
"            </li>\n"
"            % endif\n"
"        </ul>\n"
"    % endfor\n"
"\n"
msgstr ""
"<div>\n"
"    % set children = object.get_objects().mapped('child_id')\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set Deine = 'Eure' if plural else 'Deine'\n"
"    % set firstname = children.get_list('preferred_name', 3, deine + '  Patenkinder', False)\n"
"    % set Firstname = children.get_list('preferred_name', 3, Deine + ' Patenkinder', False)\n"
"    % set firstname_n = children.get_list('preferred_name', 3, deine + 'n  Patenkindern', False)\n"
"    % set Firstname_n = children.get_list('preferred_name', 3, Deine + 'n Patenkindern', False)\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'  \n"
"    % set disaster = children.mapped('child_disaster_impact_ids.disaster_id')[:1].with_context(lang='en_US')\n"
"    % set healthy = children.mapped('child_disaster_impact_ids')[:1].beneficiary_physical_condition == 'Beneficiary Healthy'\n"
"    % set house_damaged = children.mapped('child_disaster_impact_ids')[:1].house_condition != 'Not Damaged'\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"    % set sms = object.send_mode == \"sms\"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"% if not sms:\n"
"    <p>\n"
"        Vielen Dank, dass ${du} in das Leben von ${firstname_n} ${\"investiert\" if plural else \"investierst\"}.\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Wir haben erfahren, dass eine Naturkatastrope die Region von ${firstname_n} getroffen hat.\n"
"</p>\n"
"\n"
"% if healthy:\n"
"    <p>\n"
"        Wir freuen uns, dir mitzuteilen, dass es ${children.get('ihm')} gut geht. Jedoch wurde ${children.get('sein')} Zuhause beschädigt und ${children.get('he')} hat alle ${children.get('seine')} Haushaltsartikel, Kleider und Schulsachen verloren.\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        ${Firstname} ${children.get('is')} leider verletzt.\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    ${children.get('sein').title()} Zuhause wurde\n"
"\n"
"    % if house_damaged:\n"
"        beschädigt und ${children.get('he')} ${children.get('has')} alle ${children.get('seine')} Haushaltsartikel, Kleider und Schulsachen verloren.\n"
"    % else:\n"
"        noch intakt.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    ${\"Möchtet ihr\" if plural else \"Möchtest du\"} ${firstname_n} einige Zeilen schreiben um ${children.get('ihn')} zu trösten? Schreiben ${\"könnt ihr\" if plural else \"kannst du\"} über\n"
"    \n"
"    % if object.send_mode == \"digital\":\n"
"        <a href=\"https://mycompassion.ch/de_DE/my/letter\">MyCompassion</a>.\n"
"    % else:\n"
"        % if sms:\n"
"            MyCompassion: <a href=\"https://mycompassion.ch/de_DE/my/letter\">MyCompassion</a>\n"
"        % else:\n"
"            www.mycompassion.ch.\n"
"        % endif\n"
"    % endif\n"
"</p>\n"
"\n"
"% if not sms:\n"
"    <p>\n"
"        ${\"Ihr könnt\" if plural else \"Du kannst\"} ${children.get('ihm')} in diesen schwierigen Umständen mit dem beigelegten Einzahlungsschein auch eine Spende machen.\n"
"    </p>\n"
"    <p>\n"
"        Gerade in dieser Ausnahmesituation ist ${deine} Unterstützung wertvoller denn je. Herzlichen Dank!\n"
"    </p>\n"
"    <p>\n"
"        Liebe Grüsse\n"
"    </p>\n"
"    % if object.send_mode == 'digital':\n"
"        <p>${object.user_id.signature | safe}</p>\n"
"    % endif\n"
"% else:\n"
"    <p>\n"
"        Danke, dass ${du} in dieser schwierigen Situation für ${firstname} ${\"betet\" if plural else \"betest\"}.\n"
"    </p>\n"
"    <p>\n"
"        Liebe Grüsse<br/>\n"
"Sarah<br>\n"
"Tel: +41 (0)31 552 21 21<br>\n"
"Fragen? Melde dich per WhatsApp bei uns: +41 (0)79 622 31 97 \n"
"    </p>\n"
"% endif\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.mail_onboarding_first_letter
msgid ""
"<div>\n"
"    % set letter = object.get_objects()\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set child = letter.mapped('child_id')\n"
"    % set one_child = len(child) == 1\n"
"    % set less_4 = len(child) < 4\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set deinem_patenkind = child.get_list('preferred_name', 3, 'your sponsored children', translate=False)\n"
"    % set apos = \"'\" if firstname[-1] == 's' else \"'s\"\n"
"    % set urls = []\n"
"    % set special = \"BD\" in child.get_list(\"local_id\") or \"LK\" in child.get_list(\"local_id\")\n"
"\n"
"    % for letter_set in letter.filtered('read_url').mapped('read_url'):\n"
"        % if letter_set not in urls:\n"
"            % set void = urls.append(letter_set)\n"
"        % endif\n"
"    % endfor\n"
"\n"
"    % if len(urls) == 0:\n"
"        % set void = urls.append('https://mycompassion.ch/my/children?child_id=' + str(letter.child_id.id))\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"\n"
"<p>We are excited to send you ${firstname + apos} first letter today.</p>\n"
"\n"
"% if object.send_mode != \"physical\":\n"
"    % if len(letter) == 1:\n"
"        <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"            <a href=\"${urls[0]}\"\n"
"               style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\"\n"
"               title=\"\">\n"
"                Download letter\n"
"            </a>\n"
"        </div>\n"
"    % else:\n"
"        <p>You can download the letters here:</p>\n"
"        <ul>\n"
"            % for the_url in urls:\n"
"            <li><a href=\"${the_url}\">Letter from ${letter[loop.index0].child_id.preferred_name}</a></li>\n"
"            % endfor\n"
"        </ul>\n"
"    % endif\n"
"% endif\n"
"\n"
"<p>It's important to know that the sponsored children live in a culture where communication is predominantly verbal. Writing letters and responding to specific questions is, therefore, a long learning process. It's so nice that you're accompanying ${firstname} in that!</p>\n"
"\n"
"<p>The first letter was written before the sponsorship began, and every letter travels a long way:</p>\n"
"\n"
"% if object.send_mode == \"digital\":\n"
"    <div style=\"margin:30px auto; text-align: center;\">\n"
"        <a href=\"https://compassion.ch/medias/onboarding/chemin_en.pdf\">\n"
"            <img src=\"http://compassion.ch/medias/onboarding/image_1_letter_en.png\">\n"
"        </a>\n"
"    </div>\n"
"% endif\n"
"\n"
"<p>You can reply to ${firstname} via <a href=\"https://mycompassion.ch/en_US/my/letter\">MyCompassion</a>.</p>\n"
"\n"
"% if not letter.mapped('sponsorship_id').filtered('is_first_sponsorship'):\n"
"    % if special:\n"
"        <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"            <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_EN.pdf\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"                Extra information for writing letters to your sponsored child${'ren' if one_child}.\n"
"            </a>\n"
"        </div>\n"
"    % endif\n"
"% endif\n"
"\n"
"<p>Another important letter writing information: To ensure the protection of the children, but also for your own safety, the communication between you and your sponsored child[ren] must run solely through us.</p>\n"
"<p>Please never mention:</p>\n"
"<ul>\n"
"    <li>Your postal address</li>\n"
"    <li>Your email address</li>\n"
"    <li>Your phone number</li>\n"
"    <li>Compassion Switzerland's address</li>\n"
"    <li>Your Facebook or other social media contact details</li>\n"
"    <li>Making promises (e.g. a gift or visit)</li>\n"
"</ul>\n"
"<p>It is so wonderful that you are investing in the ${\"life of \" + firstname if one_child else (\"lives of \" + firstname if less_4 else \"your sponsored children\")}!</p>\n"
"<p>Warm regards,</p>\n"
"<p>${object.user_id.sudo().signature | safe}</p>"
msgstr ""
"<div>\n"
"    % set letter = object.get_objects()\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set child = letter.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), translate=False)\n"
"    % set deinem_patenkind = child.get_list('preferred_name', 3, 'euren Patenkindern' if plural else 'deinen Patenkindern', translate=False)\n"
"    % set urls = []\n"
"    % set special = \"BD\" in child.get_list(\"local_id\") or \"LK\" in child.get_list(\"local_id\")\n"
"    % set whatsapp_signature = object.get_snippet('whatsapp_signature') | striptags | safe\n"
"\n"
"    % for letter_set in letter.filtered('read_url').mapped('read_url'):\n"
"        % if letter_set not in urls:\n"
"            % set void = urls.append(letter_set)\n"
"        % endif\n"
"    % endfor\n"
"    \n"
"    % if len(urls) == 0:\n"
"        % set void = urls.append('https://mycompassion.ch/my/children?child_id=' + str(letter.child_id.id))\n"
"        % set denBrief = 'den Brief'\n"
"    % else:\n"
"        % set denBrief = 'die Briefe'\n"
"    % endif\n"
"\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"% if object.send_mode == \"sms\":\n"
"    <p>\n"
"        Wir freuen uns, ${dir} einen neuen Brief von ${firstname} zu senden!\n"
"    </p>\n"
"    <p>\n"
"        ${'Klickt' if plural else 'Klicke'} hier, um ${denBrief} herunterzuladen: <a href=\"${urls[0]}\">link</a>\n"
"    </p>\n"
"    <p>\n"
"        Viel Spass beim Lesen!\n"
"    </p>\n"
"    <p>\n"
"        ${'Nehmt' if plural else 'Nimm'} ${dir} doch fünf Minuten Zeit, um auf ${denBrief} zu antworten über MyCompassion: <a href=\"https://mycompassion.ch/de_DE/my/letter\">MyCompassion</a>\n"
"    </p>\n"
"    <p>\n"
"        Liebe Grüsse<br/>\n"
"        Sarah<br/>\n"
"        Tel: +41 (0)31 552 21 21<br/>\n"
"        Fragen? <a href=\"${wp_tchat_url}\">${wp_tchat_url}</a>\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        Wir freuen uns, ${dir} heute ${'den ersten Brief' if len(letter) == 1 else 'die ersten Briefe'} von ${deinem_patenkind} zu schicken.\n"
"    </p>\n"
"\n"
"    % if object.send_mode != \"physical\":\n"
"        % if len(letter) == 1:\n"
"            <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"                <a href=\"${urls[0]}\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"                    Brief herunterladen\n"
"                </a>\n"
"            </div>\n"
"        % else:\n"
"            <p>\n"
"                Hier ${'könnt ihr' if plural else 'kannst du'} die Briefe herunterladen:\n"
"            </p>\n"
"            <ul>\n"
"                % for the_url in urls:\n"
"                    <li>\n"
"                        <a href=\"${the_url}\">\n"
"                            Brief von ${letter[loop.index0].child_id.preferred_name}\n"
"                        </a>\n"
"                    </li>\n"
"                % endfor\n"
"            </ul>\n"
"        % endif\n"
"    % endif\n"
"\n"
"    <p>\n"
"        Es ist wichtig zu wissen, dass die Kultur der Patenkinder vorwiegend mündlich ist. Briefe zu schreiben und Fragen konkret zu beantworten erfordert daher einen langen Lernprozess. So schön, dass ${du}  ${child.get_list('preferred_name', 3, deine + ' Patenkinder', translate=False)} darin ${'begleitet' if plural else 'begleitest'}!\n"
"    </p>\n"
"    <p>\n"
"        Der erste Brief wurde bereits geschrieben, bevor die Patenschaft begann. Und jeder Brief hat einen langen Weg hinter sich:\n"
"    </p>\n"
"\n"
"    % if object.send_mode == \"digital\":\n"
"        <div style=\"margin:30px auto; text-align: center;\">\n"
"            <a href=\"https://compassion.ch/medias/onboarding/chemin_de.pdf\">\n"
"                <img src=\"http://compassion.ch/medias/onboarding/image_1_letter_de.png\">\n"
"            </a>\n"
"        </div>\n"
"    % endif\n"
"\n"
"    <p>\n"
"        % if object.send_mode == \"physical\":\n"
"            ${'Ihr könnt' if plural else 'Du kannst'} ${firstname} über www.mycompassion.ch\n"
"        % else:\n"
"            ${'Ihr könnt' if plural else 'Du kannst'} ${deinem_patenkind} über\n"
"            <a href=\"https://mycompassion.ch/de_DE/my/letter\">\n"
"                MyCompassion\n"
"            </a>\n"
"        % endif\n"
"        zurückschreiben.\n"
"    </p>\n"
"\n"
"    % if not letter.mapped('sponsorship_id').filtered('is_first_sponsorship'):\n"
"        % if special:\n"
"            % if object.send_mode == \"digital\":\n"
"                <div style=\"margin:30px auto; text-align: center; text-transform: uppercase;\">\n"
"                    <a href=\"https://compassion.ch/medias/onboarding/BD_SL_child_communication_de.pdf\" style=\"padding: 12px 18px; font-size: 14px; line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"                        Besondere Informationen zum Briefeschreiben für ${child.get(\"euer Patenkind\") if plural else child.get(\"dein Patenkind\")}\n"
"                    </a>\n"
"                </div>\n"
"            % else:\n"
"                <p>\n"
"                    Beigefügt ${\"findet ihr\" if plural else \"findest du\"} besondere Informationen zum Briefeschreiben für ${child.get(\"euer Patenkind\") if plural else child.get(\"dein Patenkind\")}.\n"
"                </p>\n"
"            % endif\n"
"        % endif\n"
"\n"
"        <p>\n"
"            Hier noch eine wichtige Information: Zum Schutz der Kinder, aber auch zu ${deine}m Schutz, läuft die Kommunikation zwischen ${dir} und ${child.get('eurem Patenkind') if plural else child.get('deinem Patenkind')} ausschliesslich über uns.\n"
"        </p>\n"
"        <p>\n"
"            Bitte ${'erwähnt' if plural else 'erwähne'} nie:\n"
"        </p>\n"
"        <ul>\n"
"            <li>\n"
"                ${deine} Postadresse\n"
"            </li>\n"
"            <li>\n"
"                ${deine} E-Mail Adresse\n"
"            </li>\n"
"            <li>\n"
"                ${deine} Telefonnummer\n"
"            </li>\n"
"            <li>\n"
"                die Adresse von Compassion Schweiz\n"
"            </li>\n"
"            <li>\n"
"                ${deine} Kontaktdaten von Facebook oder anderen sozialen Medien\n"
"            </li>\n"
"            <li>\n"
"                ${'Macht' if plural else 'Mache'} keine Versprechen, bspw. für ein Geschenk oder einen Besuch\n"
"            </li>\n"
"        </ul>\n"
"    % endif\n"
"    <p>\n"
"        Danke, dass ${du} ${child.get_list('preferred_name', 3, deine + ' Patenkinder', translate=False)} ${'ermutigt' if plural else 'ermutigst'} und ${dich} für ${child.get('ihn')} einsetzt.\n"
"    </p>\n"
"    <p>\n"
"        Liebe Grüsse\n"
"    </p>\n"
"    % if object.send_mode == \"digital\":\n"
"        <p>\n"
"            ${object.user_id.sudo().short_signature | safe}\n"
"        </p>\n"
"    % endif\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_biennial
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set child = object.get_objects()\n"
"    % set firstname = child.get_list('preferred_name', 3, 'many children', False)\n"
"\n"
"    % if len(child) == 1:\n"
"        % set Hasnot = \"Hasn't\"\n"
"    % else:\n"
"        % set Hasnot = \"Haven't\"\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    We're excited to send you a new photo of ${firstname}. ${Hasnot} ${child.get('he')} grown a lot?\n"
"</p>\n"
"<p>\n"
"    Why not take some time to write a letter to ${firstname} and show ${child.get('him')} how precious ${child.get('he')} is? You can do so <a href='https://compassion.ch/schreiben/'>online</a>.\n"
"</p>\n"
"<p>\n"
"    Thanks to your generous and faithful support, the employees of the child centre can care for ${firstname} in a holistic way. In the context of activities, a great emphasis is placed not only on ${child.get('his')} academic advancement, but also on ${child.get('his')} personality development. ${firstname} has access to medical care, receives balanced meals and is learning personal responsibility.\n"
"</p>\n"
"<p>\n"
"    Together, we are changing the world! One child at a time.\n"
"</p>\n"
"<p>\n"
"    Kind regards\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"    </p>\n"
"% endif\n"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set child = object.get_objects()\n"
"    % set one_child = len(child) == 1\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"\n"
"    % if 'Patenkinder' in firstname:\n"
"        % set firstname = deine + ' Patenkinder'\n"
"        % set firstname_n = deine + 'n Patenkindern'\n"
"        % set Firstname = deine.title() + ' Patenkinder'\n"
"    % else:\n"
"        % set firstname_n = firstname\n"
"        % set Firstname = firstname\n"
"    % endif\n"
"\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"</div>\n"
"\n"
"% if object.send_mode == \"sms\":\n"
"    <p>\n"
"        ${partner.salutation}\n"
"    </p>\n"
"    <p>\n"
"        ${\"Ihr habt\" if plural else \"Du hast\"} ein neues Foto von ${firstname} in MyCompassion erhalten: <a href=\"https://mycompassion.ch/de_DE/my/children\">link</a>\n"
"    </p>\n"
"    <p>\n"
"        Ist ${child.get('er')} nicht ${\"gross\" if child.age < 18 else \"erwachsen\"} geworden?\n"
"    </p>\n"
"    <p>\n"
"        ${\"Nehmt euch\" if plural else \"Nimm dir\"} doch kurz Zeit, ${firstname} zu sagen, wie stolz ${du} auf ${child.get(\"ihn\")} ${\"seid\" if plural else \"bist\"}: <a href=\"https://mycompassion.ch/my/letter\">link</a>\n"
"    </p>\n"
"    <p>\n"
"        Danke, dass ${du} in das Leben von ${firstname} ${\"investiert\" if plural else \"investierst\"}. Das ist enorm wertvoll!\n"
"    </p>\n"
"    <p>\n"
"        Liebe Grüsse<br/>\n"
"        Sarah<br/>\n"
"        Tel: +41 (0)31 552 21 21<br/>\n"
"        Fragen? Melde dich per WhatsApp bei uns: +41 (0)79 622 31 97\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        ${partner.salutation}\n"
"    </p>\n"
"    <p>\n"
"        Wir freuen uns, ${'euch' if plural else 'dir'} ein neues Foto von ${firstname_n} zu schicken. ${'Ist' if len(child) == 1 else 'Sind'} ${child.get('he')} nicht ${'erwachsen' if len(child)==1 and child.age>=18 else 'gross'} geworden?\n"
"    </p>\n"
"    <p>\n"
"        ${'Nehmt euch' if plural else 'Nimm dir'} doch kurz Zeit, ${firstname_n}\n"
"        % if object.send_mode != \"physical\":\n"
"            <a href=\"https://mycompassion.ch/de_DE/\">\n"
"                über MyCompassion\n"
"            </a>\n"
"        % else:\n"
"            über www.mycompassion.ch.\n"
"        % endif\n"
"        zu sagen, wie stolz ${du} auf ${child.get('ihn')} ${'seid' if plural else 'bist'}.\n"
"    </p>\n"
"    <p>\n"
"        Dank ${deine}r grosszügigen Unterstützung können die Mitarbeitenden des Kinderzentrums ${firstname} ganzheitlich unterstützen. ${child.get('he').title()} ${child.get('will be')} im Rahmen der Aktivitäten nicht nur schulisch gefördert, sondern auch in ${child.get('seiner')} Persönlichkeitsentwicklung. ${Firstname} ${child.get('will be')} medizinisch versorgt, ${'bekommt' if one_child else 'bekommen'} Mahlzeiten und ${'lernt' if one_child else 'lernen'} Selbstverantwortung.\n"
"    </p>\n"
"    <p>\n"
"        Gemeinsam verändern wir das Leben von Kindern - eins nach dem anderen.\n"
"    </p>\n"
"    <p>\n"
"        Liebe Grüsse\n"
"    </p>\n"
"    % if object.send_mode != 'physical':\n"
"        <p>\n"
"            ${object.user_id.signature | safe}\n"
"        </p>\n"
"    % endif\n"
" % endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_sponsorship_dossier
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set his = child.get('his')\n"
"    % set he = child.get('he')\n"
"    % set him = child.get('him')\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set correspondant = object.partner_id in sponsorships.mapped('correspondent_id')\n"
"</div>\n"
"<p>\n"
"</p>\n"
"<p>\n"
"    % if sponsorships.mapped('parent_id') or len(object.partner_id.sponsorship_ids) != len(sponsorships):\n"
"        ${object.partner_id.salutation},\n"
"        <br><br>\n"
"        Thank you for committing to support another child through Compassion Switzerland.\n"
"    % else:\n"
"        A warm welcome to you, ${object.partner_id.salutation|replace('Dear', 'dear')}! It's so nice to have you as part of the Compassion family!\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Your support will change the life of ${firstname} and ${child.get('his')} family significantly. We thank you so much\n"
"    for investing in the life of ${firstname} and encouraging [him] through your letters and prayers.\n"
"</p>\n"
"<p>\n"
"    For a smooth start of this new relationship please find enclosed:\n"
"</p>\n"
"<ul>\n"
"    <li>\n"
"        1 photo of ${child.get('your sponsored child')}\n"
"    </li>\n"
"    <li>\n"
"        1 folder with practical information about your sponsorship\n"
"    </li>\n"
"    <li>\n"
"        1 sheet of labels to use for all the correspondence with ${child.get('your sponsored child')} (to stick on your\n"
"        cards, letters, stickers, etc.).\n"
"    </li>\n"
"    % if payer:\n"
"        <li>\n"
"            ${sponsorships[0].payment_type_attachment}\n"
"        </li>\n"
"    % endif\n"
"    <li>\n"
"        1 presentation card to send to ${child.get('your sponsored child')}\n"
"    </li>\n"
"</ul>\n"
"% if payer:\n"
"    <p>\n"
"        Upon receipt of the first payment, which we are expecting in the coming days, ${firstname} will be notified that you are ${child.get('his')} sponsor.\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Thank you for your valuable involvement in our sponsorship program. We hope that the relationship with ${firstname} will be a source of joy and blessing for him as well as for you!\n"
"</p>\n"
"<p>\n"
"    Do not hesitate to contact us if you have any questions!\n"
"</p>\n"
"<p>\n"
"    Warm regards\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.sudo().user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    PS: Do you already have the Compassion App? With it you always have your sponsored child's pictures, letters and all\n"
"    information at hand. And the letter writing is made even easier. Download here: www.compassion.ch/app\n"
"</p>\n"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'   \n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set firstname = child.get_list('preferred_name', 3, child.get_number(), False)\n"
"    % set less_4 = firstname != child.get_number()\n"
"    % set payer = object.partner_id in sponsorships.mapped('partner_id') and len(sponsorships.filtered('period_paid')) != len(sponsorships)\n"
"    % set correspondant = object.partner_id in sponsorships.mapped('correspondent_id')\n"
"    % set number_years = object.env[\"partner.communication.job\"].get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.env[\"partner.communication.job\"].get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.env[\"partner.communication.job\"].get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.env[\"partner.communication.job\"].get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.env[\"partner.communication.job\"].get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.env[\"partner.communication.job\"].get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = object.env[\"partner.communication.job\"].get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"</div>\n"
"<div style=\"font-size:8pt\">\n"
"    <p>\n"
"        ${object.partner_id.salutation}\n"
"        <br>\n"
"        <br>\n"
"        % if sponsorships.mapped('parent_id') or len(object.partner_id.sponsorship_ids) != len(sponsorships):\n"
"            So schön, dass ${du} ${dich} entschieden ${'habt' if plural else 'hast'}, in das Leben ${'eines weiteren Kindes' if len(child) == 1 else 'weiterer Kinder'} zu investieren.\n"
"        % else:\n"
"            So schön, dass ${du} nun zur Compassion Familie ${'gehört' if plural else 'gehörst'}!\n"
"        % endif\n"
"    </p>\n"
"    <p>\n"
"        Mit ${dir} zusammen befreien wir zurzeit mit rund ${number_fcps} Partnerkirchen in ${number_countries} Ländern ${number_children} Millionen Kinder aus extremer Armut. Gemeinsam ermöglichen wir den Kindern ein Leben mit Hoffnung und Zukunft.\n"
"    </p>\n"
"    <p>\n"
"        Damit die ${child.get('Patenschaft')} für ${firstname if less_4 else deine + ' Patenkinder'} gut starten ${'kann' if len(child) == 1 else 'können'}, ${'findet ihr' if plural else 'findest du'} einige wichtige Informationen beigelegt:\n"
"    </p>\n"
"    <ul>\n"
"        <li>\n"
"            1 Foto von ${firstname if less_4 else 'jedem Kind'}\n"
"        </li>\n"
"        <li>\n"
"            Praktische Informationen\n"
"        </li>\n"
"        <li>\n"
"            ${\"1 Vorstellungskarte\" if len(sponsorships) == 1 else \"Vorstellungskarten\"}, um ${dich} ${deine}${'m Patenkind' if len(child) == 1 else 'n Patenkindern'} vorzustellen\n"
"        </li>\n"
"        <li>\n"
"            ${\"1 Blatt\" if len(sponsorships) == 1 else \"Blätter\"} mit Etiketten für den Briefwechsel (bitte auf Karten, Briefe, Aufkleber, Zeichnungen usw. kleben)\n"
"        </li>\n"
"    </ul>\n"
"    <p>\n"
"        % if payer:\n"
"            Um ${deine} Unterstützung für ${firstname if less_4 else 'die Kinder'} zu starten, sind wir dankbar, wenn ${du}\n"
"            \n"
"            % if lsv_dd:\n"
"                die Einzugsermächtigung für die Bank ${\"ausfüllt\" if plural else \"ausfüllst\"} und uns per Post ${\"zurückschickt\" if plural else \"zurückschickst\"}.\n"
"            % else:\n"
"                den Dauerauftrag mit dem beiliegenden Einzahlungsschein baldmöglichst ${\"aktiviert\" if plural else \"aktivierst\"}. \n"
"            % endif\n"
"\n"
"            Nachdem ${deine} erste Patenschaftsspende eingetroffen ist, ${child.get(\"will be\")} ${firstname if less_4 else \"die Kinder\"} darüber informiert, dass ${child.get(\"he\")} nun\n"
"\n"
"            % if not plural:\n"
"                ${\"eine Patin\" if partner.gender == \"F\" else \"einen Paten\"}\n"
"            % else:\n"
"                Paten\n"
"            % endif\n"
"\n"
"            ${\"hat\" if len(child) == 1 else \"haben\"}. ${\"Könnt ihr euch\" if plural else \"Kannst du dir\"} die grosse Freude über diese Nachricht vorstellen?\n"
"    </p>\n"
"    <p>\n"
"        % endif \n"
"        Dank ${dir} findet nicht nur ein Kind, sondern eine ganze Familie neue Hoffnung für die Zukunft. \n"
"    </p>\n"
"    <p>\n"
"        Vielen Dank, dass ${du} diese grosszügige Entscheidung für ${firstname if less_4 else deine + \" Patenkinder\"} getroffen ${\"habt\" if plural else \"hast\"}!\n"
"    </p>\n"
"    <p>\n"
"        Wir wünschen ${dir} viel Freude dabei.\n"
"    </p>\n"
"    <p>\n"
"        Falls ${du} noch Fragen ${\"habt\" if plural else \"hast\"}, sind wir gerne für ${dich} da.\n"
"    </p>\n"
"    <p>\n"
"        Gemeinsam verändern wir das Leben von Kindern - eins nach dem anderen. \n"
"    </p>\n"
"    <p>\n"
"        Liebe Grüsse\n"
"    </p>\n"
"    % if object.send_mode == 'digital':\n"
"        <p>\n"
"            ${object.sudo().user_id.signature | safe}\n"
"        </p>\n"
"    % endif\n"
"</div>"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_unplanned_exit
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set nb_weeks = sponsorships[:1].contract_duration // 7\n"
"    % set nb_years = (sponsorships[:1].contract_duration // 364) or 1\n"
"    % set field = child[:1].field_office_id\n"
"    % set hours_fcp = field.fcp_hours_week * nb_weeks\n"
"    % set meals = field.fcp_meal_week * nb_weeks\n"
"    % set medical = field.fcp_medical_check * nb_years\n"
"\n"
"    % if meals == 1:\n"
"        % set lunch = 'meal'\n"
"    % else:\n"
"        % set lunch = 'meals'\n"
"    % endif\n"
"\n"
"    % if medical == 1:\n"
"        % set checkup = 'medical checkup'\n"
"    % else:\n"
"        % set checkup = 'medical checkups'\n"
"    % endif\n"
"\n"
"   % set partner = object.partner_id\n"
"   % set plural = partner.title.plural or partner.title.id == 29\n"
"   % set name = child.get_list('preferred_name', 3, translate=False)\n"
"   % set lifecycle = child.mapped('lifecycle_ids')[:1]\n"
"   % set good_reason = lifecycle.with_context(lang=\"en_US\").request_reason in (\"beneficiary pursuing career opportunity\", \"conflicts with school or work schedule\", \"family circumstances have changed positively so that child no longer needs compassion's assistance\", \"no longer needs our assistance\")\n"
"   % set last_letter = sponsorships[:1].child_letter_ids[:1]\n"
"</div>\n"
"<p>\n"
"   ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"% if good_reason:\n"
"    We have good news!\n"
"    <br><br>\n"
"    ${name} will come to the end of ${child.get('his')} sponsored journey early, because ${lifecycle.translate('request_reason')}. ${child.get('His').title()} goal is to ${lifecycle.get_list('future_hope_ids.value')}. Isn't that great?\n"
"    <br><br>\n"
"    ${child.get('His').title()} life was positively changed thanks to your support.\n"
"    <br><br>\n"
"    ${name} spent a total of ${hours_fcp} hours at the child centre of the local church. ${child.get('He')} received ${meals} ${lunch} and went through ${medical} ${checkup}. ${child.get('He').title()} was able to go to school regularly, was encouraged individually and knew that someone on the other side of the world was looking after ${child.get('him')}. <b>Thank you so much!</b>\n"
"    <br><br>\n"
"    We understand that this news might come as a surprise to you, but we hope that you will still be able to rejoice with us. \n"
"% else:\n"
"    We have received unexpected news from our staff ${field.country_id.in_preposition} ${field.country_id.name}. ${name} will come to the end of ${child.get('his')} sponsored journey early, because ${lifecycle.translate('request_reason')}.\n"
"    <br><br>\n"
"    We understand that this news might come as a surprise to you. In circumstances of extreme poverty, the life situation sometimes changes in ways that we are not accustomed to. We are very sorry that your sponsorship with ${name} has abruptly ended.\n"
"    <br><br>\n"
"    That is why we would like to thank you all the more for your precious support. ${child.get('He').title()} received ${meals} ${lunch} and went through ${medical} ${checkup}. ${child.get('He').title()} was able to go to school regularly, was encouraged individually and knew that someone on the other side of the world was looking after ${child.get('him').title()}. Your investment will continue to impact and inspire ${child.get('him')} and ${child.get('his')} family. <b>Thank you so much!</b>\n"
"    <br><br>\n"
"    ${name} is doing well. ${child.get('His').title()} goal is to ${lifecycle.get_list('future_hope_ids.value')}. Isn't that great?\n"
"</p>\n"
"% endif\n"
"\n"
"<p>\n"
"% if object.partner_id in sponsorships.mapped('correspondent_id'):\n"
"    % if 2 in last_letter.communication_type_ids.ids and not last_letter.sent_date:\n"
"        This moment becomes even more emotional, as attached you will find ${name}'s final correspondence. You are welcome to write a final farewell letter to ${name} to encourage ${child.get('him')} for the future.\n"
"    % endif\n"
"% endif\n"
"</p>\n"
"<p>\n"
"\n"
"Thank you for changing the life of a child and ${child.get('his')} family in a sustainable way!\n"
"</p>\n"
"<p>\n"
"Together, we are changing the world! One child at a time.\n"
"</p>\n"
"<p>\n"
"Best regards\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.short_signature | safe}\n"
"        <br><br>\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Our fight against extreme poverty continues! 385 million children still live in unacceptable conditions. 14000 children under the age of five die every day. We seek to tackle this urgency. With this in mind, we will soon suggest another child for you to sponsor.\n"
"</p>"
msgstr ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set nb_weeks = sponsorships[:1].contract_duration // 7\n"
"    % set nb_years = (sponsorships[:1].contract_duration // 364) or 1\n"
"    % set field = child[:1].field_office_id\n"
"    % set hours_fcp = field.fcp_hours_week * nb_weeks\n"
"    % set meals = field.fcp_meal_week * nb_weeks\n"
"    % set medical = field.fcp_medical_check * nb_years\n"
"\n"
"    % if child.gender == 'M':\n"
"        % set er = 'er'\n"
"        % set seine = 'seine'\n"
"        % set seiner = 'seiner'\n"
"        % set ihm = 'ihm'\n"
"    % else:\n"
"        % set er = 'sie'\n"
"        % set seine = 'ihre'\n"
"        % set seiner = 'seiner'\n"
"        % set ihm = 'ihr'\n"
"    % endif\n"
"\n"
"    % if medical == 1:\n"
"        % set checkup = 'medizinische Untersuchung'\n"
"    % else:\n"
"        % set checkup = 'medizinische Untersuchungen'\n"
"    % endif\n"
"\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set wünschst = 'wünscht' if plural else 'wünschst'\n"
"    % set name = child.get_list('preferred_name', 3, translate=False)\n"
"    % set lifecycle = child.mapped('lifecycle_ids')[:1]\n"
"    % set good_reason = lifecycle.with_context(lang=\"en_US\").request_reason in (\"beneficiary pursuing career opportunity\", \"conflicts with school or work schedule\", \"family circumstances have changed positively so that child no longer needs compassion's assistance\", \"no longer needs our assistance\")\n"
"    % set reason = lifecycle.translate('request_reason')\n"
"\n"
"    % if 'Name' in reason:\n"
"        % set reason = reason|replace('Name', name)\n"
"    % endif\n"
"\n"
"    % if field.country_id.name == \"Dominikanische Republik\":\n"
"        % set country = \"Dominikanischen Republik\"\n"
"    % else:\n"
"        % set country = field.country_id.name\n"
"    % endif\n"
"\n"
"    % set last_letter = sponsorships[:1].child_letter_ids[:1]\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    % if good_reason:\n"
"        Wir haben gute Neuigkeiten! \n"
"    % else:\n"
"        Wir haben unerwartete Neuigkeiten von unseren Mitarbeitenden ${field.country_id.in_preposition} ${country} erhalten.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    ${name} kommt frühzeitig ans Ende der Patenschaft, weil ${reason}\n"
"    % if good_reason:\n"
"        ${child.get('sein').title()} Ziel ist es, ${lifecycle.get_list('future_hope_ids.value')}. Ist das nicht genial?\n"
"    % else:\n"
"        Wir verstehen, dass diese Neuigkeiten überraschend kommen. In Umständen von extremer Armut​ können sich die Lebensumstände schneller ändern, als wir es uns gewohnt sind. Es tut uns sehr leid, dass dadurch die Patenschaft für ${name} endet.\n"
"\n"
"        % if \"ferngeblieben\" in reason:\n"
"            Falls ${du} es ${wünschst}, fragen wir gerne bei unseren Mitarbeitenden vor Ort nach den genaueren Gründen, warum ${name} nicht mehr ins Kinderzentrum kommt.\n"
"        % endif\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Während ${deine}r Patenschaft konnte ${name} ${hours_fcp} Stunden im Kinderzentrum verbringen. In der lokalen Kirche wurde ${child.get('he')} liebevoll betreut und hat Hoffnung für ${child.get('sein')} Leben bekommen. ${name} hat ${meals} Mahlzeiten erhalten und bekam ${medical} ${checkup}. ${child.get('he').title()}\n"
"    % if child.age >= 7:\n"
"        konnte zur Schule gehen,\n"
"    % endif\n"
"    wurde individuell gefördert und wusste, dass sich auf der anderen Seite der Welt jemand um ${child.get('ihn')} kümmert. <b>Vielen herzlichen Dank!</b>\n"
"</p>\n"
"<p>\n"
"    % if good_reason:\n"
"        Wir verstehen, dass diese Neuigkeiten überraschend kommen, hoffen aber, dass ${du} ${dich} mit uns freuen ${\"könnt\" if plural else \"kannst\"}. \n"
"    % else:\n"
"        ${child.get('sein').title()} Ziel ist es, ${lifecycle.get_list('future_hope_ids.value')}. Ist das nicht genial?\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    % if object.partner_id in sponsorships.mapped('correspondent_id'):\n"
"        % if 2 in last_letter.communication_type_ids.ids and not last_letter.sent_date:\n"
"            Es ist zusätzlich ein emotionaler Moment, denn wir schicken ${dir} im Anhang den letzten Brief von ${name}.\n"
"            <br>\n"
"        % endif\n"
"        Gerne ${\"könnt ihr euch\" if plural else \"kannst du dich\"} von ${name} in einem letzten Brief verabschieden und ${child.get('ihn')} für die Zukunft ermutigen. \n"
"        % if \"anderen Ort\" in reason:\n"
"            Wir werden alles daran setzen, um den Brief noch übermitteln zu können.\n"
"        % endif    \n"
"\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Danke, dass ${du} das Leben eines Kindes und dessen Familie nachhaltig verändert ${\"habt\" if plural else \"hast\"}!\n"
"</p>\n"
"\n"
"% if sponsorships[:1].sds_state in (\"sub\", \"sub_waiting\"):\n"
"    <p>\n"
"        Unser Kampf gegen extreme Armut geht weiter! Es bleiben noch 385 Millionen Kinder, die in inakzeptablen Umständen leben. 14’000 Kinder unter 5 Jahren sterben pro Tag. Diese Tatsache können wir nicht so stehen lassen! Deswegen erlauben wir uns, ${dir} bald eine neue Patenschaft vorzuschlagen.\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Gemeinsam verändern wir das Leben von Kindern - eins nach dem anderen.\n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse\n"
"</p>\n"
"\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"        <br>\n"
"        <br>\n"
"    </p>\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_planned_exit
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set one = len(child) == 1\n"
"    % set name = child.get_list('preferred_name', 3, 'your children')\n"
"                        \n"
"    % if one:\n"
"        % set lifecycle = child.mapped('lifecycle_ids') and child.mapped('lifecycle_ids')[0]\n"
"    % endif \n"
"                        \n"
"    % set sub = sponsorships.mapped('sub_sponsorship_id.child_id')\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation},\n"
"    <br>\n"
"    <br>\n"
"    We sincerely thank you for investing in the life of ${name}. We have received joyful news from the child project: after many years of support from the staff at the local church and through you as the sponsor,\n"
"    <b>${name} is coming to the end of the sponsorship program and is a young adult.</b>\n"
"    ${child.get('he').title()} looks with hope and trust to the future.\n"
"    <br>\n"
"    <br>\n"
"\n"
"% if one:\n"
"    The local staff have told us that ${name}'s goals are to ${lifecycle.get_list('future_hope_ids.value')}.\n"
"    <br>\n"
"    <br>\n"
"% else:\n"
"</p>\n"
"<ul>\n"
"    % for one_child in child:\n"
"        % set lifecycle = one_child.mapped('lifecycle_ids') and one_child.mapped('lifecycle_ids')[0]\n"
"        <li>${one_child.preferred_name}'s current goals are: ${lifecycle.get_list('future_hope_ids.value')}.</li>\n"
"    % endfor\n"
"</ul>\n"
"% endif \n"
"\n"
"Thanks to your regular support, ${name} ${child.get('was')} able to go to school,  receive medical care and receive balanced meals and clothing. ${child.get('he').title()} ${child.get('was')} also able to participate in activities that have helped ${child.get('him')} in ${child.get('his')} development - socially and spiritually. The family also benefitted from the support and participated in various activities organized by the center.\n"
"<br>\n"
"<br>\n"
"\n"
"% if object.partner_id in sponsorships.mapped('correspondent_id'):\n"
"    You are welcome to send a last letter to ${name} and say goodbye to ${child.get('him')} and encourage ${child.get('him')} for the future. You can continue to accompany ${name} in prayer throughout ${child.get('his')} life.\n"
"% endif \n"
"\n"
"<br>\n"
"<br>\n"
"\n"
"% if sub:\n"
"    % if one:\n"
"        As you know, the plight is enormous in the countries of the Global South. ${sub.preferred_name} ${sub.project_id.country_id.preposition} ${sub.project_id.country_id.name} lives in extreme poverty. Would you be ready to sponsor ${sub.get('him')}? We will send you the information for ${sub.preferred_name} within 15 days to start the new sponsorship. If you would like to support a child in another country, have questions, or would like to cancel a sponsorship, please do not hesitate to contact us. We can be reached by phone at 031 552 21 25 or by e-mail at: info@compassion.ch \n"
"\t% else:\n"
"        As you already know, the plight of children living in poverty is enormous.  For instance, ${sub[0].preferred_name} ${sub.project_id.country_id.name} ${sub[0].project_id.country_id.name} is one of them.  Would you consider and be ready to sponsor ${sub.get('him')}?  We would like to send you information about ${sub[0].preferred_name} and other children in need within 15 days to begin new sponsorships. However, if you have questions, concerns, or would no longer like to be a sponsor, please do not hesitate to contact us. We can be reached by phone at 031 552 21 25 or by e-mail at: info@compassion.ch\n"
"    % endif \n"
"% else:\n"
"    With this letter, we acknowledge that you would not like to sponsor another child at this time.\n"
"    <br>\n"
"    <br>\n"
"    Did you know that you can also help children in poverty by giving them access to clean water (water filters, toilet installation, hygiene awareness)? If you are interested, call us on 031 552 21 25 or donate online here at www.compassion.ch/spenden.\n"
"% endif\n"
"\n"
"<br>\n"
"<br>\n"
"We are thankful to work with you and so many other sponsors and donors to help release children from poverty every day.\n"
"<br>\n"
"<br>\n"
"Sincerely,\n"
"\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"    ${object.sudo().user_id.short_signature | safe}\n"
"    </p>\n"
"% endif "
msgstr ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set child = sponsorships.mapped('child_id')\n"
"    % set nb_weeks = sponsorships[:1].contract_duration // 7\n"
"    % set nb_years = (sponsorships[:1].contract_duration // 364) or 1\n"
"    % set field = child[:1].field_office_id\n"
"    % set hours_fcp = field.fcp_hours_week * nb_weeks\n"
"    % set meals = field.fcp_meal_week * nb_weeks\n"
"    % set medical = field.fcp_medical_check * nb_years\n"
"\n"
"    % if medical == 1:\n"
"        % set checkup = 'medizinische Untersuchung'\n"
"    % else:\n"
"        % set checkup = 'medizinische Untersuchungen'\n"
"    % endif\n"
"\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set name = child.get_list('preferred_name', 3, translate=False)\n"
"    % set lifecycle = child.mapped('lifecycle_ids')[:1]\n"
"    % set last_letter = sponsorships[:1].child_letter_ids[:1]\n"
"    % set number_unacceptable_conditions = object.get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"    % set number_deaths_under_5 = object.get_snippet('number_deaths_under_5') | striptags | safe\n"
"    % set age_deaths_under_5 = object.get_snippet('age_deaths_under_5') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${object.partner_id.salutation}\n"
"</p>\n"
"<p>\n"
"    Ich freue mich sehr, dass ${name} nach vielen Jahren Unterstützung erfolgreich ans Ende der Patenschaft kommt.\n"
"</p>\n"
"<p>\n"
"    ${name} steht nun als ${child.get('junger Erwachsener')} auf eigenen Beinen. ${child.get('sein').title()} Ziel\n"
"    ist es, ${lifecycle.get_list('future_hope_ids.value')}. Ist das nicht genial?\n"
"</p>\n"
"<p>\n"
"    Während ${deine}r Patenschaft konnte ${name} ${hours_fcp} Stunden im Kinderzentrum der lokalen Kirche verbringen.\n"
"    Dort wurde ${child.get('he')} liebevoll betreut und hat Hoffnung für ${child.get('sein')} Leben bekommen. ${name}\n"
"    hat ${meals} Mahlzeiten erhalten und bekam ${medical} ${checkup}. ${child.get('he').title()}\n"
"\n"
"    % if child[:1].age >= 7:\n"
"        konnte zur Schule gehen,\n"
"    % endif\n"
"\n"
"    wurde individuell gefördert und wusste, dass sich auf der anderen Seite der Welt jemand um ${child.get('ihn')}\n"
"    kümmert. <b>Vielen herzlichen Dank!</b>\n"
"</p>\n"
"<p>\n"
"    % if object.partner_id in sponsorships.mapped('correspondent_id'):\n"
"        % if 2 in last_letter.communication_type_ids.ids and not last_letter.sent_date:\n"
"            Es ist zusätzlich ein emotionaler Moment, denn wir schicken ${dir} im Anhang den letzten Brief von ${name}.\n"
"        <br>\n"
"        % endif\n"
"\n"
"        Gerne ${\"könnt ihr euch\" if plural else \"kannst du dich\"} von ${name} in einem letzten Brief verabschieden und\n"
"        ${child.get('ihn')} für die Zukunft ermutigen.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Danke, dass ${du} das Leben eines Kindes und dessen Familie nachhaltig verändert ${\"habt\" if plural else \"hast\"}!\n"
"</p>\n"
"<p>\n"
"    Unser Kampf gegen extreme Armut geht weiter! Es bleiben noch ${number_unacceptable_conditions} Millionen Kinder, die\n"
"    in inakzeptablen Umständen leben. ${number_deaths_under_5} Kinder unter ${age_deaths_under_5} Jahren sterben pro\n"
"    Tag. Diese Tatsache können wir nicht so stehen lassen! Deswegen erlauben wir uns, ${dir} bald eine neue Patenschaft\n"
"    vorzuschlagen.\n"
"</p>\n"
"<p>\n"
"    Gemeinsam verändern wir das Leben von Kindern - eins nach dem anderen.\n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"<p>\n"
"    ${object.user_id.signature | safe}\n"
"    <br>\n"
"    <br>\n"
"</p>\n"
"% endif"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_reinstatement
msgid ""
"<div>\n"
"   % set child = object.get_objects()\n"
"    \n"
"% set partner = object.partner_id\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation}\n"
"   <br>\n"
"   <br>\n"
"   We have received good news! ${child.get('your sponsored child')}${child.get_list('preferred_name')} has returned to the project of the local church and has been re-enrolled in the sponsorship program, because ${child.lifecycle_ids[:1].translate('request_reason')}.\n"
"   <br>\n"
"   <br>\n"
"   You were previously the sponsor of ${child.get_list('preferred_name')}. Thus we would like to offer you the opportunity to sponsor ${child.get_list('preferred_name')} again and continue to invest in ${child.get('his')} life in order to release ${child.get('him')} from poverty in the long-term. We thank you in advance for a quick answer.\n"
"   <br>\n"
"   <br>\n"
"   After more than 70 years of experience, we at Compassion believe: Taking on a sponsorship changes the life of a child, their family and their surroundings. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together with you and our 8600 partner churches in the global south, we are able to transform the lives of more than 2,3 million children in 25 countries.\n"
"   <br>\n"
"   <br>\n"
"   Kind Regards,\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"    ${object.user_id.signature | safe}\n"
"\n"
"% endif\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Wir haben erfreuliche Nachrichten erhalten!\n"
"</p>\n"
"<p>\n"
"    ${dein.title()} Patenkind ${child.get_list('preferred_name')} ist ins Kinderzentrum von Compassion zurückgekehrt\n"
"    und wurde wieder ins Patenschaftsprogramm aufgenommen.\n"
"</p>\n"
"<p>\n"
"    ${du.title()} ${'wart' if plural else 'warst'}\n"
"    % if plural:\n"
"        die Paten\n"
"    % else:\n"
"        ${\"der Pate\" if partner.gender == \"M\" else \"die Patin\"}\n"
"    % endif\n"
"    von ${child.get_list('preferred_name')}. Deshalb möchten wir ${'euch' if plural else 'dir'} als erstes die Chance\n"
"    geben: ${'Wollt' if plural else 'Willst'} ${du} die Patenschaft für ${child.get_list('preferred_name')} wieder\n"
"    übernehmen?\n"
"</p>\n"
"<p>\n"
"    Falls ja, ${'gebt' if plural else 'gib'} uns bitte so schnell wie möglich Bescheid. ${'Stellt' if plural else\n"
"    'Stell'} ${'euch' if plural else 'dir'} die riesige Freude vor, wenn ${child.get_list('preferred_name')} davon\n"
"    erfährt.\n"
"</p>\n"
"\n"
"% if object.send_mode != \"sms\":  \n"
"    <p>\n"
"        Mit ${years_lc} ${number_years} Jahren Erfahrung wissen wir, dass eine Patenschaft nicht nur das Leben eines\n"
"        Kindes, sondern die ganze Familie und deren soziales Umfeld nachhaltig verändern kann.\n"
"    </p>\n"
"    <p>\n"
"        Danke, dass ${du} uns im Kampf gegen extreme Armut zur Seite ${'steht' if plural else 'stehst'}!\n"
"    </p>\n"
"    <p>\n"
"        Liebe Grüsse\n"
"        % if object.send_mode == 'digital':\n"
"            <br>\n"
"            <br>\n"
"            ${object.user_id.signature | safe}\n"
"        % endif\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        Liebe Grüsse<br/>\n"
"        Sarah<br/>\n"
"        Tel: +41 (0)31 552 21 21<br/>\n"
"        Fragen? <a href=\"${wp_tchat_url}\">${wp_tchat_url}</a>\n"
"    </p>\n"
"% endif\n"

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_illness
msgid ""
"<div>\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p>\n"
"   ${object.partner_id.salutation},\n"
"   <br>\n"
"   <br>\n"
"\n"
"    Thank you for investing in the life of ${child.preferred_name} with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"    In Switzerland and also in the country where ${child.preferred_name}     lives, healthcare problems sometimes occurdespite medical care and support. Our staff at the Children‘s Center haveinformed us that ${child.preferred_name} has ${child.current_values}. It is a chronic illness.\n"
"   <br>\n"
"   <br>\n"
"    Thanks to your regular support and through a special fund for medical emergencies, Compassion is committed to the treatment and care of ${child.preferred_name}. If you accompany ${child.get('him')} in prayer now and ask for God‘s blessings andprotection, you are taking on an important service for this child!\n"
"      <br>\n"
"   <br>\n"
"    Your support of a child in extreme poverty is valuable. At Compassion, weare convinced that this will give a child the chance for a dignified and meaningfullife. ${object.success_sentence or ''}\n"
"     <br>\n"
"   <br>\n"
"    Thank you again for your committment, so that together we can positivelytransform the lives of currently more than 2 million children in 25countries.\n"
"     <br>\n"
"   <br>\n"
"    Best regards,\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"      ${object.user_id.signature | safe}\n"
"% endif\n"
"  \n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"   % set child = object.get_objects()\n"
"  </div>\n"
"  <p>\n"
"   ${object.partner_id.salutation}\n"
"   <br>\n"
"   <br>\n"
"   Herzlichen Dank, dass Sie in das Leben von ${child.preferred_name or child.firstname} mit einer Patenschaft investieren.\n"
"  </p>\n"
"  <p>\n"
"   In der Schweiz und auch in dem Land, in dem ${child.preferred_name or child.firstname} lebt, treten trotz medizinischer Versorgung und Unterstützung manchmal gesundheitliche Probleme auf. Unsere Mitarbeitenden im Kinderzentrum vor Ort haben uns mitgeteilt, dass der ${child.preferred_name or child.firstname} eine Krankheit hat. Es ist eine chronische ${child.current_values}-Behinderung.\n"
"  </p>\n"
"  <p>\n"
"   Dank Ihrer regelmässigen Unterstützung und mithilfe eines besonderen Fonds für medizinische Notfälle setzt sich Compassion für die Behandlung und Versorgung von ${child.preferred_name or child.firstname} ein. Wenn Sie ihn/ sie jetzt im Gebet begleiten und Gott um Segen und Bewahrung bitten, übernehmen Sie einen wichtigen Dienst für dieses Kind!\n"
"  </p>\n"
"  <p>\n"
"   Ihre Unterstützung eines Kindes in extremer Armut ist wertvoll. Bei Compassion sind wir davon überzeugt, dass Sie dadurch einem Kind die Chance auf ein würdevolles und bedeutungsvolles Leben ermöglichen. ${object.success_sentence or ''}\n"
"  </p>\n"
"  <p>\n"
"   Noch einmal vielen Dank für Ihr Engagement, so dass wir gemeinsam das Leben von zur Zeit mehr als 2 Millionen Kindern in 27 Ländern positiv verändern.\n"
"  </p>\n"
"  <p>\n"
"   <br>\n"
"   Freundliche Grüsse\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"      ${object.user_id.short_signature | safe}\n"
"% endif\n"
"  </p>\n"
" "

#. module: partner_communication_compassion
#: model:mail.template,body_html:partner_communication_compassion.email_child_notes
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"                    \n"
"% set child = object.get_objects()\n"
"                    \n"
"% set firstname = child.get_list('preferred_name', 3, 'many children', False)\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation}\n"
"   <br>\n"
"   <br>\n"
"   Thank you for investing in the life of ${firstname} with a sponsorship.\n"
"   <br>\n"
"   <br>\n"
"   The living situation of your sponsored child has changed. The staff at the the Child Development Center has informed us that ${child.get_list('note_ids.body')}\n"
"   <br>\n"
"   <br>\n"
"   Your support for a child in extreme poverty is valuable. At Compassion, we believe that this will give a child the opportunity to live a dignified and meaningful life. ${object.success_sentence or ''}\n"
"   <br>\n"
"   <br>\n"
"   Once again, thank you for your commitment so that together we can positively transform the lives of currently more than 2 million children in 25 countries.\n"
"   <br>\n"
"  <br>\n"
"  Kind regards,\n"
"  <br>\n"
"  <br>\n"
"% if object.send_mode == 'digital':\n"
"       ${object.user_id.signature | safe}\n"
"% else:\n"
"    PS: As you requested, we will send you the original letter${s}. Please keep in mind it can take several weeks until we receive it.\n"
"% endif\n"
" </p>"
msgstr ""
"<div>\n"
"    % set child = object.get_objects()\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set wp_tchat_url = \"https://mycompassion.ch/de_DE/im_livechat/support/2\"\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"\n"
"<p>\n"
"    Wir haben vom Kinderzentrum erfahren, dass sich die Situation ${deine}s Patenkindes wie folgt verändert hat:\n"
"</p>\n"
"<ul>\n"
"    % for revision in child.mapped('revised_value_ids') + child.mapped('household_id.revised_value_ids'):\n"
"        <li>\n"
"            ${revision.name} : ${revision.old_value} -&gt; ${revision.get_field_value()}\n"
"        </li>\n"
"    % endfor\n"
"% if child.note_ids:\n"
"    <li>${child.note_ids[0].body or ''}</li>\n"
"    % endif\n"
"</ul>\n"
"\n"
"% if object.send_mode != \"sms\":\n"
"<p>\n"
"    Mit ${years_lc} ${number_years} Jahren Erfahrung, wissen wir, dass eine Patenschaft nicht nur das Leben eines\n"
"    Kindes, sondern die ganze Familie und deren soziales Umfeldes nachhaltig verändern kann.\n"
"</p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Danke, dass ${du} uns im Kampf gegen extreme Armut zur Seite ${'steht' if plural else 'stehst'}!\n"
"</p>\n"
"\n"
"% if object.send_mode != \"sms\":\n"
