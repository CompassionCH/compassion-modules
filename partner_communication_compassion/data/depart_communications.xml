<odoo noupdate="1">
        <record id="email_planned_exit_notification" model="mail.template">
            <field name="name">Notification Planned Exit</field>
            <field
        name="model_id"
        ref="partner_communication.model_partner_communication_job"
      />
            <field
        name="email_from"
      >"${object.user_id.company_id.name}" &lt;${object.user_id.company_id.email}&gt;</field>
            <field name="reply_to">${object.user_id.company_id.email}</field>
            <field
        name="partner_to"
      >${object.partner_id and object.partner_id.email and object.partner_id.id or False }</field>
            <field
        name="subject"
      >We have good news about ${object.get_objects().mapped('child_id').get_list('preferred_name',translate=False)}!</field>
            <field name="body_html" type="html">
                <div>
                % set partner = object.partner_id
                % set plural = partner.title.plural or partner.title.id == 29
                % set sponsorships = object.get_objects()
                % set children = sponsorships.mapped('child_id')
                % set firstname = children.get_list('preferred_name', 3, children.get_number(), translate=False)
                % set less_3 = firstname != children.get_number()
                % set nb_years = (sponsorships[:1].contract_duration // 364)
                % set is = 'are' if children|length > 1 else 'is'
                </div>

                <p>
                    ${partner.salutation},
                </p>

                <p>
                    We have good news!
                </p>

                <p>
                % if nb_years > 0:
                    After ${(datetime.datetime.now() - sponsorships[:1].start_date).days // 364} years of support from you and the staff in the field, ${firstname} ${is} coming to the end of the sponsorship journey in the next few weeks.
                % else:
                    ${firstname} ${is} coming to the end of the sponsorship journey in the next few weeks.
                % endif
                </p>

                <p>
                    That's a reason to celebrate and be thankful!
                </p>

                <p>
                    We will send you more detailed information about the end of the sponsorship by mail in the coming days.
                </p>

                <p>
                    Thank you so much for your investment in the life of ${firstname}.
                </p>

                <p>
                    Kind regards,
                </p>

                <p>
                    % if object.send_mode == "digital":
                        ${object.user_id.signature | safe}
                    % endif
                </p>
            </field>
        </record>
        <!-- Child Planned Exit -->
        <!-- For now, planned and unplanned exit share the same template, but they might differ. -->
        <record id="email_child_planned_exit" model="mail.template">
            <field name="name">Child Lifecycle - Planned Exit</field>
            <field
        name="model_id"
        ref="partner_communication.model_partner_communication_job"
      />
            <field name="email_from">"{{ object.user_id.company_id.with_context(lang=object.partner_id.lang).commercial_name if 'commercial_name' in object.user_id.company_id._fields else object.user_id.company_id.name }}" &lt;compassion@compassion.ch&gt;</field>
            <field name="reply_to">info@compassion.ch</field>
            <field name="partner_to">{{object.partner_id and object.partner_id.email and object.partner_id.id or False }}</field>
            <field name="subject">End of your sponsorship for {{object.get_objects().get_list('child_id.local_id', 3)}}</field>
            <field name="body_html" type="html">
                    <t t-set="sponsorships" t-value="object.get_objects()"/>
                    <t t-set="child" t-value="sponsorships.mapped('child_id')"/>
                    <t t-set="one_child" t-value="len(child) == 1"/>
                    <t t-set="nb_weeks" t-value="sponsorships[:1].contract_duration // 7"/>
                    <t t-set="nb_years" t-value="(sponsorships[:1].contract_duration // 364) or 1"/>
                    <t t-set="field" t-value="child[:1].field_office_id"/>
                    <t t-set="hours_fcp" t-value="field.fcp_hours_week * nb_weeks"/>
                    <t t-set="meals" t-value="field.fcp_meal_week * nb_weeks"/>
                    <t t-set="medical" t-value="field.fcp_medical_check * nb_years"/>
                    <t t-set="checkup" t-value="'check-up' if medical == 1 else 'check-ups'"/>
                    <t t-set="name" t-value="child.get_list('preferred_name', 3, 'your children')"/>
                    <t t-set="he" t-value="child.get('he')"/>
                    <t t-set="He" t-value="he[:1].upper() + he[1:]"/>
                    <t t-set="hopes" t-value="child.mapped('lifecycle_ids')[:1].get_list('future_hope_ids.value')"/>
                    <t t-set="last_letter" t-value="sponsorships[:1].child_letter_ids[:1]"/>
                    <t t-set="mycompassion_url" t-value="'https://www.mycompassion.ch'"/>
                    <t t-set="number_unacceptable_conditions" t-value="object.get_snippet('number_unacceptable_conditions', strip_html=True)"/>
                    <t t-set="number_deaths_under_5" t-value="object.get_snippet('number_deaths_under_5', strip_html=True)"/>
                    <t t-set="age_deaths_under_5" t-value="object.get_snippet('age_deaths_under_5', strip_html=True)"/>
                <p>
                    <t t-out="object.partner_id.salutation"/>,
                </p>
                <p>
                    We are delighted to inform you that after many years of support, <t t-out="name"/> <t t-out="'is' if one_child else 'are'"/> coming to the end of <t t-out="child.get('his')"/> sponsorship.
                </p>
                <p>
                    <b>
                        <t t-out="'Now a young adult' if one_child else 'Now young adults'"/>, <t t-out="he"/> <t t-out="'has' if one_child else 'have'"/> become <t t-out="'a responsible person' if one_child else 'responsible people'"/>, ready to face life with hope and confidence. Isn't that great?
                    </b>
                </p>
                <t t-if="one_child and hopes">
                    <p>
                        The local staff have told us that <t t-out="name"/>'s goals are to <t t-out="hopes"/>.
                    </p>
                </t>
                <p t-if="one_child">
                    During your sponsorship, <t t-out="he"/> spent <t t-out="hours_fcp"/> hours at the child development center of the local church. The staff took care of <t t-out="child.get('him')"/> with love and gave <t t-out="child.get('him')"/> hope for <t t-out="child.get('his')"/> future. <t t-out="He"/> received <t t-out="meals"/> meals and benefited from <t t-out="medical"/> medical <t t-out="checkup"/>.
                    <t t-if="child[:1].age &gt;= 7">
                        <t t-out="He"/> <t t-out="child.get('was')"/> able to go to school and be encouraged to develop <t t-out="child.get('his')"/> talents.
                    </t>
                    Finally, <t t-out="he"/> discovered that someone on the other side of the world cared about <t t-out="child.get('him')"/>. Thank you so much!
                </p>
                <p t-else="">
                    During your sponsorship, the staff of the child development center of the local church took care of <t t-out="name"/> with love and gave them hope for their future. Finally, they discovered that someone on the other side of the world cared about them. Thank you so much!
                </p>
                <t t-if="object.partner_id in sponsorships.mapped('correspondent_id')">
                    <t t-if="2 in last_letter.communication_type_ids.ids and not last_letter.sent_date">
                        <p>
                            This is an emotional moment, as we are sending you<t t-if="object.send_mode == 'physical'">, enclosed,</t> <t t-out="child.get('his')"/> last letter.
                        </p>
                    </t>
                    <p>
                        You are welcome to write a last letter to <t t-out="name"/> to say goodbye to <t t-out="child.get('him')"/> and encourage <t t-out="child.get('him')"/> for the future. You can write it easily on <a t-att-href="mycompassion_url">MyCompassion</a>.
                    </p>
                </t>
                <p>
                    Thank you for investing in the life of a child and their family, bringing about lasting change.
                </p>
                <t t-if="sponsorships[:1].sds_state in (&quot;sub&quot;, &quot;sub_waiting&quot;)">
                <p>
                    Our fight against extreme poverty continues. <t t-out="number_unacceptable_conditions"/> million children still live in unacceptable conditions. <t t-out="number_deaths_under_5"/> children under <t t-out="age_deaths_under_5"/> die every day. We cannot stand by in the face of this injustice. That is why we will soon send you a proposal for a new sponsorship.
                </p>
                </t>
                <p>
                    Together, we are changing the world, one child at a time.
                </p>
                <p>
                    Best regards,
                </p>
                <t t-if="object.send_mode == 'digital'">
                    <p t-out="object.sudo().user_id.signature"/>
                </t>
            </field>
        </record>

        <!-- Child Unplanned Exit -->
        <record id="email_child_unplanned_exit" model="mail.template">
            <field name="name">Child Lifecycle - Unplanned Exit</field>
            <field
        name="model_id"
        ref="partner_communication.model_partner_communication_job"
      />
            <field name="email_from">"{{ object.user_id.company_id.with_context(lang=object.partner_id.lang).commercial_name if 'commercial_name' in object.user_id.company_id._fields else object.user_id.company_id.name }}" &lt;compassion@compassion.ch&gt;</field>
            <field name="reply_to">info@compassion.ch</field>
            <field name="partner_to">{{object.partner_id and object.partner_id.email and object.partner_id.id or False }}</field>
            <field name="subject">Important information about {{object.get_objects().get_list('child_id.preferred_name', 3, 'your sponsored children', translate=False)}}</field>
            <field name="body_html" type="html">
                    <t t-set="sponsorships" t-value="object.get_objects()"/>
                    <t t-set="child" t-value="sponsorships.mapped('child_id')"/>
                    <t t-set="one_child" t-value="len(child) == 1"/>
                    <t t-set="nb_weeks" t-value="sponsorships[:1].contract_duration // 7"/>
                    <t t-set="nb_years" t-value="(sponsorships[:1].contract_duration // 364) or 1"/>
                    <t t-set="field" t-value="child[:1].field_office_id"/>
                    <t t-set="hours_fcp" t-value="field.fcp_hours_week * nb_weeks"/>
                    <t t-set="meals" t-value="field.fcp_meal_week * nb_weeks"/>
                    <t t-set="lunch" t-value="'meal' if meals == 1 else 'meals'"/>
                    <t t-set="medical" t-value="field.fcp_medical_check * nb_years"/>
                    <t t-set="checkup" t-value="'medical check-up' if medical == 1 else 'medical check-ups'"/>
                    <t t-set="name" t-value="child.get_list('preferred_name', 3, translate=False)"/>
                    <t t-set="he" t-value="child.get('he')"/>
                    <t t-set="He" t-value="he[:1].upper() + he[1:]"/>
                    <t t-set="his" t-value="child.get('his')"/>
                    <t t-set="His" t-value="his[:1].upper() + his[1:]"/>
                    <t t-set="him" t-value="child.get('him')"/>
                    <t t-set="lifecycle" t-value="child.mapped('lifecycle_ids')[:1]"/>
                    <t t-set="hopes" t-value="one_child and lifecycle.get_list('future_hope_ids.value')"/>
                    <t t-set="good_reason" t-value="one_child and lifecycle.with_context(lang=&quot;en_US&quot;).request_reason in (&quot;beneficiary pursuing career opportunity&quot;, &quot;conflicts with school or work schedule&quot;, &quot;family circumstances have changed positively so that child no longer needs compassion's assistance&quot;, &quot;no longer needs our assistance&quot;)"/>
                    <t t-set="reason" t-value="lifecycle.translate('request_reason').replace('Name', name)"/>
                    <t t-set="last_letter" t-value="sponsorships[:1].child_letter_ids[:1]"/>
                    <t t-set="mycompassion_url" t-value="'https://www.mycompassion.ch'"/>
                    <t t-set="number_unacceptable_conditions" t-value="object.get_snippet('number_unacceptable_conditions', strip_html=True)"/>
                    <t t-set="number_deaths_under_5" t-value="object.get_snippet('number_deaths_under_5', strip_html=True)"/>
                    <t t-set="age_deaths_under_5" t-value="object.get_snippet('age_deaths_under_5', strip_html=True)"/>
                <p t-out="object.partner_id.salutation"/>
                <t t-if="not one_child">
                <p>
                    We have received unexpected news from our staff: the sponsorships of <t t-out="name"/> will come to an end early, for the following reasons:
                </p>
                <ul>
                    <t t-foreach="child" t-as="c">
                        <t t-set="child_reason" t-value="c.mapped('lifecycle_ids')[:1].translate('request_reason')"/>
                        <li t-if="child_reason"><t t-out="c.preferred_name"/>: <t t-out="child_reason"/></li>
                    </t>
                </ul>
                </t>
                <p t-if="one_child">
                    <t t-if="good_reason">
                        We have good news! <t t-out="name"/> will come to the end of <t t-out="his"/> sponsored journey early, because <t t-out="reason"/>.
                        <t t-if="hopes">
                            <t t-out="His"/> goal is to <t t-out="hopes"/>. Isn't that great?
                        </t>
                    </t>
                    <t t-else="">
                        We have received unexpected news from our staff <t t-out="field.country_id.in_preposition"/> <t t-out="field.country_id.name"/>. <t t-out="name"/> will come to the end of <t t-out="his"/> sponsored journey early, because <t t-out="reason"/>.
                    </t>
                </p>
                <p t-if="one_child">
                    During your sponsorship, <t t-out="name"/> spent <t t-out="hours_fcp"/> hours at the child center of the local church. The staff took care of <t t-out="him"/> with love and gave <t t-out="him"/> hope for <t t-out="his"/> future. <t t-out="He"/> received <t t-out="meals"/> <t t-out="lunch"/> and benefited from <t t-out="medical"/> <t t-out="checkup"/>.
                    <t t-if="child[:1].age &gt;= 7">
                        <t t-out="He"/> <t t-out="child.get('was')"/> able to go to school and be encouraged to develop <t t-out="his"/> talents.
                    </t>
                    Finally, <t t-out="he"/> discovered that someone on the other side of the world cared about <t t-out="him"/>. <b>Thank you so much!</b>
                </p>
                <p t-else="">
                    During your sponsorship, the staff of the child center of the local church took care of <t t-out="name"/> with love and gave them hope for their future. Finally, they discovered that someone on the other side of the world cared about them. <b>Thank you so much!</b>
                </p>
                <p t-if="good_reason">
                    We understand that this news might come as a surprise to you, but we hope that you will still be able to rejoice with us.
                </p>
                <t t-if="not good_reason">
                    <p>
                        We understand that this news might come as a surprise to you. In circumstances of extreme poverty, the life situation sometimes changes in ways that we are not accustomed to. We are very sorry that your sponsorship with <t t-out="name"/> has abruptly ended.
                    </p>
                    <p>
                        Your investment will continue to impact and inspire <t t-out="him"/> and <t t-out="his"/> family. <t t-out="name"/> is doing well.
                        <t t-if="hopes">
                            <t t-out="His"/> goal is to <t t-out="hopes"/>. Isn't that great?
                        </t>
                    </p>
                </t>
                <t t-if="object.partner_id in sponsorships.mapped('correspondent_id')">
                    <t t-if="2 in last_letter.communication_type_ids.ids and not last_letter.sent_date">
                        <p>
                            This is an emotional moment, as we are sending you<t t-if="object.send_mode == 'physical'">, enclosed,</t> <t t-out="his"/> <t t-out="'last letter' if one_child else 'last letters'"/>.
                        </p>
                    </t>
                    <p>
                        You are welcome to write a last letter to <t t-out="name"/> to say goodbye to <t t-out="him"/> and encourage <t t-out="him"/> for the future. You can write it easily on <a t-att-href="mycompassion_url">MyCompassion</a>.
                    </p>
                </t>
                <p>
                    Thank you for changing the life of a child and <t t-out="his"/> family in a sustainable way!
                </p>
                <t t-if="sponsorships[:1].sds_state in (&quot;sub&quot;, &quot;sub_waiting&quot;)">
                    <p>
                        Our fight against extreme poverty continues! <t t-out="number_unacceptable_conditions"/> million children still live in unacceptable conditions. <t t-out="number_deaths_under_5"/> children under the age of <t t-out="age_deaths_under_5"/> die every day. We seek to tackle this urgency. With this in mind, we will soon suggest another child for you to sponsor.
                    </p>
                </t>
                <p>
                    Together, we are changing the world! One child at a time.
                </p>
                <p>
                    Best regards,
                </p>
                <t t-if="object.send_mode == &quot;digital&quot;">
                    <p t-out="object.user_id.signature"/>
                </t>
            </field>
        </record>

        <!-- Communication Rules -->
        <record
      id="planned_exit_notification"
      model="partner.communication.config"
    >
            <field name="name">Notification Planned Exit</field>
            <field name="send_mode">digital</field>
            <field
        name="send_mode_pref_field"
      >global_communication_delivery_preference</field>
            <field
        name="report_id"
        ref="partner_communication.report_a4_communication"
      />
            <field
        name="email_template_id"
        ref="email_planned_exit_notification"
      />
            <field name="model_id" ref="model_recurring_contract" />
        </record>
        <record
      id="lifecycle_child_planned_exit"
      model="partner.communication.config"
    >
            <field name="name">Participant Planned Exit</field>
            <field name="send_mode">physical</field>
            <field
        name="send_mode_pref_field"
      >global_communication_delivery_preference</field>
            <field
        name="report_id"
        ref="partner_communication.report_a4_communication"
      />
            <field name="email_template_id" ref="email_child_planned_exit" />
            <field name="print_if_not_email">True</field>
            <field name="model_id" ref="model_recurring_contract" />
            <field
        name="user_id"
        search="[('name', 'like', 'Rochat Carole')]"
      />
            <field name="attachments_function">final_letter_attachment</field>
        </record>
        <record
      id="lifecycle_child_unplanned_exit"
      model="partner.communication.config"
    >
            <field name="name">Participant Unplanned Exit</field>
            <field name="send_mode">physical</field>
            <field
        name="send_mode_pref_field"
      >global_communication_delivery_preference</field>
            <field name="email_template_id" ref="email_child_unplanned_exit" />
            <field
        name="report_id"
        ref="partner_communication.report_a4_communication"
      />
            <field name="print_if_not_email">True</field>
            <field name="model_id" ref="model_recurring_contract" />
            <field
        name="user_id"
        search="[('name', 'like', 'Rochat Carole')]"
      />
            <field name="attachments_function" eval="False" />
        </record>
</odoo>
