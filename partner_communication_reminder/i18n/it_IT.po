#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_reminder_3
msgid ""
"<div>\n"
"                    \n"
"% set sponsorships = object.get_objects()\n"
"   % set partner = sponsorships.partner_id\n"
"                    \n"
"% set children = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation}\n"
"   <br>\n"
"   <br>\n"
"   Previously, you had made a decision to sponsor ${firstname} to release ${children.get('him')} from extreme poverty. However, this commitment has not been confirmed by you with the funds you had pledged.\n"
"   <br>\n"
"   <br>\n"
"   Therefore, we must inform you that we have canceled the sponsorship today.\n"
"   <br>\n"
"   <br>\n"
"   We will look for a new sponsor for ${firstname} so that ${children.get('he')} can be supported and to enable ${children.get('him')} to live a life with hope in the future. A personal sponsorship changes the life of a child in extreme poverty in the long-term and is sustainable.\n"
"   <br>\n"
"   <br>\n"
"   ${object.success_sentence or ''} If you decide later on to become a sponsor, we would be happy to hear from you.\n"
"   <br>\n"
"   <br>\n"
"   Did you know that you can help children in poverty by giving them access to drinking water (water filters, toilet installation, hygiene awareness)? With a regular or one-time donation of CHF 10.-, 20.- or 30.- per month , you can make a big difference. If you are interested, please call us at 024 434 21 24 or you can donate online at: www.compassion.ch/spenden\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"  </p>\n"
"  "
msgstr ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set partner = sponsorships.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    ${'Avete' if plural else 'Hai'} scelto di sostenere ${firstname} per aiutarl${'o' if children.gender == 'M' else 'a'} a uscire dalla povertà estrema.\n"
"</p>\n"
"<p>\n"
"    Questo impegno non è stato confermato dal pagamento. Per questo motivo, ${'vi' if plural else 'ti'} informiamo che il sostegno è stato annullato. Compassion Svizzera cercherà un altro sostenitore affinché ${firstname} possa beneficiare del sostegno e delle attività messe in atto per assicurar${'gli' if children.gender == 'M' else 'le'} una vita dignitosa e piena di senso.\n"
"</p>\n"
"<p>\n"
"    Se ${'cambiaste' if plural else 'cambiassi'} idea, ${'vi' if plural else 'ti'} preghiamo di contattarci il prima possibile per telefono o via e-mail.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_reminder_2
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorships = object.get_objects()\n"
"    % set one_child = len(sponsorships) == 1\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set less_4 = firstname != children.get_number()\n"
"    % set invoices = sponsorships.mapped('due_invoice_ids')\n"
"    % set amount = sum(invoices.mapped('amount_total'))\n"
"    % set number = max(sponsorships.mapped('months_due'))\n"
"    % set month = invoices.get_date('invoice_date', 'MMMM')\n"
"    % set letter = object.send_mode == 'physical'\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you so much for your precious commitment towards ${firstname if less_4 else \"many children\"}.\n"
"</p>\n"
"<p>\n"
"    It has come to our awareness that, despite our last message, your sponsorship contributions for ${month} have not been transferred, which amounts to a total of CHF $\"{:.0f}\".format(amount).-. Thank you in advance for taking care of this within the next 10 days using the attached payment slip.*\n"
"</p>\n"
"<p>\n"
"    % if one_child:\n"
"        Otherwise, we will be left with no other choice than to end the sponsorship for ${firstname} and find ${'him' if children.gender == 'M' else 'her'} a new sponsor.\n"
"    % else:\n"
"        Otherwise, we will be left with no other choice than to end the sponsorships and find a new sponsor for the children.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Please do not hesitate to contact us if you have any questions. We can find a solution together if you are currently experiencing difficulties to finance the sponsorship.\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    *No need to take further action should this message have Please ignore this letter if it has crossed with your donation.\n"
"</p>"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorships = object.get_objects()\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set invoices = sponsorships.mapped('due_invoice_ids')\n"
"    % set amount = sum(invoices.mapped('amount_total'))\n"
"    % set number = max(sponsorships.mapped('months_due'))\n"
"    % set month = invoices.get_date('invoice_date', 'MMMM')\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    ${'Vi' if plural else 'Ti'} ringraziamo di cuore per il ${'vostro' if plural else 'tuo'} contributo a favore di ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Nonostante la nostra ultima comunicazione, l’importo del ${'vostro' if plural else 'tuo'} sostegno ${'dei' if plural else 'del'} mese di ${month}, pari a ${\"{:.0f}\".format(amount)} CHF, non è stato ancora versato.\n"
"</p>\n"
"<p>\n"
"    ${'Vi' if plural else 'Ti'} preghiamo di utilizzare il bollettino di versamento allegato per inviare la ${'vostra' if plural else 'tua'} donazione entro 10 giorni.* In caso contrario, dovremo annullare il ${'vostro' if plural else 'tuo'} sostegno e cercare un nuovo sostenitore per ${firstname}.\n"
"</p>\n"
"\n"
"% if lsv_dd:\n"
"    <p>\n"
"        ${'Vi' if plural else 'Ti'} proponiamo di modificare la modalità di pagamento e di impostare un ordine permanente utilizzando il bollettino di versamento allegato.\n"
"    </p>\n"
"    <p>\n"
"        ${'Potete' if plural else 'Puoi'} anche comunicarci un nuovo conto bancario compilando e inviandoci per posta il modulo di autorizzazione da <a href=\"https://compassion.ch/wp-content/uploads/documents_compassion/Formulaire_LSV_DD_IT.pdf\">scaricare qui</a>.\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Non esita${'t' if plural else 'r'}e a contattarci per qualsiasi domanda o se sta${'te' if plural else 'i'} attraversando una situazione economica temporaneamente difficile. Insieme, possiamo trovare una soluzione per garantire una continuità al ${'vostro' if plural else 'tuo'} sostegno.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    * Se questa comunicazione è stata inviata contemporaneamente alla ${'vostra' if plural else 'tua'} donazione, ${'potete' if plural else 'puoi'} semplicemente ignorarla. Grazie!\n"
"</p>"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_activation_reminder_2
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set amount = sum(sponsorships.mapped('total_amount')) * min(sponsorships.mapped('group_id.advance_billing_months'))\n"
"    % set extension = children[0].hold_id.no_money_extension_duration\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set lsv_form_received = partner.bank_ids\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"    <br>\n"
"    <br>\n"
"    We very warmly thank you for choosing to sponsor ${firstname} and to be on our side to free one more child from extreme poverty.\n"
"    <br>\n"
"    <br>\n"
"    In spite of our previous reminder, we notice that\n"
"\n"
"    % if lsv_dd and not lsv_form_received:\n"
"        we still haven't received the direct debit authorization form. This means that your sponsorship could not be activated. <b>Please return the completed document to us within 15 days.</b>\n"
"        Otherwise, we will have to cancel your sponsorship and look for a new sponsor for ${firstname}. If you wish to use a standing order for the payment of your sponsorship, please contact us.\n"
"    % else:\n"
"        we notice that your first payment is still missing. Your sponsorship is thus not activated. <b>We kindly ask you to transfer the amount of CHF ${\"{:.0f}\".format(amount)}.- within ${extension} days using the payment slip attached.</b>\n"
"        Otherwise, we will have to cancel your sponsorship and look for a new sponsor for ${firstname}. Please do not hesitate to contact us if you are not able to make the payment at the moment. We will find a solution together to guarantee ${firstname} support. If your payment has crossed with this letter, please disregard this letter.\n"
"    % endif\n"
"    <br>\n"
"    <br>\n"
"    Thanks to you and the commitment of the many sponsors, ${number_children} million children are currently being supported and freed from extreme poverty.\n"
"    <br>\n"
"    <br>\n"
"    With our warmest greetings.\n"
"</p>"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set boy = children.gender == 'M'\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set amount = sum(sponsorships.mapped('total_amount')) * min(sponsorships.mapped('group_id.advance_billing_months'))\n"
"    % set extension = children[0].hold_id.no_money_extension_duration\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set lsv_form_received = partner.bank_ids\n"
"    % set number_years = object.env[\"partner.communication.job\"].get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.env[\"partner.communication.job\"].get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.env[\"partner.communication.job\"].get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.env[\"partner.communication.job\"].get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.env[\"partner.communication.job\"].get_snippet('years_lc') | striptags | safe\n"
"    % set children_in_poverty = object.env[\"partner.communication.job\"].get_snippet('children_in_poverty') | striptags | safe\n"
"    % set early_deaths = object.env[\"partner.communication.job\"].get_snippet('early_deaths') | striptags | safe\n"
"    % set number_mothers = object.env[\"partner.communication.job\"].get_snippet('number_mothers') | striptags | safe\n"
"    % set number_unacceptable_conditions = object.env[\"partner.communication.job\"].get_snippet('number_unacceptable_conditions') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"\n"
"% if not sub:\n"
"    <p>\n"
"        ${'Vi' if plural else 'Ti'} ringraziamo per aver scelto di sostenere ${firstname} e di impegnar${'v' if plural else 't'}i al nostro fianco per liberare un altro bambino dalla povertà estrema.\n"
"    </p>\n"
"    <p>\n"
"        Purtroppo, non è stato possibile avviare il sostegno, perché non abbiamo ancora ricevuto la ${'vostra' if plural else 'tua'} donazione. ${firstname} sarà informat${'o' if boy else 'a'} non appena la riceveremo.*\n"
"    </p>\n"
"    <p>\n"
"\n"
"        % if lsv_dd:\n"
"            % if lsv_form_received:\n"
"                Il prelievo dal ${'vostro' if plural else 'tuo'} conto non è andato a buon fine. Per questo motivo, ${'vi' if plural else 'ti'} proponiamo di cambiare modalità di pagamento e di utilizzare il riferimento sul bollettino di versamento allegato per creare un ordine permanente destinato al sostegno.\n"
"            % else:\n"
"                Non abbiamo ricevuto il modulo di autorizzazione all'addebito diretto. ${'Vi' if plural else 'Ti'} preghiamo di compilarlo e di inviarcelo per posta entro i prossimi 15 giorni.\n"
"            % endif\n"
"        % else:\n"
"            ${'Vi' if plural else 'Ti'} preghiamo di effettuare il pagamento della prima donazione di ${amount} CHF entro 15 giorni utilizzando il bollettino allegato.\n"
"        % endif\n"
"\n"
"    </p>\n"
"    <p>\n"
"        Non esita${'t' if plural else 'r'}e a contattarci per qualsiasi domanda.\n"
"    </p>\n"
"    <p>\n"
"        Cari saluti,\n"
"    </p>\n"
"\n"
"    % if object.send_mode == 'digital':\n"
"        <p>\n"
"            ${object.user_id.signature | safe}\n"
"        </p>\n"
"    % endif\n"
"\n"
"    <p>\n"
"        *Se ${'avete' if plural else 'hai'} già effettuato questo pagamento, non ${'dovete' if plural else 'devi'} fare nulla.\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        Recentemente ${'vi' if plural else 'ti'} abbiamo informato della fine del sostegno di ${sub.get_list('preferred_name')}, proponendo${'v' if plural else 't'}i di sostenere ${firstname}.\n"
"    </p>\n"
"\n"
"    % if amount:\n"
"        <p>\n"
"            Da allora abbiamo ricevuto una donazione di ${amount} CHF da parte ${'vostra' if plural else 'tua'}, che non abbiamo potuto assegnare al sostegno di ${sub.get_list('preferred_name')}. Non avendo ricevuto una ${'vostra' if plural else 'tua'} risposta, abbiamo destinato questo importo al nostro fondo per i bambini in attesa di sostegno.\n"
"        </p>\n"
"        <p>\n"
"            Cercheremo un nuovo sostenitore per ${firstname}.\n"
"        </p>\n"
"    % endif\n"
"\n"
"    <p>\n"
"        Grazie di cuore per il ${'vostro' if plural else 'tuo'} impegno al nostro fianco nella lotta contro la povertà estrema. Saremmo felici di poter collaborare nuovamente con ${'voi' if plural else 'te'}te/voi in futuro.\n"
"    </p>\n"
"\n"
"    <p>\n"
"        Cari saluti,\n"
"    </p>\n"
"\n"
"    % if object.send_mode == 'digital':\n"
"        <p>\n"
"            ${object.user_id.signature | safe}\n"
"        </p>\n"
"    % endif\n"
"\n"
"% endif\n"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_reminder_1
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set wp = \"SWP\" in sponsorships.mapped(\"type\")\n"
"    % set partner = object.partner_id\n"
"    % set child = sponsorships.mapped(\"child_id\")\n"
"    % set firstname = child.get_list('preferred_name', translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set payment_type_attachement = sponsorships.get_payment_type_attachment_string()\n"
"    % set country = child.mapped('field_office_id')\n"
"    % set invoices = sponsorships.mapped('due_invoice_ids')\n"
"    % set amount = sum(invoices.mapped('amount_total'))\n"
"    % set number = max(sponsorships.mapped('months_due'))\n"
"    % set month = invoices.get_date('invoice_date', 'MMMM')\n"
"    % if firstname.endswith('s'):\n"
"        % set apostrophe = \"'\"\n"
"    % else:\n"
"        % set apostrophe = \"'s\"\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you for investing in the life of ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Your sponsorship is one of the best ways of releasing children from poverty in the long term, so that they can enjoy a life of dignity and meaning.\n"
"</p>\n"
"<p>\n"
"    <b>\n"
"        However, we have not received the ${number} monthly donations for ${month}, totalling CHF ${amount}.\n"
"    </b>\n"
"</p>\n"
"<p>\n"
"    Please find enclosed a payment slip to enable you to set up a new standing order*.\n"
"</p>\n"
"<p>\n"
"    % if wp:\n"
"        If you are unable to make this donation regularly or if you wish to adjust the amount, please contact us. Compassion will find another donor for the rest.\n"
"    % else:\n"
"        Please don't hesitate to contact us if you have any questions, or if, in these times of crisis in Switzerland, you find yourself in a temporarily more difficult financial situation. Together, we'll find a solution to guarantee ${firstname}${apostrophe} continued support.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Best regards\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
" % endif\n"
"<p>\n"
"    *Please ignore this letter if it has crossed with your donation.\n"
"</p>"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set suo = 'vostro' if plural else 'suo'\n"
"    % set lei = 'voi' if plural else 'lei'\n"
"    % set sponsorships = object.get_objects()\n"
"    % set wp = \"SWP\" in sponsorships.mapped(\"type\")\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set invoices = sponsorships.mapped('due_invoice_ids')\n"
"    % set amount = sum(invoices.mapped('amount_total'))\n"
"    % set number = max(sponsorships.mapped('months_due'))\n"
"    % set month = invoices.get_date('invoice_date', 'MMMM')\n"
"\n"
"    % set genders = children.mapped('gender')\n"
"    % set pronom_enfant = 'loro' if len(children) > 1 else ('le' if genders and genders[0] == 'F' else 'gli')\n"
"\n"
"    % if lsv_dd:\n"
"        % set PS = ''\n"
"    % else:\n"
"        % set PS = '*Se ' + ('avete' if plural else 'hai') + ' già effettuato la donazione, non ' + ('dovete' if plural else 'devi') + ' fare nulla.'\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Grazie per aver investito nel migliorare la vita di ${firstname}. Il ${'vostro' if plural else 'tuo'} sostegno è uno dei modi più efficaci per garantir${pronom_enfant} un futuro libero dalla povertà e una vita dignitosa e piena di senso.\n"
"</p>\n"
"\n"
"% if lsv_dd:\n"
"    <p>\n"
"        <b>Il prelievo sul ${'vostro' if plural else 'tuo'} conto non ha potuto essere effettuato ${'nei' if number > 1 else 'nel'} mese di ${month}, per un importo in sospeso di ${\"{:.0f}\".format(amount)} CHF.</b>\n"
"    </p>\n"
"    <p>\n"
"        ${'Vi' if plural else 'Ti'} proponiamo quindi di modificare la modalità di pagamento e di impostare un ordine permanente utilizzando il bollettino di versamento allegato.\n"
"    </p>\n"
"    <p>\n"
"        ${'Potete' if plural else 'Puoi'} anche comunicarci un nuovo conto bancario compilando e inviandoci per posta il modulo di autorizzazione da <a href=\"https://compassion.ch/wp-content/uploads/documents_compassion/Formulaire_LSV_DD_IT.pdf\">scaricare qui</a>.\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        <b>Non abbiamo ricevuto la donazione ${'dei' if number > 1 else 'del'} mese di ${month}, per un importo in sospeso di ${\"{:.0f}\".format(amount)} CHF</b>. ${'Troverete' if plural else 'Troverai'} allegato un bollettino di versamento per impostare un nuovo ordine permanente.*\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    % if wp:\n"
"        Se non ti è possibile effettuare questa donazione regolarmente o se desideri modificare l'importo, ti preghiamo di contattarci. Compassion si occuperà di trovare un altro donatore per cette parte del finanziamento.\n"
"    </p>\n"
"    % else:\n"
"        Non ${'esitate' if plural else 'esitare'} a contattarci per qualsiasi domanda o se ${'state' if plural else 'stai'} attraversando una situazione economica temporaneamente difficile. Insieme, possiamo trovare una solutione per garantire una continuità al ${'vostro' if plural else 'tuo'} sostegno.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>${PS}</p>"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_activation_reminder_1
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"    \n"
"% set sponsorships = object.get_objects()\n"
"    \n"
"% set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"% set frequency = sponsorships.mapped('group_freq')[0]\n"
"    \n"
"% set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    \n"
"% set lsv_form_received = partner.bank_ids\n"
"    \n"
"% set children = sponsorships.mapped('child_id')\n"
"    \n"
"% set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    \n"
"% set amount = sum(sponsorships.mapped('total_amount')) * min(sponsorships.mapped('group_id.advance_billing_months'))\n"
"    \n"
"% set extension = children[0].hold_id.no_money_extension_duration\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   We thank you for taking over the sponsorship for ${firstname}. The next step: Once your first donation payment (monthly, quarterly or yearly) has arrived, your sponsorship can officially begin. At this point, your sponsored child will also be notified that you are the sponsor.\n"
"   <br>\n"
"   <br>\n"
"   <!-- Keep space     -->\n"
"   % if lsv_dd:\n"
"\t\n"
"% if not lsv_form_received:\n"
"   <b>\n"
"    We are still waiting for the banking authorization form. Please fill it and send it back to us as soon as possible\n"
"   </b>\n"
"   so we can begin your sponsorship. Thank you for your prompt collaboration.\n"
"    \n"
"\t% else:\n"
"\tThe withdrawal from your account couldn't be executed. We therefore propose you to change your payment mode and settle a standing order with the reference that you can find on the attached payment slip.\n"
"% endif \n"
"\n"
"\t% else:\n"
"\tIf you have already made this transfer prior to receiving this letter, we thank you that you have taken care of this quickly and require no further action on your part. Your sponsored child is currently linked only to you and cannot be supported by another person. You have chosen to pay the sponsorship contributions ${frequency.lower()} which amounts to CHF ${'%d' | format(amount)}.- If you would like another arrangement, please contact us by phone at 031 552 21 25 or send an email to: rmaglo@compassion.ch. Please do not hesitate to contact us if you are currently experiencing difficulty in financing your sponsorship. Together, we will find a solution to support ${firstname}.\n"
"% endif\n"
"   <br>\n"
"   <br>\n"
"   We thank you for choosing to sponsor ${firstname}.  A personal sponsorship changes the life of a child in extreme poverty-- long-term and sustainable.  We wish you much joy with your sponsorship of ${firstname}.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"  </p>\n"
" "
msgstr ""
"<!--\n"
"Il ${'vostro' if object.partner_id.title.plural or object.partner_id.title.id == 29 else 'tuo'} sostegno a ${object.get_objects().mapped('child_id').get_list('preferred_name', 3, object.get_objects().mapped('child_id').get_number(), False)}\n"
"-->\n"
"\n"
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorships = object.get_objects()\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set lsv_form_received = partner.bank_ids\n"
"    % set frequency = sponsorships.mapped('group_freq')[0]\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set boy = children.gender == 'M'\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set less_4 = firstname != children.get_number()\n"
"    % set amount = sum(sponsorships.mapped('total_amount')) * min(sponsorships.mapped('group_id.advance_billing_months'))\n"
"    % set extension = children[0].hold_id.no_money_extension_duration\n"
"    % set sub = sponsorships.mapped('parent_id')\n"
"    % set sub_name = children.get_list('preferred_name').split(',')\n"
"\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Grazie per aver deciso di sostenere ${firstname}.\n"
"</p>\n"
"\n"
"% if sub:\n"
"    <p>\n"
"        Recentemente ${'vi' if plural else 'ti'} abbiamo informato della fine del sostegno di ${sub.get_list('preferred_name')}, proponendo${'v' if plural else 't'}i di continuare il ${'vostro' if plural else 'tuo'} impegno contro la povertà estrema sostenendo ${firstname}.\n"
"    </p>\n"
"    % if amount:\n"
"        <p>\n"
"            Da allora abbiamo ricevuto una donazione di ${amount|replace('.0','.-')} CHF da parte ${'vostra' if plural else 'tua'}, che non può più essere attribuita al sostegno di ${sub.get_list('preferred_name')}. Desider${'ate' if plural else 'i'} avviare il sostegno di ${firstname} o preferi${'te' if plural else 'sci'} ricevere un rimborso? ${firstname} essendo attualmente assegnat${'o' if boy else 'a'} a ${'voi' if plural else 'te'}, non può essere sostenut${'o' if boy else 'a'} da altre persone. ${'Vi' if plural else 'Ti'} saremmo quindi grati se potes${'te' if plural else 'si'} darci una risposta al più presto, inviandoci anche le ${'vostre' if plural else 'tue'} coordinate bancarie se necessario.\n"
"        </p>\n"
"    % else:\n"
"        <p>\n"
"            Sarest${'e' if plural else 'i'} dispost$'i' if plural else ('o' if partner.gender == 'M' else 'a')} a sostenere ${firstname}? Essendo attualmente assegnat${'o' if boy else 'a'} a ${'voi' if plural else 'te'}, non può essere sostenut${'o' if boy else 'a'} da altre persone. ${'Vi' if plural else 'Ti'} saremmo quindi grati se potes${'te' if plural else 'si'} darci una risposta al più presto.\n"
"        </p>\n"
"    % endif\n"
"% else:\n"
"    <p>\n"
"        Prossimo passo: una volta ricevuta la ${'vostra' if plural else 'tua'} donazione, il ${'vostro' if plural else 'tuo'} sostegno inizierà ufficialmente e ${firstname} verrà informat${'o' if boy else 'a'}. Attualmente, ${firstname} è stat${'o' if boy else 'a'} assegnat${'o' if boy else 'a'} a ${'voi' if plural else 'te'} e non può essere sostenut${'o' if boy else 'a'} da altre persone.\n"
"    </p>\n"
"    <p>\n"
"        % if lsv_dd:\n"
"            % if not lsv_form_received:\n"
"                Siamo ancora in attesa del modulo di autorizzazione all'addebito bancario. ${'Vi' if plural else 'Ti'} preghiamo di compilarlo e di inviarcelo al più presto per posta, in modo da poter avviare il sostegno.\n"
"            % else:\n"
"                Il prelievo dal ${'vostro' if plural else 'tuo'} conto non è andato a buon fine. Per questo motivo, ${'vi' if plural else 'ti'} proponiamo di cambiare modalità di pagamento e di utilizzare il riferimento sul bollettino di versamento allegato per creare un “ordine permanente” destinato al sostegno mensile.\n"
"            % endif\n"
"        % else:\n"
"            ${'Avete' if plural else 'Hai'} scelto di effettuare un versamento mensile di ${\"{:.0f}\".format(amount)} CHF.\n"
"        % endif\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Insieme, contribuiamo a cambiare il mondo, un bambino alla volta.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"\n"
"% if object.send_mode == 'digital':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_activation_reminder_3
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"                    \n"
"% set sponsorships = object.get_objects()\n"
"                    \n"
"% set children = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation}\n"
"   <br>\n"
"   <br>\n"
"   Previously, you had made a decision to sponsor ${firstname} to release ${children.get('him')} from extreme poverty. However, this commitment has not been confirmed by you with the funds you had pledged.\n"
"   <br>\n"
"   <br>\n"
"   Therefore, we must inform you that we have canceled the sponsorship today.\n"
"   <br>\n"
"   <br>\n"
"   We will look for a new sponsor for ${firstname} so that ${children.get('he')} can be supported and to enable ${children.get('him')} to live a life with hope in the future. A personal sponsorship changes the life of a child in extreme poverty in the long-term and is sustainable.\n"
"   <br>\n"
"   <br>\n"
"   ${object.success_sentence or ''} If you decide later on to become a sponsor, we would be happy to hear from you.\n"
"   <br>\n"
"   <br>\n"
"   Did you know that you can help children in poverty by giving them access to drinking water (water filters, toilet installation, hygiene awareness)? With a regular or one-time donation of CHF 10.-, 20.- or 30.- per month , you can make a big difference. If you are interested, please call us at 024 434 21 24 or you can donate online at: www.compassion.ch/spenden\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set boy = children.gender == 'M'\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    ${'Avete' if plural else 'Hai'} scelto di sostenere ${firstname} per aiutarl${'o' if partner.gender == 'M' else 'a'} a uscire dalla povertà estrema.\n"
"</p>\n"
"<p>\n"
"    <b>\n"
"        Purtroppo, a causa del mancato pagamento, il sostegno non è stato confermato. Per questo motivo, ${'vi' if plural else 'ti'} informiamo che verrà annullato entro una settimana.*\n"
"    </b>\n"
"</p>\n"
"<p>\n"
"    Compassion cercherà un altro sostenitore affinché ${firstname} possa beneficiare del sostegno e delle attività messe in atto per assicurar${'gli' if boy else 'le'} una vita dignitosa e piena di senso.\n"
"</p>\n"
"<p>\n"
"    Se cambias${'te' if plural else 'si'} idea, ${'vi' if plural else 'ti'} preghiamo di contattarci il prima possibile per telefono o via e-mail.\n"
"</p>\n"
"<p>\n"
"    Cari saluti,\n"
"</p>\n"
"\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    *Se ${'avete' if plural else 'hai'} già effettuato la donazione, non ${'dovete' if plural else 'devi'} fare nulla.\n"
"</p>"

