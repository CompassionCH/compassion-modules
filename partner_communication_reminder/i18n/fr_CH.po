#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_reminder_3
msgid ""
"<div>\n"
"                    \n"
"% set sponsorships = object.get_objects()\n"
"   % set partner = sponsorships.partner_id\n"
"                    \n"
"% set children = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation}\n"
"   <br>\n"
"   <br>\n"
"   Previously, you had made a decision to sponsor ${firstname} to release ${children.get('him')} from extreme poverty. However, this commitment has not been confirmed by you with the funds you had pledged.\n"
"   <br>\n"
"   <br>\n"
"   Therefore, we must inform you that we have canceled the sponsorship today.\n"
"   <br>\n"
"   <br>\n"
"   We will look for a new sponsor for ${firstname} so that ${children.get('he')} can be supported and to enable ${children.get('him')} to live a life with hope in the future. A personal sponsorship changes the life of a child in extreme poverty in the long-term and is sustainable.\n"
"   <br>\n"
"   <br>\n"
"   ${object.success_sentence or ''} If you decide later on to become a sponsor, we would be happy to hear from you.\n"
"   <br>\n"
"   <br>\n"
"   Did you know that you can help children in poverty by giving them access to drinking water (water filters, toilet installation, hygiene awareness)? With a regular or one-time donation of CHF 10.-, 20.- or 30.- per month , you can make a big difference. If you are interested, please call us at 024 434 21 24 or you can donate online at: www.compassion.ch/spenden\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"  </p>\n"
"  "
msgstr ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set partner = sponsorships.partner_id\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Vous avez choisi de parrainer ${firstname} pour lui permettre d'être libéré${children.get('accord_e') or ''} de l'extrême pauvreté.\n"
"</p>\n"
"<p>\n"
"    Cet engagement n'a pas été confirmé par le paiement du soutien promis.\n"
"</p>\n"
"<p>\n"
"    C'est pourquoi nous vous informons que ce parrainage est aujourd'hui annulé.*\n"
"</p>\n"
"<p>\n"
"    Compassion va chercher un autre parrain pour que ${firstname} puisse bénéficier du soutien et des activités mis en place pour lui assurer une vie digne et qui ait du sens.\n"
"</p>\n"
"<p>\n"
"    Vous voyez la chose autrement ? Si tel est le cas, merci de prendre rapidement contact avec nous par retour de mail ou par téléphone.\n"
"</p>\n"
"<p>\n"
"    Avec nos cordiales salutations.\n"
"</p>\n"
"<p>\n"
"    *Si vous venez d'effectuer ce règlement, vous n'avez rien à entreprendre.\n"
"</p>"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_reminder_2
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorships = object.get_objects()\n"
"    % set one_child = len(sponsorships) == 1\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set less_4 = firstname != children.get_number()\n"
"    % set invoices = sponsorships.mapped('due_invoice_ids')\n"
"    % set amount = sum(invoices.mapped('amount_total'))\n"
"    % set number = max(sponsorships.mapped('months_due'))\n"
"    % set month = invoices.get_date('invoice_date', 'MMMM')\n"
"    % set letter = object.send_mode == 'physical'\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you so much for your precious commitment towards ${firstname if less_4 else \"many children\"}.\n"
"</p>\n"
"<p>\n"
"    It has come to our awareness that, despite our last message, your sponsorship contributions for ${month} have not been transferred, which amounts to a total of CHF $\"{:.0f}\".format(amount).-. Thank you in advance for taking care of this within the next 10 days using the attached payment slip.*\n"
"</p>\n"
"<p>\n"
"    % if one_child:\n"
"        Otherwise, we will be left with no other choice than to end the sponsorship for ${firstname} and find ${'him' if children.gender == 'M' else 'her'} a new sponsor.\n"
"    % else:\n"
"        Otherwise, we will be left with no other choice than to end the sponsorships and find a new sponsor for the children.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Please do not hesitate to contact us if you have any questions. We can find a solution together if you are currently experiencing difficulties to finance the sponsorship.\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    *No need to take further action should this message have Please ignore this letter if it has crossed with your donation.\n"
"</p>"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set invoices = sponsorships.mapped('due_invoice_ids')\n"
"    % set amount = sum(invoices.mapped('amount_total'))\n"
"    % set number = max(sponsorships.mapped('months_due'))\n"
"    % set month = invoices.get_date('invoice_date', 'MMMM')\n"
"    % set letter = object.send_mode == 'physical'\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Nous vous remercions chaleureusement de votre engagement au profit de ${firstname}.\n"
"</p>\n"
"<p>\n"
"    <u>En dépit de notre précédente prise de contact, ${\"votre parrainage n'a pas été réglé\" if len(sponsorships) == 1 else \"vos parrainages n'ont pas été réglés\"} à ${\"{:.0f}\".format(number)} reprises en ${month}, ce qui représente un montant manquant de CHF ${\"{:.0f}\".format(amount)}.-.</u>\n"
"</p>\n"
"<p>\n"
"    Merci d'utiliser le bulletin de versement ci-joint pour envoyer votre don dans les 10 jours.* A défaut, nous devrons annuler ${'votre parrainage et chercher un nouveau parrain' if len(children) == 1 else 'vos parrainages et chercher de nouveaux parrains'} pour ${firstname}.\n"
"</p>\n"
"<p>\n"
"    % if lsv_dd:\n"
"        A l'avenir, nous vous proposons de changer de mode de paiement et d’utiliser la référence du bulletin de versement ci-joint pour établir un ordre permanent destiné au parrainage. Vous pouvez aussi nous communiquer un autre numéro de compte en remplissant , le formulaire d’autorisation <a href=\"https://compassion.ch/wp-content/uploads/documents_compassion/Formulaire_LSV_DD_FR.pdf\">(téléchargez-le ici)</a> et en nous le retournant par courrier postal.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    N’hésitez pas à prendre contact avec nous si vous avez des questions ou si vous n’êtes actuellement pas en mesure d’effectuer le paiement. Ensemble, nous sommes prêts à trouver une solution pour garantir un soutien continu à ${children.get('your sponsored child')}.\n"
"</p>\n"
"<p>\n"
"    Avec nos meilleures salutations.\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    *Si votre paiement s’est croisé avec ce courrier, vous n'avez rien à entreprendre.\n"
"</p>"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_activation_reminder_2
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set amount = sum(sponsorships.mapped('total_amount')) * min(sponsorships.mapped('group_id.advance_billing_months'))\n"
"    % set extension = children[0].hold_id.no_money_extension_duration\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set lsv_form_received = partner.bank_ids\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"    <br>\n"
"    <br>\n"
"    We very warmly thank you for choosing to sponsor ${firstname} and to be on our side to free one more child from extreme poverty.\n"
"    <br>\n"
"    <br>\n"
"    In spite of our previous reminder, we notice that\n"
"\n"
"    % if lsv_dd and not lsv_form_received:\n"
"        we still haven't received the direct debit authorization form. This means that your sponsorship could not be activated. <b>Please return the completed document to us within 15 days.</b>\n"
"        Otherwise, we will have to cancel your sponsorship and look for a new sponsor for ${firstname}. If you wish to use a standing order for the payment of your sponsorship, please contact us.\n"
"    % else:\n"
"        we notice that your first payment is still missing. Your sponsorship is thus not activated. <b>We kindly ask you to transfer the amount of CHF ${\"{:.0f}\".format(amount)}.- within ${extension} days using the payment slip attached.</b>\n"
"        Otherwise, we will have to cancel your sponsorship and look for a new sponsor for ${firstname}. Please do not hesitate to contact us if you are not able to make the payment at the moment. We will find a solution together to guarantee ${firstname} support. If your payment has crossed with this letter, please disregard this letter.\n"
"    % endif\n"
"    <br>\n"
"    <br>\n"
"    Thanks to you and the commitment of the many sponsors, ${number_children} million children are currently being supported and freed from extreme poverty.\n"
"    <br>\n"
"    <br>\n"
"    With our warmest greetings.\n"
"</p>"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set single_sponsorship = len(sponsorships) == 1\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set amount = sum(sponsorships.mapped('total_amount')) * min(sponsorships.mapped('group_id.advance_billing_months'))\n"
"    % set extension = children[0].hold_id.no_money_extension_duration\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set lsv_form_received = partner.bank_ids\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"% if sub:\n"
"    <p>\n"
"        Il y a quelques temps, nous vous avons informé${partner.get('accord_e') or ''} de la fin du parrainage de ${sub.get_list('preferred_name')}. Nous vous avons proposé de reprendre un parrainage pour ${firstname}.\n"
"    </p>\n"
"    <p>\n"
"        % if amount:\n"
"            Depuis, nous avons reçu un don de CHF. ${amount} de votre part, que nous n'avons pas pu attribuer au parrainage de ${sub.get_list('preferred_name')}. Comme nous n'avons pas reçu de retour de votre part, nous avons attribué ce montant à notre fonds pour les enfants en attente de parrainage.\n"
"        % else:\n"
"            Nous allons chercher ${'un nouveau parrain' if partner.gender == 'M' else 'une nouvelle marraine'} pour ${firstname}, afin d'assurer son soutien.\n"
"        % endif\n"
"    </p>\n"
"    <p>\n"
"        Un grand merci pour votre engagement à nos côtés pour libérer des enfants de l'extrême pauvreté. Nous serions heureux de pouvoir à nouveau collaborer avec vous à l'avenir.\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        Nous vous remercions d'avoir choisi de parrainer ${firstname} et de vous engager ainsi à nos côtés pour\n"
"        ${\"libérer un enfant de plus de l'extrême pauvreté.\" if single_sponsorship else \"les libérer de\n"
"        l'extrême pauvreté.\"}\n"
"    </p>\n"
"    <p>\n"
"        Malheureusement, le parrainage n'a pas pu démarrer, car nous n'avons pas encore reçu de soutien financier de votre part. ${firstname} ${children.get('is')} informé${children.get('accord_e')} du parrainage dès la réception du premier don.*\n"
"    </p>\n"
"    <p>\n"
"        % if lsv_dd:\n"
"            % if not lsv_form_received:\n"
"                Nous n'avons pas reçu le formulaire d'autorisation de prélèvement bancaire. Merci de nous renvoyer le document signé par courrier postal dans les 15 prochains jours.\n"
"            % else:\n"
"                Le montant du parrainage n'a malheureusement pas pu être débité. Nous vous proposons  d'utiliser le bulletin de versement ci-joint pour effectuer votre versement et établir un ordre permanent pour votre parrainage.\n"
"            % endif\n"
"        % else:\n"
"            D'avance merci de régler le premier don de CHF ${\"{:.0f}\".format(amount)}.- dans les 15 jours à l'aide du bulletin ci-joint.\n"
"        % endif\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    N'hésitez pas à prendre contact avec nous si vous avez une question.\n"
"</p>\n"
"<p>\n"
"    Avec nos chaleureuses salutations.\n"
"</p>\n"
"   % if object.send_mode != 'physical':\n"
"        <p>\n"
"            ${object.sudo().user_id.signature | safe}\n"
"        </p>\n"
"    % endif\n"
"<p>\n"
"    *Si vous venez d'effectuer ce règlement, vous n'avez rien à entreprendre.\n"
"</p>"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_reminder_1
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set wp = \"SWP\" in sponsorships.mapped(\"type\")\n"
"    % set partner = object.partner_id\n"
"    % set child = sponsorships.mapped(\"child_id\")\n"
"    % set firstname = child.get_list('preferred_name', translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set payment_type_attachement = sponsorships.get_payment_type_attachment_string()\n"
"    % set country = child.mapped('field_office_id')\n"
"    % set invoices = sponsorships.mapped('due_invoice_ids')\n"
"    % set amount = sum(invoices.mapped('amount_total'))\n"
"    % set number = max(sponsorships.mapped('months_due'))\n"
"    % set month = invoices.get_date('invoice_date', 'MMMM')\n"
"    % if firstname.endswith('s'):\n"
"        % set apostrophe = \"'\"\n"
"    % else:\n"
"        % set apostrophe = \"'s\"\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you for investing in the life of ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Your sponsorship is one of the best ways of releasing children from poverty in the long term, so that they can enjoy a life of dignity and meaning.\n"
"</p>\n"
"<p>\n"
"    <b>\n"
"        However, we have not received the ${number} monthly donations for ${month}, totalling CHF ${amount}.\n"
"    </b>\n"
"</p>\n"
"<p>\n"
"    Please find enclosed a payment slip to enable you to set up a new standing order*.\n"
"</p>\n"
"<p>\n"
"    % if wp:\n"
"        If you are unable to make this donation regularly or if you wish to adjust the amount, please contact us. Compassion will find another donor for the rest.\n"
"    % else:\n"
"        Please don't hesitate to contact us if you have any questions, or if, in these times of crisis in Switzerland, you find yourself in a temporarily more difficult financial situation. Together, we'll find a solution to guarantee ${firstname}${apostrophe} continued support.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Best regards\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
" % endif\n"
"<p>\n"
"    *Please ignore this letter if it has crossed with your donation.\n"
"</p>"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set wp = \"SWP\" in sponsorships.mapped(\"type\")\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set invoices = sponsorships.mapped('due_invoice_ids')\n"
"    % set amount = sum(invoices.mapped('amount_total'))\n"
"    % set number = max(sponsorships.mapped('months_due'))\n"
"    % set month = invoices.get_date('invoice_date', 'MMMM')\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Merci d'investir dans la vie de ${firstname}. Votre parrainage est un des meilleurs moyens de ${'le' if children.gender == 'M' else 'la'} libérer durablement de la pauvreté pour une vie digne et qui ait du sens.\n"
"</p>\n"
"\n"
"% if lsv_dd:\n"
"    <p>\n"
"        <b><u>\n"
"            Or, le prélèvement sur votre compte n’a pas pu être effectué à ${\"{:.0f}\".format(number)} reprises depuis ${month}, pour un montant en retard de CHF ${\"{:.0f}\".format(amount)}.-.\n"
"        </u></b>\n"
"    </p>\n"
"    <p>\n"
"        Nous vous proposons donc de modifier le mode de paiement et de mettre en place un ordre permanent à l'aide du bulletin de versement ci-joint.\n"
"    </p>\n"
"    <p>\n"
"        Vous pouvez aussi nous communiquer un nouveau compte en remplissant le formulaire LSV à <a href=\"https://compassion.ch/wp-content/uploads/documents_compassion/Formulaire_LSV_DD_FR.pdf\">télécharger ici</a> et en nous le renvoyant par courrier postal.\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        <u>Or, nous n'avons pas reçu les ${\"{:.0f}\".format(number)} soutiens mensuels de ${month}, pour un montant total de CHF ${\"{:.0f}\".format(amount)}.-.</u>\n"
"    </p>\n"
"    <p>\n"
"        Vous trouverez ci-joint un bulletin de versement pour vous permettre de mettre en place un nouvel ordre permanent.*\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    % if wp:\n"
"        Si vous ne parvenez pas à verser ce don régulièrement ou si vous désirez adapter le montant, merci de prendre contact avec nous. Compassion trouvera un autre donateur pour cette partie du financement.\n"
"    % else:\n"
"        N'hésitez pas à prendre contact avec nous si vous avez des questions ou si vous faites face à une situation financière momentanément plus difficile. Ensemble, nous sommes prêts à trouver une solution pour garantir à ${children.get('your sponsored child')} un soutien continu.\n"
"    % endif\n"
"<p>\n"
"    Avec nos meilleures salutations.\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_activation_reminder_1
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"    \n"
"% set sponsorships = object.get_objects()\n"
"    \n"
"% set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"% set frequency = sponsorships.mapped('group_freq')[0]\n"
"    \n"
"% set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    \n"
"% set lsv_form_received = partner.bank_ids\n"
"    \n"
"% set children = sponsorships.mapped('child_id')\n"
"    \n"
"% set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    \n"
"% set amount = sum(sponsorships.mapped('total_amount')) * min(sponsorships.mapped('group_id.advance_billing_months'))\n"
"    \n"
"% set extension = children[0].hold_id.no_money_extension_duration\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   We thank you for taking over the sponsorship for ${firstname}. The next step: Once your first donation payment (monthly, quarterly or yearly) has arrived, your sponsorship can officially begin. At this point, your sponsored child will also be notified that you are the sponsor.\n"
"   <br>\n"
"   <br>\n"
"   <!-- Keep space     -->\n"
"   % if lsv_dd:\n"
"\t\n"
"% if not lsv_form_received:\n"
"   <b>\n"
"    We are still waiting for the banking authorization form. Please fill it and send it back to us as soon as possible\n"
"   </b>\n"
"   so we can begin your sponsorship. Thank you for your prompt collaboration.\n"
"    \n"
"\t% else:\n"
"\tThe withdrawal from your account couldn't be executed. We therefore propose you to change your payment mode and settle a standing order with the reference that you can find on the attached payment slip.\n"
"% endif \n"
"\n"
"\t% else:\n"
"\tIf you have already made this transfer prior to receiving this letter, we thank you that you have taken care of this quickly and require no further action on your part. Your sponsored child is currently linked only to you and cannot be supported by another person. You have chosen to pay the sponsorship contributions ${frequency.lower()} which amounts to CHF ${'%d' | format(amount)}.- If you would like another arrangement, please contact us by phone at 031 552 21 25 or send an email to: rmaglo@compassion.ch. Please do not hesitate to contact us if you are currently experiencing difficulty in financing your sponsorship. Together, we will find a solution to support ${firstname}.\n"
"% endif\n"
"   <br>\n"
"   <br>\n"
"   We thank you for choosing to sponsor ${firstname}.  A personal sponsorship changes the life of a child in extreme poverty-- long-term and sustainable.  We wish you much joy with your sponsorship of ${firstname}.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set one_child = len(sponsorships) == 1\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set frequency = sponsorships.mapped('group_freq')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set lsv_form_received = partner.bank_ids\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set boy = children.gender == 'M'\n"
"    % set amount = sum(sponsorships.mapped('total_amount')) * min(sponsorships.mapped('group_id.advance_billing_months'))\n"
"    % set extension = children[0].hold_id.no_money_extension_duration\n"
"    % set sub = sponsorships.mapped('parent_id')\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"</p>\n"
"<p>\n"
"    Merci d'avoir décidé de parrainer ${firstname}.\n"
"</p>\n"
"\n"
"% if sub:\n"
"    <p>\n"
"        Nous vous avons récemment informé${partner.get('accord_e') or ''} de la fin du parrainage de ${sub.get_list('preferred_name')} et vous avions proposé de parrainer ${firstname}, pour poursuivre votre engagement contre l'extrême pauvreté.\n"
"    </p>\n"
"    % if amount:\n"
"        <p>\n"
"            Depuis, nous avons reçu un don de CHF ${amount|replace('.0','.-')} de votre part, qui  ne peut plus être attribué au parrainage de ${sub.get_list('preferred_name')}. Désirez-vous démarrer le parrainage de ${firstname} ou désirez-vous un remboursement ? Le dossier de ${firstname} est actuellement réservé${'' if boy else 'e'} pour vous et ${firstname} ne peut pas être soutenu${'' if boy else 'e'} par une autre personne. Nous vous serions donc reconnaissants de nous donner un retour rapidement, si nécessaire avec vos coordonnées bancaires.\n"
"        </p>\n"
"    % else:\n"
"        <p>\n"
"            Seriez-vous prêt${partner.get('accord_e') or ''} à parrainer ${firstname} ? Le dossier de ${firstname} est actuellement réservé${'' if boy else 'e'} pour vous et ${firstname} ne peut pas être soutenu${'' if boy else 'e'} par une autre personne. Nous vous serions donc reconnaissants de nous donner un retour rapidement.\n"
"        </p>\n"
"    % endif\n"
"% else:\n"
"    <p>\n"
"        La prochaine étape: Une fois votre don reçu, votre parrainage démarrera officiellement. ${firstname} sera averti${children.get('accord_e') or ''} à ce moment-là qu'${'il' if children.gender == 'M' else 'elle'} a désormais ${'un parrain' if partner.gender == 'M' else 'une marraine'}.\n"
"    </p>\n"
"    <p>\n"
"        Actuellement, ${firstname} vous ${'a' if one_child else 'ont'} été attribué${children.get('accord_e') or ''} et ${'il' if children.gender == 'M' else 'elle'} ne peut pas être soutenu${children.get('accord_e') or ''} par une autre personne.\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    % if lsv_dd:\n"
"        % if not lsv_form_received:\n"
"            Nous sommes encore dans l'attente du formulaire d'autorisation de prélèvement bancaire. Merci de bien vouloir le remplir et nous le faire parvenir au plus vite par courrier postal afin de pouvoir démarrer le parrainage.\n"
"        % else:\n"
"            Le prélèvement sur votre compte n’a pas pu être effectué. C’est pourquoi nous vous proposons de changer de mode de paiement et d’utiliser la référence sur le bulletin de versement ci-joint afin d’établir un «ordre permanent» destiné au parrainage mensuel.\n"
"        % endif\n"
"    % else:\n"
"        Merci d'utiliser le code QR ci-dessous si vous choisissez de parrainer ${firstname}.\n"
"    % endif\n"
"</p>\n"
"% if not sub:\n"
"    <p>\n"
"        La prochaine étape: Une fois votre don reçu, votre parrainage démarrera officiellement. ${firstname} sera ${'averti' if boy else 'avertie'} à ce moment-là ${\"qu'il\" if boy else \"qu'elle\"} a désormais ${'un parrain' if partner.gender == 'M' else 'une marraine'}.\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Ensemble, changeons le monde. Un enfant à la fois.\n"
"</p>\n"
"% if object.send_mode != 'physical':\n"
"    <p>\n"
"        ${object.sudo().user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_activation_reminder_3
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"                    \n"
"% set sponsorships = object.get_objects()\n"
"                    \n"
"% set children = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation}\n"
"   <br>\n"
"   <br>\n"
"   Previously, you had made a decision to sponsor ${firstname} to release ${children.get('him')} from extreme poverty. However, this commitment has not been confirmed by you with the funds you had pledged.\n"
"   <br>\n"
"   <br>\n"
"   Therefore, we must inform you that we have canceled the sponsorship today.\n"
"   <br>\n"
"   <br>\n"
"   We will look for a new sponsor for ${firstname} so that ${children.get('he')} can be supported and to enable ${children.get('him')} to live a life with hope in the future. A personal sponsorship changes the life of a child in extreme poverty in the long-term and is sustainable.\n"
"   <br>\n"
"   <br>\n"
"   ${object.success_sentence or ''} If you decide later on to become a sponsor, we would be happy to hear from you.\n"
"   <br>\n"
"   <br>\n"
"   Did you know that you can help children in poverty by giving them access to drinking water (water filters, toilet installation, hygiene awareness)? With a regular or one-time donation of CHF 10.-, 20.- or 30.- per month , you can make a big difference. If you are interested, please call us at 024 434 21 24 or you can donate online at: www.compassion.ch/spenden\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"</div>\n"
"<p>${partner.salutation},</p>\n"
"<p>\n"
"    Vous avez choisi de parrainer ${firstname} pour lui permettre d'être libéré${children.get('accord_e') or ''} de l'extrême pauvreté.\n"
"</p>\n"
"<p>\n"
"    <b>\n"
"        Cet engagement n'a pas été confirmé par le paiement du soutien promis. C'est pourquoi nous vous informons que ce parrainage sera annulé d'ici une semaine au plus tard.*\n"
"    </b>\n"
"</p>\n"
"<p>\n"
"    Compassion va chercher un autre parrain pour que ${firstname} puisse bénéficier du soutien et des activités mis en place pour lui assurer une vie digne et qui ait du sens.\n"
"</p>\n"
"<p>\n"
"    Vous voyez la chose autrement ? Si tel est le cas, merci de prendre rapidement contact avec nous par retour de mail ou par téléphone.\n"
"</p>\n"
"<p>\n"
"    Avec nos cordiales salutations.\n"
"</p>\n"
"   % if object.send_mode != 'physical':\n"
"        <p>\n"
"            ${object.sudo().user_id.signature | safe}\n"
"        </p>\n"
"    % endif\n"
"\n"
"<p>*Si vous venez d'effectuer ce don, vous n'avez rien à entreprendre.</p>"

