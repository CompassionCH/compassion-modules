#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_reminder_3
msgid ""
"<div>\n"
"                    \n"
"% set sponsorships = object.get_objects()\n"
"   % set partner = sponsorships.partner_id\n"
"                    \n"
"% set children = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation}\n"
"   <br>\n"
"   <br>\n"
"   Previously, you had made a decision to sponsor ${firstname} to release ${children.get('him')} from extreme poverty. However, this commitment has not been confirmed by you with the funds you had pledged.\n"
"   <br>\n"
"   <br>\n"
"   Therefore, we must inform you that we have canceled the sponsorship today.\n"
"   <br>\n"
"   <br>\n"
"   We will look for a new sponsor for ${firstname} so that ${children.get('he')} can be supported and to enable ${children.get('him')} to live a life with hope in the future. A personal sponsorship changes the life of a child in extreme poverty in the long-term and is sustainable.\n"
"   <br>\n"
"   <br>\n"
"   ${object.success_sentence or ''} If you decide later on to become a sponsor, we would be happy to hear from you.\n"
"   <br>\n"
"   <br>\n"
"   Did you know that you can help children in poverty by giving them access to drinking water (water filters, toilet installation, hygiene awareness)? With a regular or one-time donation of CHF 10.-, 20.- or 30.- per month , you can make a big difference. If you are interested, please call us at 024 434 21 24 or you can donate online at: www.compassion.ch/spenden\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"  </p>\n"
"  "
msgstr ""
"<div>\n"
"% set sponsorships = object.get_objects()\n"
"   % set partner = sponsorships.partner_id\n"
"\n"
"% set plural = partner.title.plural or partner.title.id == 29\n"
"\n"
"% set du = 'ihr' if plural else 'du'\n"
"\n"
"% set dein = 'euer' if plural else 'dein'\n"
"% set deine = 'eure' if plural else 'deine'\n"
"\n"
"                    \n"
"% set children = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
" % set less_4 = firstname != children.get_number()\n"
"  </div>\n"
"  <p><br/>\n"
"   ${partner.salutation}\n"
"<br/>\n"
"</p>\n"
"  <p>\n"
"   ${'Ihr habt euch' if plural else 'Du hast dich'} entschieden, die ${children.get('Patenschaft')} für ${firstname if less_4 else deine + \" Patenkinder\"} zu übernehmen um ${children.get('ihn')} aus extremer Armut zu befreien.\n"
"  </p>\n"
"  <p>\n"
"   Da wir die versprochene Spende leider nicht erhalten haben, werden wir die ${children.get('Patenschaft')} heute annullieren müssen.*\n"
"  </p>\n"
"  <p>\n"
"   Wir werden für ${firstname if less_4 else \"die Patenkinder\"} einen anderen Paten suchen, damit ${children.get('he')} unterstützt ${children.get('will be')} und ${children.get('ihm')} ein Leben mit Hoffnung und Zukunft ermöglicht werden kann.\n"
"  </p>\n"
"  <p>\n"
"   ${'Habt ihr es euch' if plural else 'Hast du es dir'} anders überlegt? Dann ${'gebt' if plural else 'gib'} uns schnellstmöglich Bescheid. Die Freude ${\"von \" + firstname if less_4 else \"der Kinder\"} wird riesig sein!\n"
"  </p>\n"
"  <p>\n"
"   Liebe Grüsse\n"
"  </p>\n"
"  <p>\n"
"   *Falls sich diese Nachricht mit ${deine}r Spende gekreuzt hat, ${'müsst ihr' if plural else 'musst du'} nichts mehr tun.\n"
"  </p>\n"
" "

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_reminder_2
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set sponsorships = object.get_objects()\n"
"    % set one_child = len(sponsorships) == 1\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set less_4 = firstname != children.get_number()\n"
"    % set invoices = sponsorships.mapped('due_invoice_ids')\n"
"    % set amount = sum(invoices.mapped('amount_total'))\n"
"    % set number = max(sponsorships.mapped('months_due'))\n"
"    % set month = invoices.get_date('invoice_date', 'MMMM')\n"
"    % set letter = object.send_mode == 'physical'\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you so much for your precious commitment towards ${firstname if less_4 else \"many children\"}.\n"
"</p>\n"
"<p>\n"
"    It has come to our awareness that, despite our last message, your sponsorship contributions for ${month} have not been transferred, which amounts to a total of CHF $\"{:.0f}\".format(amount).-. Thank you in advance for taking care of this within the next 10 days using the attached payment slip.*\n"
"</p>\n"
"<p>\n"
"    % if one_child:\n"
"        Otherwise, we will be left with no other choice than to end the sponsorship for ${firstname} and find ${'him' if children.gender == 'M' else 'her'} a new sponsor.\n"
"    % else:\n"
"        Otherwise, we will be left with no other choice than to end the sponsorships and find a new sponsor for the children.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Please do not hesitate to contact us if you have any questions. We can find a solution together if you are currently experiencing difficulties to finance the sponsorship.\n"
"</p>\n"
"<p>\n"
"    Kind regards,\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    *No need to take further action should this message have Please ignore this letter if it has crossed with your donation.\n"
"</p>"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set less_4 = firstname != children.get_number()\n"
"    % set invoices = sponsorships.mapped('due_invoice_ids')\n"
"    % set amount = sum(invoices.mapped('amount_total'))\n"
"    % set number = max(sponsorships.mapped('months_due'))\n"
"    % set month = invoices.get_date('invoice_date', 'MMMM')\n"
"    % set letter = object.send_mode == 'physical'\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Herzlichen Dank für ${deine}n wertvollen Einsatz für ${firstname if less_4 else deine + \" Patenkinder\"}.\n"
"</p>\n"
"<p>\n"
"    Leider ${'habt ihr' if plural else 'hast du'} trotz unserer letzten Nachricht <b>den Patenschaftsbetrag ${'des\n"
"    Monats' if number == 1 else 'der Monate'} ${month} noch nicht überwiesen, welcher CHF $\"{:.0f}\".format(amount).-\n"
"    entspricht.</b> Danke, dass ${du} den Betrag <b>innerhalb der nächsten 10 Tage</b> mit dem beigelegten\n"
"    Einzahlungsschein ${'begleicht' if plural else 'begleichst'}.*\n"
"</p>\n"
"\n"
"% if lsv_dd:\n"
"    <p>\n"
"        Wir schlagen ${dir} daher vor, die Zahlungsart mit dem beigelegten Einzahlungsschein zu ändern und einen\n"
"        Dauerauftrag einzurichten.\n"
"    </p>\n"
"    <p>\n"
"        ${'Ihr könnt' if plural else 'Du kannst'} uns aber auch eine neue Kontonummer angeben, das\n"
"        Ermächtigungsformular <a href=\"https://compassion\n"
"        .ch/wp-content/uploads/documents_compassion/Formulaire_LSV_DD_DE.pdf\">hier herunterladen</a>, es entsprechend\n"
"        ausfüllen und an uns retournieren.\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Ansonsten müssen wir\n"
"    % if len(children) == 1:\n"
"        die Patenschaft mit ${firstname}\n"
"    % else:\n"
"        die Patenschaften\n"
"    % endif\n"
"    beenden und\n"
"    % if plural:\n"
"        neue Paten\n"
"    % else:\n"
"        ${\"einen neuen Paten\" if partner.gender == \"M\" else \"eine neue Patin\"}\n"
"    % endif\n"
"    für ${children.get('ihn') if len(children) == 1 else \"die Kinder\"} suchen.\n"
"</p>\n"
"<p>\n"
"    ${'Zögert' if plural else 'Zögere'} nicht, uns zu kontaktieren, wenn ${du} Fragen ${'habt' if plural else 'hast'}.\n"
"    ${'Solltet ihr' if plural else 'Solltest du'} momentan Schwierigkeiten haben, die ${children.get('Patenschaft')\n"
"    } zu finanzieren, sind wir gerne bereit, gemeinsam eine Lösung zu finden.\n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    *Falls sich diese Nachricht mit ${deine}r Spende gekreuzt hat, ${'müsst ihr' if plural else 'musst du'} nichts\n"
"    mehr tun.\n"
"</p>"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_activation_reminder_2
msgid ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set amount = sum(sponsorships.mapped('total_amount')) * min(sponsorships.mapped('group_id.advance_billing_months'))\n"
"    % set extension = children[0].hold_id.no_money_extension_duration\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set lsv_form_received = partner.bank_ids\n"
"    % set number_children = object.env[\"partner.communication.job\"].get_snippet('number_children') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation},\n"
"    <br>\n"
"    <br>\n"
"    We very warmly thank you for choosing to sponsor ${firstname} and to be on our side to free one more child from extreme poverty.\n"
"    <br>\n"
"    <br>\n"
"    In spite of our previous reminder, we notice that\n"
"\n"
"    % if lsv_dd and not lsv_form_received:\n"
"        we still haven't received the direct debit authorization form. This means that your sponsorship could not be activated. <b>Please return the completed document to us within 15 days.</b>\n"
"        Otherwise, we will have to cancel your sponsorship and look for a new sponsor for ${firstname}. If you wish to use a standing order for the payment of your sponsorship, please contact us.\n"
"    % else:\n"
"        we notice that your first payment is still missing. Your sponsorship is thus not activated. <b>We kindly ask you to transfer the amount of CHF ${\"{:.0f}\".format(amount)}.- within ${extension} days using the payment slip attached.</b>\n"
"        Otherwise, we will have to cancel your sponsorship and look for a new sponsor for ${firstname}. Please do not hesitate to contact us if you are not able to make the payment at the moment. We will find a solution together to guarantee ${firstname} support. If your payment has crossed with this letter, please disregard this letter.\n"
"    % endif\n"
"    <br>\n"
"    <br>\n"
"    Thanks to you and the commitment of the many sponsors, ${number_children} million children are currently being supported and freed from extreme poverty.\n"
"    <br>\n"
"    <br>\n"
"    With our warmest greetings.\n"
"</p>"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set less_4 = firstname != children.get_number()\n"
"    % set amount = (sum(sponsorships.mapped('total_amount')) * min(sponsorships.mapped('group_id.advance_billing_months')))|replace('.0','.-')\n"
"<!--    % set extension = children[0].hold_id.no_money_extension_duration -->\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set lsv_form_received = partner.bank_ids\n"
"    % set sub = sponsorships.mapped(\"parent_id\")\n"
"    % set sub_name = sponsorships.filtered(\"parent_id\").mapped(\"child_id\").get_list(\"preferred_name\")\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"% if sub:\n"
"    <p>\n"
"        Vor einiger Zeit hatten wir ${dich} über das Ende der Patenschaft für ${sub.get_list('preferred_name')} informiert und ${dir} vorgeschlagen, eine neue Patenschaft für ${sub_name} zu übernehmen.\n"
"    </p>\n"
"    % if amount:\n"
"        <p>\n"
"            Seither haben wir von ${dir} Spenden von CHF ${amount} erhalten, die wir nicht mehr der Patenschaft von ${sub.get_list('preferred_name')} zuweisen konnten. ${'Möchtet ihr' if plural else 'Möchtest du'} damit die Patenschaft für ${firstname} starten oder ${'wünscht ihr' if plural else 'wünschst du'} eine Rückerstattung der Spenden?\n"
"        </p>\n"
"        <p>\n"
"            Da wir von ${dir} leider keine Rückmeldung erhalten haben, werden wir die Spenden unserem Fonds für Kinder, die auf eine Patenschaft warten, zukommen lassen.\n"
"        </p>\n"
"    % else:\n"
"        <p>\n"
"            Für ${firstname} werden wir eine neue Patin/einen neuen Paten suchen, um ${'seine' if children.gender == 'M' else 'ihre'} Unterstützung sicherstellen zu können.\n"
"        </p>\n"
"    % endif\n"
"    <p>\n"
"        Herzlichen Dank, dass ${du} ${dich} mit uns zusammen an die Seite von Kindern in extremer Armut gestellt ${'habt' if plural else 'hast'}. Wir würden uns sehr freuen, in Zukunft wieder einmal gemeinsam unterwegs zu sein.\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        Danke, dass ${du} ${dich} entschieden ${'habt' if plural else 'hast'}, die ${children.get('Patenschaft')} für ${firstname if less_4 else deine + \" Patenkinder\"} zu übernehmen.\n"
"    </p>\n"
"    <p>\n"
"        Leider ${'konnte die Patenschaft' if len(children)==1 else 'konnten die Patenschaften'} nicht starten, da wir noch keine Spende erhalten haben. ${firstname if less_4 else \"Die Kinder\"} ${children.get('will be')} erst über die Patenschaft informiert, wenn ${deine} erste Spende bei uns eingetroffen ist.*\n"
"    </p>\n"
"    <p>\n"
"        % if lsv_dd:\n"
"            % if not lsv_form_received:\n"
"                Wir warten noch auf die Einzugsermächtigung für die Bank. Danke, dass ${du} uns diese ausgefüllt spätestens in 15 Tagen ${'zurückschickt' if plural else 'zurückschickst'}, damit die ${\"Patenschaft beginnen kann\" if len(children) == 1 else \"Patenschaften beginnen können\"}.\n"
"            % else:\n"
"                Leider konnten wir ${dein} Konto aufgrund ungenügender Deckung nicht mit dem Patenschaftsbetrag belasten. Wir schlagen ${dir} daher vor, die Zahlungsart mit dem beigelegten Einzahlungsschein zu ändern und einen Dauerauftrag einzurichten.\n"
"            % endif\n"
"        % else:\n"
"            Danke, dass ${du} die Spende von CHF ${amount} innert 15 Tagen mit dem beigelegten Einzahlungsschein überweist.\n"
"        % endif\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    ${'Zögert' if plural else 'Zögere'} nicht, uns zu kontaktieren, wenn ${du} Fragen ${'habt' if plural else 'hast'}.\n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse\n"
"\n"
"    % if object.send_mode == 'digital':\n"
"        <br>\n"
"        <br>\n"
"        ${object.user_id.signature | safe}\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    *Falls sich diese Nachricht mit ${deine}r Spende gekreuzt hat, ${'musst du' if not plural else 'müsst ihr'} nichts mehr tun.\n"
"</p>"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_reminder_1
msgid ""
"<div>\n"
"    % set sponsorships = object.get_objects()\n"
"    % set wp = \"SWP\" in sponsorships.mapped(\"type\")\n"
"    % set partner = object.partner_id\n"
"    % set child = sponsorships.mapped(\"child_id\")\n"
"    % set firstname = child.get_list('preferred_name', translate=False)\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set payment_type_attachement = sponsorships.get_payment_type_attachment_string()\n"
"    % set country = child.mapped('field_office_id')\n"
"    % set invoices = sponsorships.mapped('due_invoice_ids')\n"
"    % set amount = sum(invoices.mapped('amount_total'))\n"
"    % set number = max(sponsorships.mapped('months_due'))\n"
"    % set month = invoices.get_date('invoice_date', 'MMMM')\n"
"    % if firstname.endswith('s'):\n"
"        % set apostrophe = \"'\"\n"
"    % else:\n"
"        % set apostrophe = \"'s\"\n"
"    % endif\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Thank you for investing in the life of ${firstname}.\n"
"</p>\n"
"<p>\n"
"    Your sponsorship is one of the best ways of releasing children from poverty in the long term, so that they can enjoy a life of dignity and meaning.\n"
"</p>\n"
"<p>\n"
"    <b>\n"
"        However, we have not received the ${number} monthly donations for ${month}, totalling CHF ${amount}.\n"
"    </b>\n"
"</p>\n"
"<p>\n"
"    Please find enclosed a payment slip to enable you to set up a new standing order*.\n"
"</p>\n"
"<p>\n"
"    % if wp:\n"
"        If you are unable to make this donation regularly or if you wish to adjust the amount, please contact us. Compassion will find another donor for the rest.\n"
"    % else:\n"
"        Please don't hesitate to contact us if you have any questions, or if, in these times of crisis in Switzerland, you find yourself in a temporarily more difficult financial situation. Together, we'll find a solution to guarantee ${firstname}${apostrophe} continued support.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Best regards\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
" % endif\n"
"<p>\n"
"    *Please ignore this letter if it has crossed with your donation.\n"
"</p>"
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set sponsorships = object.get_objects()\n"
"    % set wp = \"SWP\" in sponsorships.mapped(\"type\")\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set less_4 = firstname != children.get_number()\n"
"    % set invoices = sponsorships.mapped('due_invoice_ids')\n"
"    % set amount = sum(invoices.mapped('amount_total'))\n"
"    % set number = max(sponsorships.mapped('months_due'))\n"
"    % set month = invoices.get_date('invoice_date', 'MMMM')\n"
"</div>\n"
"<p>\n"
"    ${partner.informal_salutation}\n"
"</p>\n"
"<p>\n"
"    ${'Habt ihr' if plural else 'Hast du'} gewusst, dass ${deine} ${children.get('Patenschaft')} eines der besten Mittel ${\"ist\" if len(children) == 1 else \"sind\"}, um dazu beizutragen ${firstname if less_4 else deine + \" Patenkinder\"} langfristig aus extremer Armut zu befreien und ${children.get('ihm')} ein Leben mit Hoffnung und Zukunft zu ermöglichen?\n"
"</p>\n"
"\n"
"% if lsv_dd:\n"
"    <p>\n"
"        <b>\n"
"            ${dein.title()} Konto konnte leider ${'in den Monaten' if number > 1 else 'im Monat'} ${month} nicht mit dem Patenschaftsbetrag belastet werden, was einem Gesamtbetrag von CHF ${\"{:.0f}\".format(amount)} entspricht.\n"
"        </b>\n"
"    </p>\n"
"    <p>\n"
"        Wir schlagen ${dir} daher vor, die Zahlungsart mit dem beigelegten Einzahlungsschein zu ändern und einen Dauerauftrag einzurichten.\n"
"    </p>\n"
"    <p>\n"
"        ${'Ihr könnt' if plural else 'Du kannst'} uns aber auch eine neue Kontonummer angeben, das Ermächtigungsformular <a href=\"https://compassion.ch/wp-content/uploads/documents_compassion/Formulaire_LSV_DD_DE.pdf\">hier herunterladen</a>, es entsprechend ausfüllen und an uns retournieren.\n"
"    </p>\n"
"% else:\n"
"    <p>\n"
"        <b>\n"
"            Wir haben ${deine}${'n Patenschaftsbetrag' if number == 1 else ' Patenschaftsbeträge'} von ${number} ${'Monat' if number == 1 else 'Monaten'} (${month}) leider nicht erhalten, was einem Gesamtbetrag von CHF ${\"{:.0f}\".format(amount)}.- entspricht.\n"
"        </b>\n"
"    </p>\n"
"    <p>\n"
"        Im Anhang ${'findet ihr' if plural else 'findest du'} einen Einzahlungsschein, um den Betrag zu überweisen und einen neuen Dauerauftrag einzurichten.*\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    % if wp:\n"
"        Wenn ${du} diese Spende nicht regelmässig leisten kannst oder den Betrag anpassen möchtest, kannst ${du} ${dich} gerne bei uns melden. Compassion wird einen anderen Spender für diesen Teil der Patenschaft(en) finden.\n"
"    % else:\n"
"        ${'Zögert' if plural else 'Zögere'} nicht, uns zu kontaktieren, wenn ${du} Fragen ${'habt' if plural else 'hast'}. ${'Solltet ihr' if plural else 'Solltest du'} momentan Schwierigkeiten haben, die ${children.get(\"Patenschaft\")} zu finanzieren, sind wir gerne bereit, gemeinsam eine Lösung zu finden.\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Herzlichen Dank für ${deine}n wertvollen Einsatz!\n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse\n"
"</p>\n"
"% if object.send_mode == \"digital\":\n"
"    <p>\n"
"        ${object.user_id.signature | safe}\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    *Falls sich diese Nachricht mit ${deine}r Spende gekreuzt hat, ${'müsst ihr' if plural else 'musst du'} nichts mehr tun.\n"
"</p>\n"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_activation_reminder_1
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"    \n"
"% set sponsorships = object.get_objects()\n"
"    \n"
"% set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"% set frequency = sponsorships.mapped('group_freq')[0]\n"
"    \n"
"% set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    \n"
"% set lsv_form_received = partner.bank_ids\n"
"    \n"
"% set children = sponsorships.mapped('child_id')\n"
"    \n"
"% set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    \n"
"% set amount = sum(sponsorships.mapped('total_amount')) * min(sponsorships.mapped('group_id.advance_billing_months'))\n"
"    \n"
"% set extension = children[0].hold_id.no_money_extension_duration\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation},\n"
"   <br>\n"
"   <br>\n"
"   We thank you for taking over the sponsorship for ${firstname}. The next step: Once your first donation payment (monthly, quarterly or yearly) has arrived, your sponsorship can officially begin. At this point, your sponsored child will also be notified that you are the sponsor.\n"
"   <br>\n"
"   <br>\n"
"   <!-- Keep space     -->\n"
"   % if lsv_dd:\n"
"\t\n"
"% if not lsv_form_received:\n"
"   <b>\n"
"    We are still waiting for the banking authorization form. Please fill it and send it back to us as soon as possible\n"
"   </b>\n"
"   so we can begin your sponsorship. Thank you for your prompt collaboration.\n"
"    \n"
"\t% else:\n"
"\tThe withdrawal from your account couldn't be executed. We therefore propose you to change your payment mode and settle a standing order with the reference that you can find on the attached payment slip.\n"
"% endif \n"
"\n"
"\t% else:\n"
"\tIf you have already made this transfer prior to receiving this letter, we thank you that you have taken care of this quickly and require no further action on your part. Your sponsored child is currently linked only to you and cannot be supported by another person. You have chosen to pay the sponsorship contributions ${frequency.lower()} which amounts to CHF ${'%d' | format(amount)}.- If you would like another arrangement, please contact us by phone at 031 552 21 25 or send an email to: rmaglo@compassion.ch. Please do not hesitate to contact us if you are currently experiencing difficulty in financing your sponsorship. Together, we will find a solution to support ${firstname}.\n"
"% endif\n"
"   <br>\n"
"   <br>\n"
"   We thank you for choosing to sponsor ${firstname}.  A personal sponsorship changes the life of a child in extreme poverty-- long-term and sustainable.  We wish you much joy with your sponsorship of ${firstname}.\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"  </p>\n"
" "
msgstr ""
"<!--\n"
"% set partner = object.partner_id\n"
"% set plural = partner.title.plural or partner.title.id == 29\n"
"% set sponsorships = object.get_objects()\n"
"% set sub = sponsorships.mapped('parent_id')\n"
"\n"
"${'Eure' if plural else 'Deine'} Unterstützung von\n"
"% if sub:\n"
"    % set sub_name = object.get_objects().mapped('child_id').get_list('preferred_name').split(',')\n"
"    ${sub_name[0]}\n"
"% else:\n"
"    ${object.get_objects().mapped('child_id').get_list('preferred_name', 3, object.get_objects().mapped('child_id').get_number() + 'n', False)}\n"
"% endif\n"
"-->\n"
"\n"
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set deiner = 'eurer' if plural else 'deiner'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set sponsorships = object.get_objects()\n"
"\n"
"    % if len(sponsorships) == 1:\n"
"        % set ist = 'ist'\n"
"        % set kann = 'kann'\n"
"    % else:\n"
"        % set ist = 'sind'\n"
"        % set kann = 'können'\n"
"    % endif\n"
"\n"
"    % set payment_term = sponsorships.mapped('payment_mode_id.name')[0]\n"
"    % set lsv_dd = 'LSV' in payment_term or 'Postfinance' in payment_term\n"
"    % set lsv_form_received = partner.bank_ids\n"
"    % set frequency = sponsorships.mapped('group_freq')[0]\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set less_4 = firstname != children.get_number()\n"
"    % set amount = sum(sponsorships.mapped('total_amount')) * min(sponsorships.mapped('group_id.advance_billing_months'))\n"
"<!--open: ${sponsorships.open_invoice_ids}<br> -->\n"
"    % set extension = children[0].hold_id.no_money_extension_duration\n"
"    % set sub = sponsorships.mapped('parent_id')\n"
"    % set sub_name = children.get_list('preferred_name').split(',')\n"
"\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"\n"
"% if sub:\n"
"    <p>\n"
"        Vor einiger Zeit hatten wir ${dich} über das Ende der Patenschaft für ${sub.get_list('preferred_name')} informiert und ${dir} vorgeschlagen, eine neue Patenschaft für ${sub_name[0]} zu übernehmen.\n"
"    </p>\n"
"    % if amount:\n"
"        <p>\n"
"            Seither haben wir von ${dir} Spenden von CHF ${amount|replace('.0','.-')} erhalten, die wir nicht mehr der Patenschaft von ${sub.get_list('preferred_name')} zuweisen konnten. ${'Möchtet ihr' if plural else 'Möchtest du'} damit die Patenschaft für ${sub_name[0]} starten oder ${'wünscht ihr' if plural else 'wünschst du'} eine Rückerstattung der Spenden?\n"
"        </p>\n"
"        <p>\n"
"            Zurzeit ist ${sub_name[0]} nur mit ${dir} verlinkt und kann nicht von einer anderen Person unterstützt\n"
"            werden. Deshalb sind wir ${dir} für eine schnelle Rückmeldung, allenfalls inklusive ${deiner} Bankangaben, sehr dankbar.\n"
"        </p>\n"
"    % else:\n"
"        <p>\n"
"            ${'Wärt ihr' if plural else 'Wärst du'} bereit die Patenschaft für ${firstname} zu übernehmen? Zurzeit ist ${sub_name[0]} nur mit ${dir} verlinkt und kann nicht von einer anderen Person unterstützt werden. Deshalb sind wir ${dir} für eine schnelle Rückmeldung sehr dankbar.\n"
"        </p>\n"
"    % endif\n"
"% else:\n"
"    <p>\n"
"        Danke, dass ${du} die ${'Patenschaft' if len(children)==1 else 'Patenschaften'} für ${firstname if less_4 else deine + \" Patenkinder\"} ${'übernehmt' if plural else 'übernimmst'}.\n"
"    </p>\n"
"    <p>\n"
"        Der nächste Schritt: Sobald ${deine} erste Spende eingetroffen ist, welche wir in den nächsten Tagen erwarten, ${'startet ' + deine + ' Patenschaft' if len(children) == 1 else 'starten ' + deine + ' Patenschaften'} offiziell.* Danach ${children.get('will be')} ${firstname if less_4 else 'die Kinder'} informiert, dass ${children.get('he')} nun\n"
"        % if plural:\n"
"            Paten\n"
"        % else:\n"
"            ${\"eine Patin\" if partner.title.gender == \"F\" else \"einen Paten\"}\n"
"        % endif\n"
"        gefunden ${\"hat\" if len(children) == 1 else \"haben\"}.\n"
"    </p>\n"
"    <p>\n"
"        Zurzeit ${ist} ${firstname if less_4 else \"die Kinder\"} nur mit ${'euch' if plural else 'dir'} verlinkt und\n"
"        ${'kann' if len(children)==1 else 'können'} nicht von einer anderen Person unterstützt werden.\n"
"    </p>\n"
"    <p>\n"
"        % if lsv_dd:\n"
"            % if not lsv_form_received:\n"
"                Wir warten noch auf die Einzugsermächtigung für die Bank. Danke, dass ${du} uns diese ausgefüllt per Post ${'zurückschickt' if plural else 'zurückschickst'}, damit die ${'Patenschaft' if len(children)==1 else 'Patenschaften'} starten ${'kann' if len(children)==1 else 'können'}.\n"
"            % else:\n"
"                Leider konnten wir ${dein} Konto aufgrund ungenügender Deckung nicht mit dem Patenschaftsbetrag belasten. Wir schlagen daher vor, die Zahlungsart mit dem beigelegten Einzahlungsschein zu ändern und einen Dauerauftrag einzurichten.\n"
"            % endif\n"
"        % else:\n"
"            ${du.title()} ${'habt' if plural else 'hast'} gewählt, die Patenschaftsbeiträge ${frequency.lower()} für einen Betrag von CHF ${\"{:.0f}\".format(amount)}.- zu überweisen.\n"
"        % endif\n"
"    </p>\n"
"% endif\n"
"\n"
"<p>\n"
"    Gemeinsam verändern wir das Leben von Kindern - eins nach dem anderen.\n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse\n"
"\n"
"    % if object.send_mode == 'digital':\n"
"        <br>\n"
"        <br>\n"
"        ${object.user_id.signature | safe}\n"
"    % endif\n"
"    <br>\n"
"    <br>\n"
"    *Falls sich diese Nachricht mit ${deine}r Spende gekreuzt hat, ${'müsst' if plural else 'musst'} ${du} nichts mehr tun.\n"
"</p>"

#. module: partner_communication_reminder
#: model:mail.template,body_html:partner_communication_reminder.email_sponsorship_activation_reminder_3
msgid ""
"<div>\n"
"   % set partner = object.partner_id\n"
"                    \n"
"% set sponsorships = object.get_objects()\n"
"                    \n"
"% set children = sponsorships.mapped('child_id')\n"
"                    \n"
"% set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"  </div>\n"
"  <p>\n"
"   ${partner.salutation}\n"
"   <br>\n"
"   <br>\n"
"   Previously, you had made a decision to sponsor ${firstname} to release ${children.get('him')} from extreme poverty. However, this commitment has not been confirmed by you with the funds you had pledged.\n"
"   <br>\n"
"   <br>\n"
"   Therefore, we must inform you that we have canceled the sponsorship today.\n"
"   <br>\n"
"   <br>\n"
"   We will look for a new sponsor for ${firstname} so that ${children.get('he')} can be supported and to enable ${children.get('him')} to live a life with hope in the future. A personal sponsorship changes the life of a child in extreme poverty in the long-term and is sustainable.\n"
"   <br>\n"
"   <br>\n"
"   ${object.success_sentence or ''} If you decide later on to become a sponsor, we would be happy to hear from you.\n"
"   <br>\n"
"   <br>\n"
"   Did you know that you can help children in poverty by giving them access to drinking water (water filters, toilet installation, hygiene awareness)? With a regular or one-time donation of CHF 10.-, 20.- or 30.- per month , you can make a big difference. If you are interested, please call us at 024 434 21 24 or you can donate online at: www.compassion.ch/spenden\n"
"   <br>\n"
"   <br>\n"
"   Best regards,\n"
"  </p>\n"
" "
msgstr ""
"<div>\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"\n"
"    % if plural:\n"
"        % set paten = 'andere Paten'\n"
"    % else:\n"
"        % if partner.gender == 'M':\n"
"            % set paten = 'einen anderen Paten'\n"
"        % else:\n"
"            % set paten = 'eine andere Patin'\n"
"        % endif\n"
"    % endif\n"
"\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set sponsorships = object.get_objects()\n"
"    % set children = sponsorships.mapped('child_id')\n"
"    % set firstname = children.get_list('preferred_name', 3, children.get_number(), False)\n"
"    % set less_4 = firstname != children.get_number()\n"
"    % set one_child = len(children) == 1\n"
"</div>\n"
"<p>${partner.salutation}</p>\n"
"<p>\n"
"    ${'Ihr habt euch' if plural else 'Du hast dich'} entschieden, die ${children.get('Patenschaft')} für ${firstname if less_4 else deine + \" Patenkinder\"} zu übernehmen um dazu beizutragen, ${children.get('ihn')} aus extremer Armut zu befreien.\n"
"</p>\n"
"<p>\n"
"    <b>Da wir die versprochene Spende leider nicht erhalten haben, werden wir die ${children.get('Patenschaft')} spätestens in einer Woche annullieren müssen.*</b>\n"
"</p>\n"
"<p>\n"
"    Wir werden für ${firstname if less_4 else \"die Patenkinder\"} ${paten} suchen, damit ${children.get('he')} unterstützt ${children.get('will be')} und ${children.get('ihm')} ein Leben mit Hoffnung und Zukunft ermöglicht werden kann.\n"
"</p>\n"
"<p>\n"
"    ${'Habt ihr es euch' if plural else 'Hast du es dir'} doch noch anders überlegt und ${'ihr möchtet' if plural else 'du möchtest'} die ${'Patenschaft' if one_child else 'Patenschaften'} starten? Dann ${'gebt' if plural else 'gib'} uns schnellstmöglich Bescheid. Die Freude ${\"von \" + firstname if less_4 else \"der Kinder\"} wird riesig sein!\n"
"</p>\n"
"<p>\n"
"    Liebe Grüsse\n"
"\n"
"    % if object.send_mode == 'digital':\n"
"        <br>\n"
"        <br>\n"
"        ${object.user_id.signature | safe}\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    *Falls sich diese Nachricht mit ${deine}r Spende gekreuzt hat, ${'müsst ihr' if plural else 'musst du'} nichts mehr tun.\n"
"</p>\n"

