<odoo>
    <data noupdate="1">
        <record id="sponsorship_reminders_cron" model="ir.cron">
            <field name="name">Create sponsorship reminders</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="model_recurring_contract" />
            <field name="state">code</field>
            <field name="code">model.create_reminder_communication()</field>
            <field name="active" eval="False" />
        </record>
        <record
      id="sponsorship_reminder_1"
      model="partner.communication.config"
    >
            <field name="name">Sponsorship Reminder 1</field>
            <field
        name="email_template_id"
        ref="email_sponsorship_reminder_1"
      />
            <field
        name="report_id"
        ref="partner_communication.report_a4_communication"
      />
            <field name="send_mode">physical</field>
            <field name="print_if_not_email">True</field>
            <field name="model_id" ref="model_recurring_contract" />
            <field
        name="user_id"
        search="[('groups_id.display_name', 'like', 'Accounting')]"
      />
        </record>
        <record
      id="sponsorship_reminder_2"
      model="partner.communication.config"
    >
            <field name="name">Sponsorship Reminder 2</field>
            <field
        name="email_template_id"
        ref="email_sponsorship_reminder_2"
      />
            <field
        name="report_id"
        ref="partner_communication.report_a4_communication"
      />
            <field name="send_mode">physical</field>
            <field name="print_if_not_email">True</field>
            <field name="model_id" ref="model_recurring_contract" />
            <field
        name="user_id"
        search="[('groups_id.display_name', 'like', 'Accounting')]"
      />
        </record>
        <record
      id="sponsorship_reminder_3"
      model="partner.communication.config"
    >
            <field name="name">Sponsorship Reminder 3</field>
            <field
        name="email_template_id"
        ref="email_sponsorship_reminder_3"
      />
            <field
        name="report_id"
        ref="partner_communication.report_a4_communication"
      />
            <field name="send_mode">physical</field>
            <field name="print_if_not_email">True</field>
            <field name="model_id" ref="model_recurring_contract" />
            <field
        name="user_id"
        search="[('groups_id.display_name', 'like', 'Accounting')]"
      />
        </record>
        <record
      id="sponsorship_activation_reminder_1"
      model="partner.communication.config"
    >
            <field name="name">Sponsorship Activation Reminder 1</field>
            <field
        name="email_template_id"
        ref="email_sponsorship_activation_reminder_1"
      />
            <field
        name="report_id"
        ref="partner_communication.report_a4_communication"
      />
            <field name="send_mode">physical</field>
            <field name="print_if_not_email">True</field>
            <field name="model_id" ref="model_recurring_contract" />
            <field
        name="user_id"
        search="[('groups_id.display_name', 'like', 'Accounting')]"
      />
        </record>
        <record
      id="sponsorship_activation_reminder_2"
      model="partner.communication.config"
    >
            <field name="name">Sponsorship Activation Reminder 2</field>
            <field
        name="email_template_id"
        ref="email_sponsorship_activation_reminder_2"
      />
            <field
        name="report_id"
        ref="partner_communication.report_a4_communication"
      />
            <field name="send_mode">physical</field>
            <field name="print_if_not_email">True</field>
            <field name="model_id" ref="model_recurring_contract" />
            <field
        name="user_id"
        search="[('groups_id.display_name', 'like', 'Accounting')]"
      />
        </record>
