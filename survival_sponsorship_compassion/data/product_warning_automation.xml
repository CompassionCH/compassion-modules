<odoo noupdate="1">
    <record id="warn_admin_on_product_overload_action" model="ir.actions.server">
        <field name="name">Survival Product Limit Action</field>
        <field name="model_id" ref="account.model_product_product"/>
        <field name="state">code</field>
        <field name="code">records.warn_admin()</field>
    </record>
    <record id="warn_admin_on_product_overload" model="base.automation">
        <field name="name">Survival Product Limit</field>
        <field name="model_id" ref="account.model_product_product" />
        <field name="action_server_ids" eval="[(6,0 , [ref('warn_admin_on_product_overload_action')])]"/>
        <field
        name="filter_domain"
      >[("survival_sponsorship_sale", "=", True), ('slot_used', '>=', 80)]</field>
        <field name="active" eval="True" />
        <field name="trigger">on_create_or_write</field>
    </record>
</odoo>
