<?xml version="1.0" ?>
<odoo>
    <record id="demand_settings_form" model="ir.ui.view">
        <field name="name">demand.planning.settings.form</field>
        <field name="model">res.config.settings</field>
        <field
      name="inherit_id"
      ref="message_center_compassion.compassion_settings"
    />
        <field name="arch" type="xml">
            <app name="compassion_settings">
                <block
          name="demand_planning_configuration"
          title="Demand Planning"
        >
                    <setting id="number_children_website_setting">
                        <field name="number_children_website" />
                    </setting>
                    <setting id="number_children_ambassador_setting">
                        <field name="number_children_ambassador" />
                    </setting>
                    <setting id="days_allocate_before_event_setting">
                        <field name="days_allocate_before_event" />
                    </setting>
                    <setting id="days_hold_after_event_setting">
                        <field name="days_hold_after_event" />
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
