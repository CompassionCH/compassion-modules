#. module: crm_compassion
#: model:mail.template,body_html:crm_compassion.event_letter_template
msgid ""
"<div>\n"
"                    % set invoice_lines = object.get_objects()\n"
"                    % set donations = invoice_lines.get_donations()\n"
"                    % set partner = object.partner_id\n"
"                    % set ambassadors = invoice_lines.mapped('user_id')\n"
"                    % set count = 0\n"
"                    % set currency = invoice_lines[0].move_id.currency_id.name\n"
"                </div>\n"
"                <div>\n"
"                    ${partner.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    On behalf of Compassion Switzerland we truly thank you for your ${'generous' if object.config_id.id != 52 else ''} gift of <br>${donations[0]}\n"
"                    % if donations[1]:\n"
"                        <!-- space --> supporting\n"
"                        % if ambassadors:\n"
"                            <!-- space --> ${ambassadors.get_list('full_name')}\n"
"                        % endif\n"
"                            <!-- space --> for the ${donations[1]}.\n"
"                    % endif\n"
"                    <br>\n"
"                    <br>\n"
"                    % for amb in ambassadors.filtered('advocate_details_id.quote'):\n"
"                       % set count = count + 1\n"
"<div id=\"ambassador_quote\">\n"
"                        ${amb.advocate_details_id.thank_you_quote |safe}\n"
"<br>\n"
"</div>\n"
"                         % if len(ambassadors) != 1 and len(ambassadors) != count:\n"
"                                  <br>\n"
"                                  <br>\n"
"                                  <br>\n"
"                           % endif\n"
"                    % endfor\n"
"% if len(ambassadors) == 2:\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"% endif\n"
"                    % if object.event_id.thank_you_text:\n"
"                        ${object.event_id.thank_you_text |safe}\n"
"                    % endif\n"
"                    % if partner.number_sponsorships:\n"
"                        Have you recently written to your sponsor child? Our website allows you to write a letter directly online. Why not have another go at writing this week?\n"
"                    % else:\n"
"                        % if partner.is_new_donor:\n"
"                            Since 1952, Compassion has been pursuing a very specific mission: to release as many children as possible from extreme poverty – in Jesus’ name.\n"
"In collaboration with 8600 local churches, we currently support 2,3 million children in 27 countries of the global south.\n"
"                            <br>\n"
"                            <br>\n"
"                        % endif\n"
"                        % if not partner.opt_out:\n"
"                            Is the future of the world's poorest children important to you? Compassion offers different ways and solutions to release children from poverty. At the heart of Compassion’s ministry is the Child Sponsorship program. Maybe you would consider sponsoring a child and offering support and encouragement throughout their development? You can find further information on\n"
"www.compassion.ch or you can call us on 0800 874 773.\n"
"                                 <br>\n"
"                                 <br>\n"
"                        % endif\n"
"                    % endif\n"
"                    We just want to take this opportunity to thank you once again for your generosity and support towards these children in need.\n"
"                    <br>\n"
"                    <br>\n"
"                    Sincerely yours\n"
"% if object.send_mode == 'digital':\n"
"   <br>\n"
"   <br>\n"
"    Rachel Maglo\n"
"    <br>\n"
"    Donors relation\n"
"    <br>\n"
"    Compassion Switzerland\n"
"% endif\n"
"% if len(ambassadors) != 0 and len(ambassadors) != 1:\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"% endif\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"    % set invoice_lines = object.get_objects()\n"
"    % set events = invoice_lines.mapped('event_id')\n"
"    % set donations = invoice_lines.get_donations()\n"
"    % set total =  sum(invoice_lines.mapped('price_subtotal'))\n"
"    % set gross = ' grosszügige' if total >= 100 else ''\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set products = invoice_lines.mapped('product_id')\n"
"    % set invoices = invoice_lines.mapped('move_id')\n"
"    % set gift = 'gift' in invoice_lines.mapped('move_id.invoice_category')\n"
"    % set ambassadors = invoice_lines.mapped('user_id').filtered('advocate_details_id.quote')\n"
"    % set prenoms = invoice_lines.mapped('contract_id.child_id').get_list('preferred_name', 3, deine + ' Patenkinder', False)\n"
"\n"
"    % if len(products) == 1 and len(invoices) == 1 or (gift and len(invoice_lines.mapped('move_id.invoice_category')) == 1):\n"
"        % set votre_don = ('eure' + gross + ' Spende') if plural else ('deine' + gross + ' Spende')\n"
"        % set one = True\n"
"    % else:\n"
"        % set votre_don = 'eure Spenden für einen Gesamtbetrag' if plural else  'deine Spenden für einen Gesamtbetrag'\n"
"        % set one = False\n"
"    % endif\n"
"\n"
"    % set currency = invoices[0].currency_id.name\n"
"    % set number_years = object.get_snippet('number_years') | striptags | safe\n"
"    % set number_children = object.get_snippet('number_children') | striptags | safe\n"
"    % set number_fcps = object.get_snippet('number_fcps') | striptags | safe\n"
"    % set number_countries = object.get_snippet('number_countries') | striptags | safe\n"
"    % set years_uc = object.get_snippet('years_uc') | striptags | safe\n"
"    % set years_lc = object.get_snippet('years_lc') | striptags | safe\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Herzlichen Dank für ${votre_don} von ${donations[0]}\n"
"\n"
"    % if ambassadors and not gift:\n"
"        zugunsten von ${ambassadors.get_list('preferred_name')} und ${ambassadors.get('sein')} Einsatz am ${events.name}.\n"
"        Dass Menschen wie ${du} ${ambassadors.get('ihn')} dabei unterstützen, ist unglaublich wertvoll!\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    Dank ${deine}m Engagement und dem Einsatz unserer rund ${number_fcps} Partnerkirchen vor Ort unterstützen wir zurzeit ${number_children} Millionen Kinder im globalen Süden. Gemeinsam tun wir das mit einem Ziel: sie nachhaltig aus Armut zu befreien.\n"
"</p>\n"
"% if partner.number_sponsorships < 1:\n"
"    <p>\n"
"        ${'Hättet ihr' if plral else 'Hättest du'} Freude, eine Patenschaft für ein Kind zu übernehmen? Momentan sucht Compassion für diese Kinder dringend eine Patin oder einen Paten: <a href=\"https://compassion.ch/werde_pate\">compassion.ch/werde-pate</a>\n"
"    </p>\n"
"% endif\n"
"<p>\n"
"    Wenn ${du} mehr über die Verwendung ${deine}r Spende erfahren möchte${'s' if not plural else ''}t, ${'könnt' if plural else 'kannst'} ${du} ${dich} gerne bei uns melden.\n"
"</p>\n"
"<p>\n"
"    Gemeinsam verändern wir das Leben von Kindern - eins nach dem anderen.\n"
"</p>\n"
"Liebe Grüsse\n"

