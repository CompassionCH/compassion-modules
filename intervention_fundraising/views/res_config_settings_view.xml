<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_fundraising" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.fundraising</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="main_currency_setting_container" position="after">
                <block title="Intervention fundraising" name="intervention_fundraising">
                    <setting
            string="Funding accounts"
            company_dependent="1"
            help="Code prefixes of the accounts where the interventions are prefinanced (cost) and where their donations are booked (income)"
          >
                        <div class="row mt8">
                            <label for="fundraising_cost_account_prefix" string="Cost" class="col-lg-3 o_light_label" />
                            <field name="fundraising_cost_account_prefix" />
                        </div>
                        <div class="row">
                            <label for="fundraising_income_account_prefix" string="Income" class="col-lg-3 o_light_label" />
                            <field name="fundraising_income_account_prefix" />
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
