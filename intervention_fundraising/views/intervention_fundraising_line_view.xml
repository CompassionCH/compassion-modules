<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="intervention_fundraising_line_view_list" model="ir.ui.view">
        <field name="name">intervention.fundraising.line.list</field>
        <field name="model">intervention.fundraising.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="currency_id" column_invisible="1" />
                <field name="date" />
                <field name="intervention_id" />
                <field name="partner_id" />
                <field name="kind" />
                <field name="account_id" optional="hide" />
                <field name="move_id" optional="show" />
                <field name="amount" sum="Total" />
            </list>
        </field>
    </record>

    <record id="intervention_fundraising_line_view_pivot" model="ir.ui.view">
        <field name="name">intervention.fundraising.line.pivot</field>
        <field name="model">intervention.fundraising.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="partner_id" type="row" />
                <field name="date" interval="year" type="col" />
                <field name="amount" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="intervention_fundraising_line_view_search" model="ir.ui.view">
        <field name="name">intervention.fundraising.line.search</field>
        <field name="model">intervention.fundraising.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="intervention_id" />
                <field name="partner_id" />
                <filter name="donations" string="Donations" domain="[('kind', '=', 'income')]" />
                <filter name="costs" string="Prefinancing" domain="[('kind', '=', 'cost')]" />
                <separator />
                <filter name="date" string="Date" date="date" />
                <group>
                    <filter name="group_partner" string="Donor" context="{'group_by': 'partner_id'}" />
                    <filter name="group_intervention" string="Intervention" context="{'group_by': 'intervention_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_intervention_fundraising_line" model="ir.actions.act_window">
        <field name="name">Intervention donations</field>
        <field name="res_model">intervention.fundraising.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_donations': 1}</field>
    </record>
</odoo>
