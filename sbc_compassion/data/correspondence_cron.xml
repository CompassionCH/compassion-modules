<odoo noupdate="1">
    <record id="send_postponed_christmas_letters_cron" model="ir.cron">
        <field name="name">Send postponed Christmas letters cron </field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">365</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall">1</field>
        <field name="model_id" ref="model_correspondence" />
        <field name="code">model.check_postponed_christmas_letters()</field>
    </record>

    <record id="download_old_correspondence_cron" model="ir.cron">
        <field name="name">Download old correspondence</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="model_id" ref="model_correspondence" />
        <field name="code">model.cron_download_old_correspondence()</field>
    </record>
</odoo>
