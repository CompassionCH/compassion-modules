<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- TpLoader: inline spinner for small loading indicators -->
    <t t-name="sbc_translation.TpLoader">
        <div class="d-flex justify-content-center">
            <span class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </span>
        </div>
    </t>

    <!-- TpBlurLoader: full-screen blur overlay shown while page-level content loads -->
    <t t-name="sbc_translation.TpBlurLoader">
        <div t-if="props.active"
             class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center"
             style="background: rgba(255,255,255,0.7); backdrop-filter: blur(4px); z-index: 40;">
            <div class="p-4 bg-white rounded shadow">
                <TpLoader />
            </div>
            <p t-if="props.text" class="mt-3 text-muted fs-5" t-out="props.text" />
        </div>
    </t>

</templates>
