<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Help modal -->
    <t t-name="sbc_translation.TpHelpModal">
        <TpModal active="props.active" onClose="props.onClose" title="Help">
            <div class="p-3 small" style="max-width: 450px;">
                <h6 class="fw-semibold">How to use the Translation Platform</h6>
                <ul>
                    <li class="mb-2">Go to <strong>Home</strong> to see the letters waiting for your skills.</li>
                    <li class="mb-2">Click on a letter link or the <em>Take the first</em> button to start translating.</li>
                    <li class="mb-2">In the editor: fill in the <em>Translated Content</em> field for each paragraph.</li>
                    <li class="mb-2">Use <strong>Save</strong> to save your work in progress.</li>
                    <li class="mb-2">Use <strong>Submit</strong> when you are done. Your translation will be reviewed.</li>
                    <li class="mb-2">If there is a problem with the letter, click <strong>Signal a Problem</strong>.</li>
                    <li class="mb-2">The keyboard shortcut <kbd>Ctrl+S</kbd> saves your current translation.</li>
                </ul>
            </div>
        </TpModal>
    </t>

    <!-- Root application component -->
    <t t-name="sbc_translation.TranslationPlatform">
        <div class="tp-root d-flex" style="min-height: 100vh;">
            <!-- Sidebar navigation -->
            <div class="tp-sidebar d-flex flex-column align-items-center py-3 bg-compassion text-white"
                 style="width: 64px; min-height: 100vh; flex-shrink: 0; position: fixed; z-index: 100; top: 0; left: 0;">
                <!-- Logo -->
                <div class="mb-4 text-center" style="font-size: 10px; line-height: 1.2;">
                    <i class="fa fa-heart fa-2x mb-1" /><br/>CP
                </div>
                <!-- Home -->
                <button type="button"
                        class="btn btn-link text-white p-2 mb-1"
                        title="Home"
                        t-att-class="{ 'tp-nav-active': state.page === 'home' }"
                        t-on-click="() => this.navigate('home')">
                    <i class="fa fa-home fa-lg" />
                </button>
                <!-- Letters -->
                <button type="button"
                        class="btn btn-link text-white p-2 mb-1"
                        title="Letters"
                        t-att-class="{ 'tp-nav-active': state.page === 'letters' }"
                        t-on-click="() => this.navigate('letters')">
                    <i class="fa fa-envelope fa-lg" />
                </button>
                <!-- Translators (admin only) -->
                <button type="button"
                        class="btn btn-link text-white p-2 mb-1"
                        t-if="state.translator and state.translator.role === 'admin'"
                        title="Translators"
                        t-att-class="{ 'tp-nav-active': state.page === 'translators' }"
                        t-on-click="() => this.navigate('translators')">
                    <i class="fa fa-users fa-lg" />
                </button>
                <!-- Bottom utilities -->
                <div class="mt-auto d-flex flex-column align-items-center gap-2">
                    <button type="button"
                            class="btn btn-link text-white p-2"
                            title="Child Protection"
                            t-on-click="() => state.childModal = true">
                        <i class="fa fa-child fa-lg" />
                    </button>
                    <button type="button"
                            class="btn btn-link text-white p-2"
                            title="Help"
                            t-on-click="() => state.helpModal = true">
                        <i class="fa fa-info-circle fa-lg" />
                    </button>
                </div>
            </div>

            <!-- Main content area (offset for sidebar) -->
            <div class="flex-grow-1" style="margin-left: 64px; min-height: 100vh;">
                <!-- Global loading overlay -->
                <div t-if="state.loading"
                     class="d-flex flex-column align-items-center justify-content-center"
                     style="height: 100vh;">
                    <div class="spinner-border text-primary mb-3" />
                    <p class="text-muted">Loading translation platform…</p>
                </div>

                <!-- Page router -->
                <div t-elif="state.page === 'home'">
                    <TpHome translator="state.translator"
                            navigate="navigate"
                            onRefreshTranslator="refreshTranslator" />
                </div>
                <div t-elif="state.page === 'letters'">
                    <TpLetters navigate="navigate"
                               translator="state.translator"
                               isAdmin="state.translator and state.translator.role === 'admin'" />
                </div>
                <div t-elif="state.page === 'letter-edit'">
                    <TpLetterEdit letterId="state.letterId"
                                  navigate="navigate"
                                  translator="state.translator" />
                </div>
                <div t-elif="state.page === 'translators'">
                    <TpTranslators navigate="navigate" />
                </div>
            </div>

            <!-- Modals -->
            <TpChildModal active="state.childModal" onClose="() => state.childModal = false" />
            <TpHelpModal active="state.helpModal" onClose="() => state.helpModal = false" />
        </div>
    </t>

</templates>
