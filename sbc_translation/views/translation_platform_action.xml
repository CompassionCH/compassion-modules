<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Client Action: Translation Platform
        Registered in the action registry with tag "translation_platform".
        This mounts the OWL TranslationPlatform root component.
    -->
    <record id="action_translation_platform" model="ir.actions.client">
        <field name="name">Translation Platform</field>
        <field name="tag">translation_platform</field>
        <!-- Make it full-screen by removing the breadcrumb / action manager header -->
        <field name="target">main</field>
    </record>

    <!--
        Menu item visible to translator users (group_user).
        Sits under the existing "Translation Platform" parent menu.
        Translators are redirected here automatically on login (see translation_user.py).
    -->
    <menuitem id="menu_translation_platform_app"
              name="My Translations"
              parent="sbc_translation.menu_translation_platform"
              action="action_translation_platform"
              sequence="0"
              groups="sbc_translation.group_user" />
</odoo>
