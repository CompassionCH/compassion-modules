<odoo>
<record id="view_translation_badge_tree" model="ir.ui.view">
        <field name="name">translation.badge.tree</field>
        <field name="model">translation.badge</field>
        <field name="arch" type="xml">
            <list string="Badges">
                <field name="name"/>
                <field name="badge_type"/>
                <field name="threshold"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_translation_badge_form" model="ir.ui.view">
        <field name="name">translation.badge.form</field>
        <field name="model">translation.badge</field>
        <field name="arch" type="xml">
            <form string="Badge">
                <sheet>
                    <field name="icon" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Badge Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="badge_type"/>
                            <field name="threshold"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="start_date" invisible="badge_type != 'campaign'"/>
                            <field name="end_date" invisible="badge_type != 'campaign'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_translation_badge" model="ir.actions.act_window">
        <field name="name">Badges</field>
        <field name="res_model">translation.badge</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_translation_badge"
              parent="menu_translation_platform"
              name="Badges"
              action="action_translation_badge"
              sequence="4"
              groups="sbc_translation.group_manager"/>
</odoo>
