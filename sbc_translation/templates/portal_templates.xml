<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Portal home: add a "Translation Platform" entry so translators
        see the link when they log in and visit /my.
    -->
    <template id="portal_my_home_translation"
              name="Translation Platform – Portal Home"
              inherit_id="portal.portal_my_home"
              customize_show="True"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
          <t t-set="portal_client_category_enable" t-value="True" />
          <t t-set="portal_alert_category_enable" t-value="True" />
        </xpath>
        <div id="portal_alert_category" position="inside">
          <t t-call="portal.portal_docs_entry" t-if="translator">
            <t t-set="bg_color" t-value="'alert alert-info align-items-center'" />
            <t t-set="placeholder_count" t-value="'letters_in_progress'" />
            <t t-set="title">Letter in translation</t>
            <t t-set="url" t-value="'/my/translation-platform'" />
            <t t-set="show_count" t-value="True" />
          </t>
        </div>
        <div id="portal_client_category" position="inside">
            <h1>TP <t t-out="translator.name" /></h1>
            <t t-call="portal.portal_docs_entry" t-if="translator">
                <t t-set="icon" t-value="'/sbc_translation/static/img/menu_icon_small.png'"/>
                <t t-set="title">Letters to translate</t>
                <t t-set="text">Go to the Translation Platform</t>
                <t t-set="url" t-value="'/my/translation-platform'"/>
                <t t-set="placeholder_count" t-value="'letters_to_translate'" />
                <t t-set="show_count" t-value="True" />
            </t>
        </div>
    </template>

    <!--
        Full-screen Translation Platform page.
        Served at /my/translation-platform.
        The OWL app is mounted inside #tp-app-root by translation_platform.esm.js.
    -->
    <template id="portal_translation_platform" name="Translation Platform">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="True"/>
            <!--
                Full-screen fixed overlay that covers the portal header/footer.
                The OWL root component mounts here.
            -->
            <div id="tp-app-root"
                 style="position:fixed;top:0;left:0;width:100vw;height:100vh;
                        z-index:10000;background:#fff;overflow:hidden;"/>
        </t>
    </template>
</odoo>
