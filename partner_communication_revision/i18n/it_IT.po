#. module: partner_communication_revision
#: model:mail.template,body_html:partner_communication_revision.revision_reminder_template
msgid ""
"<html>\n"
"  <body><div>\n"
"                    <t t-set=\"user\" t-value=\"object.get_objects()\"/>\n"
"                    <t t-set=\"revisions\" t-value=\"object.env[&#x27;partner.communication.revision&#x27;].search([&#x27;|&#x27;, &#x27;&amp;amp;&#x27;, (&#x27;user_id&#x27;, &#x27;=&#x27;, user.id), (&#x27;state&#x27;, &#x27;in&#x27;, [&#x27;pending&#x27;, &#x27;corrected&#x27;]), &#x27;&amp;amp;&#x27;, (&#x27;correction_user_id&#x27;, &#x27;=&#x27;, user.id), (&#x27;state&#x27;, &#x27;=&#x27;, &#x27;submit&#x27;)])\"/>\n"
"                    <t t-set=\"base_url\" t-value=\"object.env[&#x27;ir.config_parameter&#x27;].get_param(&#x27;web.base.url&#x27;)\"/>\n"
"                </div>\n"
"                <p>\n"
"                    Dear <t t-out=\"object.partner_id.firstname\"></t>,\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <t t-if=\"revisions\">\n"
"                        You have been assigned to the following revision texts, for which an action is still needed from you:\n"
"                    </t>\n"
"<t t-else=\"\">\n"
"                        <t t-set=\"number\" t-value=\"object.env[&#x27;partner.communication.revision&#x27;].search_count([(&#x27;state&#x27;, &#x27;not in&#x27;, [&#x27;approved&#x27;, &#x27;active&#x27;]), &#x27;|&#x27;, (&#x27;user_id&#x27;, &#x27;=&#x27;, user.id), (&#x27;correction_user_id&#x27;, &#x27;=&#x27;, user.id)])\"/>\n"
"                        Congratulations! You have finished all your work with the revision texts! How great is that? You still have <t t-out=\"number\"></t> texts that are waiting for approval. Let's hope they will be accepted. In the meantime, make sure to treat yourself with a good cup of coffee or tea, you deserved this.\n"
"                    </t>\n"
"                </p>\n"
"                <ul>\n"
"                    <t t-foreach=\"revisions\" t-as=\"revision\">\n"
"                        <t t-set=\"action\" t-value=\"&#x27;Submit your text.&#x27;\"/>\n"
"                        <t t-if=\"revision.state == &#x27;corrected&#x27;\">\n"
"                            <t t-set=\"action\" t-value=\"&#x27;Approve the corrections or submit a new proposition.&#x27;\"/>\n"
"                        </t>\n"
"                        <t t-if=\"revision.state == &#x27;submit&#x27;\">\n"
"                            <t t-set=\"action\" t-value=\"&#x27;Proofread the text and approve/correct it.&#x27;\"/>\n"
"                        </t>\n"
"                        <li>[<a t-attf-href=\"{{base_url + '/web#id={}}&amp;view_type=form&amp;model=partner.communication.revision'.format(revision.id)}\"><t t-out=\"revision.display_name\"></t></a>]: <t t-out=\"action\"></t></li>\n"
"                    </t>\n"
"                </ul>\n"
"                <p>Have a nice day</p>\n"
"            </body>\n"
"</html>\n"
msgstr ""

