<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t
    t-inherit="mail.Message"
    t-inherit-mode="extension"
    t-name="Message Edit Icon"
  >
        <xpath expr="//div[hasclass('o_Message_sidebarCommands')]">
            <span class="o_Message_command" t-if="message and message.subject">
                <i
          class="fa fa-comments"
          t-att-class="{
                        'o-mobile': env.messaging.device.isMobile,
                    }"
          t-on-click="_onMessageToInteraction"
        > </i>
            </span>
        </xpath>
        <xpath expr="//div[hasclass('o_Message_headerCommands')]">
            <div
        class="o_Message_command ml-2"
        t-if="message and message.subject"
      >
                <i
          class="fa fa-comments"
          t-att-class="{
                        'o-mobile': env.messaging.device.isMobile,
                    }"
          t-on-click="_onMessageToInteraction"
        > </i>
            </div>
        </xpath>
    </t>

</templates>
