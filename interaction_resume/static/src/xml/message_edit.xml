<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-inherit="mail.Message" t-inherit-mode="extension" t-name="interaction_resume.Message">
        <xpath expr="//div[contains(@class, 'o-mail-Message-header')]" position="inside">
            <span class="ms-2"
                  style="cursor: pointer;"
                  t-if="message.subject"
                  t-on-click="messageToInteraction"
                  title="Convert to Interaction">
                <i class="fa fa-comments text-muted"/>
            </span>
        </xpath>
    </t>
</templates>
