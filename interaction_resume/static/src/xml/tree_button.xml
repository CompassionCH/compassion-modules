<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="interaction_resume.ListView.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
            <button type="button" class="btn btn-secondary btn-refresh" t-on-click="onRefresh">
                <i class="fa fa-refresh"/> Refresh
            </button>
            <button type="button" class="btn btn-secondary btn-fetch-more" t-on-click="onFetchMore">
                <i class="fa fa-plus"/> Fetch More
            </button>
            <button type="button" class="btn btn-secondary btn-log-interaction" t-on-click="onLogInteraction">
                <i class="fa fa-pencil"/> Log Interaction
            </button>
        </xpath>
    </t>
</templates>
