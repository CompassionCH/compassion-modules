#. module: crm_request
#. odoo-python
#: code:addons/crm_request/models/holiday_closure.py:0
msgid ""
"\n"
"<p>\n"
"    Thank you for your message.\n"
"</p>\n"
"<p>\n"
"    We look forward to answering your message again from [reply_date].\n"
"</p>\n"
"<p>\n"
"    Until then, we wish you happy holidays.\n"
"</p>\n"
msgstr ""
"\n"
"<p>Grazie per il messaggio.</p>\n"
"<p>Non vediamo l'ora di rispondere di nuovo al tuo messaggio il [reply_date].</p>\n"
"<p>Fino ad allora, vi auguriamo buone vacanze.</p>\n"

#. module: crm_request
#: model:mail.template,body_html:crm_request.assigned_contact_holiday_email_template
msgid ""
"<html>\n"
"  <body><div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    <t t-set=\"claim\" t-value=\"object\"/>\n"
"                    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"                </div>\n"
"                <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    <t t-out=\"partner.salutation or &quot;Dear friends of Compassion&quot;\"></t>,\n"
"                    <br/>\n"
"                    <br/>\n"
"                    Your assigned contact at Compassion is currently in holiday. You might not have an answer before [his/her] return on the [return_date].\n"
"                    If your request requires an urgent answer, please reply to this email or reach to us by phone.\n"
"                    Thank you for your comprehension.\n"
"                    <br/>\n"
"                    <br/>\n"
"                    Kind regards,\n"
"                </div>\n"
"            <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"            <t t-if=\"user and user.signature\">\n"
"                <t t-out=\"user.signature\"></t>\n"
"            </t>\n"
"            </div></body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body>\n"
"    <div>\n"
"         <t t-if=\"user and user.signature\">\n"
"                <t t-out=\"user.signature\"></t>\n"
"            </t>\n"
"            </div>\n"
"  </body>\n"
"</html>\n"

#. module: crm_request
#: model:mail.template,body_html:crm_request.business_closed_email_template
msgid ""
"<html>\n"
"  <body><div>\n"
"                    <t t-set=\"claim\" t-value=\"object\"/>\n"
"                    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"                    <t t-set=\"closure\" t-value=\"object.holiday_closure_id\"/>\n"
"                </div>\n"
"                <div>\n"
"                    <t t-out=\"partner.salutation or &quot;Dear friends of Compassion&quot;\"></t>,\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <t t-out=\"closure.holiday_template_message\"></t>\n"
"                    <t t-out=\"closure.signature\"></t>\n"
"                </div></body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div>\n"
"                    <t t-set=\"claim\" t-value=\"object\"/>\n"
"                    <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
