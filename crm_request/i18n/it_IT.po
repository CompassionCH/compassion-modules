"                </div>\n"
"                <div>\n"
"                    <t t-out=\"partner.salutation or &quot;Caro amico di Compassion&quot;\"></t>,\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <t t-out=\"closure.holiday_template_message\"></t>\n"
"                    <t t-out=\"closure.signature\"></t>\n"
"                </div></body>\n"
"</html>\n"

